RULE { :state9 :qa ?za; :qb ?zb; :qc ?zc } WHERE {
  :state8 :qa ?a; :qb ?b; :qc ?c.
  SET(?na := 1 - ?a)
  SET(?nc := 1 - ?c)
  SET(?t1 := ?a * ?c)
  SET(?t2 := ?b * ?nc)
  SET(?t3 := ?na * ?c)
  SET(?d1 := ?t1 + ?t2 - ?t1 * ?t2)
