  SET(?nc := 1 - ?c)
  SET(?t1 := ?a * ?c)
  SET(?t2 := ?b * ?nc)
  SET(?t3 := ?na * ?c)
  SET(?d1 := ?t1 + ?t2 - ?t1 * ?t2)
  SET(?d2 := ?t2 + ?t3 - ?t2 * ?t3)
  SET(?ab := ?a * ?b)
  SET(?nb := 1 - ?b)
  SET(?nanb := ?na * ?nb)
  SET(?d3 := ?ab + ?nanb - ?ab * ?nanb)
