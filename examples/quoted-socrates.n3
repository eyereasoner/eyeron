# Classifying a quoted Socrates statement
#
# A quoted graph says that Socrates is human, and a class link relates
# humans to mortals. An N3 rule derives the corresponding quoted mortality
# statement.

@base <https://eyereasoner.github.io/eye/reasoning/rdf-star-reasoning/socrates.n3> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix : <http://example.org/socrates#> .

# The Human statement is inside a graph value; it is not a top-level fact.
:we :have {
    :Socrates rdf:type :Human .
} .
:Human rdfs:subClassOf :Mortal .

# Match the quoted type, follow its subclass link and produce another
# quoted statement under have, keeping it apart from asserted data.
{
    ?A rdfs:subClassOf ?B .
    :we :have {
        ?S rdf:type ?A .
    }
} => {
    :we :have {
        ?S rdf:type ?B .
    }
} .
