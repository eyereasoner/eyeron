# Building Collatz sequences
#
# Selected positive integers are repeatedly halved when even or replaced by
# three times the number plus one when odd. Recursive backward N3 rules
# build their sequences down to one.

@prefix : <http://example.org/> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Stop at one. Each recursive case below prepends its starting value.
{
    1 :collatz (1)
} <= true .

# For an even number above one, halve it and continue.
{
    ?N :collatz ?Sequence
} <= {
    ?N math:greaterThan 1 .
    (?N 2) math:remainder ?Parity .
    ?Parity math:equalTo 0 .
    (?N 2) math:integerQuotient ?Next .
    ?Next :collatz ?Tail .
    ?Sequence list:firstRest (?N ?Tail) .
} .

# For an odd number above one, continue from three times it plus one.
{
    ?N :collatz ?Sequence
} <= {
    ?N math:greaterThan 1 .
    (?N 2) math:remainder ?Parity .
    ?Parity math:equalTo 1 .
    (3 ?N) math:product ?Triple .
    (?Triple 1) math:sum ?Next .
    ?Next :collatz ?Tail .
    ?Sequence list:firstRest (?N ?Tail) .
} .

# Ask only for these nine starts; this does not test the general conjecture.
{
    (1 2 3 4 5 6 8 10 16) list:member ?N .
    ?N :collatz ?Sequence
} => {
    :sequences :collatz (?N ?Sequence)
} .
