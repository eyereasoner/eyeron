{ :ok_list_append_1 a :Pass . } pe:why {
  { :ok_list_append_1 a :Pass . }
    pe:by [ pe:rule "list-builtins-tests.n3"; pe:line 11 ];
    pe:uses { ((1 2) (3 4)) list:append (1 2 3 4) . }.

  { ((1 2) (3 4)) list:append (1 2 3 4) . }
    pe:by [ pe:builtin list:append ].
}.

