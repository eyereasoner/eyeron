{ :clinicMicrogrid :criticalWatts 620 . } pe:why {
  { :clinicMicrogrid :criticalWatts 620 . }
    pe:by [ pe:rule "rdf-message-microgrid.n3"; pe:line 50 ];
    pe:binding
      [ pe:var "CriticalWatts"; pe:value 620 ],
      [ pe:var "Fridge"; pe:value 120 ],
      [ pe:var "Message"; pe:value <urn:eyeron:rdf-message-stream:1:envelope:1> ],
      [ pe:var "Oxygen"; pe:value 500 ],
      [ pe:var "Payload"; pe:value <urn:eyeron:rdf-message-stream:1:payload:1> ],
      [ pe:var "PayloadContext"; pe:value {
          :oxygenConcentrator a :LifeSafetyLoad .
          :oxygenConcentrator :requiresWatts 500 .
          :oxygenConcentrator :serves :respiratoryCareRoom .
          :vaccineFridge a :ColdChainLoad .
          :vaccineFridge :requiresWatts 120 .
          :vaccineFridge :serves :vaccineColdChain .
          in:run a see:InputDataset .
          in:run see:name "rdf_message_microgrid" .
          in:run see:title "RDF Message Microgrid" .
          in:run see:sourceFile "examples/rdf-message-microgrid.n3" .
          in:run see:description "A true RDF 1.2 Message Log for a storm clinic microgrid. Eyeron parses MESSAGE delimiters into replayable internal message envelopes for bounded, explainable load-shedding." .
          in:run see:compiler "Eyeron RDF Message Log input" .
      } ];
    pe:uses
      { <urn:eyeron:rdf-message-stream:1:envelope:1> eymsg:payloadGraph <urn:eyeron:rdf-message-stream:1:payload:1> . },
      {
          <urn:eyeron:rdf-message-stream:1:payload:1> log:nameOf {
              :oxygenConcentrator a :LifeSafetyLoad .
              :oxygenConcentrator :requiresWatts 500 .
              :oxygenConcentrator :serves :respiratoryCareRoom .
              :vaccineFridge a :ColdChainLoad .
              :vaccineFridge :requiresWatts 120 .
              :vaccineFridge :serves :vaccineColdChain .
              in:run a see:InputDataset .
              in:run see:name "rdf_message_microgrid" .
              in:run see:title "RDF Message Microgrid" .
              in:run see:sourceFile "examples/rdf-message-microgrid.n3" .
              in:run see:description "A true RDF 1.2 Message Log for a storm clinic microgrid. Eyeron parses MESSAGE delimiters into replayable internal message envelopes for bounded, explainable load-shedding." .
              in:run see:compiler "Eyeron RDF Message Log input" .
          } .
      },
      {
          {
              :oxygenConcentrator a :LifeSafetyLoad .
              :oxygenConcentrator :requiresWatts 500 .
              :oxygenConcentrator :serves :respiratoryCareRoom .
              :vaccineFridge a :ColdChainLoad .
              :vaccineFridge :requiresWatts 120 .
              :vaccineFridge :serves :vaccineColdChain .
              in:run a see:InputDataset .
              in:run see:name "rdf_message_microgrid" .
