@prefix : <http://example.org/pn-junction-tunneling#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:case :peakBias 2 .
:case :peakCurrent 4 .
:case :negativeDifferentialRegion true .

{ :case :peakBias 2 . }
  pe:rule 7;
  pe:binding
    [ pe:var "c0"; pe:value 2 ],
    [ pe:var "c1"; pe:value 3 ],
    [ pe:var "c3"; pe:value 3 ],
    [ pe:var "c4"; pe:value 2 ],
    [ pe:var "c5"; pe:value 1 ],
    [ pe:var "c6"; pe:value 0 ],
    [ pe:var "peak"; pe:value 4 ];
  pe:uses
    { :b2 :currentProxy 4 . },
    { :b0 :currentProxy 2 . },
    { 4 math:greaterThan 2 . },
    { :b1 :currentProxy 3 . },
    { 4 math:greaterThan 3 . },
    { :b3 :currentProxy 3 . },
    { 4 math:greaterThan 3 . },
    { :b4 :currentProxy 2 . },
    { 4 math:greaterThan 2 . },
    { :b5 :currentProxy 1 . },
    { 4 math:greaterThan 1 . },
    { :b6 :currentProxy 0 . },
    { 4 math:greaterThan 0 . }.

{ :b2 :currentProxy 4 . }
  pe:rule 6;
  pe:binding
    [ pe:var "bnode"; pe:value :b2 ],
    [ pe:var "current"; pe:value 4 ],
    [ pe:var "v0"; pe:value 1 ],
    [ pe:var "v1"; pe:value 1 ],
    [ pe:var "v2"; pe:value 1 ],
    [ pe:var "v3"; pe:value 1 ];
  pe:uses
    { (:b2 0) :overlapValue 1 . },
    { (:b2 1) :overlapValue 1 . },
    { (:b2 2) :overlapValue 1 . },
    { (:b2 3) :overlapValue 1 . },
    { (1 1 1 1) math:sum 4 . }.

{ (:b2 0) :overlapValue 1 . }
  pe:rule 3;
  pe:binding
    [ pe:var "bnode"; pe:value :b2 ],
    [ pe:var "shifted"; pe:value 1 ],
    [ pe:var "slot"; pe:value 0 ];
  pe:uses
    { (:b2 0) :shiftedLevel 1 . },
    { 1 math:notLessThan 1 . },
    { 1 math:notGreaterThan 4 . }.

{ (:b2 0) :shiftedLevel 1 . }
  pe:rule 2;
  pe:binding
    [ pe:var "bias"; pe:value 2 ],
    [ pe:var "bnode"; pe:value :b2 ],
    [ pe:var "levels"; pe:value (3 4 5 6) ],
    [ pe:var "shifted"; pe:value 1 ],
    [ pe:var "slot"; pe:value 0 ],
    [ pe:var "zeroLevel"; pe:value 3 ];
  pe:uses
    { :b2 list:in (:b0 :b1 :b2 :b3 :b4 :b5 :b6) . },
    { :b2 :value 2 . },
    { :case :pEmptyZeroBiasLevels (3 4 5 6) . },
    { (3 4 5 6) list:iterate (0 3) . },
    { (3 2) math:difference 1 . }.

{ :b2 list:in (:b0 :b1 :b2 :b3 :b4 :b5 :b6) . }
  pe:builtin list:in.

{ :b2 :value 2 . }
  pe:fact "pn-junction-tunneling.n3".

{ :case :pEmptyZeroBiasLevels (3 4 5 6) . }
  pe:fact "pn-junction-tunneling.n3".

{ (3 4 5 6) list:iterate (0 3) . }
  pe:builtin list:iterate.

{ (3 2) math:difference 1 . }
  pe:builtin math:difference.

{ 1 math:notLessThan 1 . }
  pe:builtin math:notLessThan.

{ 1 math:notGreaterThan 4 . }
  pe:builtin math:notGreaterThan.

