@prefix : <https://example/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:test :namedPerson :alice .
:test :namedText "Alice"^^xsd:string .
:alice :displayName "Bonjour"@fr .
:test :title "HTML و CSS"@ar--rtl .
:test :knowsSource :chat .
:test :knowsSubject :alice .
:test :knowsObject :bob .

{ :test :namedPerson :alice . } pe:why {
  { :test :namedPerson :alice . }
    pe:by [ pe:rule "rdf12-interoperability.n3"; pe:line 26 ];
    pe:binding
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "text"; pe:value "Alice"^^xsd:string ];
    pe:uses { :alice :name "Alice"^^xsd:string . }.

  { :alice :name "Alice"^^xsd:string . }
    pe:by [ pe:fact "rdf12-interoperability.n3"; pe:line 17 ].
}.

{ :test :namedText "Alice"^^xsd:string . } pe:why {
  { :test :namedText "Alice"^^xsd:string . }
    pe:by [ pe:rule "rdf12-interoperability.n3"; pe:line 26 ];
    pe:binding
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "text"; pe:value "Alice"^^xsd:string ];
    pe:uses { :alice :name "Alice"^^xsd:string . }.

  { :alice :name "Alice"^^xsd:string . }
    pe:by [ pe:fact "rdf12-interoperability.n3"; pe:line 17 ].
}.

{ :alice :displayName "Bonjour"@fr . } pe:why {
  { :alice :displayName "Bonjour"@fr . }
    pe:by [ pe:rule "rdf12-interoperability.n3"; pe:line 24 ];
    pe:binding
      [ pe:var "label"; pe:value "Bonjour"@fr ],
      [ pe:var "person"; pe:value :alice ];
    pe:uses { :alice :label "Bonjour"@fr . }.

  { :alice :label "Bonjour"@fr . }
    pe:by [ pe:fact "rdf12-interoperability.n3"; pe:line 18 ].
}.

{ :test :title "HTML و CSS"@ar--rtl . } pe:why {
  { :test :title "HTML و CSS"@ar--rtl . }
    pe:by [ pe:rule "rdf12-interoperability.n3"; pe:line 27 ];
    pe:binding [ pe:var "title"; pe:value "HTML و CSS"@ar--rtl ];
    pe:uses { :document :title "HTML و CSS"@ar--rtl . }.

  { :document :title "HTML و CSS"@ar--rtl . }
    pe:by [ pe:fact "rdf12-interoperability.n3"; pe:line 20 ].
}.

{ :test :knowsSource :chat . } pe:why {
  { :test :knowsSource :chat . }
    pe:by [ pe:rule "rdf12-interoperability.n3"; pe:line 28 ];
    pe:binding
      [ pe:var "claim"; pe:value _:b1 ],
      [ pe:var "o"; pe:value :bob ],
      [ pe:var "s"; pe:value :alice ],
      [ pe:var "source"; pe:value :chat ];
    pe:uses
      {
          _:b1 :statement {
              :alice :knows :bob .
          } .
      },
      { _:b1 :source :chat . }.

  {
    _:b1 :statement {
        :alice :knows :bob .
    } .
}
    pe:by [ pe:fact "rdf12-interoperability.n3"; pe:line 22 ].

  { _:b1 :source :chat . }
    pe:by [ pe:fact "rdf12-interoperability.n3"; pe:line 22 ].
}.

