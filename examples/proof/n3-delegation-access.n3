            ?DocP :says ?FP .
            ?FP log:includes {
                ?G :mayRead ?R .
            } .
        } => {
            {
                ?U :memberOf ?G .
            } :assertedBy ?DocM .
            {
                ?G :mayRead ?R .
            } :assertedBy ?DocP .
        } .
    };
  pe:binding
    [ pe:var "DocM"; pe:value <https://interns.example/members.n3> ],
    [ pe:var "DocP"; pe:value <https://hr.example/policy.n3> ],
    [ pe:var "FM"; pe:value {
        id:eve foaf:name "Eve" .
        id:eve :memberOf :eng .
    } ],
    [ pe:var "FP"; pe:value {
        :eng :mayRead :buildReport .
        :eng :mayRead :roadmap .
    } ],
    [ pe:var "G"; pe:value :eng ],
    [ pe:var "R"; pe:value :buildReport ],
    [ pe:var "U"; pe:value id:eve ];
  pe:uses
    { id:eve :canRead :buildReport . },
    { id:eve :memberOf :eng . },
    { :eng :mayRead :buildReport . },
    { :policy :trusts <https://interns.example/members.n3> . },
    {
        <https://interns.example/members.n3> :says {
            id:eve foaf:name "Eve" .
            id:eve :memberOf :eng .
        } .
    },
    {
        {
            id:eve foaf:name "Eve" .
            id:eve :memberOf :eng .
        } log:includes {
            id:eve :memberOf :eng .
        } .
    },
    { :policy :trusts <https://hr.example/policy.n3> . },
    {
        <https://hr.example/policy.n3> :says {
            :eng :mayRead :buildReport .
            :eng :mayRead :roadmap .
        } .
    },
    {
        {
            :eng :mayRead :buildReport .
            :eng :mayRead :roadmap .
        } log:includes {
            :eng :mayRead :buildReport .
        } .
    }.
