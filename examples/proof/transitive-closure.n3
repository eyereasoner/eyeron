:test :is true .

{ :range :has 2 . }
  pe:rule 1;
  pe:binding
    [ pe:var "Max"; pe:value 70 ],
    [ pe:var "N"; pe:value 1 ],
    [ pe:var "Next"; pe:value 2 ];
  pe:uses
    { :range :has 1 . },
    { :report :nodes 70 . },
    { 1 math:lessThan 70 . },
    { (1 1) math:sum 2 . }.

{ :range :has 1 . }
  pe:fact "transitive-closure.n3".

{ :report :nodes 70 . }
  pe:fact "transitive-closure.n3".

{ 1 math:lessThan 70 . }
  pe:builtin math:lessThan.

{ (1 1) math:sum 2 . }
  pe:builtin math:sum.

{ 1 :nextNumber 2 . }
  pe:rule 3;
  pe:binding
    [ pe:var "Max"; pe:value 70 ],
    [ pe:var "N"; pe:value 1 ],
    [ pe:var "Next"; pe:value 2 ];
  pe:uses
    { :range :has 1 . },
    { :report :nodes 70 . },
    { 1 math:lessThan 70 . },
    { (1 1) math:sum 2 . }.

{ 2 :nextNumber 3 . }
  pe:rule 3;
  pe:binding
    [ pe:var "Max"; pe:value 70 ],
    [ pe:var "N"; pe:value 2 ],
    [ pe:var "Next"; pe:value 3 ];
  pe:uses
    { :range :has 2 . },
    { :report :nodes 70 . },
    { 2 math:lessThan 70 . },
    { (2 1) math:sum 3 . }.

{ 2 math:lessThan 70 . }
  pe:builtin math:lessThan.

{ (2 1) math:sum 3 . }
  pe:builtin math:sum.

{ :report :directLinks 69 . }
  pe:rule 7;
  pe:binding
    [ pe:var "Links"; pe:value 69 ],
    [ pe:var "Max"; pe:value 70 ];
  pe:uses
    { :report :nodes 70 . },
    { (70 1) math:difference 69 . }.

{ (70 1) math:difference 69 . }
  pe:builtin math:difference.

{ :report :reachablePairs 2415 . }
  pe:rule 8;
  pe:binding
    [ pe:var "Max"; pe:value 70 ],
    [ pe:var "Pairs"; pe:value 2415 ],
    [ pe:var "Previous"; pe:value 69 ],
    [ pe:var "TwicePairs"; pe:value 4830 ];
  pe:uses
    { :report :nodes 70 . },
    { (70 1) math:difference 69 . },
    { (70 69) math:product 4830 . },
    { (4830 2) math:quotient 2415 . }.

{ (70 69) math:product 4830 . }
  pe:builtin math:product.

{ (4830 2) math:quotient 2415 . }
  pe:builtin math:quotient.

{ :report :expectedMaterializedTriples 2492 . }
  pe:rule 9;
  pe:binding
    [ pe:var "GraphTriples"; pe:value 2484 ],
    [ pe:var "Links"; pe:value 69 ],
    [ pe:var "Max"; pe:value 70 ],
    [ pe:var "Pairs"; pe:value 2415 ],
    [ pe:var "Total"; pe:value 2492 ],
    [ pe:var "TwicePairs"; pe:value 4830 ];
  pe:uses
    { :report :nodes 70 . },
    { (70 1) math:difference 69 . },
