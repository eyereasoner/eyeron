PREFIX : <http://example.org/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :rec42 :id <http://lib.ugent.be/record/rec42> .
  <http://lib.ugent.be/record/rec42> :title "Reasoning about RDF Message Logs" .
  <http://lib.ugent.be/record/rec42> :subject "Linked Data Streams" .
  <http://lib.ugent.be/record/rec42> :type "book" .

  _:step1
    rdf:reifies <<(:rec42 :id <http://lib.ugent.be/record/rec42>)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "ctrl"; pe:value "rec42" ],
      [ pe:var "f"; pe:value :f001 ],
      [ pe:var "id"; pe:value <http://lib.ugent.be/record/rec42> ],
      [ pe:var "record"; pe:value :rec42 ];
    pe:uses
      <<(:rec42 :hasField :f001)>>,
      <<(:f001 :tag "001")>>,
      <<(:f001 :value "rec42")>>.

  _:step2
    rdf:reifies <<(<http://lib.ugent.be/record/rec42> :title "Reasoning about RDF Message Logs")>>;
    pe:rule 2;
    pe:binding
      [ pe:var "f"; pe:value :f245 ],
      [ pe:var "id"; pe:value <http://lib.ugent.be/record/rec42> ],
      [ pe:var "record"; pe:value :rec42 ],
      [ pe:var "val"; pe:value "Reasoning about RDF Message Logs" ];
    pe:uses
      _:step1,
      <<(:rec42 :hasField :f245)>>,
      <<(:f245 :tag "245")>>,
      <<(:f245 :subfield "a")>>,
      <<(:f245 :value "Reasoning about RDF Message Logs")>>.

  _:step3
    rdf:reifies <<(<http://lib.ugent.be/record/rec42> :subject "Linked Data Streams")>>;
    pe:rule 3;
    pe:binding
      [ pe:var "f"; pe:value :f650 ],
      [ pe:var "id"; pe:value <http://lib.ugent.be/record/rec42> ],
      [ pe:var "record"; pe:value :rec42 ],
      [ pe:var "val"; pe:value "Linked Data Streams" ];
    pe:uses
      _:step1,
      <<(:rec42 :hasField :f650)>>,
      <<(:f650 :tag "650")>>,
      <<(:f650 :subfield "a")>>,
      <<(:f650 :value "Linked Data Streams")>>.

  _:step4
    rdf:reifies <<(<http://lib.ugent.be/record/rec42> :type "book")>>;
    pe:rule 4;
    pe:binding
      [ pe:var "f"; pe:value :f920 ],
      [ pe:var "id"; pe:value <http://lib.ugent.be/record/rec42> ],
      [ pe:var "record"; pe:value :rec42 ],
      [ pe:var "val"; pe:value "book" ];
    pe:uses
      _:step1,
      <<(:rec42 :hasField :f920)>>,
      <<(:f920 :tag "920")>>,
      <<(:f920 :subfield "a")>>,
      <<(:f920 :value "book")>>.
}
