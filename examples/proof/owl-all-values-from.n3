@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:milo a :Cat .
:CatOwner rdfs:subClassOf :AnimalOwner .

{ :milo a :Cat . }
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value :CatOwner ],
    [ pe:var "P"; pe:value :hasPet ],
    [ pe:var "U"; pe:value :alice ],
    [ pe:var "V"; pe:value :milo ],
    [ pe:var "Y"; pe:value :Cat ];
  pe:uses
    { :CatOwner owl:allValuesFrom :Cat . },
    { :CatOwner owl:onProperty :hasPet . },
    { :alice a :CatOwner . },
    { :alice :hasPet :milo . }.

{ :CatOwner owl:allValuesFrom :Cat . }
  pe:fact "owl-all-values-from.n3".

{ :CatOwner owl:onProperty :hasPet . }
  pe:fact "owl-all-values-from.n3".

{ :alice a :CatOwner . }
  pe:fact "owl-all-values-from.n3".

{ :alice :hasPet :milo . }
  pe:fact "owl-all-values-from.n3".

{ :CatOwner rdfs:subClassOf :AnimalOwner . }
  pe:rule 2;
  pe:binding
    [ pe:var "C"; pe:value :CatOwner ],
    [ pe:var "D"; pe:value :AnimalOwner ],
    [ pe:var "P"; pe:value :hasPet ],
    [ pe:var "Y"; pe:value :Cat ],
    [ pe:var "Z"; pe:value :Animal ];
  pe:uses
    { :CatOwner owl:allValuesFrom :Cat . },
    { :CatOwner owl:onProperty :hasPet . },
    { :AnimalOwner owl:allValuesFrom :Animal . },
    { :AnimalOwner owl:onProperty :hasPet . },
    { :Cat rdfs:subClassOf :Animal . }.

{ :AnimalOwner owl:allValuesFrom :Animal . }
  pe:fact "owl-all-values-from.n3".

{ :AnimalOwner owl:onProperty :hasPet . }
  pe:fact "owl-all-values-from.n3".

{ :Cat rdfs:subClassOf :Animal . }
  pe:fact "owl-all-values-from.n3".
