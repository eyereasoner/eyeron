PREFIX : <http://example/>
PREFIX log: <http://www.w3.org/2000/10/swap/log#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :ind a :N1 .
  :ind a :I1 .
  :ind a :J1 .
  :arc :check1 "C1 OK - the starting classification N0 is present." .
  :ind a :N2 .
  :ind a :I2 .
  :ind a :J2 .
  :arc :check2 "C2 OK - the first expansion produced N1 together with side labels I1 and J1." .
  :ind a :N3 .
  :ind a :I3 .
  :ind a :J3 .
  :ind a :N4 .
  :ind a :I4 .
  :ind a :J4 .
  :ind a :N5 .
  :ind a :I5 .
  :ind a :J5 .
  :ind a :N6 .
  :ind a :I6 .
  :ind a :J6 .
  :arc :check3 "C3 OK - the chain reaches the midpoint N5 and still carries both side-label branches." .
  :ind a :N7 .
  :ind a :I7 .
  :ind a :J7 .
  :ind a :N8 .
  :ind a :I8 .
  :ind a :J8 .
  :ind a :N9 .
  :ind a :I9 .
  :ind a :J9 .
  :ind a :N10 .
  :ind a :I10 .
  :ind a :J10 .
  :ind a :A2 .
  :arc :check4 "C4 OK - the final taxonomy step from N9 to N10 was completed." .
  :test :is true .
  :arc :check5 "C5 OK - once N10 is reached, the terminal class A2 is derived." .
  :arc :check6 "C6 OK - the success flag is raised only after the terminal class A2 is present." .
  :report log:outputString "Deep Taxonomy - deep classification benchmark\n\nAnswer\nThe test succeeds: starting from one individual classified as N0, the rules eventually classify it as N10 and then as A2.\n\nReason Why\nEach rule moves the same individual one level deeper in the taxonomy and also adds two side labels. Because that chain continues all the way from N0 to N10, the final rule deriving A2 fires, and that in turn makes the test true.\n\nCheck\nC1 OK - the starting classification N0 is present.\nC2 OK - the first expansion produced N1 together with side labels I1 and J1.\nC3 OK - the chain reaches the midpoint N5 and still carries both side-label branches.\nC4 OK - the final taxonomy step from N9 to N10 was completed.\nC5 OK - once N10 is reached, the terminal class A2 is derived.\nC6 OK - the success flag is raised only after the terminal class A2 is present." .

  _:step1
    rdf:reifies <<(:ind a :N1)>>;
    pe:rule 2;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses <<(:ind a :N0)>>.

  _:step2
    rdf:reifies <<(:ind a :I1)>>;
    pe:rule 2;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses <<(:ind a :N0)>>.

  _:step3
    rdf:reifies <<(:ind a :J1)>>;
    pe:rule 2;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses <<(:ind a :N0)>>.

  _:step4
    rdf:reifies <<(:arc :check1 "C1 OK - the starting classification N0 is present.")>>;
    pe:rule 13;
    pe:uses <<(:ind a :N0)>>.

  _:step5
    rdf:reifies <<(:ind a :N2)>>;
    pe:rule 3;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step1.

  _:step6
    rdf:reifies <<(:ind a :I2)>>;
    pe:rule 3;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step1.

  _:step7
    rdf:reifies <<(:ind a :J2)>>;
    pe:rule 3;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step1.

  _:step8
    rdf:reifies <<(:arc :check2 "C2 OK - the first expansion produced N1 together with side labels I1 and J1.")>>;
    pe:rule 14;
    pe:uses
      _:step1,
      _:step2,
      _:step3.

  _:step9
    rdf:reifies <<(:ind a :N3)>>;
    pe:rule 4;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step5.

  _:step10
    rdf:reifies <<(:ind a :I3)>>;
    pe:rule 4;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step5.

  _:step11
    rdf:reifies <<(:ind a :J3)>>;
    pe:rule 4;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step5.

  _:step12
    rdf:reifies <<(:ind a :N4)>>;
    pe:rule 5;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step9.

  _:step13
    rdf:reifies <<(:ind a :I4)>>;
    pe:rule 5;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step9.

  _:step14
    rdf:reifies <<(:ind a :J4)>>;
    pe:rule 5;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step9.

  _:step15
    rdf:reifies <<(:ind a :N5)>>;
    pe:rule 6;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step12.

  _:step16
    rdf:reifies <<(:ind a :I5)>>;
    pe:rule 6;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step12.

  _:step17
    rdf:reifies <<(:ind a :J5)>>;
    pe:rule 6;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step12.

  _:step18
    rdf:reifies <<(:ind a :N6)>>;
    pe:rule 7;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step15.

  _:step19
    rdf:reifies <<(:ind a :I6)>>;
    pe:rule 7;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step15.

  _:step20
    rdf:reifies <<(:ind a :J6)>>;
    pe:rule 7;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step15.

  _:step21
    rdf:reifies <<(:arc :check3 "C3 OK - the chain reaches the midpoint N5 and still carries both side-label branches.")>>;
    pe:rule 15;
    pe:uses
      _:step15,
      _:step16,
      _:step17.

  _:step22
    rdf:reifies <<(:ind a :N7)>>;
    pe:rule 8;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step18.

  _:step23
    rdf:reifies <<(:ind a :I7)>>;
    pe:rule 8;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step18.

  _:step24
    rdf:reifies <<(:ind a :J7)>>;
    pe:rule 8;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step18.

  _:step25
    rdf:reifies <<(:ind a :N8)>>;
    pe:rule 9;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step22.

  _:step26
    rdf:reifies <<(:ind a :I8)>>;
    pe:rule 9;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step22.

  _:step27
    rdf:reifies <<(:ind a :J8)>>;
    pe:rule 9;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step22.

  _:step28
    rdf:reifies <<(:ind a :N9)>>;
    pe:rule 10;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step25.

  _:step29
    rdf:reifies <<(:ind a :I9)>>;
    pe:rule 10;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step25.

  _:step30
    rdf:reifies <<(:ind a :J9)>>;
    pe:rule 10;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step25.

  _:step31
    rdf:reifies <<(:ind a :N10)>>;
    pe:rule 11;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step28.

  _:step32
    rdf:reifies <<(:ind a :I10)>>;
    pe:rule 11;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step28.

  _:step33
    rdf:reifies <<(:ind a :J10)>>;
    pe:rule 11;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step28.

  _:step34
    rdf:reifies <<(:ind a :A2)>>;
    pe:rule 12;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step31.

  _:step35
    rdf:reifies <<(:arc :check4 "C4 OK - the final taxonomy step from N9 to N10 was completed.")>>;
    pe:rule 16;
    pe:uses
      _:step28,
      _:step31.

  _:step36
    rdf:reifies <<(:test :is true)>>;
    pe:rule 1;
    pe:uses _:step34.

  _:step37
    rdf:reifies <<(:arc :check5 "C5 OK - once N10 is reached, the terminal class A2 is derived.")>>;
    pe:rule 17;
    pe:uses
      _:step31,
      _:step34.

  _:step38
    rdf:reifies <<(:arc :check6 "C6 OK - the success flag is raised only after the terminal class A2 is present.")>>;
    pe:rule 18;
    pe:uses
      _:step34,
      _:step36.

  _:step39
    rdf:reifies <<(:report log:outputString "Deep Taxonomy - deep classification benchmark\n\nAnswer\nThe test succeeds: starting from one individual classified as N0, the rules eventually classify it as N10 and then as A2.\n\nReason Why\nEach rule moves the same individual one level deeper in the taxonomy and also adds two side labels. Because that chain continues all the way from N0 to N10, the final rule deriving A2 fires, and that in turn makes the test true.\n\nCheck\nC1 OK - the starting classification N0 is present.\nC2 OK - the first expansion produced N1 together with side labels I1 and J1.\nC3 OK - the chain reaches the midpoint N5 and still carries both side-label branches.\nC4 OK - the final taxonomy step from N9 to N10 was completed.\nC5 OK - once N10 is reached, the terminal class A2 is derived.\nC6 OK - the success flag is raised only after the terminal class A2 is present.")>>;
    pe:rule 19;
    pe:binding
      [ pe:var "C1"; pe:value "C1 OK - the starting classification N0 is present." ],
      [ pe:var "C2"; pe:value "C2 OK - the first expansion produced N1 together with side labels I1 and J1." ],
      [ pe:var "C3"; pe:value "C3 OK - the chain reaches the midpoint N5 and still carries both side-label branches." ],
      [ pe:var "C4"; pe:value "C4 OK - the final taxonomy step from N9 to N10 was completed." ],
      [ pe:var "C5"; pe:value "C5 OK - once N10 is reached, the terminal class A2 is derived." ],
      [ pe:var "C6"; pe:value "C6 OK - the success flag is raised only after the terminal class A2 is present." ];
    pe:uses
      _:step36,
      _:step4,
      _:step8,
      _:step21,
      _:step35,
      _:step37,
      _:step38.
}
