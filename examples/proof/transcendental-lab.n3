{ :report :transcendental :e . }
  pe:rule
    {
        {
            ?X :kind :Transcendental .
        } => {
            :report :transcendental ?X .
        } .
    };
  pe:binding [ pe:var "X"; pe:value :e ];
  pe:uses { :e :kind :Transcendental . }.

{ :e :kind :Transcendental . }
  pe:fact "transcendental-lab.n3".

