PREFIX : <http://example.org/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :c a :Animal .
  :test :is true .

  _:step1
    rdf:reifies <<(:c a :Animal)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :c ];
    pe:uses <<(:c a :Cat)>>.

  _:step2
    rdf:reifies <<(:test :is true)>>;
    pe:rule 2;
    pe:uses _:step1.
}
