PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :x :bothPositive true .

  _:step1
    rdf:reifies <<(:x :bothPositive true)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "v1"; pe:value 1 ],
      [ pe:var "v2"; pe:value 2 ],
      [ pe:var "x"; pe:value :x ];
    pe:uses
      <<(:x :p 1)>>,
      <<(:x :q 2)>>.
}
