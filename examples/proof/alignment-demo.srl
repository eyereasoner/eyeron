  _:step21
    rdf:reifies <<( ref:Car skos:narrower tel:HeavyVehicle )>>;
    pe:rule "alignment-demo.srl";
    pe:line 26;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
