    pe:uses _:step3.

  _:step22
    rdf:reifies <<( ref:Car skos:narrower anpr:VehicleWithPlate )>>;
    pe:rule "alignment-demo.srl";
    pe:line 26;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
      [ pe:var "n"; pe:value anpr:VehicleWithPlate ];
    pe:uses _:step5.

  _:step23
    rdf:reifies <<( tel:Car skos:broaderTransitive ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 27;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
      [ pe:var "n"; pe:value tel:Car ];
    pe:uses _:step1.

  _:step24
    rdf:reifies <<( tel:HeavyVehicle skos:broaderTransitive ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 27;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
      [ pe:var "n"; pe:value tel:HeavyVehicle ];
    pe:uses _:step3.

  _:step25
    rdf:reifies <<( anpr:VehicleWithPlate skos:broaderTransitive ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 27;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
      [ pe:var "n"; pe:value anpr:VehicleWithPlate ];
    pe:uses _:step5.

  _:step26
    rdf:reifies <<( anpr:VehicleWithPlate skos:narrowerTransitive anpr:PassengerCar )>>;
    pe:rule "alignment-demo.srl";
    pe:line 28;
    pe:binding
      [ pe:var "c"; pe:value anpr:PassengerCar ],
      [ pe:var "n"; pe:value anpr:VehicleWithPlate ];
    pe:uses _:step7.

  _:step27
    rdf:reifies <<( anpr:PassengerCar ex:narrowerOrEqualOf anpr:VehicleWithPlate )>>;
    pe:rule "alignment-demo.srl";
    pe:line 39;
    pe:binding
      [ pe:var "b"; pe:value anpr:VehicleWithPlate ],
      [ pe:var "c"; pe:value anpr:PassengerCar ];
    pe:uses _:step9.

  _:step28
    rdf:reifies <<( ref:Car ex:rollsUpTo ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 40;
    pe:binding [ pe:var "x"; pe:value ref:Car ];
    pe:uses _:step10.

  _:step29
    rdf:reifies <<( ref:Car skos:narrowerTransitive tel:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 28;
    pe:binding
      [ pe:var "c"; pe:value tel:Car ],
      [ pe:var "n"; pe:value ref:Car ];
    pe:uses _:step20.

  _:step30
    rdf:reifies <<( ref:Car skos:narrowerTransitive tel:HeavyVehicle )>>;
    pe:rule "alignment-demo.srl";
    pe:line 28;
    pe:binding
      [ pe:var "c"; pe:value tel:HeavyVehicle ],
      [ pe:var "n"; pe:value ref:Car ];
    pe:uses _:step21.

  _:step31
    rdf:reifies <<( ref:Car skos:narrowerTransitive anpr:VehicleWithPlate )>>;
    pe:rule "alignment-demo.srl";
    pe:line 28;
    pe:binding
      [ pe:var "c"; pe:value anpr:VehicleWithPlate ],
      [ pe:var "n"; pe:value ref:Car ];
    pe:uses _:step22.

  _:step32
    rdf:reifies <<( anpr:PassengerCar skos:broaderTransitive ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 30;
    pe:binding
      [ pe:var "a"; pe:value anpr:PassengerCar ],
      [ pe:var "b"; pe:value anpr:VehicleWithPlate ],
      [ pe:var "c"; pe:value ref:Car ];
    pe:uses
      _:step9,
      _:step25.

  _:step33
    rdf:reifies <<( tel:Car ex:narrowerOrEqualOf ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 39;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
      [ pe:var "c"; pe:value tel:Car ];
    pe:uses _:step23.

  _:step34
    rdf:reifies <<( tel:HeavyVehicle ex:narrowerOrEqualOf ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 39;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
      [ pe:var "c"; pe:value tel:HeavyVehicle ];
    pe:uses _:step24.

  _:step35
    rdf:reifies <<( anpr:VehicleWithPlate ex:narrowerOrEqualOf ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 39;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
      [ pe:var "c"; pe:value anpr:VehicleWithPlate ];
    pe:uses _:step25.

  _:step36
    rdf:reifies <<( ref:Car skos:narrowerTransitive anpr:PassengerCar )>>;
    pe:rule "alignment-demo.srl";
    pe:line 33;
    pe:binding
      [ pe:var "a"; pe:value ref:Car ],
      [ pe:var "b"; pe:value anpr:VehicleWithPlate ],
      [ pe:var "c"; pe:value anpr:PassengerCar ];
    pe:uses
      _:step31,
      _:step26.

  _:step37
    rdf:reifies <<( anpr:PassengerCar ex:narrowerOrEqualOf ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 39;
    pe:binding
      [ pe:var "b"; pe:value ref:Car ],
      [ pe:var "c"; pe:value anpr:PassengerCar ];
    pe:uses _:step32.

  _:step38
    rdf:reifies <<( tel:Car ex:rollsUpTo ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 40;
    pe:binding [ pe:var "x"; pe:value tel:Car ];
    pe:uses _:step33.

  _:step39
    rdf:reifies <<( tel:HeavyVehicle ex:rollsUpTo ref:Car )>>;
    pe:rule "alignment-demo.srl";
    pe:line 40;
    pe:binding [ pe:var "x"; pe:value tel:HeavyVehicle ];
