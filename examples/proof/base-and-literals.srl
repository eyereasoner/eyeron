PREFIX : <http://example/base/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :adult true .
  :alice :slug "alice-smith" .

  _:step1
    rdf:reifies <<(:alice :adult true)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "age"; pe:value 22 ],
      [ pe:var "name"; pe:value "Alice Smith"@en ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "slug"; pe:value "alice-smith" ];
    pe:uses
      <<(:alice :name "Alice Smith"@en)>>,
      <<(:alice :age 22)>>.

  _:step2
    rdf:reifies <<(:alice :slug "alice-smith")>>;
    pe:rule 1;
    pe:binding
      [ pe:var "age"; pe:value 22 ],
      [ pe:var "name"; pe:value "Alice Smith"@en ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "slug"; pe:value "alice-smith" ];
    pe:uses
      <<(:alice :name "Alice Smith"@en)>>,
      <<(:alice :age 22)>>.
}
