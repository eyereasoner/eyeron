<urn:eyeron:rdf-message-stream:1:envelope:1> :boundaryExplicit true .
<urn:eyeron:rdf-message-stream:1> :replayContains <urn:eyeron:rdf-message-stream:1:envelope:1> .
<urn:eyeron:rdf-message-stream:1:envelope:2> :boundaryExplicit true .
<urn:eyeron:rdf-message-stream:1> :replayContains <urn:eyeron:rdf-message-stream:1:envelope:2> .
