{ :test-absoluteValue-1 a :MathBuiltinTest . }
  pe:rule 1;
  pe:binding [ pe:var "abs"; pe:value 2 ];
  pe:uses
    { -2 math:absoluteValue 2 . },
    { 2 math:equalTo 2 . }.

{ -2 math:absoluteValue 2 . }
  pe:builtin math:absoluteValue.

{ 2 math:equalTo 2 . }
  pe:builtin math:equalTo.

{ :test-absoluteValue-1 :builtin math:absoluteValue . }
  pe:rule 1;
  pe:binding [ pe:var "abs"; pe:value 2 ];
  pe:uses
    { -2 math:absoluteValue 2 . },
    { 2 math:equalTo 2 . }.

{ :test-absoluteValue-1 :input -2 . }
  pe:rule 1;
  pe:binding [ pe:var "abs"; pe:value 2 ];
  pe:uses
    { -2 math:absoluteValue 2 . },
    { 2 math:equalTo 2 . }.

{ :test-absoluteValue-1 :expected 2 . }
  pe:rule 1;
  pe:binding [ pe:var "abs"; pe:value 2 ];
  pe:uses
    { -2 math:absoluteValue 2 . },
    { 2 math:equalTo 2 . }.

{ :test-absoluteValue-1 :actual 2 . }
  pe:rule 1;
  pe:binding [ pe:var "abs"; pe:value 2 ];
  pe:uses
    { -2 math:absoluteValue 2 . },
    { 2 math:equalTo 2 . }.

{ :test-absoluteValue-1 :status :pass . }
  pe:rule 1;
  pe:binding [ pe:var "abs"; pe:value 2 ];
  pe:uses
    { -2 math:absoluteValue 2 . },
    { 2 math:equalTo 2 . }.

{ :test-absoluteValue-2 a :MathBuiltinTest . }
  pe:rule 2;
  pe:binding [ pe:var "abs"; pe:value 3 ];
  pe:uses
    { 3 math:absoluteValue 3 . },
    { 3 math:equalTo 3 . }.

{ 3 math:absoluteValue 3 . }
  pe:builtin math:absoluteValue.

{ 3 math:equalTo 3 . }
  pe:builtin math:equalTo.

{ :test-absoluteValue-2 :builtin math:absoluteValue . }
  pe:rule 2;
  pe:binding [ pe:var "abs"; pe:value 3 ];
  pe:uses
    { 3 math:absoluteValue 3 . },
    { 3 math:equalTo 3 . }.

{ :test-absoluteValue-2 :input 3 . }
  pe:rule 2;
  pe:binding [ pe:var "abs"; pe:value 3 ];
  pe:uses
    { 3 math:absoluteValue 3 . },
    { 3 math:equalTo 3 . }.

{ :test-absoluteValue-2 :expected 3 . }
  pe:rule 2;
  pe:binding [ pe:var "abs"; pe:value 3 ];
  pe:uses
    { 3 math:absoluteValue 3 . },
    { 3 math:equalTo 3 . }.

{ :test-absoluteValue-2 :actual 3 . }
  pe:rule 2;
  pe:binding [ pe:var "abs"; pe:value 3 ];
  pe:uses
    { 3 math:absoluteValue 3 . },
    { 3 math:equalTo 3 . }.

{ :test-absoluteValue-2 :status :pass . }
  pe:rule 2;
  pe:binding [ pe:var "abs"; pe:value 3 ];
  pe:uses
    { 3 math:absoluteValue 3 . },
    { 3 math:equalTo 3 . }.

