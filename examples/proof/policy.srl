PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :carol a :Blocked .
  :bob a :Eligible .

  _:step1
    rdf:reifies <<( :carol a :Blocked )>>;
    pe:rule "policy.srl";
    pe:line 16;
    pe:binding [ pe:var "x"; pe:value :carol ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :carol a :Flagged )>>;
    pe:fact "policy.srl";
    pe:line 10.

  _:step3
    rdf:reifies <<( :bob a :Eligible )>>;
    pe:rule "policy.srl";
    pe:line 13;
    pe:binding [ pe:var "x"; pe:value :bob ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :bob a :Person )>>;
    pe:fact "policy.srl";
    pe:line 9.
}
