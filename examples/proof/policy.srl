PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :carol a :Blocked .
  :bob a :Eligible .

  _:step1
    rdf:reifies <<(:carol a :Blocked)>>;
    pe:rule 2;
    pe:binding [ pe:var "x"; pe:value :carol ];
    pe:uses <<(:carol a :Flagged)>>.

  _:step2
    rdf:reifies <<(:bob a :Eligible)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :bob ];
    pe:uses <<(:bob a :Person)>>.
}
