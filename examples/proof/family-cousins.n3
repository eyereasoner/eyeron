:Heidi :cousin :Judy .
:Judy :cousin :Heidi .
:Ivan :cousin :Judy .
:Judy :cousin :Ivan .

{ :Heidi :branch :b . } pe:why {
  { :Heidi :branch :b . }
    pe:rule 3;
    pe:binding
      [ pe:var "B"; pe:value :b ],
      [ pe:var "C"; pe:value :Heidi ],
      [ pe:var "P"; pe:value :Dave ];
    pe:uses
      { :Dave :parentOf :Heidi . },
      { :Dave :branch :b . }.

  { :Dave :parentOf :Heidi . }
    pe:fact "family-cousins.n3".

  { :Dave :branch :b . }
    pe:fact "family-cousins.n3".
}.

