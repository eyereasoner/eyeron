@prefix : <http://example.org/family#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:Heidi :branch :b .
:Ivan :branch :b .
:Judy :branch :c .
:Adam :generation 0 .
:Bob :generation 1 .
:Carol :generation 1 .
:Dave :generation 2 .
:Eve :generation 2 .
:Frank :generation 2 .
:Grace :generation 2 .
:Heidi :generation 3 .
:Dave :cousin :Frank .
:Dave :cousin :Grace .
:Frank :cousin :Dave .
:Grace :cousin :Dave .
:Ivan :generation 3 .
:Eve :cousin :Frank .
:Eve :cousin :Grace .
:Frank :cousin :Eve .
:Grace :cousin :Eve .
