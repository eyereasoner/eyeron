}.

{ :Bob :generation 1 . } pe:why {
  { :Bob :generation 1 . }
    pe:rule 2;
    pe:binding
      [ pe:var "C"; pe:value :Bob ],
      [ pe:var "G"; pe:value 0 ],
      [ pe:var "G1"; pe:value 1 ],
      [ pe:var "P"; pe:value :Adam ];
    pe:uses
      { :Adam :parentOf :Bob . },
      { :Adam :generation 0 . },
      { (0 1) math:sum 1 . }.

  { :Adam :parentOf :Bob . }
    pe:fact "family-cousins.n3".

  { :Adam :generation 0 . }
    pe:rule 1.

  { (0 1) math:sum 1 . }
    pe:builtin math:sum.
}.

