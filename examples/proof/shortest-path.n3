    { ((5 :d :c :b :a) (7 :d :c :a) (9 :d :b :a)) list:firstRest ((5 :d :c :b :a) ((7 :d :c :a) (9 :d :b :a))) . },
    { (5 :d :c :b :a) list:firstRest (5 (:d :c :b :a)) . },
    { (:d :c :b :a) list:firstRest (:d (:c :b :a)) . }.

{ ((5 :d :c :b :a) (7 :d :c :a) (9 :d :b :a)) list:firstRest ((5 :d :c :b :a) ((7 :d :c :a) (9 :d :b :a))) . }
  pe:builtin list:firstRest.

{ (5 :d :c :b :a) list:firstRest (5 (:d :c :b :a)) . }
  pe:builtin list:firstRest.

{ (:d :c :b :a) list:firstRest (:d (:c :b :a)) . }
  pe:builtin list:firstRest.

{ (:d :c :b :a) list:reverse (:a :b :c :d) . }
  pe:builtin list:reverse.

{ :test :bestPath (:a :b :c :d) . }
  pe:rule 4;
  pe:binding
    [ pe:var "best"; pe:value 5 ],
    [ pe:var "bestPath"; pe:value (:a :b :c :d) ],
    [ pe:var "costs"; pe:value (5 7 9) ],
    [ pe:var "rest"; pe:value (7 9) ],
    [ pe:var "sorted"; pe:value (5 7 9) ];
  pe:uses
    {
        (?cost {
            (:a :d) :shortest (?path ?cost) .
        } (5 7 9)) log:collectAllIn ?SCOPE .
    },
    { (5 7 9) list:sort (5 7 9) . },
    { (5 7 9) list:firstRest (5 (7 9)) . },
    { (:a :d) :shortest ((:a :b :c :d) 5) . }.
