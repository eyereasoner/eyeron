PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :lit1 :hasType :Int .
  :var1 :hasType :Int .
  :app1 :hasType :Int .

  _:step1
    rdf:reifies <<(:lit1 :hasType :Int)>>;
    pe:rule 1;
    pe:binding [ pe:var "t"; pe:value :lit1 ];
    pe:uses <<(:lit1 a :IntLit)>>.

  _:step2
    rdf:reifies <<(:var1 :hasType :Int)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "app"; pe:value :app1 ],
      [ pe:var "arg"; pe:value :lit1 ],
      [ pe:var "argType"; pe:value :Int ],
      [ pe:var "body"; pe:value :var1 ],
      [ pe:var "lam"; pe:value :lam1 ],
      [ pe:var "p"; pe:value :x ];
    pe:uses
      <<(:app1 a :App)>>,
      <<(:app1 :fn :lam1)>>,
      <<(:app1 :arg :lit1)>>,
      <<(:lam1 a :Lam)>>,
      <<(:lam1 :param :x)>>,
      <<(:lam1 :body :var1)>>,
      <<(:var1 a :Var)>>,
      <<(:var1 :name :x)>>,
      _:step1.

  _:step3
    rdf:reifies <<(:app1 :hasType :Int)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "app"; pe:value :app1 ],
      [ pe:var "arg"; pe:value :lit1 ],
      [ pe:var "body"; pe:value :var1 ],
      [ pe:var "lam"; pe:value :lam1 ],
      [ pe:var "resultType"; pe:value :Int ];
    pe:uses
      <<(:app1 a :App)>>,
      <<(:app1 :fn :lam1)>>,
      <<(:app1 :arg :lit1)>>,
      <<(:lam1 a :Lam)>>,
      <<(:lam1 :body :var1)>>,
      _:step2.
}
