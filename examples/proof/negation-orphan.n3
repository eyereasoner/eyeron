@prefix : <https://eyereasoner.github.io/eyepl/examples/negation-orphan#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:bob a :Orphan .

{ :bob a :Orphan . } pe:why {
  { :bob a :Orphan . }
    pe:rule 1;
    pe:binding
      [ pe:var "SCOPE"; pe:value {
          <http://example.org/a> <http://example.org/b> <http://example.org/c> .
      } ],
      [ pe:var "x"; pe:value :bob ];
    pe:uses
      { :bob a :Person . },
      {
          {
              <http://example.org/a> <http://example.org/b> <http://example.org/c> .
          } log:notIncludes {
              :bob :childOf ?y .
          } .
      }.

  { :bob a :Person . }
    pe:fact "negation-orphan.n3".

  {
    {
        <http://example.org/a> <http://example.org/b> <http://example.org/c> .
    } log:notIncludes {
        :bob :childOf ?y .
    } .
}
    pe:builtin log:notIncludes.
}.
