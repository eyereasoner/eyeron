@prefix : <http://examples.org/#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

(:a :a) :sameTerm true .
(:b :b) :sameTerm true .
(:p :p) :sameTerm true .
(:q :q) :sameTerm true .
(:r :r) :sameTerm true .
(:h :a :a) :sameInputUnderEqualCompositeOutput true .
(:h :b :b) :sameInputUnderEqualCompositeOutput true .
(:p :q) :sameTerm true .
(:q :p) :sameTerm true .
(:h :a) :app :r .
(:h :b) :app :r .
(:a :b) :sameTerm true .
(:b :a) :sameTerm true .
(:h :a :b) :sameInputUnderEqualCompositeOutput true .
(:h :b :a) :sameInputUnderEqualCompositeOutput true .

{ (:a :a) :sameTerm true . }
  pe:rule 1;
  pe:binding [ pe:var "x"; pe:value :a ];
  pe:uses { :a :inX true . }.

{ :a :inX true . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:b :b) :sameTerm true . }
  pe:rule 1;
  pe:binding [ pe:var "x"; pe:value :b ];
  pe:uses { :b :inX true . }.

{ :b :inX true . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:p :p) :sameTerm true . }
  pe:rule 2;
  pe:binding [ pe:var "y"; pe:value :p ];
  pe:uses { :p :inY true . }.

{ :p :inY true . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:q :q) :sameTerm true . }
  pe:rule 2;
  pe:binding [ pe:var "y"; pe:value :q ];
  pe:uses { :q :inY true . }.

{ :q :inY true . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:r :r) :sameTerm true . }
  pe:rule 3;
  pe:binding [ pe:var "z"; pe:value :r ];
  pe:uses { :r :inZ true . }.

{ :r :inZ true . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:h :a :a) :sameInputUnderEqualCompositeOutput true . }
  pe:rule 8;
  pe:binding
    [ pe:var "f"; pe:value :f ],
    [ pe:var "fx"; pe:value :p ],
    [ pe:var "fy"; pe:value :p ],
    [ pe:var "g"; pe:value :g ],
    [ pe:var "h"; pe:value :h ],
    [ pe:var "u"; pe:value :r ],
    [ pe:var "v"; pe:value :r ],
    [ pe:var "x"; pe:value :a ],
    [ pe:var "y"; pe:value :a ];
  pe:uses
    { :h :compositeOf (:g :f) . },
    { :f :injective true . },
    { :g :injective true . },
    { (:f :a) :app :p . },
    { (:f :a) :app :p . },
    { (:g :p) :app :r . },
    { (:g :p) :app :r . },
    { (:r :r) :sameTerm true . },
    { (:a :a) :sameTerm true . }.

{ :h :compositeOf (:g :f) . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ :f :injective true . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ :g :injective true . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:f :a) :app :p . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:g :p) :app :r . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:h :b :b) :sameInputUnderEqualCompositeOutput true . }
  pe:rule 8;
  pe:binding
    [ pe:var "f"; pe:value :f ],
    [ pe:var "fx"; pe:value :q ],
    [ pe:var "fy"; pe:value :q ],
    [ pe:var "g"; pe:value :g ],
    [ pe:var "h"; pe:value :h ],
    [ pe:var "u"; pe:value :r ],
    [ pe:var "v"; pe:value :r ],
    [ pe:var "x"; pe:value :b ],
    [ pe:var "y"; pe:value :b ];
  pe:uses
    { :h :compositeOf (:g :f) . },
    { :f :injective true . },
    { :g :injective true . },
    { (:f :b) :app :q . },
    { (:f :b) :app :q . },
    { (:g :q) :app :r . },
    { (:g :q) :app :r . },
    { (:r :r) :sameTerm true . },
    { (:b :b) :sameTerm true . }.

{ (:f :b) :app :q . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:g :q) :app :r . }
  pe:fact "composition-of-injective-functions-is-injective.n3".

{ (:p :q) :sameTerm true . }
  pe:rule 6;
  pe:binding
    [ pe:var "f"; pe:value :g ],
    [ pe:var "u"; pe:value :r ],
    [ pe:var "v"; pe:value :r ],
    [ pe:var "x"; pe:value :p ],
    [ pe:var "y"; pe:value :q ];
  pe:uses
    { :g :injective true . },
    { (:g :p) :app :r . },
    { (:g :q) :app :r . },
    { (:r :r) :sameTerm true . }.

{ (:q :p) :sameTerm true . }
  pe:rule 6;
  pe:binding
    [ pe:var "f"; pe:value :g ],
    [ pe:var "u"; pe:value :r ],
    [ pe:var "v"; pe:value :r ],
    [ pe:var "x"; pe:value :q ],
    [ pe:var "y"; pe:value :p ];
  pe:uses
    { :g :injective true . },
    { (:g :q) :app :r . },
    { (:g :p) :app :r . },
    { (:r :r) :sameTerm true . }.

{ (:h :a) :app :r . }
  pe:rule 7;
  pe:binding
    [ pe:var "f"; pe:value :f ],
    [ pe:var "g"; pe:value :g ],
    [ pe:var "h"; pe:value :h ],
    [ pe:var "x"; pe:value :a ],
    [ pe:var "y"; pe:value :p ],
    [ pe:var "z"; pe:value :r ];
  pe:uses
    { :h :compositeOf (:g :f) . },
    { (:f :a) :app :p . },
    { (:g :p) :app :r . }.

{ (:h :b) :app :r . }
  pe:rule 7;
  pe:binding
    [ pe:var "f"; pe:value :f ],
    [ pe:var "g"; pe:value :g ],
    [ pe:var "h"; pe:value :h ],
    [ pe:var "x"; pe:value :b ],
    [ pe:var "y"; pe:value :q ],
    [ pe:var "z"; pe:value :r ];
  pe:uses
    { :h :compositeOf (:g :f) . },
    { (:f :b) :app :q . },
    { (:g :q) :app :r . }.

{ (:a :b) :sameTerm true . }
  pe:rule 6;
  pe:binding
    [ pe:var "f"; pe:value :f ],
    [ pe:var "u"; pe:value :p ],
    [ pe:var "v"; pe:value :q ],
    [ pe:var "x"; pe:value :a ],
    [ pe:var "y"; pe:value :b ];
  pe:uses
    { :f :injective true . },
    { (:f :a) :app :p . },
    { (:f :b) :app :q . },
    { (:p :q) :sameTerm true . }.

{ (:b :a) :sameTerm true . }
  pe:rule 6;
  pe:binding
    [ pe:var "f"; pe:value :f ],
    [ pe:var "u"; pe:value :q ],
    [ pe:var "v"; pe:value :p ],
    [ pe:var "x"; pe:value :b ],
    [ pe:var "y"; pe:value :a ];
  pe:uses
    { :f :injective true . },
    { (:f :b) :app :q . },
    { (:f :a) :app :p . },
    { (:q :p) :sameTerm true . }.

{ (:h :a :b) :sameInputUnderEqualCompositeOutput true . }
  pe:rule 8;
  pe:binding
    [ pe:var "f"; pe:value :f ],
    [ pe:var "fx"; pe:value :p ],
    [ pe:var "fy"; pe:value :q ],
    [ pe:var "g"; pe:value :g ],
    [ pe:var "h"; pe:value :h ],
    [ pe:var "u"; pe:value :r ],
    [ pe:var "v"; pe:value :r ],
    [ pe:var "x"; pe:value :a ],
    [ pe:var "y"; pe:value :b ];
  pe:uses
    { :h :compositeOf (:g :f) . },
    { :f :injective true . },
    { :g :injective true . },
    { (:f :a) :app :p . },
    { (:f :b) :app :q . },
    { (:g :p) :app :r . },
    { (:g :q) :app :r . },
    { (:r :r) :sameTerm true . },
    { (:a :b) :sameTerm true . }.

{ (:h :b :a) :sameInputUnderEqualCompositeOutput true . }
  pe:rule 8;
  pe:binding
    [ pe:var "f"; pe:value :f ],
    [ pe:var "fx"; pe:value :q ],
    [ pe:var "fy"; pe:value :p ],
    [ pe:var "g"; pe:value :g ],
    [ pe:var "h"; pe:value :h ],
    [ pe:var "u"; pe:value :r ],
    [ pe:var "v"; pe:value :r ],
    [ pe:var "x"; pe:value :b ],
    [ pe:var "y"; pe:value :a ];
  pe:uses
    { :h :compositeOf (:g :f) . },
    { :f :injective true . },
    { :g :injective true . },
    { (:f :b) :app :q . },
    { (:f :a) :app :p . },
    { (:g :q) :app :r . },
    { (:g :p) :app :r . },
    { (:r :r) :sameTerm true . },
    { (:b :a) :sameTerm true . }.
