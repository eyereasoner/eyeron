PREFIX : <http://example/eyeling/family/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :Adam :generation 0 .
  :Bob :generation 1 .
  :Carol :generation 1 .
  :Dave :generation 2 .
  :Eve :generation 2 .
  :Frank :generation 2 .
  :Grace :generation 2 .
  :Heidi :generation 3 .
  :Ivan :generation 3 .
  :Judy :generation 3 .
  :Heidi :branch :b .
  :Ivan :branch :b .
  :Judy :branch :c .
  :Dave :cousin :Frank .
  :Dave :cousin :Grace .
  :Eve :cousin :Frank .
  :Eve :cousin :Grace .
  :Frank :cousin :Dave .
  :Frank :cousin :Eve .
  :Grace :cousin :Dave .
  :Grace :cousin :Eve .
  :Heidi :cousin :Judy .
  :Ivan :cousin :Judy .
  :Judy :cousin :Heidi .
  :Judy :cousin :Ivan .

  _:step1
    rdf:reifies <<(:Adam :generation 0)>>;
    pe:rule 1.

  _:step2
    rdf:reifies <<(:Bob :generation 1)>>;
    pe:rule 2;
    pe:binding [ pe:var "child"; pe:value :Bob ];
    pe:uses <<(:Adam :parentOf :Bob)>>.

  _:step3
    rdf:reifies <<(:Carol :generation 1)>>;
    pe:rule 2;
    pe:binding [ pe:var "child"; pe:value :Carol ];
    pe:uses <<(:Adam :parentOf :Carol)>>.

  _:step4
    rdf:reifies <<(:Dave :generation 2)>>;
    pe:rule 3;
    pe:binding [ pe:var "grandchild"; pe:value :Dave ].

  _:step5
    rdf:reifies <<(:Eve :generation 2)>>;
    pe:rule 3;
    pe:binding [ pe:var "grandchild"; pe:value :Eve ].

  _:step6
    rdf:reifies <<(:Frank :generation 2)>>;
    pe:rule 3;
    pe:binding [ pe:var "grandchild"; pe:value :Frank ].

  _:step7
    rdf:reifies <<(:Grace :generation 2)>>;
    pe:rule 3;
    pe:binding [ pe:var "grandchild"; pe:value :Grace ].

  _:step8
    rdf:reifies <<(:Heidi :generation 3)>>;
    pe:rule 4;
    pe:binding [ pe:var "greatGrandchild"; pe:value :Heidi ].

  _:step9
    rdf:reifies <<(:Ivan :generation 3)>>;
    pe:rule 4;
    pe:binding [ pe:var "greatGrandchild"; pe:value :Ivan ].

  _:step10
    rdf:reifies <<(:Judy :generation 3)>>;
    pe:rule 4;
    pe:binding [ pe:var "greatGrandchild"; pe:value :Judy ].

  _:step11
    rdf:reifies <<(:Heidi :branch :b)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "branch"; pe:value :b ],
      [ pe:var "child"; pe:value :Heidi ],
      [ pe:var "parent"; pe:value :Dave ];
    pe:uses
      <<(:Dave :parentOf :Heidi)>>,
      <<(:Dave :branch :b)>>.

  _:step12
    rdf:reifies <<(:Ivan :branch :b)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "branch"; pe:value :b ],
      [ pe:var "child"; pe:value :Ivan ],
      [ pe:var "parent"; pe:value :Eve ];
    pe:uses
      <<(:Eve :parentOf :Ivan)>>,
      <<(:Eve :branch :b)>>.

  _:step13
    rdf:reifies <<(:Judy :branch :c)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "branch"; pe:value :c ],
      [ pe:var "child"; pe:value :Judy ],
      [ pe:var "parent"; pe:value :Frank ];
    pe:uses
      <<(:Frank :parentOf :Judy)>>,
      <<(:Frank :branch :c)>>.

  _:step14
    rdf:reifies <<(:Dave :cousin :Frank)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :b ],
      [ pe:var "branchY"; pe:value :c ],
      [ pe:var "generation"; pe:value 2 ],
      [ pe:var "x"; pe:value :Dave ],
      [ pe:var "y"; pe:value :Frank ];
    pe:uses
      _:step4,
      _:step6,
      <<(:Dave :branch :b)>>,
      <<(:Frank :branch :c)>>,
      <<(:b :differentFrom :c)>>.

  _:step15
    rdf:reifies <<(:Dave :cousin :Grace)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :b ],
      [ pe:var "branchY"; pe:value :c ],
      [ pe:var "generation"; pe:value 2 ],
      [ pe:var "x"; pe:value :Dave ],
      [ pe:var "y"; pe:value :Grace ];
    pe:uses
      _:step4,
      _:step7,
      <<(:Dave :branch :b)>>,
      <<(:Grace :branch :c)>>,
      <<(:b :differentFrom :c)>>.

  _:step16
    rdf:reifies <<(:Eve :cousin :Frank)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :b ],
      [ pe:var "branchY"; pe:value :c ],
      [ pe:var "generation"; pe:value 2 ],
      [ pe:var "x"; pe:value :Eve ],
      [ pe:var "y"; pe:value :Frank ];
    pe:uses
      _:step5,
      _:step6,
      <<(:Eve :branch :b)>>,
      <<(:Frank :branch :c)>>,
      <<(:b :differentFrom :c)>>.

  _:step17
    rdf:reifies <<(:Eve :cousin :Grace)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :b ],
      [ pe:var "branchY"; pe:value :c ],
      [ pe:var "generation"; pe:value 2 ],
      [ pe:var "x"; pe:value :Eve ],
      [ pe:var "y"; pe:value :Grace ];
    pe:uses
      _:step5,
      _:step7,
      <<(:Eve :branch :b)>>,
      <<(:Grace :branch :c)>>,
      <<(:b :differentFrom :c)>>.

  _:step18
    rdf:reifies <<(:Frank :cousin :Dave)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :c ],
      [ pe:var "branchY"; pe:value :b ],
      [ pe:var "generation"; pe:value 2 ],
      [ pe:var "x"; pe:value :Frank ],
      [ pe:var "y"; pe:value :Dave ];
    pe:uses
      _:step6,
      _:step4,
      <<(:Frank :branch :c)>>,
      <<(:Dave :branch :b)>>,
      <<(:c :differentFrom :b)>>.

  _:step19
    rdf:reifies <<(:Frank :cousin :Eve)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :c ],
      [ pe:var "branchY"; pe:value :b ],
      [ pe:var "generation"; pe:value 2 ],
      [ pe:var "x"; pe:value :Frank ],
      [ pe:var "y"; pe:value :Eve ];
    pe:uses
      _:step6,
      _:step5,
      <<(:Frank :branch :c)>>,
      <<(:Eve :branch :b)>>,
      <<(:c :differentFrom :b)>>.

  _:step20
    rdf:reifies <<(:Grace :cousin :Dave)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :c ],
      [ pe:var "branchY"; pe:value :b ],
      [ pe:var "generation"; pe:value 2 ],
      [ pe:var "x"; pe:value :Grace ],
      [ pe:var "y"; pe:value :Dave ];
    pe:uses
      _:step7,
      _:step4,
      <<(:Grace :branch :c)>>,
      <<(:Dave :branch :b)>>,
      <<(:c :differentFrom :b)>>.

  _:step21
    rdf:reifies <<(:Grace :cousin :Eve)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :c ],
      [ pe:var "branchY"; pe:value :b ],
      [ pe:var "generation"; pe:value 2 ],
      [ pe:var "x"; pe:value :Grace ],
      [ pe:var "y"; pe:value :Eve ];
    pe:uses
      _:step7,
      _:step5,
      <<(:Grace :branch :c)>>,
      <<(:Eve :branch :b)>>,
      <<(:c :differentFrom :b)>>.

  _:step22
    rdf:reifies <<(:Heidi :cousin :Judy)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :b ],
      [ pe:var "branchY"; pe:value :c ],
      [ pe:var "generation"; pe:value 3 ],
      [ pe:var "x"; pe:value :Heidi ],
      [ pe:var "y"; pe:value :Judy ];
    pe:uses
      _:step8,
      _:step10,
      _:step11,
      _:step13,
      <<(:b :differentFrom :c)>>.

  _:step23
    rdf:reifies <<(:Ivan :cousin :Judy)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :b ],
      [ pe:var "branchY"; pe:value :c ],
      [ pe:var "generation"; pe:value 3 ],
      [ pe:var "x"; pe:value :Ivan ],
      [ pe:var "y"; pe:value :Judy ];
    pe:uses
      _:step9,
      _:step10,
      _:step12,
      _:step13,
      <<(:b :differentFrom :c)>>.

  _:step24
    rdf:reifies <<(:Judy :cousin :Heidi)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :c ],
      [ pe:var "branchY"; pe:value :b ],
      [ pe:var "generation"; pe:value 3 ],
      [ pe:var "x"; pe:value :Judy ],
      [ pe:var "y"; pe:value :Heidi ];
    pe:uses
      _:step10,
      _:step8,
      _:step13,
      _:step11,
      <<(:c :differentFrom :b)>>.

  _:step25
    rdf:reifies <<(:Judy :cousin :Ivan)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "branchX"; pe:value :c ],
      [ pe:var "branchY"; pe:value :b ],
      [ pe:var "generation"; pe:value 3 ],
      [ pe:var "x"; pe:value :Judy ],
      [ pe:var "y"; pe:value :Ivan ];
    pe:uses
      _:step10,
      _:step9,
      _:step13,
      _:step12,
      <<(:c :differentFrom :b)>>.
}
