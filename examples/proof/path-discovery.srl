      <<(res:AIRPORT_310 nepo:hasOutboundRouteTo res:AIRPORT_309)>>,
      <<(res:AIRPORT_309 nepo:hasOutboundRouteTo res:AIRPORT_3998)>>,
      <<(res:AIRPORT_3998 nepo:hasOutboundRouteTo res:AIRPORT_1587)>>,
      <<(res:AIRPORT_310 rdfs:label "Ostend-Bruges International Airport")>>,
      <<(res:AIRPORT_309 rdfs:label "Liège Airport")>>,
      <<(res:AIRPORT_3998 rdfs:label "Palma De Mallorca Airport")>>,
      <<(res:AIRPORT_1587 rdfs:label "Václav Havel Airport Prague")>>.
}
