PREFIX : <http://example.org/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :Felix :says "Meow" .

  _:step1
    rdf:reifies <<(:Felix :says "Meow")>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :Felix ];
    pe:uses <<(:Felix a :Cat)>>.
}
