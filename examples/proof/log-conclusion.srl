PREFIX : <http://example.org/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :Felix :says "Meow" .

  _:step1
    rdf:reifies <<( :Felix :says "Meow" )>>;
    pe:rule "log-conclusion.srl";
    pe:line 10;
    pe:binding [ pe:var "x"; pe:value :Felix ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :Felix a :Cat )>>;
    pe:fact "log-conclusion.srl";
    pe:line 8.
}
