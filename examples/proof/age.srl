PREFIX : <https://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :test :is true .

  _:step1
    rdf:reifies <<(:test :is true)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "birthYear"; pe:value 1944 ],
      [ pe:var "now"; pe:value 2025 ];
    pe:uses
      <<(:patH :birthYear 1944)>>,
      <<(:ref :year 2025)>>.
}
