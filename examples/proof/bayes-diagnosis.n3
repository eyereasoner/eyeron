      { (0.0042 0.02) math:product 0.000084 . },
      { (0.000084 0.95) math:product 0.00007979999999999999 . },
      { (0.00007979999999999999 0.60) math:product 0.00004787999999999999 . }.

  { :BacterialPneumonia :prior 0.01 . }
    pe:fact "bayes-diagnosis.n3".

  { :BacterialPneumonia :fever 0.70 . }
    pe:fact "bayes-diagnosis.n3".

