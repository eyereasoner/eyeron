      [ pe:var "p3"; pe:value 0.000084 ],
      [ pe:var "p4"; pe:value 0.00007979999999999999 ],
      [ pe:var "prior"; pe:value 0.01 ],
      [ pe:var "score"; pe:value 0.00004787999999999999 ],
      [ pe:var "smell"; pe:value 0.02 ];
    pe:uses
      { :BacterialPneumonia :prior 0.01 . },
      { :BacterialPneumonia :fever 0.70 . },
      { :BacterialPneumonia :cough 0.60 . },
      { :BacterialPneumonia :smell 0.02 . },
      { :BacterialPneumonia :noSneezing 0.95 . },
      { :BacterialPneumonia :breath 0.60 . },
      { (0.01 0.70) math:product 0.006999999999999999 . },
