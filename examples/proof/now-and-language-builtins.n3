@prefix : <http://example/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:msg :sameLanguageAs true .
:clock :eventYear 2026 .

{ :msg :sameLanguageAs true . } pe:why {
  { :msg :sameLanguageAs true . }
    pe:by [ pe:rule "now-and-language-builtins.n3"; pe:line 17 ];
    pe:binding
      [ pe:var "msg"; pe:value :msg ],
      [ pe:var "text"; pe:value "bonjour"@fr ];
    pe:uses
      { :msg :text "bonjour"@fr . },
      { "bonjour"@fr log:equalTo "bonjour"@fr . }.

  { :msg :text "bonjour"@fr . }
    pe:by [ pe:fact "now-and-language-builtins.n3"; pe:line 14 ].

  { "bonjour"@fr log:equalTo "bonjour"@fr . }
    pe:by [ pe:builtin log:equalTo ].
}.

{ :clock :eventYear 2026 . } pe:why {
  { :clock :eventYear 2026 . }
    pe:by [ pe:rule "now-and-language-builtins.n3"; pe:line 18 ];
    pe:binding
      [ pe:var "day"; pe:value 15 ],
      [ pe:var "event"; pe:value :clock ],
      [ pe:var "hour"; pe:value 10 ],
      [ pe:var "minute"; pe:value 20 ],
      [ pe:var "month"; pe:value 5 ],
      [ pe:var "second"; pe:value 30 ],
      [ pe:var "year"; pe:value 2026 ];
    pe:uses { :clock :event (2026 5 15 10 20 30) . }.

  { :clock :event (2026 5 15 10 20 30) . }
    pe:by [ pe:fact "now-and-language-builtins.n3"; pe:line 15 ].
}.