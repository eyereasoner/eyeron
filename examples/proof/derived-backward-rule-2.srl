PREFIX : <http://example.org/socrates#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

DATA {
  :Socrates a :Mortal .
  :test :is true .

  _:step1
    rdf:reifies <<( :Socrates a :Mortal )>>;
    pe:rule "derived-backward-rule-2.srl";
    pe:line 10;
    pe:binding
      [ pe:var "a"; pe:value :Human ],
      [ pe:var "b"; pe:value :Mortal ],
      [ pe:var "s"; pe:value :Socrates ];
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( :Socrates a :Human )>>;
    pe:fact "derived-backward-rule-2.srl";
    pe:line 8.

  _:step3
    rdf:reifies <<( :Human rdfs:subClassOf :Mortal )>>;
    pe:fact "derived-backward-rule-2.srl";
    pe:line 8.

  _:step4
    rdf:reifies <<( :test :is true )>>;
    pe:rule "derived-backward-rule-2.srl";
    pe:line 11;
    pe:uses _:step1.
}
