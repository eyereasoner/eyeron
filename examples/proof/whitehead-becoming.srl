PREFIX : <http://example.org/whitehead#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :o2 :becomesFrom :o1 .
  :o3 :becomesFrom :o2 .
  :o2 :inherits :red .
  :o2 :inherits :warm .
  :o2 :mayRealize :bright .
  :o3 :mayRealize :dark .
  :o1 :ingresses :red .
  :o1 :ingresses :warm .
  :o1 :status :objectivelyAvailable .
  :o1 :availableForFuturePrehension :yes .
  :o2 :integrates :red .
  :o2 :integrates :bright .
  :o2 :achieves :satisfaction .
  :o2 :integrates :warm .
  :o2 :realizes :red .
  :o2 :realizes :bright .
  :o2 :realizes :warm .
  :o2 :status :objectivelyAvailable .
  :o2 :availableForFuturePrehension :yes .
  :o3 :inherits :red .
  :o3 :inherits :bright .
  :o3 :inherits :warm .
  :o2 :ingresses :red .
  :o2 :ingresses :bright .
  :o2 :ingresses :warm .
  :o3 :integrates :red .
  :o3 :integrates :dark .
  :o3 :achieves :satisfaction .
  :o3 :integrates :bright .
  :o3 :integrates :warm .
  :o3 :realizes :red .
  :o3 :realizes :dark .
  :o3 :realizes :bright .
  :o3 :realizes :warm .
  :o3 :status :objectivelyAvailable .
  :o3 :availableForFuturePrehension :yes .
  :o3 :ingresses :red .
  :o3 :ingresses :dark .
  :o3 :ingresses :bright .
  :o3 :ingresses :warm .

  _:step1
    rdf:reifies <<(:o2 :becomesFrom :o1)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :o1 ],
      [ pe:var "later"; pe:value :o2 ];
    pe:uses <<(:o2 :prehends :o1)>>.

  _:step2
    rdf:reifies <<(:o3 :becomesFrom :o2)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :o2 ],
      [ pe:var "later"; pe:value :o3 ];
    pe:uses <<(:o3 :prehends :o2)>>.

  _:step3
    rdf:reifies <<(:o2 :inherits :red)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "earlier"; pe:value :o1 ],
      [ pe:var "form"; pe:value :red ],
      [ pe:var "later"; pe:value :o2 ];
    pe:uses
      <<(:o2 :prehends :o1)>>,
      <<(:o1 :realizes :red)>>.

  _:step4
    rdf:reifies <<(:o2 :inherits :warm)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "earlier"; pe:value :o1 ],
      [ pe:var "form"; pe:value :warm ],
      [ pe:var "later"; pe:value :o2 ];
    pe:uses
      <<(:o2 :prehends :o1)>>,
      <<(:o1 :realizes :warm)>>.

  _:step5
    rdf:reifies <<(:o2 :mayRealize :bright)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "aim"; pe:value :intensity ],
      [ pe:var "form"; pe:value :bright ],
      [ pe:var "o"; pe:value :o2 ];
    pe:uses
      <<(:o2 :subjectiveAim :intensity)>>,
      <<(:intensity :lures :bright)>>.

  _:step6
    rdf:reifies <<(:o3 :mayRealize :dark)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "aim"; pe:value :contrast ],
      [ pe:var "form"; pe:value :dark ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      <<(:o3 :subjectiveAim :contrast)>>,
      <<(:contrast :lures :dark)>>.

  _:step7
    rdf:reifies <<(:o1 :ingresses :red)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :red ],
      [ pe:var "o"; pe:value :o1 ];
    pe:uses
      <<(:o1 :realizes :red)>>,
      <<(:red a :PurePotential)>>.

  _:step8
    rdf:reifies <<(:o1 :ingresses :warm)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :warm ],
      [ pe:var "o"; pe:value :o1 ];
    pe:uses
      <<(:o1 :realizes :warm)>>,
      <<(:warm a :PurePotential)>>.

  _:step9
    rdf:reifies <<(:o1 :status :objectivelyAvailable)>>;
    pe:rule 7;
    pe:binding [ pe:var "o"; pe:value :o1 ];
    pe:uses <<(:o1 :achieves :satisfaction)>>.

  _:step10
    rdf:reifies <<(:o1 :availableForFuturePrehension :yes)>>;
    pe:rule 7;
    pe:binding [ pe:var "o"; pe:value :o1 ];
    pe:uses <<(:o1 :achieves :satisfaction)>>.

  _:step11
    rdf:reifies <<(:o2 :integrates :red)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :bright ],
      [ pe:var "o"; pe:value :o2 ],
      [ pe:var "pastForm"; pe:value :red ];
    pe:uses
      _:step3,
      _:step5.

  _:step12
    rdf:reifies <<(:o2 :integrates :bright)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :bright ],
      [ pe:var "o"; pe:value :o2 ],
      [ pe:var "pastForm"; pe:value :red ];
    pe:uses
      _:step3,
      _:step5.

  _:step13
    rdf:reifies <<(:o2 :achieves :satisfaction)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :bright ],
      [ pe:var "o"; pe:value :o2 ],
      [ pe:var "pastForm"; pe:value :red ];
    pe:uses
      _:step3,
      _:step5.

  _:step14
    rdf:reifies <<(:o2 :integrates :warm)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :bright ],
      [ pe:var "o"; pe:value :o2 ],
      [ pe:var "pastForm"; pe:value :warm ];
    pe:uses
      _:step4,
      _:step5.

  _:step15
    rdf:reifies <<(:o2 :realizes :red)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "form"; pe:value :red ],
      [ pe:var "o"; pe:value :o2 ];
    pe:uses
      _:step11,
      _:step13.

  _:step16
    rdf:reifies <<(:o2 :realizes :bright)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "form"; pe:value :bright ],
      [ pe:var "o"; pe:value :o2 ];
    pe:uses
      _:step12,
      _:step13.

  _:step17
    rdf:reifies <<(:o2 :realizes :warm)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "form"; pe:value :warm ],
      [ pe:var "o"; pe:value :o2 ];
    pe:uses
      _:step14,
      _:step13.

  _:step18
    rdf:reifies <<(:o2 :status :objectivelyAvailable)>>;
    pe:rule 7;
    pe:binding [ pe:var "o"; pe:value :o2 ];
    pe:uses _:step13.

  _:step19
    rdf:reifies <<(:o2 :availableForFuturePrehension :yes)>>;
    pe:rule 7;
    pe:binding [ pe:var "o"; pe:value :o2 ];
    pe:uses _:step13.

  _:step20
    rdf:reifies <<(:o3 :inherits :red)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "earlier"; pe:value :o2 ],
      [ pe:var "form"; pe:value :red ],
      [ pe:var "later"; pe:value :o3 ];
    pe:uses
      <<(:o3 :prehends :o2)>>,
      _:step15.

  _:step21
    rdf:reifies <<(:o3 :inherits :bright)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "earlier"; pe:value :o2 ],
      [ pe:var "form"; pe:value :bright ],
      [ pe:var "later"; pe:value :o3 ];
    pe:uses
      <<(:o3 :prehends :o2)>>,
      _:step16.

  _:step22
    rdf:reifies <<(:o3 :inherits :warm)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "earlier"; pe:value :o2 ],
      [ pe:var "form"; pe:value :warm ],
      [ pe:var "later"; pe:value :o3 ];
    pe:uses
      <<(:o3 :prehends :o2)>>,
      _:step17.

  _:step23
    rdf:reifies <<(:o2 :ingresses :red)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :red ],
      [ pe:var "o"; pe:value :o2 ];
    pe:uses
      _:step15,
      <<(:red a :PurePotential)>>.

  _:step24
    rdf:reifies <<(:o2 :ingresses :bright)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :bright ],
      [ pe:var "o"; pe:value :o2 ];
    pe:uses
      _:step16,
      <<(:bright a :PurePotential)>>.

  _:step25
    rdf:reifies <<(:o2 :ingresses :warm)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :warm ],
      [ pe:var "o"; pe:value :o2 ];
    pe:uses
      _:step17,
      <<(:warm a :PurePotential)>>.

  _:step26
    rdf:reifies <<(:o3 :integrates :red)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :dark ],
      [ pe:var "o"; pe:value :o3 ],
      [ pe:var "pastForm"; pe:value :red ];
    pe:uses
      _:step20,
      _:step6.

  _:step27
    rdf:reifies <<(:o3 :integrates :dark)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :dark ],
      [ pe:var "o"; pe:value :o3 ],
      [ pe:var "pastForm"; pe:value :red ];
    pe:uses
      _:step20,
      _:step6.

  _:step28
    rdf:reifies <<(:o3 :achieves :satisfaction)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :dark ],
      [ pe:var "o"; pe:value :o3 ],
      [ pe:var "pastForm"; pe:value :red ];
    pe:uses
      _:step20,
      _:step6.

  _:step29
    rdf:reifies <<(:o3 :integrates :bright)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :dark ],
      [ pe:var "o"; pe:value :o3 ],
      [ pe:var "pastForm"; pe:value :bright ];
    pe:uses
      _:step21,
      _:step6.

  _:step30
    rdf:reifies <<(:o3 :integrates :warm)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "novelForm"; pe:value :dark ],
      [ pe:var "o"; pe:value :o3 ],
      [ pe:var "pastForm"; pe:value :warm ];
    pe:uses
      _:step22,
      _:step6.

  _:step31
    rdf:reifies <<(:o3 :realizes :red)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "form"; pe:value :red ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      _:step26,
      _:step28.

  _:step32
    rdf:reifies <<(:o3 :realizes :dark)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "form"; pe:value :dark ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      _:step27,
      _:step28.

  _:step33
    rdf:reifies <<(:o3 :realizes :bright)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "form"; pe:value :bright ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      _:step29,
      _:step28.

  _:step34
    rdf:reifies <<(:o3 :realizes :warm)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "form"; pe:value :warm ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      _:step30,
      _:step28.

  _:step35
    rdf:reifies <<(:o3 :status :objectivelyAvailable)>>;
    pe:rule 7;
    pe:binding [ pe:var "o"; pe:value :o3 ];
    pe:uses _:step28.

  _:step36
    rdf:reifies <<(:o3 :availableForFuturePrehension :yes)>>;
    pe:rule 7;
    pe:binding [ pe:var "o"; pe:value :o3 ];
    pe:uses _:step28.

  _:step37
    rdf:reifies <<(:o3 :ingresses :red)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :red ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      _:step31,
      <<(:red a :PurePotential)>>.

  _:step38
    rdf:reifies <<(:o3 :ingresses :dark)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :dark ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      _:step32,
      <<(:dark a :PurePotential)>>.

  _:step39
    rdf:reifies <<(:o3 :ingresses :bright)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :bright ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      _:step33,
      <<(:bright a :PurePotential)>>.

  _:step40
    rdf:reifies <<(:o3 :ingresses :warm)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :warm ],
      [ pe:var "o"; pe:value :o3 ];
    pe:uses
      _:step34,
      <<(:warm a :PurePotential)>>.
}
