@prefix : <https://eyereasoner.github.io/eyeling/examples/genetic-knapsack-selection#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .

:Run :localSearchStopsAt :FinalLocal .
:geneticKnapsackSelection log:outputString "# genetic-knapsack-selection\n\n## Source files\n\n- [N3 rules](../genetic-knapsack-selection.n3)\n- [Input TriG](../input/genetic-knapsack-selection.trig)\n\n## Answer\nfinal genome : 101000000101\nselected items : item01, item03, item10, item12\nweight : 50 / 50\nvalue : 101\nfitness : 999899\ngenerations evaluated : 5\nexhaustive optimum value : 104 at genome 001000011111\n\n## Explanation\nEach genome bit says whether the corresponding item is selected for the knapsack. Feasible candidates get fitness 1000000 minus value, so higher value means lower fitness; overweight candidates are penalized above every feasible candidate. The N3 source records the deterministic local-search result and validates that the final genome respects capacity and has no strictly better one-bit neighbor. For transparency, an exhaustive enumeration also records the global best feasible value, showing this is a local mutation search rather than a global-optimality claim." .
:geneticKnapsackSelection :selects :FinalLocal .

{ :Run :localSearchStopsAt :FinalLocal . }
  pe:rule 1;
  pe:binding
    [ pe:var "BestNeighbor"; pe:value 101 ],
    [ pe:var "Capacity"; pe:value 50 ],
    [ pe:var "Value"; pe:value 101 ],
    [ pe:var "Weight"; pe:value 50 ];
  pe:uses
    { :Run :capacity 50 . },
    { :FinalLocal :weight 50 . },
    { :FinalLocal :value 101 . },
    { :NeighborSummary :bestNeighborValue 101 . },
    { :NeighborSummary :capacityRespected true . },
    { 50 math:notGreaterThan 50 . },
    { 101 math:notGreaterThan 101 . }.

{ :Run :capacity 50 . }
  pe:fact "<unknown>".

{ :FinalLocal :weight 50 . }
  pe:fact "<unknown>".

{ :FinalLocal :value 101 . }
  pe:fact "<unknown>".

{ :NeighborSummary :bestNeighborValue 101 . }
  pe:fact "<unknown>".

{ :NeighborSummary :capacityRespected true . }
  pe:fact "<unknown>".

{ 50 math:notGreaterThan 50 . }
  pe:builtin math:notGreaterThan.

{ 101 math:notGreaterThan 101 . }
  pe:builtin math:notGreaterThan.

{ :geneticKnapsackSelection log:outputString "# genetic-knapsack-selection\n\n## Source files\n\n- [N3 rules](../genetic-knapsack-selection.n3)\n- [Input TriG](../input/genetic-knapsack-selection.trig)\n\n## Answer\nfinal genome : 101000000101\nselected items : item01, item03, item10, item12\nweight : 50 / 50\nvalue : 101\nfitness : 999899\ngenerations evaluated : 5\nexhaustive optimum value : 104 at genome 001000011111\n\n## Explanation\nEach genome bit says whether the corresponding item is selected for the knapsack. Feasible candidates get fitness 1000000 minus value, so higher value means lower fitness; overweight candidates are penalized above every feasible candidate. The N3 source records the deterministic local-search result and validates that the final genome respects capacity and has no strictly better one-bit neighbor. For transparency, an exhaustive enumeration also records the global best feasible value, showing this is a local mutation search rather than a global-optimality claim." . }
  pe:rule 2;
  pe:binding
    [ pe:var "Block"; pe:value "# genetic-knapsack-selection\n\n## Source files\n\n- [N3 rules](../genetic-knapsack-selection.n3)\n- [Input TriG](../input/genetic-knapsack-selection.trig)\n\n## Answer\nfinal genome : 101000000101\nselected items : item01, item03, item10, item12\nweight : 50 / 50\nvalue : 101\nfitness : 999899\ngenerations evaluated : 5\nexhaustive optimum value : 104 at genome 001000011111\n\n## Explanation\nEach genome bit says whether the corresponding item is selected for the knapsack. Feasible candidates get fitness 1000000 minus value, so higher value means lower fitness; overweight candidates are penalized above every feasible candidate. The N3 source records the deterministic local-search result and validates that the final genome respects capacity and has no strictly better one-bit neighbor. For transparency, an exhaustive enumeration also records the global best feasible value, showing this is a local mutation search rather than a global-optimality claim." ],
    [ pe:var "Capacity"; pe:value 50 ],
    [ pe:var "Fitness"; pe:value 999899 ],
    [ pe:var "Generations"; pe:value 5 ],
    [ pe:var "Genome"; pe:value "101000000101" ],
    [ pe:var "Items"; pe:value "item01, item03, item10, item12" ],
    [ pe:var "OptGenome"; pe:value "001000011111" ],
    [ pe:var "OptValue"; pe:value 104 ],
    [ pe:var "Value"; pe:value 101 ],
    [ pe:var "Weight"; pe:value 50 ];
  pe:uses
    { :Run :capacity 50 . },
    { :Run :localSearchStopsAt :FinalLocal . },
    { :FinalLocal :genome "101000000101" . },
    { :FinalLocal :selectedItems "item01, item03, item10, item12" . },
    { :FinalLocal :weight 50 . },
    { :FinalLocal :value 101 . },
    { :FinalLocal :fitness 999899 . },
    { :FinalLocal :generationsEvaluated 5 . },
    { :ExhaustiveOptimum :genome "001000011111" . },
    { :ExhaustiveOptimum :value 104 . },
