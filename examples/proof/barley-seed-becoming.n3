  pe:binding
    [ pe:var "Genome"; pe:value :mainGenome ],
    [ pe:var "Line"; pe:value :mainLine ],
    [ pe:var "Repair"; pe:value :mainRepair ],
    [ pe:var "Seed"; pe:value :mainSeed ],
    [ pe:var "Vehicle"; pe:value :mainEmbryoVehicle ];
  pe:uses
    { :mainLine a :Lineage . },
    { :mainLine :seedStage :mainSeed . },
    { :mainLine :replicator :mainGenome . },
    { :mainGenome :canBecome :AccuratelyCopiedGenome . },
    { :mainSeed :hasVehicle :mainEmbryoVehicle . },
    { :mainEmbryoVehicle :usesRepair :mainRepair . },
    { :mainRepair a :RepairVehicle . },
    { :zygote a :DevelopmentalBottleneck . }.

{ :mainLine a :Lineage . }
  pe:fact "barley-seed-becoming.n3".

{ :mainLine :seedStage :mainSeed . }
  pe:fact "barley-seed-becoming.n3".

{ :mainLine :replicator :mainGenome . }
