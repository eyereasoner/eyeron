PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :knowsNamed "Bob" .
  :team :firstMember :alice .

  _:step1
    rdf:reifies <<( :alice :knowsNamed "Bob" )>>;
    pe:rule "collections-and-blank-nodes.srl";
    pe:line 8;
    pe:binding
      [ pe:var "__b5"; pe:value _:b1 ],
      [ pe:var "name"; pe:value "Bob" ],
      [ pe:var "person"; pe:value :alice ];
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( _:b1 :name "Bob" )>>;
    pe:fact "collections-and-blank-nodes.srl";
    pe:line 4.

  _:step3
    rdf:reifies <<( :alice :knows _:b1 )>>;
    pe:fact "collections-and-blank-nodes.srl";
    pe:line 4.

  _:step4
    rdf:reifies <<( :team :firstMember :alice )>>;
    pe:rule "collections-and-blank-nodes.srl";
    pe:line 11;
    pe:binding [ pe:var "first"; pe:value :alice ];
    pe:uses
      <<( ?__path_s_0 :members ?__path_o_0 )>>,
      <<( ?__path_s_1 rdf:first ?__path_o_1 )>>.

  _:step5
    rdf:reifies <<( :team :members _:b2 )>>;
    pe:fact "collections-and-blank-nodes.srl";
    pe:line 5.

  _:step6
    rdf:reifies <<( _:b2 rdf:first :alice )>>;
    pe:fact "collections-and-blank-nodes.srl";
    pe:line 5.
}
