PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :knowsNamed "Bob" .
  :team :firstMember :alice .

  _:step1
    rdf:reifies <<(:alice :knowsNamed "Bob")>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "__b5"; pe:value _:b1 ],
      [ pe:var "name"; pe:value "Bob" ],
      [ pe:var "person"; pe:value :alice ];
    pe:uses
      <<(_:b1 :name "Bob")>>,
      <<(:alice :knows _:b1)>>.

  _:step2
    rdf:reifies <<(:team :firstMember :alice)>>;
    pe:rule "rule#2";
    pe:binding [ pe:var "first"; pe:value :alice ].
}
