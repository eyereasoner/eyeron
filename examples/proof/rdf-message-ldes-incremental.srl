PREFIX : <https://eyereasoner.github.io/eyeling/examples/rdf-message-ldes-incremental#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :obs033 :alreadyCommitted true .
  :obs034 :alreadyCommitted true .
  :obs035 :newlyEmitted true .
  :obs036 :newlyEmitted true .
  :obs037 :newlyEmitted true .
  :obs038 :newlyEmitted true .
  :obs039 :newlyEmitted true .
  :obs040 :newlyEmitted true .
  :obs035 :inWindow true .
  :obs036 :inWindow true .
  :obs037 :inWindow true .
  :obs038 :inWindow true .
  :obs039 :inWindow true .
  :obs040 :inWindow true .
  :doorA :rawConflict true .
  :currentLDESWindow :preferredEvidence :obs040 .
  :currentLDESWindow :resolvedDoorState :closed .
  :currentLDESWindow :preferredPriority 5 .
  :currentLDESWindow :preferredSource "safety-controller" .
  :currentLDESWindow :materializedActionText "keep the compartment sealed and continue monitoring" .

  _:step1
    rdf:reifies <<(:obs033 :alreadyCommitted true)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "b"; pe:value 34 ],
      [ pe:var "m"; pe:value :obs033 ],
      [ pe:var "seq"; pe:value 33 ];
    pe:uses
      <<(:obs033 :sequence 33)>>,
      <<(:doorStream :lastCommittedSequence 34)>>.

  _:step2
    rdf:reifies <<(:obs034 :alreadyCommitted true)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "b"; pe:value 34 ],
      [ pe:var "m"; pe:value :obs034 ],
      [ pe:var "seq"; pe:value 34 ];
    pe:uses
      <<(:obs034 :sequence 34)>>,
      <<(:doorStream :lastCommittedSequence 34)>>.

  _:step3
    rdf:reifies <<(:obs035 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 34 ],
      [ pe:var "m"; pe:value :obs035 ],
      [ pe:var "seq"; pe:value 35 ];
    pe:uses
      <<(:obs035 :sequence 35)>>,
      <<(:doorStream :lastCommittedSequence 34)>>.

  _:step4
    rdf:reifies <<(:obs036 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 34 ],
      [ pe:var "m"; pe:value :obs036 ],
      [ pe:var "seq"; pe:value 36 ];
    pe:uses
      <<(:obs036 :sequence 36)>>,
      <<(:doorStream :lastCommittedSequence 34)>>.

  _:step5
    rdf:reifies <<(:obs037 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 34 ],
      [ pe:var "m"; pe:value :obs037 ],
      [ pe:var "seq"; pe:value 37 ];
    pe:uses
      <<(:obs037 :sequence 37)>>,
      <<(:doorStream :lastCommittedSequence 34)>>.

  _:step6
    rdf:reifies <<(:obs038 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 34 ],
      [ pe:var "m"; pe:value :obs038 ],
      [ pe:var "seq"; pe:value 38 ];
    pe:uses
      <<(:obs038 :sequence 38)>>,
      <<(:doorStream :lastCommittedSequence 34)>>.

  _:step7
    rdf:reifies <<(:obs039 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 34 ],
      [ pe:var "m"; pe:value :obs039 ],
      [ pe:var "seq"; pe:value 39 ];
    pe:uses
      <<(:obs039 :sequence 39)>>,
      <<(:doorStream :lastCommittedSequence 34)>>.

  _:step8
    rdf:reifies <<(:obs040 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 34 ],
      [ pe:var "m"; pe:value :obs040 ],
      [ pe:var "seq"; pe:value 40 ];
    pe:uses
      <<(:obs040 :sequence 40)>>,
      <<(:doorStream :lastCommittedSequence 34)>>.

  _:step9
    rdf:reifies <<(:obs035 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs035 ],
      [ pe:var "seq"; pe:value 35 ],
      [ pe:var "w"; pe:value 35 ];
    pe:uses
      _:step3,
      <<(:obs035 :sequence 35)>>,
      <<(:doorStream :currentWindowFromSequence 35)>>.

  _:step10
    rdf:reifies <<(:obs036 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs036 ],
      [ pe:var "seq"; pe:value 36 ],
      [ pe:var "w"; pe:value 35 ];
    pe:uses
      _:step4,
      <<(:obs036 :sequence 36)>>,
      <<(:doorStream :currentWindowFromSequence 35)>>.

  _:step11
    rdf:reifies <<(:obs037 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs037 ],
      [ pe:var "seq"; pe:value 37 ],
      [ pe:var "w"; pe:value 35 ];
    pe:uses
      _:step5,
      <<(:obs037 :sequence 37)>>,
      <<(:doorStream :currentWindowFromSequence 35)>>.

  _:step12
    rdf:reifies <<(:obs038 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs038 ],
      [ pe:var "seq"; pe:value 38 ],
      [ pe:var "w"; pe:value 35 ];
    pe:uses
      _:step6,
      <<(:obs038 :sequence 38)>>,
      <<(:doorStream :currentWindowFromSequence 35)>>.

  _:step13
    rdf:reifies <<(:obs039 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs039 ],
      [ pe:var "seq"; pe:value 39 ],
      [ pe:var "w"; pe:value 35 ];
    pe:uses
      _:step7,
      <<(:obs039 :sequence 39)>>,
      <<(:doorStream :currentWindowFromSequence 35)>>.

  _:step14
    rdf:reifies <<(:obs040 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs040 ],
      [ pe:var "seq"; pe:value 40 ],
      [ pe:var "w"; pe:value 35 ];
    pe:uses
      _:step8,
      <<(:obs040 :sequence 40)>>,
      <<(:doorStream :currentWindowFromSequence 35)>>.

  _:step15
    rdf:reifies <<(:doorA :rawConflict true)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "m1"; pe:value :obs037 ],
      [ pe:var "m2"; pe:value :obs035 ];
    pe:uses
      _:step11,
      <<(:obs037 :doorState :open)>>,
      _:step9,
      <<(:obs035 :doorState :closed)>>.

  _:step16
    rdf:reifies <<(:currentLDESWindow :preferredEvidence :obs040)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "m"; pe:value :obs040 ],
      [ pe:var "other"; pe:value :obs037 ],
      [ pe:var "otherPriority"; pe:value 1 ],
      [ pe:var "otherState"; pe:value :open ],
      [ pe:var "priority"; pe:value 5 ],
      [ pe:var "source"; pe:value "safety-controller" ],
      [ pe:var "state"; pe:value :closed ];
    pe:uses
      _:step14,
      <<(:obs040 :doorState :closed)>>,
      <<(:obs040 :priority 5)>>,
      <<(:obs040 :source "safety-controller")>>,
      _:step11,
      <<(:obs037 :doorState :open)>>,
      <<(:obs037 :priority 1)>>.

  _:step17
    rdf:reifies <<(:currentLDESWindow :resolvedDoorState :closed)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "m"; pe:value :obs040 ],
      [ pe:var "other"; pe:value :obs037 ],
      [ pe:var "otherPriority"; pe:value 1 ],
      [ pe:var "otherState"; pe:value :open ],
      [ pe:var "priority"; pe:value 5 ],
      [ pe:var "source"; pe:value "safety-controller" ],
      [ pe:var "state"; pe:value :closed ];
    pe:uses
      _:step14,
      <<(:obs040 :doorState :closed)>>,
      <<(:obs040 :priority 5)>>,
      <<(:obs040 :source "safety-controller")>>,
      _:step11,
      <<(:obs037 :doorState :open)>>,
      <<(:obs037 :priority 1)>>.

  _:step18
    rdf:reifies <<(:currentLDESWindow :preferredPriority 5)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "m"; pe:value :obs040 ],
      [ pe:var "other"; pe:value :obs037 ],
      [ pe:var "otherPriority"; pe:value 1 ],
      [ pe:var "otherState"; pe:value :open ],
      [ pe:var "priority"; pe:value 5 ],
      [ pe:var "source"; pe:value "safety-controller" ],
      [ pe:var "state"; pe:value :closed ];
    pe:uses
      _:step14,
      <<(:obs040 :doorState :closed)>>,
      <<(:obs040 :priority 5)>>,
      <<(:obs040 :source "safety-controller")>>,
      _:step11,
      <<(:obs037 :doorState :open)>>,
      <<(:obs037 :priority 1)>>.

  _:step19
    rdf:reifies <<(:currentLDESWindow :preferredSource "safety-controller")>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "m"; pe:value :obs040 ],
      [ pe:var "other"; pe:value :obs037 ],
      [ pe:var "otherPriority"; pe:value 1 ],
      [ pe:var "otherState"; pe:value :open ],
      [ pe:var "priority"; pe:value 5 ],
      [ pe:var "source"; pe:value "safety-controller" ],
      [ pe:var "state"; pe:value :closed ];
    pe:uses
      _:step14,
      <<(:obs040 :doorState :closed)>>,
      <<(:obs040 :priority 5)>>,
      <<(:obs040 :source "safety-controller")>>,
      _:step11,
      <<(:obs037 :doorState :open)>>,
      <<(:obs037 :priority 1)>>.

  _:step20
    rdf:reifies <<(:currentLDESWindow :materializedActionText "keep the compartment sealed and continue monitoring")>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "state"; pe:value :closed ],
      [ pe:var "text"; pe:value "keep the compartment sealed and continue monitoring" ];
    pe:uses
      _:step17,
      <<(:closed :actionText "keep the compartment sealed and continue monitoring")>>.
}
