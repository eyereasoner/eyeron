@prefix ex: <https://example.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .

ex:alice a foaf:Person .
ex:alice foaf:name "Alice Example" .
ex:alice foaf:givenName "Alice" .
ex:alice foaf:familyName "Example" .

{ ex:alice a foaf:Person . }
  pe:rule 1;
  pe:binding [ pe:var "p"; pe:value ex:alice ];
  pe:uses { ex:alice a schema:Person . }.

{ ex:alice a schema:Person . }
  pe:fact "schema-foaf-mapping.n3".

{ ex:alice foaf:name "Alice Example" . }
  pe:rule 2;
  pe:binding
    [ pe:var "name"; pe:value "Alice Example" ],
    [ pe:var "p"; pe:value ex:alice ];
  pe:uses { ex:alice schema:name "Alice Example" . }.

{ ex:alice schema:name "Alice Example" . }
  pe:fact "schema-foaf-mapping.n3".

{ ex:alice foaf:givenName "Alice" . }
  pe:rule 3;
  pe:binding
    [ pe:var "given"; pe:value "Alice" ],
    [ pe:var "p"; pe:value ex:alice ];
  pe:uses { ex:alice schema:givenName "Alice" . }.

{ ex:alice schema:givenName "Alice" . }
  pe:fact "schema-foaf-mapping.n3".

{ ex:alice foaf:familyName "Example" . }
  pe:rule 4;
  pe:binding
    [ pe:var "family"; pe:value "Example" ],
    [ pe:var "p"; pe:value ex:alice ];
  pe:uses { ex:alice schema:familyName "Example" . }.

{ ex:alice schema:familyName "Example" . }
  pe:fact "schema-foaf-mapping.n3".
