@prefix : <http://example.org/expression-eval#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:Root :result 12 .

{ :Root :result 12 . }
  pe:rule 5;
  pe:binding
    [ pe:var "E"; pe:value :eAdd ],
    [ pe:var "V"; pe:value 12 ];
  pe:uses
    { :Root :expr :eAdd . },
    { :eAdd :value 12 . }.

{ :Root :expr :eAdd . }
  pe:fact "expression-eval.n3".

{ :eAdd :value 12 . }
  pe:rule 2;
  pe:binding
    [ pe:var "E"; pe:value :eAdd ],
    [ pe:var "L"; pe:value :eMul ],
    [ pe:var "LV"; pe:value 6 ],
    [ pe:var "R"; pe:value :eSub ],
    [ pe:var "RV"; pe:value 6 ],
    [ pe:var "V"; pe:value 12 ];
  pe:uses
    { :eAdd :op :add . },
    { :eAdd :left :eMul . },
    { :eAdd :right :eSub . },
    { :eMul :value 6 . },
    { :eSub :value 6 . },
    { (6 6) math:sum 12 . }.

{ :eAdd :op :add . }
  pe:fact "expression-eval.n3".

{ :eAdd :left :eMul . }
  pe:fact "expression-eval.n3".

{ :eAdd :right :eSub . }
  pe:fact "expression-eval.n3".

{ :eMul :value 6 . }
  pe:rule 4;
  pe:binding
    [ pe:var "E"; pe:value :eMul ],
    [ pe:var "L"; pe:value :n2 ],
    [ pe:var "LV"; pe:value 2 ],
    [ pe:var "R"; pe:value :n3 ],
    [ pe:var "RV"; pe:value 3 ],
    [ pe:var "V"; pe:value 6 ];
  pe:uses
    { :eMul :op :mul . },
    { :eMul :left :n2 . },
    { :eMul :right :n3 . },
    { :n2 :value 2 . },
    { :n3 :value 3 . },
    { (2 3) math:product 6 . }.

{ :eMul :op :mul . }
  pe:fact "expression-eval.n3".

{ :eMul :left :n2 . }
  pe:fact "expression-eval.n3".

{ :eMul :right :n3 . }
  pe:fact "expression-eval.n3".

{ :n2 :value 2 . }
  pe:rule 1;
  pe:binding
    [ pe:var "N"; pe:value :n2 ],
    [ pe:var "V"; pe:value 2 ];
  pe:uses { :n2 :n 2 . }.

{ :n2 :n 2 . }
  pe:fact "expression-eval.n3".

{ :n3 :value 3 . }
  pe:rule 1;
  pe:binding
    [ pe:var "N"; pe:value :n3 ],
    [ pe:var "V"; pe:value 3 ];
  pe:uses { :n3 :n 3 . }.

{ :n3 :n 3 . }
  pe:fact "expression-eval.n3".

{ (2 3) math:product 6 . }
  pe:builtin math:product.

{ :eSub :value 6 . }
  pe:rule 3;
  pe:binding
    [ pe:var "E"; pe:value :eSub ],
    [ pe:var "L"; pe:value :n10 ],
    [ pe:var "LV"; pe:value 10 ],
    [ pe:var "R"; pe:value :n4 ],
    [ pe:var "RV"; pe:value 4 ],
    [ pe:var "V"; pe:value 6 ];
  pe:uses
    { :eSub :op :sub . },
    { :eSub :left :n10 . },
    { :eSub :right :n4 . },
    { :n10 :value 10 . },
    { :n4 :value 4 . },
    { (10 4) math:difference 6 . }.

{ :eSub :op :sub . }
  pe:fact "expression-eval.n3".

{ :eSub :left :n10 . }
  pe:fact "expression-eval.n3".

{ :eSub :right :n4 . }
  pe:fact "expression-eval.n3".

{ :n10 :value 10 . }
  pe:rule 1;
  pe:binding
    [ pe:var "N"; pe:value :n10 ],
    [ pe:var "V"; pe:value 10 ];
  pe:uses { :n10 :n 10 . }.

{ :n10 :n 10 . }
  pe:fact "expression-eval.n3".

{ :n4 :value 4 . }
  pe:rule 1;
  pe:binding
    [ pe:var "N"; pe:value :n4 ],
    [ pe:var "V"; pe:value 4 ];
  pe:uses { :n4 :n 4 . }.

{ :n4 :n 4 . }
  pe:fact "expression-eval.n3".

{ (10 4) math:difference 6 . }
  pe:builtin math:difference.

{ (6 6) math:sum 12 . }
  pe:builtin math:sum.
