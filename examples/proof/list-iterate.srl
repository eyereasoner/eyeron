PREFIX : <urn:example:>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  _:b1 :iterate0 "Huey" .
  _:b1 :iterate1 "Dewey" .
  _:b1 :iterate2 "Louie" .
  "Dewey" :hasIndex 1 .
  :test :is true .

  _:step1
    rdf:reifies <<( _:b1 :iterate0 "Huey" )>>;
    pe:rule "list-iterate.srl";
    pe:line 14;
    pe:binding
      [ pe:var "item"; pe:value "Huey" ],
      [ pe:var "list"; pe:value _:b1 ];
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( :Let :param _:b1 )>>;
    pe:fact "list-iterate.srl";
    pe:line 11.

  _:step3
    rdf:reifies <<( _:b1 rdf:first "Huey" )>>;
    pe:fact "list-iterate.srl";
    pe:line 11.

  _:step4
    rdf:reifies <<( _:b1 :iterate1 "Dewey" )>>;
    pe:rule "list-iterate.srl";
    pe:line 15;
    pe:binding
      [ pe:var "item"; pe:value "Dewey" ],
      [ pe:var "list"; pe:value _:b1 ];
    pe:uses
      _:step2,
      <<( ?__path_s_0 rdf:rest ?__path_o_0 )>>,
      <<( ?__path_s_1 rdf:first ?__path_o_1 )>>.

  _:step5
    rdf:reifies <<( _:b1 rdf:rest _:b2 )>>;
    pe:fact "list-iterate.srl";
    pe:line 11.

  _:step6
    rdf:reifies <<( _:b1 :iterate2 "Louie" )>>;
    pe:rule "list-iterate.srl";
    pe:line 16;
    pe:binding
      [ pe:var "item"; pe:value "Louie" ],
      [ pe:var "list"; pe:value _:b1 ];
    pe:uses
      _:step2,
      <<( ?__path_s_0 rdf:rest ?__path_o_0 )>>,
      <<( ?__path_s_1 rdf:rest ?__path_o_1 )>>,
      <<( ?__path_s_2 rdf:first ?__path_o_2 )>>.

  _:step7
    rdf:reifies <<( "Dewey" :hasIndex 1 )>>;
    pe:rule "list-iterate.srl";
    pe:line 17;
    pe:binding [ pe:var "list"; pe:value _:b1 ];
    pe:uses _:step4.

  _:step8
    rdf:reifies <<( :test :is true )>>;
    pe:rule "list-iterate.srl";
    pe:line 18;
    pe:uses _:step7.
}
