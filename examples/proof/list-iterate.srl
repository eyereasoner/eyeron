PREFIX : <urn:example:>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  _:b1 :iterate0 "Huey" .
  _:b1 :iterate1 "Dewey" .
  _:b1 :iterate2 "Louie" .
  "Dewey" :hasIndex 1 .
  :test :is true .

  _:step1
    rdf:reifies <<(_:b1 :iterate0 "Huey")>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "item"; pe:value "Huey" ],
      [ pe:var "list"; pe:value _:b1 ];
    pe:uses
      <<(:Let :param _:b1)>>,
      <<(_:b1 rdf:first "Huey")>>.

  _:step2
    rdf:reifies <<(_:b1 :iterate1 "Dewey")>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "item"; pe:value "Dewey" ],
      [ pe:var "list"; pe:value _:b1 ];
    pe:uses <<(:Let :param _:b1)>>.

  _:step3
    rdf:reifies <<(_:b1 :iterate2 "Louie")>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "item"; pe:value "Louie" ],
      [ pe:var "list"; pe:value _:b1 ];
    pe:uses <<(:Let :param _:b1)>>.

  _:step4
    rdf:reifies <<("Dewey" :hasIndex 1)>>;
    pe:rule "rule#4";
    pe:binding [ pe:var "list"; pe:value _:b1 ];
    pe:uses _:step2.

  _:step5
    rdf:reifies <<(:test :is true)>>;
    pe:rule "rule#5";
    pe:uses _:step4.
}
