PREFIX : <http://example.org/socrates#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

DATA {
  :Socrates a :Mortal .

  _:step1
    rdf:reifies <<(:Socrates a :Mortal)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "class"; pe:value :Human ],
      [ pe:var "individual"; pe:value :Socrates ],
      [ pe:var "superclass"; pe:value :Mortal ];
    pe:uses
      <<(:Socrates a :Human)>>,
      <<(:Human rdfs:subClassOf :Mortal)>>.
}
