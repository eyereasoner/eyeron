PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :bob :knownBy :alice .
  :bob :scoredFor 8 .
  :carol :knownBy :alice .
  :carol :scoredFor 8 .

  _:step1
    rdf:reifies <<(:bob :knownBy :alice)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "friend"; pe:value :bob ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      <<(:alice :knows :bob)>>,
      <<(:alice :score 8)>>.

  _:step2
    rdf:reifies <<(:bob :scoredFor 8)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "friend"; pe:value :bob ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      <<(:alice :knows :bob)>>,
      <<(:alice :score 8)>>.

  _:step3
    rdf:reifies <<(:carol :knownBy :alice)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "friend"; pe:value :carol ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      <<(:alice :knows :carol)>>,
      <<(:alice :score 8)>>.

  _:step4
    rdf:reifies <<(:carol :scoredFor 8)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "friend"; pe:value :carol ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      <<(:alice :knows :carol)>>,
      <<(:alice :score 8)>>.
}
