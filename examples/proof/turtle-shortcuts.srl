PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :bob :knownBy :alice .
  :bob :scoredFor 8 .
  :carol :knownBy :alice .
  :carol :scoredFor 8 .

  _:step1
    rdf:reifies <<( :bob :knownBy :alice )>>;
    pe:rule "turtle-shortcuts.srl";
    pe:line 9;
    pe:binding
      [ pe:var "friend"; pe:value :bob ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( :alice :knows :bob )>>;
    pe:fact "turtle-shortcuts.srl";
    pe:line 4.

  _:step3
    rdf:reifies <<( :alice :score 8 )>>;
    pe:fact "turtle-shortcuts.srl";
    pe:line 4.

  _:step4
    rdf:reifies <<( :bob :scoredFor 8 )>>;
    pe:rule "turtle-shortcuts.srl";
    pe:line 9;
    pe:binding
      [ pe:var "friend"; pe:value :bob ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      _:step2,
      _:step3.

  _:step5
    rdf:reifies <<( :carol :knownBy :alice )>>;
    pe:rule "turtle-shortcuts.srl";
    pe:line 9;
    pe:binding
      [ pe:var "friend"; pe:value :carol ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      _:step6,
      _:step3.

  _:step6
    rdf:reifies <<( :alice :knows :carol )>>;
    pe:fact "turtle-shortcuts.srl";
    pe:line 4.

  _:step7
    rdf:reifies <<( :carol :scoredFor 8 )>>;
    pe:rule "turtle-shortcuts.srl";
    pe:line 9;
    pe:binding
      [ pe:var "friend"; pe:value :carol ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      _:step6,
      _:step3.
}
