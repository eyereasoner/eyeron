@prefix : <http://example/> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:bob :knownBy :alice .
:bob :scoredFor 8 .
:carol :knownBy :alice .
:carol :scoredFor 8 .

{ :bob :knownBy :alice . } pe:why {
  { :bob :knownBy :alice . }
    pe:by [ pe:rule "turtle-shortcuts.n3"; pe:line 14 ];
    pe:binding
      [ pe:var "friend"; pe:value :bob ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      { :alice :knows :bob . },
      { :alice :score 8 . },
      { 8 math:notLessThan 5 . }.

  { :alice :knows :bob . }
    pe:by [ pe:fact "turtle-shortcuts.n3"; pe:line 9 ].

  { :alice :score 8 . }
    pe:by [ pe:fact "turtle-shortcuts.n3"; pe:line 9 ].

  { 8 math:notLessThan 5 . }
    pe:by [ pe:builtin math:notLessThan ].
}.

{ :bob :scoredFor 8 . } pe:why {
  { :bob :scoredFor 8 . }
    pe:by [ pe:rule "turtle-shortcuts.n3"; pe:line 14 ];
    pe:binding
      [ pe:var "friend"; pe:value :bob ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "score"; pe:value 8 ];
    pe:uses
      { :alice :knows :bob . },
      { :alice :score 8 . },
      { 8 math:notLessThan 5 . }.

  { :alice :knows :bob . }
    pe:by [ pe:fact "turtle-shortcuts.n3"; pe:line 9 ].

  { :alice :score 8 . }
    pe:by [ pe:fact "turtle-shortcuts.n3"; pe:line 9 ].

  { 8 math:notLessThan 5 . }
    pe:by [ pe:builtin math:notLessThan ].
}.

