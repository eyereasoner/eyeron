PREFIX : <http://example.org/control#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :c2 :inheritsRequirement :stabilityReq .
  :c2 :inheritsRequirement :trackingReq .
  :c2 :considers :leadCompensator .
  :c3 :considers :integralAction .
  :c2 :targets :overshootReq .
  :c3 :targets :disturbanceRejectionReq .
  :c1 :availableForFutureTuning :yes .
  :c1 :status :approvedController .
  :c2 :preserves :stabilityReq .
  :c2 :integrates :leadCompensator .
  :c2 :preserves :trackingReq .
  :c2 :satisfies :overshootReq .
  :c3 :satisfies :disturbanceRejectionReq .
  :c3 :integrates :integralAction .
  :c3 :inheritsRequirement :overshootReq .
  :c2 :satisfies :stabilityReq .
  :c2 :satisfies :trackingReq .
  :c2 :realizes :leadCompensator .
  :c3 :realizes :integralAction .
  :c3 :inheritsRequirement :stabilityReq .
  :c3 :inheritsRequirement :trackingReq .
  :c3 :preserves :overshootReq .
  :c2 :achieves :approvedController .
  :c2 :availableForFutureTuning :yes .
  :c3 :achieves :approvedController .
  :c3 :availableForFutureTuning :yes .
  :c3 :preserves :stabilityReq .
  :c3 :preserves :trackingReq .
  :c3 :satisfies :overshootReq .
  :c2 :status :approvedController .
  :c3 :status :approvedController .
  :c3 :satisfies :stabilityReq .
  :c3 :satisfies :trackingReq .

  _:step1
    rdf:reifies <<(:c2 :inheritsRequirement :stabilityReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :c1 ],
      [ pe:var "later"; pe:value :c2 ],
      [ pe:var "req"; pe:value :stabilityReq ];
    pe:uses
      <<(:c2 :derivesFrom :c1)>>,
      <<(:c1 :satisfies :stabilityReq)>>.

  _:step2
    rdf:reifies <<(:c2 :inheritsRequirement :trackingReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :c1 ],
      [ pe:var "later"; pe:value :c2 ],
      [ pe:var "req"; pe:value :trackingReq ];
    pe:uses
      <<(:c2 :derivesFrom :c1)>>,
      <<(:c1 :satisfies :trackingReq)>>.

  _:step3
    rdf:reifies <<(:c2 :considers :leadCompensator)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "goal"; pe:value :reduceOvershoot ],
      [ pe:var "strategy"; pe:value :leadCompensator ];
    pe:uses
      <<(:c2 :designGoal :reduceOvershoot)>>,
      <<(:reduceOvershoot :suggests :leadCompensator)>>.

  _:step4
    rdf:reifies <<(:c3 :considers :integralAction)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "goal"; pe:value :rejectDisturbance ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses
      <<(:c3 :designGoal :rejectDisturbance)>>,
      <<(:rejectDisturbance :suggests :integralAction)>>.

  _:step5
    rdf:reifies <<(:c2 :targets :overshootReq)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "goal"; pe:value :reduceOvershoot ],
      [ pe:var "req"; pe:value :overshootReq ];
    pe:uses
      <<(:c2 :designGoal :reduceOvershoot)>>,
      <<(:reduceOvershoot :introducesRequirement :overshootReq)>>.

  _:step6
    rdf:reifies <<(:c3 :targets :disturbanceRejectionReq)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "goal"; pe:value :rejectDisturbance ],
      [ pe:var "req"; pe:value :disturbanceRejectionReq ];
    pe:uses
      <<(:c3 :designGoal :rejectDisturbance)>>,
      <<(:rejectDisturbance :introducesRequirement :disturbanceRejectionReq)>>.

  _:step7
    rdf:reifies <<(:c1 :availableForFutureTuning :yes)>>;
    pe:rule 8;
    pe:binding
      [ pe:var "ctrl"; pe:value :c1 ],
      [ pe:var "strategy"; pe:value :baselinePID ];
    pe:uses <<(:c1 :realizes :baselinePID)>>.

  _:step8
    rdf:reifies <<(:c1 :status :approvedController)>>;
    pe:rule 9;
    pe:binding [ pe:var "ctrl"; pe:value :c1 ];
    pe:uses <<(:c1 :achieves :approvedController)>>.

  _:step9
    rdf:reifies <<(:c2 :preserves :stabilityReq)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "req"; pe:value :stabilityReq ],
      [ pe:var "strategy"; pe:value :leadCompensator ];
    pe:uses
      _:step1,
      _:step3,
      <<(:leadCompensator :compatibleWith :stabilityReq)>>.

  _:step10
    rdf:reifies <<(:c2 :integrates :leadCompensator)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "req"; pe:value :stabilityReq ],
      [ pe:var "strategy"; pe:value :leadCompensator ];
    pe:uses
      _:step1,
      _:step3,
      <<(:leadCompensator :compatibleWith :stabilityReq)>>.

  _:step11
    rdf:reifies <<(:c2 :preserves :trackingReq)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "req"; pe:value :trackingReq ],
      [ pe:var "strategy"; pe:value :leadCompensator ];
    pe:uses
      _:step2,
      _:step3,
      <<(:leadCompensator :compatibleWith :trackingReq)>>.

  _:step12
    rdf:reifies <<(:c2 :satisfies :overshootReq)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "req"; pe:value :overshootReq ],
      [ pe:var "strategy"; pe:value :leadCompensator ];
    pe:uses
      _:step5,
      _:step3,
      <<(:leadCompensator :enables :overshootReq)>>.

  _:step13
    rdf:reifies <<(:c3 :satisfies :disturbanceRejectionReq)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "req"; pe:value :disturbanceRejectionReq ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses
      _:step6,
      _:step4,
      <<(:integralAction :enables :disturbanceRejectionReq)>>.

  _:step14
    rdf:reifies <<(:c3 :integrates :integralAction)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "req"; pe:value :disturbanceRejectionReq ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses
      _:step6,
      _:step4,
      <<(:integralAction :enables :disturbanceRejectionReq)>>.

  _:step15
    rdf:reifies <<(:c3 :inheritsRequirement :overshootReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :c2 ],
      [ pe:var "later"; pe:value :c3 ],
      [ pe:var "req"; pe:value :overshootReq ];
    pe:uses
      <<(:c3 :derivesFrom :c2)>>,
      _:step12.

  _:step16
    rdf:reifies <<(:c2 :satisfies :stabilityReq)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "req"; pe:value :stabilityReq ];
    pe:uses _:step9.

  _:step17
    rdf:reifies <<(:c2 :satisfies :trackingReq)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "req"; pe:value :trackingReq ];
    pe:uses _:step11.

  _:step18
    rdf:reifies <<(:c2 :realizes :leadCompensator)>>;
    pe:rule 7;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "strategy"; pe:value :leadCompensator ];
    pe:uses _:step10.

  _:step19
    rdf:reifies <<(:c3 :realizes :integralAction)>>;
    pe:rule 7;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses _:step14.

  _:step20
    rdf:reifies <<(:c3 :inheritsRequirement :stabilityReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :c2 ],
      [ pe:var "later"; pe:value :c3 ],
      [ pe:var "req"; pe:value :stabilityReq ];
    pe:uses
      <<(:c3 :derivesFrom :c2)>>,
      _:step16.

  _:step21
    rdf:reifies <<(:c3 :inheritsRequirement :trackingReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :c2 ],
      [ pe:var "later"; pe:value :c3 ],
      [ pe:var "req"; pe:value :trackingReq ];
    pe:uses
      <<(:c3 :derivesFrom :c2)>>,
      _:step17.

  _:step22
    rdf:reifies <<(:c3 :preserves :overshootReq)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "req"; pe:value :overshootReq ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses
      _:step15,
      _:step4,
      <<(:integralAction :compatibleWith :overshootReq)>>.

  _:step23
    rdf:reifies <<(:c2 :achieves :approvedController)>>;
    pe:rule 8;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "strategy"; pe:value :leadCompensator ];
    pe:uses _:step18.

  _:step24
    rdf:reifies <<(:c2 :availableForFutureTuning :yes)>>;
    pe:rule 8;
    pe:binding
      [ pe:var "ctrl"; pe:value :c2 ],
      [ pe:var "strategy"; pe:value :leadCompensator ];
    pe:uses _:step18.

  _:step25
    rdf:reifies <<(:c3 :achieves :approvedController)>>;
    pe:rule 8;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses _:step19.

  _:step26
    rdf:reifies <<(:c3 :availableForFutureTuning :yes)>>;
    pe:rule 8;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses _:step19.

  _:step27
    rdf:reifies <<(:c3 :preserves :stabilityReq)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "req"; pe:value :stabilityReq ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses
      _:step20,
      _:step4,
      <<(:integralAction :compatibleWith :stabilityReq)>>.

  _:step28
    rdf:reifies <<(:c3 :preserves :trackingReq)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "req"; pe:value :trackingReq ],
      [ pe:var "strategy"; pe:value :integralAction ];
    pe:uses
      _:step21,
      _:step4,
      <<(:integralAction :compatibleWith :trackingReq)>>.

  _:step29
    rdf:reifies <<(:c3 :satisfies :overshootReq)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "req"; pe:value :overshootReq ];
    pe:uses _:step22.

  _:step30
    rdf:reifies <<(:c2 :status :approvedController)>>;
    pe:rule 9;
    pe:binding [ pe:var "ctrl"; pe:value :c2 ];
    pe:uses _:step23.

  _:step31
    rdf:reifies <<(:c3 :status :approvedController)>>;
    pe:rule 9;
    pe:binding [ pe:var "ctrl"; pe:value :c3 ];
    pe:uses _:step25.

  _:step32
    rdf:reifies <<(:c3 :satisfies :stabilityReq)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "req"; pe:value :stabilityReq ];
    pe:uses _:step27.

  _:step33
    rdf:reifies <<(:c3 :satisfies :trackingReq)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "ctrl"; pe:value :c3 ],
      [ pe:var "req"; pe:value :trackingReq ];
    pe:uses _:step28.
}
