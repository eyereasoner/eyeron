@prefix : <https://eyereasoner.github.io/eyepl/examples/spec-2-2-recursion#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:X :childOf :A .
:X :childOf :B .
:A :childOf :C .
:X :descendedFrom :A .
:X :descendedFrom :B .
:A :descendedFrom :C .
:X :descendedFrom :C .

{ :X :childOf :A . }
  pe:rule 1;
  pe:binding
    [ pe:var "x"; pe:value :X ],
    [ pe:var "y"; pe:value :A ];
  pe:uses { :A :fatherOf :X . }.

{ :A :fatherOf :X . }
  pe:fact "spec-2-2-recursion.n3".

{ :X :childOf :B . }
  pe:rule 2;
  pe:binding
    [ pe:var "x"; pe:value :X ],
    [ pe:var "y"; pe:value :B ];
  pe:uses { :B :motherOf :X . }.

{ :B :motherOf :X . }
  pe:fact "spec-2-2-recursion.n3".

{ :A :childOf :C . }
  pe:rule 2;
  pe:binding
    [ pe:var "x"; pe:value :A ],
    [ pe:var "y"; pe:value :C ];
  pe:uses { :C :motherOf :A . }.

{ :C :motherOf :A . }
  pe:fact "spec-2-2-recursion.n3".

{ :X :descendedFrom :A . }
  pe:rule 3;
  pe:binding
    [ pe:var "x"; pe:value :X ],
    [ pe:var "y"; pe:value :A ];
  pe:uses { :X :childOf :A . }.

{ :X :descendedFrom :B . }
  pe:rule 3;
  pe:binding
    [ pe:var "x"; pe:value :X ],
    [ pe:var "y"; pe:value :B ];
  pe:uses { :X :childOf :B . }.

{ :A :descendedFrom :C . }
  pe:rule 3;
  pe:binding
    [ pe:var "x"; pe:value :A ],
    [ pe:var "y"; pe:value :C ];
  pe:uses { :A :childOf :C . }.

{ :X :descendedFrom :C . }
  pe:rule 4;
  pe:binding
    [ pe:var "x"; pe:value :X ],
    [ pe:var "y"; pe:value :A ],
    [ pe:var "z"; pe:value :C ];
  pe:uses
    { :X :childOf :A . },
    { :A :descendedFrom :C . }.
