PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :ancestorOf :bob .
  :bob :ancestorOf :carol .
  :dora :ancestorOf :emma .
  :alice :ancestorOf :carol .

  _:step1
    rdf:reifies <<( :alice :ancestorOf :bob )>>;
    pe:rule "query.srl";
    pe:line 9;
    pe:binding
      [ pe:var "x"; pe:value :alice ],
      [ pe:var "y"; pe:value :bob ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :alice :parentOf :bob )>>;
    pe:fact "query.srl";
    pe:line 4.

  _:step3
    rdf:reifies <<( :bob :ancestorOf :carol )>>;
    pe:rule "query.srl";
    pe:line 9;
    pe:binding
      [ pe:var "x"; pe:value :bob ],
      [ pe:var "y"; pe:value :carol ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :bob :parentOf :carol )>>;
    pe:fact "query.srl";
    pe:line 5.

  _:step5
    rdf:reifies <<( :dora :ancestorOf :emma )>>;
    pe:rule "query.srl";
    pe:line 9;
    pe:binding
      [ pe:var "x"; pe:value :dora ],
      [ pe:var "y"; pe:value :emma ];
    pe:uses _:step6.

  _:step6
    rdf:reifies <<( :dora :parentOf :emma )>>;
    pe:fact "query.srl";
    pe:line 6.

  _:step7
    rdf:reifies <<( :alice :ancestorOf :carol )>>;
    pe:rule "query.srl";
    pe:line 10;
    pe:binding
      [ pe:var "x"; pe:value :alice ],
      [ pe:var "y"; pe:value :bob ],
      [ pe:var "z"; pe:value :carol ];
    pe:uses
      _:step2,
      _:step3.
}
