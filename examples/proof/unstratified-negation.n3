@prefix : <https://eyereasoner.github.io/eyepl/examples/unstratified-negation#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:alice a :In .

{ :alice a :In . } pe:why {
  { :alice a :In . }
    pe:by [ pe:rule "unstratified-negation.n3"; pe:line 19 ];
    pe:binding
      [ pe:var "SCOPE"; pe:value {
          <http://example.org/a> <http://example.org/b> <http://example.org/c> .
      } ],
      [ pe:var "x"; pe:value :alice ];
    pe:uses
      { :alice a :Person . },
      {
          {
              <http://example.org/a> <http://example.org/b> <http://example.org/c> .
          } log:notIncludes {
              :alice a :Out .
          } .
      }.

  { :alice a :Person . }
    pe:by [ pe:fact "unstratified-negation.n3"; pe:line 17 ].

  {
    {
        <http://example.org/a> <http://example.org/b> <http://example.org/c> .
    } log:notIncludes {
        :alice a :Out .
    } .
}
    pe:by [ pe:builtin log:notIncludes ].
}.