PREFIX : <http://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :result :is true .

  _:step1
    rdf:reifies <<( :result :is true )>>;
    pe:rule "log-for-all-in.srl";
    pe:line 22;
    pe:binding [ pe:var "c"; pe:value :c ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :c a :CompositeTask )>>;
    pe:fact "log-for-all-in.srl";
    pe:line 11.
}
