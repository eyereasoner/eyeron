PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :two :peanoValue :n1 .
  :fac0 :peanoValue :n1 .
  :addStep1 :peanoValue :n2 .
  :fac1 :peanoValue :n1 .
  :three :peanoValue :n3 .
  :fac2 :peanoValue :n2 .
  :facStep1 :peanoValue :n4 .
  :facStep2 :peanoValue :n5 .
  :fac3 :peanoValue :n6 .
  :test :three :n3 .
  :test :result :n6 .

  _:step1
    rdf:reifies <<( :two :peanoValue :n1 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 25;
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :n1 :succ :n0 )>>;
    pe:fact "peano-arithmetic.srl";
    pe:line 17.

  _:step3
    rdf:reifies <<( :fac0 :peanoValue :n1 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 29;
    pe:uses _:step2.

  _:step4
    rdf:reifies <<( :addStep1 :peanoValue :n2 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 26;
    pe:binding
      [ pe:var "a"; pe:value :n1 ],
      [ pe:var "m"; pe:value :n2 ];
    pe:uses
      _:step1,
      _:step5.

  _:step5
    rdf:reifies <<( :n2 :succ :n1 )>>;
    pe:fact "peano-arithmetic.srl";
    pe:line 18.

  _:step6
    rdf:reifies <<( :fac1 :peanoValue :n1 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 30;
    pe:uses _:step3.

  _:step7
    rdf:reifies <<( :three :peanoValue :n3 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 27;
    pe:binding
      [ pe:var "m"; pe:value :n2 ],
      [ pe:var "r"; pe:value :n3 ];
    pe:uses
      _:step4,
      _:step8.

  _:step8
    rdf:reifies <<( :n3 :succ :n2 )>>;
    pe:fact "peano-arithmetic.srl";
    pe:line 19.

  _:step9
    rdf:reifies <<( :fac2 :peanoValue :n2 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 31;
    pe:uses _:step6.

  _:step10
    rdf:reifies <<( :facStep1 :peanoValue :n4 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 32;
    pe:binding [ pe:var "m"; pe:value :n4 ];
    pe:uses
      _:step9,
      _:step11.

  _:step11
    rdf:reifies <<( :n4 :succ :n3 )>>;
    pe:fact "peano-arithmetic.srl";
    pe:line 20.

  _:step12
    rdf:reifies <<( :facStep2 :peanoValue :n5 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 33;
    pe:binding
      [ pe:var "m"; pe:value :n5 ],
      [ pe:var "p"; pe:value :n4 ];
    pe:uses
      _:step10,
      _:step13.

  _:step13
    rdf:reifies <<( :n5 :succ :n4 )>>;
    pe:fact "peano-arithmetic.srl";
    pe:line 21.

  _:step14
    rdf:reifies <<( :fac3 :peanoValue :n6 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 34;
    pe:binding
      [ pe:var "m"; pe:value :n6 ],
      [ pe:var "p"; pe:value :n5 ];
    pe:uses
      _:step12,
      _:step15.

  _:step15
    rdf:reifies <<( :n6 :succ :n5 )>>;
    pe:fact "peano-arithmetic.srl";
    pe:line 22.

  _:step16
    rdf:reifies <<( :test :three :n3 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 36;
    pe:binding
      [ pe:var "result"; pe:value :n6 ],
      [ pe:var "three"; pe:value :n3 ];
    pe:uses
      _:step7,
      _:step14.

  _:step17
    rdf:reifies <<( :test :result :n6 )>>;
    pe:rule "peano-arithmetic.srl";
    pe:line 36;
    pe:binding
      [ pe:var "result"; pe:value :n6 ],
      [ pe:var "three"; pe:value :n3 ];
    pe:uses
      _:step7,
      _:step14.
}
