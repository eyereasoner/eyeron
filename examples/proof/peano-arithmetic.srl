PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :two :peanoValue :n1 .
  :fac0 :peanoValue :n1 .
  :addStep1 :peanoValue :n2 .
  :fac1 :peanoValue :n1 .
  :three :peanoValue :n3 .
  :fac2 :peanoValue :n2 .
  :facStep1 :peanoValue :n4 .
  :facStep2 :peanoValue :n5 .
  :fac3 :peanoValue :n6 .
  :test :three :n3 .
  :test :result :n6 .

  _:step1
    rdf:reifies <<(:two :peanoValue :n1)>>;
    pe:rule 1;
    pe:uses <<(:n1 :succ :n0)>>.

  _:step2
    rdf:reifies <<(:fac0 :peanoValue :n1)>>;
    pe:rule 4;
    pe:uses <<(:n1 :succ :n0)>>.

  _:step3
    rdf:reifies <<(:addStep1 :peanoValue :n2)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "a"; pe:value :n1 ],
      [ pe:var "m"; pe:value :n2 ];
    pe:uses
      _:step1,
      <<(:n2 :succ :n1)>>.

  _:step4
    rdf:reifies <<(:fac1 :peanoValue :n1)>>;
    pe:rule 5;
    pe:uses _:step2.

  _:step5
    rdf:reifies <<(:three :peanoValue :n3)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "m"; pe:value :n2 ],
      [ pe:var "r"; pe:value :n3 ];
    pe:uses
      _:step3,
      <<(:n3 :succ :n2)>>.

  _:step6
    rdf:reifies <<(:fac2 :peanoValue :n2)>>;
    pe:rule 6;
    pe:uses _:step4.

  _:step7
    rdf:reifies <<(:facStep1 :peanoValue :n4)>>;
    pe:rule 7;
    pe:binding [ pe:var "m"; pe:value :n4 ];
    pe:uses
      _:step6,
      <<(:n4 :succ :n3)>>.

  _:step8
    rdf:reifies <<(:facStep2 :peanoValue :n5)>>;
    pe:rule 8;
    pe:binding
      [ pe:var "m"; pe:value :n5 ],
      [ pe:var "p"; pe:value :n4 ];
    pe:uses
      _:step7,
      <<(:n5 :succ :n4)>>.

  _:step9
    rdf:reifies <<(:fac3 :peanoValue :n6)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "m"; pe:value :n6 ],
      [ pe:var "p"; pe:value :n5 ];
    pe:uses
      _:step8,
      <<(:n6 :succ :n5)>>.

  _:step10
    rdf:reifies <<(:test :three :n3)>>;
    pe:rule 10;
    pe:binding
      [ pe:var "result"; pe:value :n6 ],
      [ pe:var "three"; pe:value :n3 ];
    pe:uses
      _:step5,
      _:step9.

  _:step11
    rdf:reifies <<(:test :result :n6)>>;
    pe:rule 10;
    pe:binding
      [ pe:var "result"; pe:value :n6 ],
      [ pe:var "three"; pe:value :n3 ];
    pe:uses
      _:step5,
      _:step9.
}
