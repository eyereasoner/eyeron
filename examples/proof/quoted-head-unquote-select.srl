PREFIX : <http://example.org/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :c a :Animal .
  :test :is true .

  _:step1
    rdf:reifies <<( :c a :Animal )>>;
    pe:rule "quoted-head-unquote-select.srl";
    pe:line 15;
    pe:binding [ pe:var "x"; pe:value :c ];
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( :c a :Cat )>>;
    pe:fact "quoted-head-unquote-select.srl";
    pe:line 12.

  _:step3
    rdf:reifies <<( :Cat :activates :ruleCat )>>;
    pe:fact "quoted-head-unquote-select.srl";
    pe:line 10.

  _:step4
    rdf:reifies <<( :test :is true )>>;
    pe:rule "quoted-head-unquote-select.srl";
    pe:line 17;
    pe:uses _:step1.
}
