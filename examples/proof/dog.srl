PREFIX : <http://example/eyeling/dog/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :mustHave :dogLicense .

  _:step1
    rdf:reifies <<(:alice :mustHave :dogLicense)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "d1"; pe:value :dog1 ],
      [ pe:var "d2"; pe:value :dog2 ],
      [ pe:var "d3"; pe:value :dog3 ],
      [ pe:var "d4"; pe:value :dog4 ],
      [ pe:var "d5"; pe:value :dog5 ],
      [ pe:var "person"; pe:value :alice ];
    pe:uses
      <<(:alice :hasDog :dog1)>>,
      <<(:alice :hasDog :dog2)>>,
      <<(:alice :hasDog :dog3)>>,
      <<(:alice :hasDog :dog4)>>,
      <<(:alice :hasDog :dog5)>>.
}
