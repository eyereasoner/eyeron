PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :ancestorOf :bob .
  :bob :ancestorOf :carol .
  :alice :ancestorOf :carol .

  _:step1
    rdf:reifies <<(:alice :ancestorOf :bob)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "x"; pe:value :alice ],
      [ pe:var "y"; pe:value :bob ];
    pe:uses <<(:alice :parentOf :bob)>>.

  _:step2
    rdf:reifies <<(:bob :ancestorOf :carol)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "x"; pe:value :bob ],
      [ pe:var "y"; pe:value :carol ];
    pe:uses <<(:bob :parentOf :carol)>>.

  _:step3
    rdf:reifies <<(:alice :ancestorOf :carol)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "x"; pe:value :alice ],
      [ pe:var "y"; pe:value :bob ],
      [ pe:var "z"; pe:value :carol ];
    pe:uses
      <<(:alice :parentOf :bob)>>,
      _:step2.
}
