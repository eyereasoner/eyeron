@prefix : <http://example.org/#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:H :trace 3 .
:H :det 2 .
:C :a11 0 .
:C :a12 -1 .
:C :a21 1 .
:C :a22 0 .
:C :nonzero "yes" .

{ :H :trace 3 . }
  pe:rule 1;
  pe:binding
    [ pe:var "h11"; pe:value 1 ],
    [ pe:var "h22"; pe:value 2 ],
    [ pe:var "tr"; pe:value 3 ];
  pe:uses
    { :H :a11 1 . },
    { :H :a22 2 . },
    { (1 2) math:sum 3 . }.

{ :H :a11 1 . }
  pe:fact "matrix-mechanics.n3".

{ :H :a22 2 . }
  pe:fact "matrix-mechanics.n3".

{ (1 2) math:sum 3 . }
  pe:builtin math:sum.

{ :H :det 2 . }
