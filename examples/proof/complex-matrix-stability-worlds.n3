    [ pe:var "a11abs"; pe:value "0"^^xsd:decimal ],
    [ pe:var "a11i"; pe:value 0 ],
    [ pe:var "a11r"; pe:value 0 ],
    [ pe:var "a12abs"; pe:value "1"^^xsd:decimal ],
    [ pe:var "a12i"; pe:value 0 ],
    [ pe:var "a12r"; pe:value 1 ],
    [ pe:var "a21abs"; pe:value "1"^^xsd:decimal ],
    [ pe:var "a21i"; pe:value 0 ],
    [ pe:var "a21r"; pe:value -1 ],
    [ pe:var "a22abs"; pe:value "0"^^xsd:decimal ],
    [ pe:var "a22i"; pe:value 0 ],
    [ pe:var "a22r"; pe:value 0 ],
    [ pe:var "g1"; pe:value "1"^^xsd:decimal ],
    [ pe:var "g2"; pe:value "1"^^xsd:decimal ];
  pe:uses
    { :Rotation a :Matrix2x2 . },
    { :Rotation :a11 (0 0) . },
    { :Rotation :a12 (1 0) . },
    { :Rotation :a21 (-1 0) . },
    { :Rotation :a22 (0 0) . },
    { (0 0) complex:abs "0"^^xsd:decimal . },
    { (0 0) complex:abs "0"^^xsd:decimal . },
    { (1 0) complex:abs "1"^^xsd:decimal . },
    { (-1 0) complex:abs "1"^^xsd:decimal . },
    { ("0"^^xsd:decimal "1"^^xsd:decimal) math:sum "1"^^xsd:decimal . },
    { ("0"^^xsd:decimal "1"^^xsd:decimal) math:sum "1"^^xsd:decimal . },
    { "1"^^xsd:decimal math:notLessThan "1"^^xsd:decimal . }.

{ (-1 0) complex:abs "1"^^xsd:decimal . }
  pe:rule 5;
  pe:binding
    [ pe:var "R"; pe:value "1"^^xsd:decimal ],
    [ pe:var "R2"; pe:value 1 ],
    [ pe:var "X"; pe:value -1 ],
    [ pe:var "X2"; pe:value 1 ],
    [ pe:var "Y"; pe:value 0 ],
    [ pe:var "Y2"; pe:value 0 ];
  pe:uses
    { (-1 2) math:exponentiation 1 . },
    { (0 2) math:exponentiation 0 . },
    { (1 0) math:sum 1 . },
    { (1 0.5) math:exponentiation "1"^^xsd:decimal . }.

{ (-1 2) math:exponentiation 1 . }
  pe:builtin math:exponentiation.

{ :Id :stableInWorld :W2 . }
  pe:rule 24;
  pe:binding
    [ pe:var "A"; pe:value :Id ],
    [ pe:var "d"; pe:value "1"^^xsd:decimal ];
  pe:uses
    { :Id :diagRadius "1"^^xsd:decimal . },
    { "1"^^xsd:decimal math:notGreaterThan 1.0 . }.

{ :Id :diagRadius "1"^^xsd:decimal . }
  pe:rule 17;
  pe:binding
    [ pe:var "A"; pe:value :Id ],
    [ pe:var "a11abs"; pe:value "1"^^xsd:decimal ],
    [ pe:var "a11i"; pe:value 0 ],
    [ pe:var "a11r"; pe:value 1 ],
    [ pe:var "a22abs"; pe:value "1"^^xsd:decimal ],
    [ pe:var "a22i"; pe:value 0 ],
    [ pe:var "a22r"; pe:value 1 ];
  pe:uses
    { :Id a :Matrix2x2 . },
    { :Id :a11 (1 0) . },
    { :Id :a22 (1 0) . },
    { (1 0) complex:abs "1"^^xsd:decimal . },
    { (1 0) complex:abs "1"^^xsd:decimal . },
    { "1"^^xsd:decimal math:notLessThan "1"^^xsd:decimal . }.

{ :DampedDiag :stableInWorld :W2 . }
  pe:rule 24;
  pe:binding
    [ pe:var "A"; pe:value :DampedDiag ],
    [ pe:var "d"; pe:value 0.8 ];
  pe:uses
    { :DampedDiag :diagRadius 0.8 . },
    { 0.8 math:notGreaterThan 1.0 . }.

{ :DampedDiag :diagRadius 0.8 . }
  pe:rule 17;
  pe:binding
    [ pe:var "A"; pe:value :DampedDiag ],
    [ pe:var "a11abs"; pe:value 0.8 ],
    [ pe:var "a11i"; pe:value 0 ],
    [ pe:var "a11r"; pe:value 0.8 ],
    [ pe:var "a22abs"; pe:value 0.7 ],
    [ pe:var "a22i"; pe:value 0 ],
    [ pe:var "a22r"; pe:value 0.7 ];
  pe:uses
    { :DampedDiag a :Matrix2x2 . },
    { :DampedDiag :a11 (0.8 0) . },
    { :DampedDiag :a22 (0.7 0) . },
    { (0.8 0) complex:abs 0.8 . },
    { (0.7 0) complex:abs 0.7 . },
    { 0.8 math:notLessThan 0.7 . }.

{ :Rotation :stableInWorld :W2 . }
  pe:rule 24;
  pe:binding
    [ pe:var "A"; pe:value :Rotation ],
    [ pe:var "d"; pe:value "0"^^xsd:decimal ];
  pe:uses
    { :Rotation :diagRadius "0"^^xsd:decimal . },
    { "0"^^xsd:decimal math:notGreaterThan 1.0 . }.

{ :Rotation :diagRadius "0"^^xsd:decimal . }
  pe:rule 17;
  pe:binding
    [ pe:var "A"; pe:value :Rotation ],
    [ pe:var "a11abs"; pe:value "0"^^xsd:decimal ],
    [ pe:var "a11i"; pe:value 0 ],
    [ pe:var "a11r"; pe:value 0 ],
    [ pe:var "a22abs"; pe:value "0"^^xsd:decimal ],
    [ pe:var "a22i"; pe:value 0 ],
    [ pe:var "a22r"; pe:value 0 ];
  pe:uses
    { :Rotation a :Matrix2x2 . },
    { :Rotation :a11 (0 0) . },
    { :Rotation :a22 (0 0) . },
    { (0 0) complex:abs "0"^^xsd:decimal . },
    { (0 0) complex:abs "0"^^xsd:decimal . },
    { "0"^^xsd:decimal math:notLessThan "0"^^xsd:decimal . }.

{ "0"^^xsd:decimal math:notLessThan "0"^^xsd:decimal . }
  pe:builtin math:notLessThan.

{ "0"^^xsd:decimal math:notGreaterThan 1.0 . }
  pe:builtin math:notGreaterThan.

{ :DampedDiag :dampedInWorld :W0 . }
  pe:rule 21;
  pe:binding
    [ pe:var "A"; pe:value :DampedDiag ],
