{ :doorStream a ldes:EventStream . }
  pe:rule 2;
  pe:binding
    [ pe:var "Bookmark"; pe:value 34 ],
    [ pe:var "ClosedAction"; pe:value "keep the compartment sealed and continue monitoring" ],
    [ pe:var "ClosedStateText"; pe:value "closed" ],
    [ pe:var "Envelope"; pe:value <urn:eyeron:rdf-message-stream:1:envelope:1> ],
    [ pe:var "OpenAction"; pe:value "dispatch an operator to inspect and close the door" ],
    [ pe:var "OpenStateText"; pe:value "open" ],
    [ pe:var "Payload"; pe:value <urn:eyeron:rdf-message-stream:1:payload:1> ],
    [ pe:var "PayloadContext"; pe:value {
        :doorStream a ldes:EventStream .
        :doorStream ldes:timestampPath :observedAt .
        :doorStream ldes:sequencePath :sequence .
        :doorStream tree:view :doorStreamPage .
        :doorStream :lastCommittedSequence 34 .
        :doorStream :currentWindowFromSequence 35 .
        :doorStream :windowSize 6 .
        :doorStream :repairPolicy :preferHigherPriority .
        :open :stateText "open" .
        :open :actionText "dispatch an operator to inspect and close the door" .
        :closed :stateText "closed" .
        :closed :actionText "keep the compartment sealed and continue monitoring" .
        in:run a see:InputDataset .
        in:run see:name "rdf_message_ldes_incremental" .
        in:run see:title "RDF Message LDES Incremental Repair" .
        in:run see:sourceFile "examples/rdf-message-ldes-incremental.n3" .
        in:run see:description "Forty LDES members serialized as RDF Messages; the rules use a sequence bookmark to reason only over the new tail." .
        in:run see:compiler "Eyeron RDF Message Log input" .
    } ],
    [ pe:var "WindowSize"; pe:value 6 ],
    [ pe:var "WindowStart"; pe:value 35 ];
  pe:uses
