{ (<urn:eyeron:rdf-message-stream:1:envelope:1> <urn:eyeron:rdf-message-stream:1:envelope:2> <urn:eyeron:rdf-message-stream:1:envelope:3> <urn:eyeron:rdf-message-stream:1:envelope:4> <urn:eyeron:rdf-message-stream:1:envelope:5> <urn:eyeron:rdf-message-stream:1:envelope:6> <urn:eyeron:rdf-message-stream:1:envelope:7> <urn:eyeron:rdf-message-stream:1:envelope:8> <urn:eyeron:rdf-message-stream:1:envelope:9> <urn:eyeron:rdf-message-stream:1:envelope:10> <urn:eyeron:rdf-message-stream:1:envelope:11> <urn:eyeron:rdf-message-stream:1:envelope:12> <urn:eyeron:rdf-message-stream:1:envelope:13> <urn:eyeron:rdf-message-stream:1:envelope:14> <urn:eyeron:rdf-message-stream:1:envelope:15> <urn:eyeron:rdf-message-stream:1:envelope:16> <urn:eyeron:rdf-message-stream:1:envelope:17> <urn:eyeron:rdf-message-stream:1:envelope:18> <urn:eyeron:rdf-message-stream:1:envelope:19> <urn:eyeron:rdf-message-stream:1:envelope:20> <urn:eyeron:rdf-message-stream:1:envelope:21> <urn:eyeron:rdf-message-stream:1:envelope:22> <urn:eyeron:rdf-message-stream:1:envelope:23> <urn:eyeron:rdf-message-stream:1:envelope:24> <urn:eyeron:rdf-message-stream:1:envelope:25> <urn:eyeron:rdf-message-stream:1:envelope:26> <urn:eyeron:rdf-message-stream:1:envelope:27> <urn:eyeron:rdf-message-stream:1:envelope:28> <urn:eyeron:rdf-message-stream:1:envelope:29> <urn:eyeron:rdf-message-stream:1:envelope:30> <urn:eyeron:rdf-message-stream:1:envelope:31> <urn:eyeron:rdf-message-stream:1:envelope:32> <urn:eyeron:rdf-message-stream:1:envelope:33> <urn:eyeron:rdf-message-stream:1:envelope:34> <urn:eyeron:rdf-message-stream:1:envelope:35> <urn:eyeron:rdf-message-stream:1:envelope:36> <urn:eyeron:rdf-message-stream:1:envelope:37> <urn:eyeron:rdf-message-stream:1:envelope:38> <urn:eyeron:rdf-message-stream:1:envelope:39> <urn:eyeron:rdf-message-stream:1:envelope:40> <urn:eyeron:rdf-message-stream:1:envelope:41>) list:length 41 . }
