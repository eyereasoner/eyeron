PREFIX : <http://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :e2_e_mul_e2 :holds true .
  :e2_e_mul_e :holds true .
  :result :uniqueIdentity :e2 .

  _:step1
    rdf:reifies <<( :e2_e_mul_e2 :holds true )>>;
    pe:rule "monoid-identity-uniqueness.srl";
    pe:line 15;
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :e2 :inG true )>>;
    pe:fact "monoid-identity-uniqueness.srl";
    pe:line 13.

  _:step3
    rdf:reifies <<( :e2_e_mul_e :holds true )>>;
    pe:rule "monoid-identity-uniqueness.srl";
    pe:line 16;
    pe:uses
      _:step4,
      _:step5.

  _:step4
    rdf:reifies <<( :e2 :candidateIdentity true )>>;
    pe:fact "monoid-identity-uniqueness.srl";
    pe:line 13.

  _:step5
    rdf:reifies <<( :e :inG true )>>;
    pe:fact "monoid-identity-uniqueness.srl";
    pe:line 13.

  _:step6
    rdf:reifies <<( :result :uniqueIdentity :e2 )>>;
    pe:rule "monoid-identity-uniqueness.srl";
    pe:line 18;
    pe:uses
      _:step1,
      _:step3.
}
