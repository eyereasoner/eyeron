PREFIX : <http://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :e2_e_mul_e2 :holds true .
  :e2_e_mul_e :holds true .
  :result :uniqueIdentity :e2 .

  _:step1
    rdf:reifies <<(:e2_e_mul_e2 :holds true)>>;
    pe:rule 1;
    pe:uses <<(:e2 :inG true)>>.

  _:step2
    rdf:reifies <<(:e2_e_mul_e :holds true)>>;
    pe:rule 2;
    pe:uses
      <<(:e2 :candidateIdentity true)>>,
      <<(:e :inG true)>>.

  _:step3
    rdf:reifies <<(:result :uniqueIdentity :e2)>>;
    pe:rule 3;
    pe:uses
      _:step1,
      _:step2.
}
