    { :PermitHealthcareResearch odrl:target :LabResult . },
    { :PermitHealthcareResearch odrl:action dpv:Use . },
    { :PermitHealthcareResearch odrl:constraint :HealthcarePurpose . },
    { :PermitHealthcareResearch odrl:constraint :MinTrust . },
    { :HealthcarePurpose odrl:leftOperand fpv:purpose . },
    { :HealthcarePurpose odrl:operator odrl:isA . },
    { :HealthcarePurpose odrl:rightOperand dpv:Healthcare . },
    { :MinTrust odrl:leftOperand fpv:sourceTrust . },
    { :MinTrust odrl:operator odrl:gteq . },
    { :MinTrust odrl:rightOperand 0.80 . },
    { 0.92 math:notLessThan 0.80 . }.

