{ :FlowAds fpv:decision fpv:deny . }
  pe:rule 3;
  pe:binding
    [ pe:var "action"; pe:value dpv:Share ],
    [ pe:var "data"; pe:value :LabResult ],
    [ pe:var "flow"; pe:value :FlowAds ],
    [ pe:var "prohibition"; pe:value :ProhibitMarketingDisclosure ],
    [ pe:var "purpose"; pe:value dpv:Marketing ],
    [ pe:var "purposeConstraint"; pe:value :MarketingPurpose ],
    [ pe:var "recipient"; pe:value :AdNetwork ];
  pe:uses
    { :FlowAds a fpv:DataFlow . },
    { :FlowAds fpv:recipient :AdNetwork . },
    { :FlowAds fpv:data :LabResult . },
    { :FlowAds fpv:processing dpv:Share . },
    { :FlowAds fpv:purpose dpv:Marketing . },
    { :TrustPolicy odrl:prohibition :ProhibitMarketingDisclosure . },
    { :ProhibitMarketingDisclosure odrl:assignee :AdNetwork . },
    { :ProhibitMarketingDisclosure odrl:target :LabResult . },
    { :ProhibitMarketingDisclosure odrl:action dpv:Share . },
    { :ProhibitMarketingDisclosure odrl:constraint :MarketingPurpose . },
    { :MarketingPurpose odrl:leftOperand fpv:purpose . },
    { :MarketingPurpose odrl:operator odrl:isA . },
    { :MarketingPurpose odrl:rightOperand dpv:Marketing . }.

