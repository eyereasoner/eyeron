PREFIX : <http://example.org/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :result :is true .

  _:step1
    rdf:reifies <<( :result :is true )>>;
    pe:rule "rdf-list.srl";
    pe:line 9;
    pe:binding [ pe:var "Y"; pe:value _:b1 ];
    pe:uses
      _:step2,
      _:step3,
      <<( ?__path_s_0 rdf:rest ?__path_o_0 )>>,
      <<( ?__path_s_1 rdf:first ?__path_o_1 )>>,
      <<( ?__path_s_0 rdf:rest ?__path_o_0 )>>,
      <<( ?__path_s_1 rdf:rest ?__path_o_1 )>>.

  _:step2
    rdf:reifies <<( :X :val _:b1 )>>;
    pe:fact "rdf-list.srl";
    pe:line 7.

  _:step3
    rdf:reifies <<( _:b1 rdf:first 1 )>>;
    pe:fact "rdf-list.srl";
    pe:line 7.

  _:step4
    rdf:reifies <<( _:b1 rdf:rest _:b2 )>>;
    pe:fact "rdf-list.srl";
    pe:line 7.
}
