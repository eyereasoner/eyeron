PREFIX : <http://example.org/euler-identity#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :phasePi :exactRe -1 .
  :phasePi :exactIm 0 .
  :EulerIdentity :lhsRe 0 .
  :EulerIdentity :lhsIm 0 .
  :phasePi :modSq 1 .
  :EulerIdentity :holds true .
  :phasePi :modSqIsOne true .

  _:step1
    rdf:reifies <<(:phasePi :exactRe -1)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "re"; pe:value -1 ],
      [ pe:var "x"; pe:value 0 ],
      [ pe:var "y"; pe:value 0 ];
    pe:uses
      <<(:phasePi :re 0)>>,
      <<(:phasePi :im 0)>>.

  _:step2
    rdf:reifies <<(:phasePi :exactIm 0)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "re"; pe:value -1 ],
      [ pe:var "x"; pe:value 0 ],
      [ pe:var "y"; pe:value 0 ];
    pe:uses
      <<(:phasePi :re 0)>>,
      <<(:phasePi :im 0)>>.

  _:step3
    rdf:reifies <<(:EulerIdentity :lhsRe 0)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "re"; pe:value -1 ],
      [ pe:var "sumIm"; pe:value 0 ],
      [ pe:var "sumRe"; pe:value 0 ];
    pe:uses
      _:step1,
      _:step2.

  _:step4
    rdf:reifies <<(:EulerIdentity :lhsIm 0)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "re"; pe:value -1 ],
      [ pe:var "sumIm"; pe:value 0 ],
      [ pe:var "sumRe"; pe:value 0 ];
    pe:uses
      _:step1,
      _:step2.

  _:step5
    rdf:reifies <<(:phasePi :modSq 1)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "m"; pe:value 1 ],
      [ pe:var "re"; pe:value -1 ];
    pe:uses
      _:step1,
      _:step2.

  _:step6
    rdf:reifies <<(:EulerIdentity :holds true)>>;
    pe:rule "rule#3";
    pe:uses
      _:step3,
      _:step4.

  _:step7
    rdf:reifies <<(:phasePi :modSqIsOne true)>>;
    pe:rule "rule#5";
    pe:uses _:step5.
}
