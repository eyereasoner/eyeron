PREFIX : <http://example.org/euler-identity#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :phasePi :exactRe -1 .
  :phasePi :exactIm 0 .
  :EulerIdentity :lhsRe 0 .
  :EulerIdentity :lhsIm 0 .
  :phasePi :modSq 1 .
  :EulerIdentity :holds true .
  :phasePi :modSqIsOne true .

  _:step1
    rdf:reifies <<( :phasePi :exactRe -1 )>>;
    pe:rule "euler-identity.srl";
    pe:line 12;
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "re"; pe:value -1 ],
      [ pe:var "x"; pe:value 0 ],
      [ pe:var "y"; pe:value 0 ];
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( :phasePi :re 0 )>>;
    pe:fact "euler-identity.srl";
    pe:line 9.

  _:step3
    rdf:reifies <<( :phasePi :im 0 )>>;
    pe:fact "euler-identity.srl";
    pe:line 9.

  _:step4
    rdf:reifies <<( :phasePi :exactIm 0 )>>;
    pe:rule "euler-identity.srl";
    pe:line 12;
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "re"; pe:value -1 ],
      [ pe:var "x"; pe:value 0 ],
      [ pe:var "y"; pe:value 0 ];
    pe:uses
      _:step2,
      _:step3.

  _:step5
    rdf:reifies <<( :EulerIdentity :lhsRe 0 )>>;
    pe:rule "euler-identity.srl";
    pe:line 18;
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "re"; pe:value -1 ],
      [ pe:var "sumIm"; pe:value 0 ],
      [ pe:var "sumRe"; pe:value 0 ];
    pe:uses
      _:step1,
      _:step4.

  _:step6
    rdf:reifies <<( :EulerIdentity :lhsIm 0 )>>;
    pe:rule "euler-identity.srl";
    pe:line 18;
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "re"; pe:value -1 ],
      [ pe:var "sumIm"; pe:value 0 ],
      [ pe:var "sumRe"; pe:value 0 ];
    pe:uses
      _:step1,
      _:step4.

  _:step7
    rdf:reifies <<( :phasePi :modSq 1 )>>;
    pe:rule "euler-identity.srl";
    pe:line 28;
    pe:binding
      [ pe:var "im"; pe:value 0 ],
      [ pe:var "m"; pe:value 1 ],
      [ pe:var "re"; pe:value -1 ];
    pe:uses
      _:step1,
      _:step4.

  _:step8
    rdf:reifies <<( :EulerIdentity :holds true )>>;
    pe:rule "euler-identity.srl";
    pe:line 24;
    pe:uses
      _:step5,
      _:step6.

  _:step9
    rdf:reifies <<( :phasePi :modSqIsOne true )>>;
    pe:rule "euler-identity.srl";
    pe:line 35;
    pe:uses _:step7.
}
