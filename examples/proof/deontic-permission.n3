        }) log:forAllIn _:forAllIn .
    }.

{
  {
      :s2 :p2 :o2 .
  } log:holdsIn :w1 .
}
  pe:fact "deontic-permission.n3".

{
  ({
      :w1 log:hasAccessTo ?W2 .
  } {
      {
          :s2 :p2 :o2 .
      } log:holdsIn ?W2 .
  }) log:forAllIn _:forAllIn .
}
  pe:builtin log:forAllIn.

{
  {
      :s1 :p1 :o1 .
  } log:isObligatoryIn :w2 .
}
  pe:rule 1;
  pe:binding
    [ pe:var "P"; pe:value {
        :s1 :p1 :o1 .
    } ],
    [ pe:var "Sc"; pe:value _:forAllIn ],
    [ pe:var "W"; pe:value :w3 ],
    [ pe:var "W1"; pe:value :w2 ];
  pe:uses
    { :w2 log:hasAccessTo :w3 . },
    {
        {
            :s1 :p1 :o1 .
        } log:holdsIn :w2 .
    },
    {
        ({
            :w2 log:hasAccessTo ?W2 .
        } {
            {
                :s1 :p1 :o1 .
            } log:holdsIn ?W2 .
        }) log:forAllIn _:forAllIn .
    }.

{
  ({
      :w2 log:hasAccessTo ?W2 .
  } {
      {
          :s1 :p1 :o1 .
      } log:holdsIn ?W2 .
  }) log:forAllIn _:forAllIn .
}
  pe:builtin log:forAllIn.

{
  {
      :s2 :p2 :o2 .
  } log:isObligatoryIn :w2 .
}
  pe:rule 1;
  pe:binding
    [ pe:var "P"; pe:value {
        :s2 :p2 :o2 .
    } ],
    [ pe:var "Sc"; pe:value _:forAllIn ],
    [ pe:var "W"; pe:value :w3 ],
    [ pe:var "W1"; pe:value :w2 ];
  pe:uses
    { :w2 log:hasAccessTo :w3 . },
    {
        {
            :s2 :p2 :o2 .
        } log:holdsIn :w2 .
    },
    {
        ({
            :w2 log:hasAccessTo ?W2 .
        } {
            {
                :s2 :p2 :o2 .
            } log:holdsIn ?W2 .
        }) log:forAllIn _:forAllIn .
    }.

{
  ({
      :w2 log:hasAccessTo ?W2 .
  } {
      {
          :s2 :p2 :o2 .
      } log:holdsIn ?W2 .
  }) log:forAllIn _:forAllIn .
}
  pe:builtin log:forAllIn.

{
  {
      {
          :s3 :p3 :o3 .
      } => false .
  } log:isObligatoryIn :w2 .
}
  pe:rule 1;
  pe:binding
    [ pe:var "P"; pe:value {
        {
            :s3 :p3 :o3 .
        } => false .
    } ],
    [ pe:var "Sc"; pe:value _:forAllIn ],
    [ pe:var "W"; pe:value :w3 ],
    [ pe:var "W1"; pe:value :w2 ];
  pe:uses
