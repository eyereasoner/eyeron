PREFIX : <https://eyereasoner.github.io/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :test :is true .

  _:step1
    rdf:reifies <<(:test :is true)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "x"; pe:value :Minka ],
      [ pe:var "y"; pe:value :Charly ];
    pe:uses
      <<(:Minka a :Cat)>>,
      <<(:Charly a :Dog)>>.
}
