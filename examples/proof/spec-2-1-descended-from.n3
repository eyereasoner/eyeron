@prefix : <https://eyereasoner.github.io/eyepl/examples/spec-2-1-descended-from#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:X :childOf :A .
:X :childOf :B .
:A :childOf :C .
:X :descendedFrom :A .
:X :descendedFrom :B .
:A :descendedFrom :C .

{ :X :childOf :A . } pe:why {
  { :X :childOf :A . }
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :A ];
    pe:uses { :A :fatherOf :X . }.

  { :A :fatherOf :X . }
    pe:fact "spec-2-1-descended-from.n3".
}.

{ :X :childOf :B . } pe:why {
  { :X :childOf :B . }
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :B ];
    pe:uses { :B :motherOf :X . }.

  { :B :motherOf :X . }
    pe:fact "spec-2-1-descended-from.n3".
}.

{ :A :childOf :C . } pe:why {
  { :A :childOf :C . }
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :A ],
      [ pe:var "y"; pe:value :C ];
    pe:uses { :C :motherOf :A . }.

  { :C :motherOf :A . }
    pe:fact "spec-2-1-descended-from.n3".
}.

{ :X :descendedFrom :A . } pe:why {
  { :X :descendedFrom :A . }
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :A ];
    pe:uses { :X :childOf :A . }.

  { :X :childOf :A . }
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :A ];
    pe:uses { :A :fatherOf :X . }.

  { :A :fatherOf :X . }
    pe:fact "spec-2-1-descended-from.n3".
}.

{ :X :descendedFrom :B . } pe:why {
  { :X :descendedFrom :B . }
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :B ];
    pe:uses { :X :childOf :B . }.

  { :X :childOf :B . }
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :B ];
    pe:uses { :B :motherOf :X . }.

  { :B :motherOf :X . }
    pe:fact "spec-2-1-descended-from.n3".
}.

{ :A :descendedFrom :C . } pe:why {
  { :A :descendedFrom :C . }
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :A ],
      [ pe:var "y"; pe:value :C ];
    pe:uses { :A :childOf :C . }.

  { :A :childOf :C . }
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :A ],
      [ pe:var "y"; pe:value :C ];
    pe:uses { :C :motherOf :A . }.

  { :C :motherOf :A . }
    pe:fact "spec-2-1-descended-from.n3".
}.
