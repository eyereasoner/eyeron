    [ pe:var "md"; pe:value "Require an EHDS Health Data Request for statistically anonymised data (eu-ehds:HealthDataRequest), and add a constraint that secondary-use data must be statistically anonymised." ],
    [ pe:var "mline"; pe:value "- **Mitigation for clause H4:** Require an EHDS Health Data Request for statistically anonymised data (eu-ehds:HealthDataRequest), and add a constraint that secondary-use data must be statistically anonymised.\n\n" ],
    [ pe:var "r"; pe:value _:riskH4_cece88d41ac6b3e0 ],
    [ pe:var "score"; pe:value 80 ];
