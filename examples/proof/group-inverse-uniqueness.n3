@prefix : <http://example.org/#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

(:e :x) :mul :x .
(:x :e) :mul :x .
(:x :i) :mul :e .
(:i :x) :mul :e .
(:x :j) :mul :e .
(:j :x) :mul :e .
(:e :i) :mul :i .
(:i :e) :mul :i .
(:e :j) :mul :j .
(:j :e) :mul :j .
(:e :e) :mul :e .
(:x :x) :sameTerm true .
(:e :e) :sameTerm true .
(:i :i) :sameTerm true .
(:i :j) :sameTerm true .
(:j :i) :sameTerm true .
(:j :j) :sameTerm true .
(:x :i :i) :sameInverse true .
(:x :i :j) :sameInverse true .
(:x :j :i) :sameInverse true .
(:x :j :j) :sameInverse true .

{ (:e :x) :mul :x . }
  pe:rule 3;
  pe:binding [ pe:var "a"; pe:value :x ];
  pe:uses { :x :inG true . }.

{ :x :inG true . }
  pe:fact "group-inverse-uniqueness.n3".

{ (:x :e) :mul :x . }
  pe:rule 4;
  pe:binding [ pe:var "a"; pe:value :x ];
  pe:uses { :x :inG true . }.

{ (:x :i) :mul :e . }
  pe:rule 5;
  pe:binding
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :i ];
  pe:uses
    { :x :inG true . },
    { :i :inG true . },
    { :i :inverseOf :x . }.

{ :i :inG true . }
  pe:fact "group-inverse-uniqueness.n3".

{ :i :inverseOf :x . }
  pe:fact "group-inverse-uniqueness.n3".

{ (:i :x) :mul :e . }
  pe:rule 5;
  pe:binding
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :i ];
  pe:uses
    { :x :inG true . },
    { :i :inG true . },
    { :i :inverseOf :x . }.

{ (:x :j) :mul :e . }
  pe:rule 5;
  pe:binding
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :j ];
  pe:uses
    { :x :inG true . },
    { :j :inG true . },
    { :j :inverseOf :x . }.

{ :j :inG true . }
  pe:fact "group-inverse-uniqueness.n3".

{ :j :inverseOf :x . }
  pe:fact "group-inverse-uniqueness.n3".

{ (:j :x) :mul :e . }
  pe:rule 5;
  pe:binding
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :j ];
  pe:uses
    { :x :inG true . },
    { :j :inG true . },
    { :j :inverseOf :x . }.

{ (:e :i) :mul :i . }
  pe:rule 3;
  pe:binding [ pe:var "a"; pe:value :i ];
  pe:uses { :i :inG true . }.

{ (:i :e) :mul :i . }
  pe:rule 4;
  pe:binding [ pe:var "a"; pe:value :i ];
  pe:uses { :i :inG true . }.

{ (:e :j) :mul :j . }
  pe:rule 3;
  pe:binding [ pe:var "a"; pe:value :j ];
  pe:uses { :j :inG true . }.

{ (:j :e) :mul :j . }
  pe:rule 4;
  pe:binding [ pe:var "a"; pe:value :j ];
  pe:uses { :j :inG true . }.

{ (:e :e) :mul :e . }
  pe:rule 3;
  pe:binding [ pe:var "a"; pe:value :e ];
  pe:uses { :e :inG true . }.

{ :e :inG true . }
  pe:fact "group-inverse-uniqueness.n3".

{ (:x :x) :sameTerm true . }
  pe:rule 1;
  pe:binding
    [ pe:var "a"; pe:value :e ],
    [ pe:var "ab"; pe:value :x ],
    [ pe:var "b"; pe:value :x ],
    [ pe:var "bc"; pe:value :x ],
    [ pe:var "c"; pe:value :e ],
    [ pe:var "left"; pe:value :x ],
    [ pe:var "right"; pe:value :x ];
  pe:uses
    { (:e :x) :mul :x . },
    { (:x :e) :mul :x . },
    { (:x :e) :mul :x . },
    { (:e :x) :mul :x . }.

{ (:e :e) :sameTerm true . }
  pe:rule 1;
  pe:binding
    [ pe:var "a"; pe:value :e ],
    [ pe:var "ab"; pe:value :x ],
    [ pe:var "b"; pe:value :x ],
    [ pe:var "bc"; pe:value :e ],
    [ pe:var "c"; pe:value :i ],
    [ pe:var "left"; pe:value :e ],
    [ pe:var "right"; pe:value :e ];
  pe:uses
    { (:e :x) :mul :x . },
    { (:x :i) :mul :e . },
    { (:x :i) :mul :e . },
    { (:e :e) :mul :e . }.

{ (:i :i) :sameTerm true . }
  pe:rule 1;
  pe:binding
    [ pe:var "a"; pe:value :i ],
    [ pe:var "ab"; pe:value :e ],
    [ pe:var "b"; pe:value :x ],
    [ pe:var "bc"; pe:value :e ],
    [ pe:var "c"; pe:value :i ],
    [ pe:var "left"; pe:value :i ],
    [ pe:var "right"; pe:value :i ];
  pe:uses
    { (:i :x) :mul :e . },
    { (:e :i) :mul :i . },
    { (:x :i) :mul :e . },
    { (:i :e) :mul :i . }.

{ (:i :j) :sameTerm true . }
  pe:rule 1;
  pe:binding
    [ pe:var "a"; pe:value :j ],
    [ pe:var "ab"; pe:value :e ],
    [ pe:var "b"; pe:value :x ],
    [ pe:var "bc"; pe:value :e ],
    [ pe:var "c"; pe:value :i ],
    [ pe:var "left"; pe:value :i ],
    [ pe:var "right"; pe:value :j ];
  pe:uses
    { (:j :x) :mul :e . },
    { (:e :i) :mul :i . },
    { (:x :i) :mul :e . },
    { (:j :e) :mul :j . }.

{ (:j :i) :sameTerm true . }
  pe:rule 1;
  pe:binding
    [ pe:var "a"; pe:value :i ],
    [ pe:var "ab"; pe:value :e ],
    [ pe:var "b"; pe:value :x ],
    [ pe:var "bc"; pe:value :e ],
    [ pe:var "c"; pe:value :j ],
    [ pe:var "left"; pe:value :j ],
    [ pe:var "right"; pe:value :i ];
  pe:uses
    { (:i :x) :mul :e . },
    { (:e :j) :mul :j . },
    { (:x :j) :mul :e . },
    { (:i :e) :mul :i . }.

{ (:j :j) :sameTerm true . }
  pe:rule 1;
  pe:binding
    [ pe:var "a"; pe:value :j ],
    [ pe:var "ab"; pe:value :e ],
    [ pe:var "b"; pe:value :x ],
    [ pe:var "bc"; pe:value :e ],
    [ pe:var "c"; pe:value :j ],
    [ pe:var "left"; pe:value :j ],
    [ pe:var "right"; pe:value :j ];
  pe:uses
    { (:j :x) :mul :e . },
    { (:e :j) :mul :j . },
    { (:x :j) :mul :e . },
    { (:j :e) :mul :j . }.

{ (:x :i :i) :sameInverse true . }
  pe:rule 6;
  pe:binding
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :i ],
    [ pe:var "z"; pe:value :i ];
  pe:uses
    { :i :inverseOf :x . },
    { :i :inverseOf :x . },
    { (:i :i) :sameTerm true . }.

{ (:x :i :j) :sameInverse true . }
  pe:rule 6;
  pe:binding
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :i ],
    [ pe:var "z"; pe:value :j ];
  pe:uses
    { :i :inverseOf :x . },
    { :j :inverseOf :x . },
    { (:i :j) :sameTerm true . }.

{ (:x :j :i) :sameInverse true . }
  pe:rule 6;
  pe:binding
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :j ],
    [ pe:var "z"; pe:value :i ];
  pe:uses
    { :j :inverseOf :x . },
    { :i :inverseOf :x . },
    { (:j :i) :sameTerm true . }.

{ (:x :j :j) :sameInverse true . }
  pe:rule 6;
  pe:binding
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :j ],
    [ pe:var "z"; pe:value :j ];
  pe:uses
    { :j :inverseOf :x . },
    { :j :inverseOf :x . },
    { (:j :j) :sameTerm true . }.
