PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :ancestor :bob .
  :bob :ancestor :carol .
  :carol :ancestor :dana .
  :alice :ancestor :carol .
  :bob :ancestor :dana .
  :alice :ancestor :dana .

  _:step1
    rdf:reifies <<(:alice :ancestor :bob)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :alice ],
      [ pe:var "y"; pe:value :bob ];
    pe:uses <<(:alice :parent :bob)>>.

  _:step2
    rdf:reifies <<(:bob :ancestor :carol)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :bob ],
      [ pe:var "y"; pe:value :carol ];
    pe:uses <<(:bob :parent :carol)>>.

  _:step3
    rdf:reifies <<(:carol :ancestor :dana)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :carol ],
      [ pe:var "y"; pe:value :dana ];
    pe:uses <<(:carol :parent :dana)>>.

  _:step4
    rdf:reifies <<(:alice :ancestor :carol)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :alice ],
      [ pe:var "y"; pe:value :bob ],
      [ pe:var "z"; pe:value :carol ];
    pe:uses
      <<(:alice :parent :bob)>>,
      _:step2.

  _:step5
    rdf:reifies <<(:bob :ancestor :dana)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :bob ],
      [ pe:var "y"; pe:value :carol ],
      [ pe:var "z"; pe:value :dana ];
    pe:uses
      <<(:bob :parent :carol)>>,
      _:step3.

  _:step6
    rdf:reifies <<(:alice :ancestor :dana)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :alice ],
      [ pe:var "y"; pe:value :bob ],
      [ pe:var "z"; pe:value :dana ];
    pe:uses
      <<(:alice :parent :bob)>>,
      _:step5.
}
