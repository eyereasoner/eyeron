          ?Org :employs ?P .
      } .
  } log:includes {
      {
          ?P :parentOf ?Q .
      } => {
          ?Q :childOf ?P .
      } .
  } .
}
  pe:builtin log:includes.

{
  {
      {
          ?X a ?C .
          ?C rdfs:subClassOf ?D .
      } => {
          ?X a ?D .
      } .
      {
          ?Org :employs ?P .
      } => {
          ?P :worksFor ?Org .
      } .
      {
          ?P :mentors ?Q .
      } => {
          ?Q :menteeOf ?P .
      } .
  } log:notIncludes {
      {
          ?P :parentOf ?Q .
      } => {
          ?Q :childOf ?P .
      } .
  } .
}
  pe:builtin log:notIncludes.

