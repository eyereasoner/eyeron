@prefix : <http://example.org/ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:result :is true .

{ :result :is true . }
  pe:rule 3;
  pe:binding
    [ pe:var "H"; pe:value 1 ],
    [ pe:var "T"; pe:value (2) ],
    [ pe:var "X"; pe:value :X ],
    [ pe:var "Y"; pe:value (1 2) ];
  pe:uses
    { :X :val (1 2) . },
    { (1 2) :head 1 . },
    { (1 2) :tail (2) . },
    { 1 log:equalTo 1 . },
    { (2) log:equalTo (2) . }.

{ :X :val (1 2) . }
  pe:fact "rdf-list.n3".

{ (1 2) :head 1 . }
  pe:rule 1;
  pe:binding
    [ pe:var "X"; pe:value (1 2) ],
    [ pe:var "Y"; pe:value 1 ];
  pe:uses { (1 2) rdf:first 1 . }.

{ (1 2) rdf:first 1 . }
  pe:builtin rdf:first.

{ (1 2) :tail (2) . }
  pe:rule 2;
  pe:binding
    [ pe:var "X"; pe:value (1 2) ],
    [ pe:var "Y"; pe:value (2) ];
  pe:uses { (1 2) rdf:rest (2) . }.

{ (1 2) rdf:rest (2) . }
  pe:builtin rdf:rest.

{ 1 log:equalTo 1 . }
  pe:builtin log:equalTo.

{ (2) log:equalTo (2) . }
  pe:builtin log:equalTo.
