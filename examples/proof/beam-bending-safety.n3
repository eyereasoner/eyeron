{ :ShelfLight :bendingStress 8333.333333333334 . }
  pe:rule 3;
  pe:binding
    [ pe:var "B"; pe:value :ShelfLight ],
    [ pe:var "M"; pe:value 0.2 ],
    [ pe:var "S"; pe:value 0.000024 ],
    [ pe:var "sigma"; pe:value 8333.333333333334 ];
  pe:uses
    { :ShelfLight :maxMoment 0.2 . },
    { :ShelfLight :sectionModulus 0.000024 . },
    { (0.2 0.000024) math:quotient 8333.333333333334 . }.

{ :ShelfLight :maxMoment 0.2 . }
  pe:rule 1;
  pe:binding
    [ pe:var "B"; pe:value :ShelfLight ],
    [ pe:var "L"; pe:value 0.8 ],
    [ pe:var "M"; pe:value 0.2 ],
    [ pe:var "P"; pe:value 1.0 ],
    [ pe:var "PL"; pe:value 0.8 ];
  pe:uses
    { :ShelfLight a :BeamDesign . },
    { :ShelfLight :span 0.8 . },
    { :ShelfLight :pointLoad 1.0 . },
    { (1.0 0.8) math:product 0.8 . },
    { (0.8 4.0) math:quotient 0.2 . }.

{ :ShelfLight a :BeamDesign . }
  pe:fact "beam-bending-safety.n3".

{ :ShelfLight :span 0.8 . }
  pe:fact "beam-bending-safety.n3".

{ :ShelfLight :pointLoad 1.0 . }
  pe:fact "beam-bending-safety.n3".

{ (1.0 0.8) math:product 0.8 . }
  pe:builtin math:product.

{ (0.8 4.0) math:quotient 0.2 . }
  pe:builtin math:quotient.

{ :ShelfLight :sectionModulus 0.000024 . }
  pe:rule 2;
  pe:binding
    [ pe:var "B"; pe:value :ShelfLight ],
    [ pe:var "S"; pe:value 0.000024 ],
    [ pe:var "b"; pe:value 0.04 ],
    [ pe:var "bh2"; pe:value 0.000144 ],
    [ pe:var "h"; pe:value 0.06 ],
    [ pe:var "h2"; pe:value 0.0036 ];
  pe:uses
    { :ShelfLight a :BeamDesign . },
    { :ShelfLight :width 0.04 . },
    { :ShelfLight :height 0.06 . },
    { (0.06 2) math:exponentiation 0.0036 . },
    { (0.04 0.0036) math:product 0.000144 . },
