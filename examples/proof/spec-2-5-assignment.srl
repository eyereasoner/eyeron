PREFIX : <http://example.com/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :route1 :distanceKm 16.0934 .
  :route2 :distanceKm 8.0467 .

  _:step1
    rdf:reifies <<( :route1 :distanceKm 16.0934 )>>;
    pe:rule "spec-2-5-assignment.srl";
    pe:line 8;
    pe:binding
      [ pe:var "kilometers"; pe:value 16.0934 ],
      [ pe:var "miles"; pe:value 10 ],
      [ pe:var "x"; pe:value :route1 ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :route1 :distanceMiles 10 )>>;
    pe:fact "spec-2-5-assignment.srl";
    pe:line 4.

  _:step3
    rdf:reifies <<( :route2 :distanceKm 8.0467 )>>;
    pe:rule "spec-2-5-assignment.srl";
    pe:line 8;
    pe:binding
      [ pe:var "kilometers"; pe:value 8.0467 ],
      [ pe:var "miles"; pe:value 5 ],
      [ pe:var "x"; pe:value :route2 ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :route2 :distanceMiles 5 )>>;
    pe:fact "spec-2-5-assignment.srl";
    pe:line 5.
}
