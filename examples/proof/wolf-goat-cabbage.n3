  { ((:w :w :w :w) (:e :w :e :w)) :edge 1 . }
    pe:rule 6;
    pe:binding
      [ pe:var "MoveType"; pe:value :goat ],
      [ pe:var "a"; pe:value :w ],
      [ pe:var "b"; pe:value :w ],
