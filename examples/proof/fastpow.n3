{ (2 10) :pow 1024 . }
  pe:rule 1;
  pe:binding
    [ pe:var "B"; pe:value 2 ],
    [ pe:var "E"; pe:value 10 ],
    [ pe:var "R"; pe:value 1024 ];
  pe:uses { (2 10) math:exponentiation 1024 . }.

{ (2 10) math:exponentiation 1024 . }
  pe:builtin math:exponentiation.

{ (2 10) :powSlow 1024 . }
  pe:rule 3;
  pe:binding
    [ pe:var "B"; pe:value 2 ],
    [ pe:var "E"; pe:value 10 ],
    [ pe:var "E1"; pe:value 9 ],
    [ pe:var "Prev"; pe:value 512 ],
    [ pe:var "R"; pe:value 1024 ];
  pe:uses
    { 10 math:greaterThan 0 . },
    { (10 1) math:difference 9 . },
    { (2 9) :powSlow 512 . },
    { (512 2) math:product 1024 . }.

{ 10 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ (10 1) math:difference 9 . }
  pe:builtin math:difference.

{ (2 9) :powSlow 512 . }
