@prefix : <http://example.org/fastpow#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:test :is {
    (2 10) :pow 1024 .
    (2 10) :powSlow 1024 .
    (2 10000) :powMod1e6 709376 .
    (3 10000) :powMod1e6 200001 .
    (2 4) :tower 65536 .
    (2 5) :towerMod1e6 156736 .
} .

{
  :test :is {
      (2 10) :pow 1024 .
      (2 10) :powSlow 1024 .
      (2 10000) :powMod1e6 709376 .
      (3 10000) :powMod1e6 200001 .
      (2 4) :tower 65536 .
      (2 5) :towerMod1e6 156736 .
  } .
}
  pe:rule 8;
  pe:binding
    [ pe:var "M1"; pe:value 709376 ],
    [ pe:var "M2"; pe:value 200001 ],
    [ pe:var "P10"; pe:value 1024 ],
    [ pe:var "S10"; pe:value 1024 ],
    [ pe:var "T4"; pe:value 65536 ],
    [ pe:var "TM5"; pe:value 156736 ];
  pe:uses
    { (2 10) :pow 1024 . },
    { (2 10) :powSlow 1024 . },
    { (2 10000) :powMod1e6 709376 . },
    { (3 10000) :powMod1e6 200001 . },
