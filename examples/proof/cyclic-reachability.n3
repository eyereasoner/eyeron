    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ];
    pe:uses { :b :edge :c . }.

  { :b :edge :c . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 9 ].

  { :c :edge :a . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 10 ].
}.

{ :a :path :a . } pe:why {
  { :a :path :a . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 13 ];
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :c ],
      [ pe:var "z"; pe:value :a ];
    pe:uses
      { :a :path :c . },
      { :c :edge :a . }.

  { :a :path :c . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 13 ];
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ],
      [ pe:var "z"; pe:value :c ];
    pe:uses
      { :a :path :b . },
      { :b :edge :c . }.

  { :a :path :b . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 12 ];
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ];
    pe:uses { :a :edge :b . }.

  { :a :edge :b . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 8 ].

  { :b :edge :c . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 9 ].

  { :c :edge :a . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 10 ].
}.

