      [ pe:var "y"; pe:value :c ],
      [ pe:var "z"; pe:value :a ];
    pe:uses
      { :b :path :c . },
      { :c :edge :a . }.

  { :b :path :c . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 12 ];
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ];
    pe:uses { :b :edge :c . }.

  { :b :edge :c . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 9 ].

