@prefix : <https://eyereasoner.github.io/eyepl/examples/cyclic-reachability#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:a :path :b .
:b :path :c .
:a :path :c .
:c :path :a .
:b :path :a .
:a :path :a .
:c :path :b .
:b :path :b .
:c :path :c .

{ :a :path :b . } pe:why {
  { :a :path :b . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 12 ];
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ];
    pe:uses { :a :edge :b . }.

  { :a :edge :b . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 8 ].
}.

{ :b :path :c . } pe:why {
  { :b :path :c . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 12 ];
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ];
    pe:uses { :b :edge :c . }.

  { :b :edge :c . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 9 ].
}.

{ :a :path :c . } pe:why {
  { :a :path :c . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 13 ];
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ],
      [ pe:var "z"; pe:value :c ];
    pe:uses
      { :a :path :b . },
      { :b :edge :c . }.

  { :a :path :b . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 12 ];
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ];
    pe:uses { :a :edge :b . }.

  { :a :edge :b . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 8 ].

  { :b :edge :c . }
    pe:by [ pe:fact "cyclic-reachability.n3"; pe:line 9 ].
}.

