    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 12 ];
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :a ];
    pe:uses { :c :edge :a . }.

