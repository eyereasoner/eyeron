  { :c :path :b . }
    pe:by [ pe:rule "cyclic-reachability.n3"; pe:line 13 ];
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :a ],
      [ pe:var "z"; pe:value :b ];
    pe:uses
      { :c :path :a . },
