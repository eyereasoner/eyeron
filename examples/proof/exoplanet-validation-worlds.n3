    { (0.010000000000000009 0.8) math:product 0.008000000000000007 . },
    { (0.198 0.008000000000000007) math:sum 0.20600000000000002 . },
    { (0.198 0.20600000000000002) math:quotient 0.9611650485436893 . }.

