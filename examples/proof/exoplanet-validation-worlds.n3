    { :MstarShortPeriod a :Candidate . },
    { :MstarShortPeriod :occurrence 0.20 . },
    { :MstarShortPeriod :sensitivity 0.99 . },
    { :MstarShortPeriod :specificity 0.99 . },
    { (0.99 0.20) math:product 0.198 . },
    { (1.0 0.20) math:difference 0.8 . },
