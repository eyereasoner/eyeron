{ :MstarShortPeriod :confirmsInWorld :W0 . }
  pe:rule 2;
  pe:binding
    [ pe:var "C"; pe:value :MstarShortPeriod ],
    [ pe:var "PPV"; pe:value 0.9611650485436893 ];
  pe:uses
    { :MstarShortPeriod :ppv_Planet 0.9611650485436893 . },
    { 0.9611650485436893 math:notLessThan 0.9 . }.

{ :MstarShortPeriod :ppv_Planet 0.9611650485436893 . }
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value :MstarShortPeriod ],
    [ pe:var "PPV"; pe:value 0.9611650485436893 ],
    [ pe:var "Se"; pe:value 0.99 ],
    [ pe:var "Sp"; pe:value 0.99 ],
    [ pe:var "denom"; pe:value 0.20600000000000002 ],
    [ pe:var "fp"; pe:value 0.008000000000000007 ],
    [ pe:var "fpr"; pe:value 0.010000000000000009 ],
    [ pe:var "num"; pe:value 0.198 ],
    [ pe:var "pNo"; pe:value 0.8 ],
    [ pe:var "pOcc"; pe:value 0.20 ];
