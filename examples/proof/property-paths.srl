PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :a :grandparentOf :c .
  :b :hasParent :a .
  :c :hasParent :b .

  _:step1
    rdf:reifies <<(:a :grandparentOf :c)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "z"; pe:value :c ];
    pe:uses
      <<(:a :parentOf :b)>>,
      <<(:b :parentOf :c)>>.

  _:step2
    rdf:reifies <<(:b :hasParent :a)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :a ];
    pe:uses <<(:a :parentOf :b)>>.

  _:step3
    rdf:reifies <<(:c :hasParent :b)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :b ];
    pe:uses <<(:b :parentOf :c)>>.
}
