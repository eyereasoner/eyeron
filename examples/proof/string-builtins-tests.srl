PREFIX : <https://eyereasoner.github.io/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :ok_string_concatenation_1 a :Pass .
  :ok_string_contains_1 a :Pass .
  :ok_string_containsIgnoringCase_1 a :Pass .
  :ok_string_endsWith_1 a :Pass .
  :ok_string_equalIgnoringCase_1 a :Pass .
  :ok_string_format_1 a :Pass .
  :ok_string_greaterThan_1 a :Pass .
  :ok_string_lessThan_1 a :Pass .
  :ok_string_matches_1 a :Pass .
  :ok_string_notEqualIgnoringCase_1 a :Pass .
  :ok_string_notGreaterThan_1 a :Pass .
  :ok_string_notLessThan_1 a :Pass .
  :ok_string_notMatches_1 a :Pass .
  :ok_string_replace_1 a :Pass .
  :ok_string_scrape_1 a :Pass .
  :ok_string_startsWith_1 a :Pass .

  _:step1
    rdf:reifies <<(:ok_string_concatenation_1 a :Pass)>>;
    pe:rule 1.

  _:step2
    rdf:reifies <<(:ok_string_contains_1 a :Pass)>>;
    pe:rule 2.

  _:step3
    rdf:reifies <<(:ok_string_containsIgnoringCase_1 a :Pass)>>;
    pe:rule 3.

  _:step4
    rdf:reifies <<(:ok_string_endsWith_1 a :Pass)>>;
    pe:rule 4.

  _:step5
    rdf:reifies <<(:ok_string_equalIgnoringCase_1 a :Pass)>>;
    pe:rule 5.

  _:step6
    rdf:reifies <<(:ok_string_format_1 a :Pass)>>;
    pe:rule 6.

  _:step7
    rdf:reifies <<(:ok_string_greaterThan_1 a :Pass)>>;
    pe:rule 7.

  _:step8
    rdf:reifies <<(:ok_string_lessThan_1 a :Pass)>>;
    pe:rule 8.

  _:step9
    rdf:reifies <<(:ok_string_matches_1 a :Pass)>>;
    pe:rule 9.

  _:step10
    rdf:reifies <<(:ok_string_notEqualIgnoringCase_1 a :Pass)>>;
    pe:rule 10.

  _:step11
    rdf:reifies <<(:ok_string_notGreaterThan_1 a :Pass)>>;
    pe:rule 11.

  _:step12
    rdf:reifies <<(:ok_string_notLessThan_1 a :Pass)>>;
    pe:rule 12.

  _:step13
    rdf:reifies <<(:ok_string_notMatches_1 a :Pass)>>;
    pe:rule 13.

  _:step14
    rdf:reifies <<(:ok_string_replace_1 a :Pass)>>;
    pe:rule 14.

  _:step15
    rdf:reifies <<(:ok_string_scrape_1 a :Pass)>>;
    pe:rule 15.

  _:step16
    rdf:reifies <<(:ok_string_startsWith_1 a :Pass)>>;
    pe:rule 16.
}
