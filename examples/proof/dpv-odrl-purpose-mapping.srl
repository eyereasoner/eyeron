PREFIX : <https://example.org/dpv-odrl-purpose-mapping#>
PREFIX dpv: <https://w3id.org/dpv#>
PREFIX dpvodrl: <https://w3id.org/dpv/mappings/odrl#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :AlphaPolicy a odrl:Policy .
  :AlphaPolicy odrl:permission :AlphaPermission .
  :AlphaPermission a odrl:Permission .
  :AlphaPermission odrl:assigner :HospitalA .
  :AlphaPermission odrl:assignee :ResearchPartner .
  :AlphaPermission odrl:target :LabResult .
  :AlphaPermission odrl:action dpv:Use .
  :AlphaPermission :derivedFromProcess :AlphaCareProcess .
  :AlphaPermission odrl:constraint :AlphaPurposeConstraint .
  :AlphaPurposeConstraint a odrl:Constraint .
  :AlphaPurposeConstraint odrl:leftOperand dpvodrl:Purpose .
  :AlphaPurposeConstraint odrl:operator odrl:isA .
  :AlphaPurposeConstraint odrl:rightOperand dpv:Healthcare .
  :AlphaPermission odrl:constraint :AlphaBasisConstraint .
  :AlphaBasisConstraint a odrl:Constraint .
  :AlphaBasisConstraint odrl:leftOperand dpvodrl:LegalBasis .
  :AlphaBasisConstraint odrl:operator odrl:isA .
  :AlphaBasisConstraint odrl:rightOperand dpv:Consent .

  _:step1
    rdf:reifies <<(:AlphaPolicy a odrl:Policy)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "controller"; pe:value :HospitalA ],
      [ pe:var "data"; pe:value :LabResult ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "processing"; pe:value dpv:Use ],
      [ pe:var "recipient"; pe:value :ResearchPartner ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaCareProcess a dpv:Process)>>,
      <<(:AlphaCareProcess dpv:hasDataController :HospitalA)>>,
      <<(:AlphaCareProcess dpv:hasRecipient :ResearchPartner)>>,
      <<(:AlphaCareProcess dpv:hasPersonalData :LabResult)>>,
      <<(:AlphaCareProcess dpv:hasProcessing dpv:Use)>>.

  _:step2
    rdf:reifies <<(:AlphaPolicy odrl:permission :AlphaPermission)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "controller"; pe:value :HospitalA ],
      [ pe:var "data"; pe:value :LabResult ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "processing"; pe:value dpv:Use ],
      [ pe:var "recipient"; pe:value :ResearchPartner ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaCareProcess a dpv:Process)>>,
      <<(:AlphaCareProcess dpv:hasDataController :HospitalA)>>,
      <<(:AlphaCareProcess dpv:hasRecipient :ResearchPartner)>>,
      <<(:AlphaCareProcess dpv:hasPersonalData :LabResult)>>,
      <<(:AlphaCareProcess dpv:hasProcessing dpv:Use)>>.

  _:step3
    rdf:reifies <<(:AlphaPermission a odrl:Permission)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "controller"; pe:value :HospitalA ],
      [ pe:var "data"; pe:value :LabResult ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "processing"; pe:value dpv:Use ],
      [ pe:var "recipient"; pe:value :ResearchPartner ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaCareProcess a dpv:Process)>>,
      <<(:AlphaCareProcess dpv:hasDataController :HospitalA)>>,
      <<(:AlphaCareProcess dpv:hasRecipient :ResearchPartner)>>,
      <<(:AlphaCareProcess dpv:hasPersonalData :LabResult)>>,
      <<(:AlphaCareProcess dpv:hasProcessing dpv:Use)>>.

  _:step4
    rdf:reifies <<(:AlphaPermission odrl:assigner :HospitalA)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "controller"; pe:value :HospitalA ],
      [ pe:var "data"; pe:value :LabResult ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "processing"; pe:value dpv:Use ],
      [ pe:var "recipient"; pe:value :ResearchPartner ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaCareProcess a dpv:Process)>>,
      <<(:AlphaCareProcess dpv:hasDataController :HospitalA)>>,
      <<(:AlphaCareProcess dpv:hasRecipient :ResearchPartner)>>,
      <<(:AlphaCareProcess dpv:hasPersonalData :LabResult)>>,
      <<(:AlphaCareProcess dpv:hasProcessing dpv:Use)>>.

  _:step5
    rdf:reifies <<(:AlphaPermission odrl:assignee :ResearchPartner)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "controller"; pe:value :HospitalA ],
      [ pe:var "data"; pe:value :LabResult ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "processing"; pe:value dpv:Use ],
      [ pe:var "recipient"; pe:value :ResearchPartner ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaCareProcess a dpv:Process)>>,
      <<(:AlphaCareProcess dpv:hasDataController :HospitalA)>>,
      <<(:AlphaCareProcess dpv:hasRecipient :ResearchPartner)>>,
      <<(:AlphaCareProcess dpv:hasPersonalData :LabResult)>>,
      <<(:AlphaCareProcess dpv:hasProcessing dpv:Use)>>.

  _:step6
    rdf:reifies <<(:AlphaPermission odrl:target :LabResult)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "controller"; pe:value :HospitalA ],
      [ pe:var "data"; pe:value :LabResult ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "processing"; pe:value dpv:Use ],
      [ pe:var "recipient"; pe:value :ResearchPartner ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaCareProcess a dpv:Process)>>,
      <<(:AlphaCareProcess dpv:hasDataController :HospitalA)>>,
      <<(:AlphaCareProcess dpv:hasRecipient :ResearchPartner)>>,
      <<(:AlphaCareProcess dpv:hasPersonalData :LabResult)>>,
      <<(:AlphaCareProcess dpv:hasProcessing dpv:Use)>>.

  _:step7
    rdf:reifies <<(:AlphaPermission odrl:action dpv:Use)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "controller"; pe:value :HospitalA ],
      [ pe:var "data"; pe:value :LabResult ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "processing"; pe:value dpv:Use ],
      [ pe:var "recipient"; pe:value :ResearchPartner ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaCareProcess a dpv:Process)>>,
      <<(:AlphaCareProcess dpv:hasDataController :HospitalA)>>,
      <<(:AlphaCareProcess dpv:hasRecipient :ResearchPartner)>>,
      <<(:AlphaCareProcess dpv:hasPersonalData :LabResult)>>,
      <<(:AlphaCareProcess dpv:hasProcessing dpv:Use)>>.

  _:step8
    rdf:reifies <<(:AlphaPermission :derivedFromProcess :AlphaCareProcess)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "controller"; pe:value :HospitalA ],
      [ pe:var "data"; pe:value :LabResult ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "processing"; pe:value dpv:Use ],
      [ pe:var "recipient"; pe:value :ResearchPartner ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaCareProcess a dpv:Process)>>,
      <<(:AlphaCareProcess dpv:hasDataController :HospitalA)>>,
      <<(:AlphaCareProcess dpv:hasRecipient :ResearchPartner)>>,
      <<(:AlphaCareProcess dpv:hasPersonalData :LabResult)>>,
      <<(:AlphaCareProcess dpv:hasProcessing dpv:Use)>>.

  _:step9
    rdf:reifies <<(:AlphaPermission odrl:constraint :AlphaPurposeConstraint)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "constraint"; pe:value :AlphaPurposeConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "purpose"; pe:value dpv:Healthcare ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :purposeConstraint :AlphaPurposeConstraint)>>,
      <<(:AlphaCareProcess dpv:hasPurpose dpv:Healthcare)>>.

  _:step10
    rdf:reifies <<(:AlphaPurposeConstraint a odrl:Constraint)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "constraint"; pe:value :AlphaPurposeConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "purpose"; pe:value dpv:Healthcare ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :purposeConstraint :AlphaPurposeConstraint)>>,
      <<(:AlphaCareProcess dpv:hasPurpose dpv:Healthcare)>>.

  _:step11
    rdf:reifies <<(:AlphaPurposeConstraint odrl:leftOperand dpvodrl:Purpose)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "constraint"; pe:value :AlphaPurposeConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "purpose"; pe:value dpv:Healthcare ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :purposeConstraint :AlphaPurposeConstraint)>>,
      <<(:AlphaCareProcess dpv:hasPurpose dpv:Healthcare)>>.

  _:step12
    rdf:reifies <<(:AlphaPurposeConstraint odrl:operator odrl:isA)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "constraint"; pe:value :AlphaPurposeConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "purpose"; pe:value dpv:Healthcare ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :purposeConstraint :AlphaPurposeConstraint)>>,
      <<(:AlphaCareProcess dpv:hasPurpose dpv:Healthcare)>>.

  _:step13
    rdf:reifies <<(:AlphaPurposeConstraint odrl:rightOperand dpv:Healthcare)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "constraint"; pe:value :AlphaPurposeConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ],
      [ pe:var "purpose"; pe:value dpv:Healthcare ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :purposeConstraint :AlphaPurposeConstraint)>>,
      <<(:AlphaCareProcess dpv:hasPurpose dpv:Healthcare)>>.

  _:step14
    rdf:reifies <<(:AlphaPermission odrl:constraint :AlphaBasisConstraint)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "basis"; pe:value dpv:Consent ],
      [ pe:var "constraint"; pe:value :AlphaBasisConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :basisConstraint :AlphaBasisConstraint)>>,
      <<(:AlphaCareProcess dpv:hasLegalBasis dpv:Consent)>>.

  _:step15
    rdf:reifies <<(:AlphaBasisConstraint a odrl:Constraint)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "basis"; pe:value dpv:Consent ],
      [ pe:var "constraint"; pe:value :AlphaBasisConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :basisConstraint :AlphaBasisConstraint)>>,
      <<(:AlphaCareProcess dpv:hasLegalBasis dpv:Consent)>>.

  _:step16
    rdf:reifies <<(:AlphaBasisConstraint odrl:leftOperand dpvodrl:LegalBasis)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "basis"; pe:value dpv:Consent ],
      [ pe:var "constraint"; pe:value :AlphaBasisConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :basisConstraint :AlphaBasisConstraint)>>,
      <<(:AlphaCareProcess dpv:hasLegalBasis dpv:Consent)>>.

  _:step17
    rdf:reifies <<(:AlphaBasisConstraint odrl:operator odrl:isA)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "basis"; pe:value dpv:Consent ],
      [ pe:var "constraint"; pe:value :AlphaBasisConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :basisConstraint :AlphaBasisConstraint)>>,
      <<(:AlphaCareProcess dpv:hasLegalBasis dpv:Consent)>>.

  _:step18
    rdf:reifies <<(:AlphaBasisConstraint odrl:rightOperand dpv:Consent)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "basis"; pe:value dpv:Consent ],
      [ pe:var "constraint"; pe:value :AlphaBasisConstraint ],
      [ pe:var "permission"; pe:value :AlphaPermission ],
      [ pe:var "policy"; pe:value :AlphaPolicy ],
      [ pe:var "process"; pe:value :AlphaCareProcess ];
    pe:uses
      <<(:AlphaPolicy :representsProcess :AlphaCareProcess)>>,
      <<(:AlphaPolicy :permissionNode :AlphaPermission)>>,
      <<(:AlphaPolicy :basisConstraint :AlphaBasisConstraint)>>,
      <<(:AlphaCareProcess dpv:hasLegalBasis dpv:Consent)>>.
}
