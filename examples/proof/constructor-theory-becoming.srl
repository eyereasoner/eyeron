PREFIX : <http://example.org/constructor#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :perfectRestoreTask :status :impossibleTask .
  :writeTask :status :possibleTask .
  :writer :retainsCapacityFor :writeTask .
  :stabilizeTask :status :possibleTask .
  :stabilizer :retainsCapacityFor :stabilizeTask .
  :v1 :availableForFurtherTask :yes .
  :damaged1 :availableForFurtherTask :yes .
  :v2 :canUndergo :writeTask .
  :v2 :becomesFrom :v1 .
  :vBad :status :blockedTransition .
  :v2 :hasAttribute :encodedMemory .
  :v3 :canUndergo :stabilizeTask .
  :v3 :becomesFrom :v2 .
  :v2 :availableForFurtherTask :yes .
  :v3 :hasAttribute :stabilizedMemory .
  :v3 :availableForFurtherTask :yes .

  _:step1
    rdf:reifies <<(:perfectRestoreTask :status :impossibleTask)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "principle"; pe:value :noMiraclePrinciple ],
      [ pe:var "task"; pe:value :perfectRestoreTask ];
    pe:uses <<(:perfectRestoreTask :forbiddenBy :noMiraclePrinciple)>>.

  _:step2
    rdf:reifies <<(:writeTask :status :possibleTask)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "constructor"; pe:value :writer ],
      [ pe:var "task"; pe:value :writeTask ];
    pe:uses <<(:writer :canPerform :writeTask)>>.

  _:step3
    rdf:reifies <<(:writer :retainsCapacityFor :writeTask)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "constructor"; pe:value :writer ],
      [ pe:var "task"; pe:value :writeTask ];
    pe:uses <<(:writer :canPerform :writeTask)>>.

  _:step4
    rdf:reifies <<(:stabilizeTask :status :possibleTask)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "constructor"; pe:value :stabilizer ],
      [ pe:var "task"; pe:value :stabilizeTask ];
    pe:uses <<(:stabilizer :canPerform :stabilizeTask)>>.

  _:step5
    rdf:reifies <<(:stabilizer :retainsCapacityFor :stabilizeTask)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "constructor"; pe:value :stabilizer ],
      [ pe:var "task"; pe:value :stabilizeTask ];
    pe:uses <<(:stabilizer :canPerform :stabilizeTask)>>.

  _:step6
    rdf:reifies <<(:v1 :availableForFurtherTask :yes)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "attr"; pe:value :blankMemory ],
      [ pe:var "next"; pe:value :v1 ];
    pe:uses <<(:v1 :hasAttribute :blankMemory)>>.

  _:step7
    rdf:reifies <<(:damaged1 :availableForFurtherTask :yes)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "attr"; pe:value :damagedMemory ],
      [ pe:var "next"; pe:value :damaged1 ];
    pe:uses <<(:damaged1 :hasAttribute :damagedMemory)>>.

  _:step8
    rdf:reifies <<(:v2 :canUndergo :writeTask)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "in"; pe:value :blankMemory ],
      [ pe:var "next"; pe:value :v2 ],
      [ pe:var "prev"; pe:value :v1 ],
      [ pe:var "task"; pe:value :writeTask ];
    pe:uses
      <<(:v2 :derivesFrom :v1)>>,
      <<(:v2 :intendsTask :writeTask)>>,
      _:step2,
      <<(:writeTask :input :blankMemory)>>,
      <<(:v1 :hasAttribute :blankMemory)>>.

  _:step9
    rdf:reifies <<(:v2 :becomesFrom :v1)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "in"; pe:value :blankMemory ],
      [ pe:var "next"; pe:value :v2 ],
      [ pe:var "prev"; pe:value :v1 ],
      [ pe:var "task"; pe:value :writeTask ];
    pe:uses
      <<(:v2 :derivesFrom :v1)>>,
      <<(:v2 :intendsTask :writeTask)>>,
      _:step2,
      <<(:writeTask :input :blankMemory)>>,
      <<(:v1 :hasAttribute :blankMemory)>>.

  _:step10
    rdf:reifies <<(:vBad :status :blockedTransition)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "next"; pe:value :vBad ],
      [ pe:var "task"; pe:value :perfectRestoreTask ];
    pe:uses
      <<(:vBad :intendsTask :perfectRestoreTask)>>,
      _:step1.

  _:step11
    rdf:reifies <<(:v2 :hasAttribute :encodedMemory)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "next"; pe:value :v2 ],
      [ pe:var "out"; pe:value :encodedMemory ],
      [ pe:var "task"; pe:value :writeTask ];
    pe:uses
      _:step8,
      <<(:writeTask :output :encodedMemory)>>.

  _:step12
    rdf:reifies <<(:v3 :canUndergo :stabilizeTask)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "in"; pe:value :encodedMemory ],
      [ pe:var "next"; pe:value :v3 ],
      [ pe:var "prev"; pe:value :v2 ],
      [ pe:var "task"; pe:value :stabilizeTask ];
    pe:uses
      <<(:v3 :derivesFrom :v2)>>,
      <<(:v3 :intendsTask :stabilizeTask)>>,
      _:step4,
      <<(:stabilizeTask :input :encodedMemory)>>,
      _:step11.

  _:step13
    rdf:reifies <<(:v3 :becomesFrom :v2)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "in"; pe:value :encodedMemory ],
      [ pe:var "next"; pe:value :v3 ],
      [ pe:var "prev"; pe:value :v2 ],
      [ pe:var "task"; pe:value :stabilizeTask ];
    pe:uses
      <<(:v3 :derivesFrom :v2)>>,
      <<(:v3 :intendsTask :stabilizeTask)>>,
      _:step4,
      <<(:stabilizeTask :input :encodedMemory)>>,
      _:step11.

  _:step14
    rdf:reifies <<(:v2 :availableForFurtherTask :yes)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "attr"; pe:value :encodedMemory ],
      [ pe:var "next"; pe:value :v2 ];
    pe:uses _:step11.

  _:step15
    rdf:reifies <<(:v3 :hasAttribute :stabilizedMemory)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "next"; pe:value :v3 ],
      [ pe:var "out"; pe:value :stabilizedMemory ],
      [ pe:var "task"; pe:value :stabilizeTask ];
    pe:uses
      _:step12,
      <<(:stabilizeTask :output :stabilizedMemory)>>.

  _:step16
    rdf:reifies <<(:v3 :availableForFurtherTask :yes)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "attr"; pe:value :stabilizedMemory ],
      [ pe:var "next"; pe:value :v3 ];
    pe:uses _:step15.
}
