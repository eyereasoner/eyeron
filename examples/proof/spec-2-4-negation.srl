PREFIX : <http://example.com/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :X3 a :UnclassifiedSize .

  _:step1
    rdf:reifies <<( :X3 a :UnclassifiedSize )>>;
    pe:rule "spec-2-4-negation.srl";
    pe:line 14;
    pe:binding [ pe:var "x"; pe:value :X3 ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :X3 a :Place )>>;
    pe:fact "spec-2-4-negation.srl";
    pe:line 11.
}
