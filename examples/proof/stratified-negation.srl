PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :carol :blocked true .
  :bob :eligible true .

  _:step1
    rdf:reifies <<(:carol :blocked true)>>;
    pe:rule 2;
    pe:binding [ pe:var "x"; pe:value :carol ];
    pe:uses <<(:carol :flagged true)>>.

  _:step2
    rdf:reifies <<(:bob :eligible true)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :bob ];
    pe:uses <<(:bob a :Person)>>.
}
