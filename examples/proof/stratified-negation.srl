PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :carol :blocked true .
  :bob :eligible true .

  _:step1
    rdf:reifies <<( :carol :blocked true )>>;
    pe:rule "stratified-negation.srl";
    pe:line 14;
    pe:binding [ pe:var "x"; pe:value :carol ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :carol :flagged true )>>;
    pe:fact "stratified-negation.srl";
    pe:line 6.

  _:step3
    rdf:reifies <<( :bob :eligible true )>>;
    pe:rule "stratified-negation.srl";
    pe:line 11;
    pe:binding [ pe:var "x"; pe:value :bob ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :bob a :Person )>>;
    pe:fact "stratified-negation.srl";
    pe:line 5.
}
