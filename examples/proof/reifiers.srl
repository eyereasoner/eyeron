PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :statementSource :chat .
  :bob :statementSource :email .
  :claim1 :isClaim true .
  :claim2 :isClaim true .

  _:step1
    rdf:reifies <<(:alice :statementSource :chat)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "claim"; pe:value :claim1 ],
      [ pe:var "object"; pe:value :hello ],
      [ pe:var "source"; pe:value :chat ],
      [ pe:var "speaker"; pe:value :alice ];
    pe:uses
      <<(:claim1 rdf:reifies <<(:alice :says :hello)>>)>>,
      <<(:claim1 :source :chat)>>.

  _:step2
    rdf:reifies <<(:bob :statementSource :email)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "claim"; pe:value :claim2 ],
      [ pe:var "object"; pe:value :hi ],
      [ pe:var "source"; pe:value :email ],
      [ pe:var "speaker"; pe:value :bob ];
    pe:uses
      <<(:claim2 rdf:reifies <<(:bob :says :hi)>>)>>,
      <<(:claim2 :source :email)>>.

  _:step3
    rdf:reifies <<(:claim1 :isClaim true)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "claim"; pe:value :claim1 ],
      [ pe:var "object"; pe:value :hello ],
      [ pe:var "speaker"; pe:value :alice ];
    pe:uses <<(:claim1 rdf:reifies <<(:alice :says :hello)>>)>>.

  _:step4
    rdf:reifies <<(:claim2 :isClaim true)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "claim"; pe:value :claim2 ],
      [ pe:var "object"; pe:value :hi ],
      [ pe:var "speaker"; pe:value :bob ];
    pe:uses <<(:claim2 rdf:reifies <<(:bob :says :hi)>>)>>.
}
