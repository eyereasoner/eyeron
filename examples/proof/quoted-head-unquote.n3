@prefix : <http://example.org/ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

{
    ?X a :Cat .
} => {
    ?X a :Animal .
} .
:c a :Animal .
:test :is true .

{
    {
        ?X a :Cat .
    } => {
        ?X a :Animal .
    } .
} pe:why {
  {
    {
        ?X a :Cat .
    } => {
        ?X a :Animal .
    } .
}
    pe:by [ pe:rule "quoted-head-unquote.n3"; pe:line 13 ];
    pe:binding
      [ pe:var "C"; pe:value {
          {
              ?X a :Cat .
          } => {
              ?X a :Animal .
          } .
      } ];
    pe:uses
      {
          :a :b {
              {
                  ?X a :Cat .
              } => {
                  ?X a :Animal .
              } .
          } .
      }.

  {
    :a :b {
        {
            ?X a :Cat .
        } => {
            ?X a :Animal .
        } .
    } .
}
    pe:by [ pe:fact "quoted-head-unquote.n3"; pe:line 9 ].
}.

{ :c a :Animal . } pe:why {
  { :c a :Animal . }
    pe:by [ pe:rule "<unknown>" ];
    pe:binding [ pe:var "X"; pe:value :c ];
    pe:uses { :c a :Cat . }.

  { :c a :Cat . }
    pe:by [ pe:fact "quoted-head-unquote.n3"; pe:line 18 ].
}.

{ :test :is true . } pe:why {
  { :test :is true . }
    pe:by [ pe:rule "quoted-head-unquote.n3"; pe:line 20 ];
    pe:uses { :c a :Animal . }.

  { :c a :Animal . }
    pe:by [ pe:rule "<unknown>" ];
    pe:binding [ pe:var "X"; pe:value :c ];
    pe:uses { :c a :Cat . }.

  { :c a :Cat . }
    pe:by [ pe:fact "quoted-head-unquote.n3"; pe:line 18 ].
}.