@prefix : <http://example.org/ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

{
    ?X a :Cat .
} => {
    ?X a :Animal .
} .
:c a :Animal .
:test :is true .

{
  {
      ?X a :Cat .
  } => {
      ?X a :Animal .
  } .
}
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value {
        {
            ?X a :Cat .
        } => {
            ?X a :Animal .
        } .
    } ];
  pe:uses
    {
        :a :b {
            {
                ?X a :Cat .
            } => {
                ?X a :Animal .
            } .
        } .
    }.

{
  :a :b {
      {
          ?X a :Cat .
      } => {
          ?X a :Animal .
      } .
  } .
}
  pe:fact "quoted-head-unquote.n3".

{ :c a :Animal . }
  pe:rule
    {
        {
            ?X a :Cat .
        } => {
            ?X a :Animal .
        } .
    };
  pe:binding [ pe:var "X"; pe:value :c ];
  pe:uses { :c a :Cat . }.

{ :c a :Cat . }
  pe:fact "quoted-head-unquote.n3".

{ :test :is true . }
  pe:rule 2;
  pe:uses { :c a :Animal . }.
