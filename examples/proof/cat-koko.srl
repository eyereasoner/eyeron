PREFIX : <https://eyereasoner.github.io/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  _:cat_14650fb0739d0383 a :Cat .
  _:bsh_14650fb0739d0383 a :BritishShortHair .
  :test :is true .

  _:step1
    rdf:reifies <<( _:cat_14650fb0739d0383 a :Cat )>>;
    pe:rule "cat-koko.srl";
    pe:line 28;
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :Koko a :Animal )>>;
    pe:fact "cat-koko.srl";
    pe:line 25.

  _:step3
    rdf:reifies <<( _:bsh_14650fb0739d0383 a :BritishShortHair )>>;
    pe:rule "cat-koko.srl";
    pe:line 33;
    pe:uses _:step2.

  _:step4
    rdf:reifies <<( :test :is true )>>;
    pe:rule "cat-koko.srl";
    pe:line 45;
    pe:binding
      [ pe:var "X"; pe:value _:cat_14650fb0739d0383 ],
      [ pe:var "Y"; pe:value _:bsh_14650fb0739d0383 ];
    pe:uses
      _:step1,
      _:step3.
}
