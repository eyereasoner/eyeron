@prefix : <https://example.org/odrl-dpv-risk-ranked#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix tosl: <https://example.org/tosl-profile#> .

(:Agreement1 :ConsumerExample 0) log:outputString "# odrl-dpv-risk-ranked\n\n## Source files\n\n- [N3 rules](../odrl-dpv-risk-ranked.n3)\n\n## Ranked DPV Risk Report\n\n**Agreement:** Example Agreement\n**Profile:** Example consumer profile\n\n" .
(:Agreement1 :ConsumerExample 1 900 "C1" 0 _:risk1_87cd4004194bead4) log:outputString "### Clause C1 — score 100\n\n**Risk level:** `https://w3id.org/dpv/risk#HighRisk`\n**Severity:** `https://w3id.org/dpv/risk#HighSeverity`\n\nRisk: account/data removal is permitted without notice safeguards (no notice constraint and no duty to inform). Clause C1: Provider may remove the user account (and associated data) at its discretion.\n\n" .
(:Agreement1 :ConsumerExample 1 915 "C2" 0 _:risk2_dd26e4e8f36bbb7f) log:outputString "### Clause C2 — score 85\n\n**Risk level:** `https://w3id.org/dpv/risk#HighRisk`\n**Severity:** `https://w3id.org/dpv/risk#HighSeverity`\n\nRisk: terms may change with notice (3 days) below consumer requirement (14 days). Clause C2: Provider may change terms by informing users at least 3 days in advance.\n\n" .
(:Agreement1 :ConsumerExample 1 903 "C3" 0 _:risk3_1987663455332410) log:outputString "### Clause C3 — score 97\n\n**Risk level:** `https://w3id.org/dpv/risk#HighRisk`\n**Severity:** `https://w3id.org/dpv/risk#HighSeverity`\n\nRisk: user data sharing is permitted without an explicit consent constraint. Clause C3: Provider may share user data with partners for business purposes.\n\n" .
(:Agreement1 :ConsumerExample 1 930 "C4" 0 _:risk4_4cf150de25434292) log:outputString "### Clause C4 — score 70\n\n**Risk level:** `https://w3id.org/dpv/risk#ModerateRisk`\n**Severity:** `https://w3id.org/dpv/risk#ModerateSeverity`\n\nRisk: portability is restricted because exporting user data is prohibited. Clause C4: Users are not permitted to export their data.\n\n" .
(:Agreement1 :ConsumerExample 1 900 "C1" 1 _:risk1_87cd4004194bead4 _:m11_87cd4004194bead4) log:outputString "- **Mitigation for clause C1:** Add a notice constraint (minimum noticeDays) before account removal.\n\n" .
(:Agreement1 :ConsumerExample 1 900 "C1" 1 _:risk1_87cd4004194bead4 _:m21_87cd4004194bead4) log:outputString "- **Mitigation for clause C1:** Add a duty to inform the consumer prior to account removal.\n\n" .
(:Agreement1 :ConsumerExample 1 915 "C2" 1 _:risk2_dd26e4e8f36bbb7f _:m12_dd26e4e8f36bbb7f) log:outputString "- **Mitigation for clause C2:** Increase minimum noticeDays in the inform duty to meet the consumer requirement.\n\n" .
(:Agreement1 :ConsumerExample 1 903 "C3" 1 _:risk3_1987663455332410 _:m13_1987663455332410) log:outputString "- **Mitigation for clause C3:** Add an explicit consent constraint before data sharing.\n\n" .
(:Agreement1 :ConsumerExample 1 930 "C4" 1 _:risk4_4cf150de25434292 _:m14_4cf150de25434292) log:outputString "- **Mitigation for clause C4:** Add a permission allowing data export (or remove the prohibition) to support portability.\n\n" .

{ (:Agreement1 :ConsumerExample 0) log:outputString "# odrl-dpv-risk-ranked\n\n## Source files\n\n- [N3 rules](../odrl-dpv-risk-ranked.n3)\n\n## Ranked DPV Risk Report\n\n**Agreement:** Example Agreement\n**Profile:** Example consumer profile\n\n" . }
  pe:rule
    {
        {
            :Agreement1 dct:title ?alabel .
            :ConsumerExample dct:title ?plabel .
            ("# odrl-dpv-risk-ranked\n\n## Source files\n\n- [N3 rules](../odrl-dpv-risk-ranked.n3)\n\n## Ranked DPV Risk Report\n\n**Agreement:** %s\n**Profile:** %s\n\n" ?alabel ?plabel) string:format ?hdr .
        } => {
            (:Agreement1 :ConsumerExample 0) log:outputString ?hdr .
        } .
    };
  pe:binding
    [ pe:var "alabel"; pe:value "Example Agreement" ],
    [ pe:var "hdr"; pe:value "# odrl-dpv-risk-ranked\n\n## Source files\n\n- [N3 rules](../odrl-dpv-risk-ranked.n3)\n\n## Ranked DPV Risk Report\n\n**Agreement:** Example Agreement\n**Profile:** Example consumer profile\n\n" ],
    [ pe:var "plabel"; pe:value "Example consumer profile" ];
  pe:uses
    { :Agreement1 dct:title "Example Agreement" . },
    { :ConsumerExample dct:title "Example consumer profile" . },
    { ("# odrl-dpv-risk-ranked\n\n## Source files\n\n- [N3 rules](../odrl-dpv-risk-ranked.n3)\n\n## Ranked DPV Risk Report\n\n**Agreement:** %s\n**Profile:** %s\n\n" "Example Agreement" "Example consumer profile") string:format "# odrl-dpv-risk-ranked\n\n## Source files\n\n- [N3 rules](../odrl-dpv-risk-ranked.n3)\n\n## Ranked DPV Risk Report\n\n**Agreement:** Example Agreement\n**Profile:** Example consumer profile\n\n" . }.

{ :Agreement1 dct:title "Example Agreement" . }
  pe:fact "odrl-dpv-risk-ranked.n3".

{ :ConsumerExample dct:title "Example consumer profile" . }
  pe:fact "odrl-dpv-risk-ranked.n3".

{ ("# odrl-dpv-risk-ranked\n\n## Source files\n\n- [N3 rules](../odrl-dpv-risk-ranked.n3)\n\n## Ranked DPV Risk Report\n\n**Agreement:** %s\n**Profile:** %s\n\n" "Example Agreement" "Example consumer profile") string:format "# odrl-dpv-risk-ranked\n\n## Source files\n\n- [N3 rules](../odrl-dpv-risk-ranked.n3)\n\n## Ranked DPV Risk Report\n\n**Agreement:** Example Agreement\n**Profile:** Example consumer profile\n\n" . }
  pe:builtin string:format.

{ (:Agreement1 :ConsumerExample 1 900 "C1" 0 _:risk1_87cd4004194bead4) log:outputString "### Clause C1 — score 100\n\n**Risk level:** `https://w3id.org/dpv/risk#HighRisk`\n**Severity:** `https://w3id.org/dpv/risk#HighSeverity`\n\nRisk: account/data removal is permitted without notice safeguards (no notice constraint and no duty to inform). Clause C1: Provider may remove the user account (and associated data) at its discretion.\n\n" . }
  pe:rule
    {
        {
            ?r a dpv:Risk .
            ?r :score ?score .
            ?r dpv:hasRiskLevel ?lvl .
            ?r dpv:hasSeverity ?sev .
            ?r :aboutClause ?clause .
            ?r dct:description ?why .
            ?clause :clauseId ?cid .
            (1000 ?score) math:difference ?inv .
            ("### Clause %s — score %s\n\n**Risk level:** `%s`\n**Severity:** `%s`\n\n%s\n\n" ?cid ?score ?lvl ?sev ?why) string:format ?line .
        } => {
            (:Agreement1 :ConsumerExample 1 ?inv ?cid 0 ?r) log:outputString ?line .
        } .
    };
  pe:binding
    [ pe:var "cid"; pe:value "C1" ],
    [ pe:var "clause"; pe:value :ClauseC1 ],
    [ pe:var "inv"; pe:value 900 ],
    [ pe:var "line"; pe:value "### Clause C1 — score 100\n\n**Risk level:** `https://w3id.org/dpv/risk#HighRisk`\n**Severity:** `https://w3id.org/dpv/risk#HighSeverity`\n\nRisk: account/data removal is permitted without notice safeguards (no notice constraint and no duty to inform). Clause C1: Provider may remove the user account (and associated data) at its discretion.\n\n" ],
    [ pe:var "lvl"; pe:value risk:HighRisk ],
    [ pe:var "r"; pe:value _:risk1_87cd4004194bead4 ],
    [ pe:var "score"; pe:value 100 ],
    [ pe:var "sev"; pe:value risk:HighSeverity ],
    [ pe:var "why"; pe:value "Risk: account/data removal is permitted without notice safeguards (no notice constraint and no duty to inform). Clause C1: Provider may remove the user account (and associated data) at its discretion." ];
  pe:uses
    { _:risk1_87cd4004194bead4 a dpv:Risk . },
    { _:risk1_87cd4004194bead4 :score 100 . },
    { _:risk1_87cd4004194bead4 dpv:hasRiskLevel risk:HighRisk . },
    { _:risk1_87cd4004194bead4 dpv:hasSeverity risk:HighSeverity . },
    { _:risk1_87cd4004194bead4 :aboutClause :ClauseC1 . },
    { _:risk1_87cd4004194bead4 dct:description "Risk: account/data removal is permitted without notice safeguards (no notice constraint and no duty to inform). Clause C1: Provider may remove the user account (and associated data) at its discretion." . },
    { :ClauseC1 :clauseId "C1" . },
    { (1000 100) math:difference 900 . },
    { ("### Clause %s — score %s\n\n**Risk level:** `%s`\n**Severity:** `%s`\n\n%s\n\n" "C1" 100 risk:HighRisk risk:HighSeverity "Risk: account/data removal is permitted without notice safeguards (no notice constraint and no duty to inform). Clause C1: Provider may remove the user account (and associated data) at its discretion.") string:format "### Clause C1 — score 100\n\n**Risk level:** `https://w3id.org/dpv/risk#HighRisk`\n**Severity:** `https://w3id.org/dpv/risk#HighSeverity`\n\nRisk: account/data removal is permitted without notice safeguards (no notice constraint and no duty to inform). Clause C1: Provider may remove the user account (and associated data) at its discretion.\n\n" . }.

