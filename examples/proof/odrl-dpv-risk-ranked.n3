  pe:rule
    {
        {
            ?r a dpv:Risk .
            ?r :score ?score .
            ?r dpv:isMitigatedByMeasure ?m .
            ?r :aboutClause ?clause .
            ?clause :clauseId ?cid .
            ?m dct:description ?md .
            (1000 ?score) math:difference ?inv .
            ("- **Mitigation for clause %s:** %s\n\n" ?cid ?md) string:format ?mline .
        } => {
            (:Agreement1 :ConsumerExample 1 ?inv ?cid 1 ?r ?m) log:outputString ?mline .
        } .
    };
