{ (:Agreement1 :ConsumerExample 1 915 "C2" 1 _:risk2_dd26e4e8f36bbb7f _:m12_dd26e4e8f36bbb7f) log:outputString "- **Mitigation for clause C2:** Increase minimum noticeDays in the inform duty to meet the consumer requirement.\n\n" . }
  pe:rule
    {
        {
            ?r a dpv:Risk .
            ?r :score ?score .
            ?r dpv:isMitigatedByMeasure ?m .
            ?r :aboutClause ?clause .
            ?clause :clauseId ?cid .
            ?m dct:description ?md .
            (1000 ?score) math:difference ?inv .
            ("- **Mitigation for clause %s:** %s\n\n" ?cid ?md) string:format ?mline .
        } => {
            (:Agreement1 :ConsumerExample 1 ?inv ?cid 1 ?r ?m) log:outputString ?mline .
        } .
    };
