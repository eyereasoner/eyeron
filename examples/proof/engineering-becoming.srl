PREFIX : <http://example.org/engineering#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :r2 :inheritsRequirement :stiffnessReq .
  :r2 :inheritsRequirement :assemblyReq .
  :r2 :considers :carbonFrame .
  :r3 :considers :ribbedHousing .
  :r1 :availableForFutureIteration :yes .
  :r1 :status :approvedBaseline .
  :r2 :preserves :stiffnessReq .
  :r2 :integrates :carbonFrame .
  :r2 :preserves :assemblyReq .
  :r2 :satisfies :stiffnessReq .
  :r2 :satisfies :assemblyReq .
  :r2 :realizes :carbonFrame .
  :r3 :inheritsRequirement :stiffnessReq .
  :r3 :inheritsRequirement :assemblyReq .
  :r2 :achieves :approvedBaseline .
  :r2 :availableForFutureIteration :yes .
  :r3 :preserves :assemblyReq .
  :r3 :integrates :ribbedHousing .
  :r2 :status :approvedBaseline .
  :r3 :satisfies :assemblyReq .
  :r3 :realizes :ribbedHousing .
  :r3 :achieves :approvedBaseline .
  :r3 :availableForFutureIteration :yes .
  :r3 :status :approvedBaseline .

  _:step1
    rdf:reifies <<(:r2 :inheritsRequirement :stiffnessReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :r1 ],
      [ pe:var "later"; pe:value :r2 ],
      [ pe:var "req"; pe:value :stiffnessReq ];
    pe:uses
      <<(:r2 :derivesFrom :r1)>>,
      <<(:r1 :satisfies :stiffnessReq)>>.

  _:step2
    rdf:reifies <<(:r2 :inheritsRequirement :assemblyReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :r1 ],
      [ pe:var "later"; pe:value :r2 ],
      [ pe:var "req"; pe:value :assemblyReq ];
    pe:uses
      <<(:r2 :derivesFrom :r1)>>,
      <<(:r1 :satisfies :assemblyReq)>>.

  _:step3
    rdf:reifies <<(:r2 :considers :carbonFrame)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "goal"; pe:value :reduceWeight ],
      [ pe:var "opt"; pe:value :carbonFrame ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses
      <<(:r2 :designGoal :reduceWeight)>>,
      <<(:reduceWeight :suggests :carbonFrame)>>.

  _:step4
    rdf:reifies <<(:r3 :considers :ribbedHousing)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "goal"; pe:value :improveCooling ],
      [ pe:var "opt"; pe:value :ribbedHousing ],
      [ pe:var "rev"; pe:value :r3 ];
    pe:uses
      <<(:r3 :designGoal :improveCooling)>>,
      <<(:improveCooling :suggests :ribbedHousing)>>.

  _:step5
    rdf:reifies <<(:r1 :availableForFutureIteration :yes)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "opt"; pe:value :aluminumFrame ],
      [ pe:var "rev"; pe:value :r1 ];
    pe:uses <<(:r1 :realizes :aluminumFrame)>>.

  _:step6
    rdf:reifies <<(:r1 :status :approvedBaseline)>>;
    pe:rule 7;
    pe:binding [ pe:var "rev"; pe:value :r1 ];
    pe:uses <<(:r1 :achieves :approvedBaseline)>>.

  _:step7
    rdf:reifies <<(:r2 :preserves :stiffnessReq)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "opt"; pe:value :carbonFrame ],
      [ pe:var "req"; pe:value :stiffnessReq ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses
      _:step1,
      _:step3,
      <<(:carbonFrame :compatibleWith :stiffnessReq)>>.

  _:step8
    rdf:reifies <<(:r2 :integrates :carbonFrame)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "opt"; pe:value :carbonFrame ],
      [ pe:var "req"; pe:value :stiffnessReq ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses
      _:step1,
      _:step3,
      <<(:carbonFrame :compatibleWith :stiffnessReq)>>.

  _:step9
    rdf:reifies <<(:r2 :preserves :assemblyReq)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "opt"; pe:value :carbonFrame ],
      [ pe:var "req"; pe:value :assemblyReq ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses
      _:step2,
      _:step3,
      <<(:carbonFrame :compatibleWith :assemblyReq)>>.

  _:step10
    rdf:reifies <<(:r2 :satisfies :stiffnessReq)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "req"; pe:value :stiffnessReq ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses _:step7.

  _:step11
    rdf:reifies <<(:r2 :satisfies :assemblyReq)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "req"; pe:value :assemblyReq ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses _:step9.

  _:step12
    rdf:reifies <<(:r2 :realizes :carbonFrame)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "opt"; pe:value :carbonFrame ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses _:step8.

  _:step13
    rdf:reifies <<(:r3 :inheritsRequirement :stiffnessReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :r2 ],
      [ pe:var "later"; pe:value :r3 ],
      [ pe:var "req"; pe:value :stiffnessReq ];
    pe:uses
      <<(:r3 :derivesFrom :r2)>>,
      _:step10.

  _:step14
    rdf:reifies <<(:r3 :inheritsRequirement :assemblyReq)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "earlier"; pe:value :r2 ],
      [ pe:var "later"; pe:value :r3 ],
      [ pe:var "req"; pe:value :assemblyReq ];
    pe:uses
      <<(:r3 :derivesFrom :r2)>>,
      _:step11.

  _:step15
    rdf:reifies <<(:r2 :achieves :approvedBaseline)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "opt"; pe:value :carbonFrame ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses _:step12.

  _:step16
    rdf:reifies <<(:r2 :availableForFutureIteration :yes)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "opt"; pe:value :carbonFrame ],
      [ pe:var "rev"; pe:value :r2 ];
    pe:uses _:step12.

  _:step17
    rdf:reifies <<(:r3 :preserves :assemblyReq)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "opt"; pe:value :ribbedHousing ],
      [ pe:var "req"; pe:value :assemblyReq ],
      [ pe:var "rev"; pe:value :r3 ];
    pe:uses
      _:step14,
      _:step4,
      <<(:ribbedHousing :compatibleWith :assemblyReq)>>.

  _:step18
    rdf:reifies <<(:r3 :integrates :ribbedHousing)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "opt"; pe:value :ribbedHousing ],
      [ pe:var "req"; pe:value :assemblyReq ],
      [ pe:var "rev"; pe:value :r3 ];
    pe:uses
      _:step14,
      _:step4,
      <<(:ribbedHousing :compatibleWith :assemblyReq)>>.

  _:step19
    rdf:reifies <<(:r2 :status :approvedBaseline)>>;
    pe:rule 7;
    pe:binding [ pe:var "rev"; pe:value :r2 ];
    pe:uses _:step15.

  _:step20
    rdf:reifies <<(:r3 :satisfies :assemblyReq)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "req"; pe:value :assemblyReq ],
      [ pe:var "rev"; pe:value :r3 ];
    pe:uses _:step17.

  _:step21
    rdf:reifies <<(:r3 :realizes :ribbedHousing)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "opt"; pe:value :ribbedHousing ],
      [ pe:var "rev"; pe:value :r3 ];
    pe:uses _:step18.

  _:step22
    rdf:reifies <<(:r3 :achieves :approvedBaseline)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "opt"; pe:value :ribbedHousing ],
      [ pe:var "rev"; pe:value :r3 ];
    pe:uses _:step21.

  _:step23
    rdf:reifies <<(:r3 :availableForFutureIteration :yes)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "opt"; pe:value :ribbedHousing ],
      [ pe:var "rev"; pe:value :r3 ];
    pe:uses _:step21.

  _:step24
    rdf:reifies <<(:r3 :status :approvedBaseline)>>;
    pe:rule 7;
    pe:binding [ pe:var "rev"; pe:value :r3 ];
    pe:uses _:step22.
}
