PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :result :is true .

  _:step1
    rdf:reifies <<( :result :is true )>>;
    pe:rule "rule-matching.srl";
    pe:line 12;
    pe:binding [ pe:var "r"; pe:value :rule1 ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :rule1 a :Implication )>>;
    pe:fact "rule-matching.srl";
    pe:line 10.
}
