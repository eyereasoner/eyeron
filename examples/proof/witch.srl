PREFIX : <https://eyereasoner.github.io/eye/reasoning/witch#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :DUCK a :ISMADEOFWOOD .
  :GIRL a :FLOATS .
  :DUCK a :BURNS .
  :GIRL a :ISMADEOFWOOD .
  :GIRL a :BURNS .
  :GIRL a :WITCH .

  _:step1
    rdf:reifies <<(:DUCK a :ISMADEOFWOOD)>>;
    pe:rule "rule#3";
    pe:binding [ pe:var "x"; pe:value :DUCK ];
    pe:uses <<(:DUCK a :FLOATS)>>.

  _:step2
    rdf:reifies <<(:GIRL a :FLOATS)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "x"; pe:value :DUCK ],
      [ pe:var "y"; pe:value :GIRL ];
    pe:uses
      <<(:DUCK a :FLOATS)>>,
      <<(:DUCK :SAMEWEIGHT :GIRL)>>.

  _:step3
    rdf:reifies <<(:DUCK a :BURNS)>>;
    pe:rule "rule#2";
    pe:binding [ pe:var "x"; pe:value :DUCK ];
    pe:uses _:step1.

  _:step4
    rdf:reifies <<(:GIRL a :ISMADEOFWOOD)>>;
    pe:rule "rule#3";
    pe:binding [ pe:var "x"; pe:value :GIRL ];
    pe:uses _:step2.

  _:step5
    rdf:reifies <<(:GIRL a :BURNS)>>;
    pe:rule "rule#2";
    pe:binding [ pe:var "x"; pe:value :GIRL ];
    pe:uses _:step4.

  _:step6
    rdf:reifies <<(:GIRL a :WITCH)>>;
    pe:rule "rule#1";
    pe:binding [ pe:var "x"; pe:value :GIRL ];
    pe:uses
      _:step5,
      <<(:GIRL a :WOMAN)>>.
}
