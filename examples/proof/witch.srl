PREFIX : <https://eyereasoner.github.io/eye/reasoning/witch#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :DUCK a :ISMADEOFWOOD .
  :GIRL a :FLOATS .
  :DUCK a :BURNS .
  :GIRL a :ISMADEOFWOOD .
  :GIRL a :BURNS .
  :GIRL a :WITCH .

  _:step1
    rdf:reifies <<( :DUCK a :ISMADEOFWOOD )>>;
    pe:rule "witch.srl";
    pe:line 14;
    pe:binding [ pe:var "x"; pe:value :DUCK ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :DUCK a :FLOATS )>>;
    pe:fact "witch.srl";
    pe:line 8.

  _:step3
    rdf:reifies <<( :GIRL a :FLOATS )>>;
    pe:rule "witch.srl";
    pe:line 15;
    pe:binding
      [ pe:var "x"; pe:value :DUCK ],
      [ pe:var "y"; pe:value :GIRL ];
    pe:uses
      _:step2,
      _:step4.

  _:step4
    rdf:reifies <<( :DUCK :SAMEWEIGHT :GIRL )>>;
    pe:fact "witch.srl";
    pe:line 9.

  _:step5
    rdf:reifies <<( :DUCK a :BURNS )>>;
    pe:rule "witch.srl";
    pe:line 13;
    pe:binding [ pe:var "x"; pe:value :DUCK ];
    pe:uses _:step1.

  _:step6
    rdf:reifies <<( :GIRL a :ISMADEOFWOOD )>>;
    pe:rule "witch.srl";
    pe:line 14;
    pe:binding [ pe:var "x"; pe:value :GIRL ];
    pe:uses _:step3.

  _:step7
    rdf:reifies <<( :GIRL a :BURNS )>>;
    pe:rule "witch.srl";
    pe:line 13;
    pe:binding [ pe:var "x"; pe:value :GIRL ];
    pe:uses _:step6.

  _:step8
    rdf:reifies <<( :GIRL a :WITCH )>>;
    pe:rule "witch.srl";
    pe:line 12;
    pe:binding [ pe:var "x"; pe:value :GIRL ];
    pe:uses
      _:step7,
      _:step9.

  _:step9
    rdf:reifies <<( :GIRL a :WOMAN )>>;
    pe:fact "witch.srl";
    pe:line 7.
}
