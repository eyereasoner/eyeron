  _:step1
    rdf:reifies <<(:a :sim :a)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :a ];
    pe:uses <<(:a :inX true)>>.

  _:step2
    rdf:reifies <<(:b :sim :b)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :b ];
    pe:uses <<(:b :inX true)>>.

  _:step3
