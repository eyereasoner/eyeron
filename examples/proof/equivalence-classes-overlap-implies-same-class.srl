PREFIX : <http://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :a :sim :a .
  :b :sim :b .
  :c :sim :c .
  :a :sim :b .
  :c :sim :b .
  :b :inClassOf :a .
  :b :inClassOf :c .
  :b :sameClass :a .
  :b :sameClass :c .
  :a :sim :c .
  :c :sim :a .
  :a :inClassOf :a .
  :b :inClassOf :b .
  :c :inClassOf :c .
