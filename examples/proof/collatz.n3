{ 8 :collatz (8 4 2 1) . }
  pe:rule 2;
  pe:binding
    [ pe:var "N"; pe:value 8 ],
    [ pe:var "Next"; pe:value 4 ],
    [ pe:var "Parity"; pe:value 0 ],
    [ pe:var "Sequence"; pe:value (8 4 2 1) ],
    [ pe:var "Tail"; pe:value (4 2 1) ];
  pe:uses
    { 8 math:greaterThan 1 . },
    { (8 2) math:remainder 0 . },
    { 0 math:equalTo 0 . },
    { (8 2) math:integerQuotient 4 . },
    { 4 :collatz (4 2 1) . },
    { (8 4 2 1) list:firstRest (8 (4 2 1)) . }.

{ 8 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (8 2) math:remainder 0 . }
  pe:builtin math:remainder.

{ (8 2) math:integerQuotient 4 . }
  pe:builtin math:integerQuotient.

{ 4 :collatz (4 2 1) . }
  pe:rule 2;
  pe:binding
    [ pe:var "N"; pe:value 4 ],
    [ pe:var "Next"; pe:value 2 ],
    [ pe:var "Parity"; pe:value 0 ],
    [ pe:var "Sequence"; pe:value (4 2 1) ],
    [ pe:var "Tail"; pe:value (2 1) ];
  pe:uses
    { 4 math:greaterThan 1 . },
    { (4 2) math:remainder 0 . },
    { 0 math:equalTo 0 . },
    { (4 2) math:integerQuotient 2 . },
    { 2 :collatz (2 1) . },
    { (4 2 1) list:firstRest (4 (2 1)) . }.

{ 4 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (4 2) math:remainder 0 . }
  pe:builtin math:remainder.

{ (4 2) math:integerQuotient 2 . }
  pe:builtin math:integerQuotient.

{ (4 2 1) list:firstRest (4 (2 1)) . }
  pe:builtin list:firstRest.

{ (8 4 2 1) list:firstRest (8 (4 2 1)) . }
  pe:builtin list:firstRest.

{ (16 8 4 2 1) list:firstRest (16 (8 4 2 1)) . }
  pe:builtin list:firstRest.

{ (5 16 8 4 2 1) list:firstRest (5 (16 8 4 2 1)) . }
  pe:builtin list:firstRest.

{ (10 5 16 8 4 2 1) list:firstRest (10 (5 16 8 4 2 1)) . }
  pe:builtin list:firstRest.

{ (3 10 5 16 8 4 2 1) list:firstRest (3 (10 5 16 8 4 2 1)) . }
  pe:builtin list:firstRest.

{ :sequences :collatz (4 (4 2 1)) . }
  pe:rule 4;
  pe:binding
    [ pe:var "N"; pe:value 4 ],
    [ pe:var "Sequence"; pe:value (4 2 1) ];
  pe:uses
