PREFIX : <https://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DATA {
  :alice :displayName "Bonjour"@fr .
  :test :namedPerson :alice .
  :test :namedText "Alice"^^xsd:string .
  :test :title "HTML و CSS"@ar--rtl .
  :test :knowsSource :chat .
  :test :knowsSubject :alice .
  :test :knowsObject :bob .

  _:step1
    rdf:reifies <<( :alice :displayName "Bonjour"@fr )>>;
    pe:rule "rdf12-interoperability.srl";
    pe:line 21;
    pe:binding
      [ pe:var "label"; pe:value "Bonjour"@fr ],
      [ pe:var "person"; pe:value :alice ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :alice :label "Bonjour"@fr )>>;
    pe:fact "rdf12-interoperability.srl";
    pe:line 14.

  _:step3
    rdf:reifies <<( :test :namedPerson :alice )>>;
    pe:rule "rdf12-interoperability.srl";
    pe:line 24;
    pe:binding
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "text"; pe:value "Alice"^^xsd:string ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :alice :name "Alice"^^xsd:string )>>;
    pe:fact "rdf12-interoperability.srl";
    pe:line 13.

  _:step5
    rdf:reifies <<( :test :namedText "Alice"^^xsd:string )>>;
    pe:rule "rdf12-interoperability.srl";
    pe:line 24;
    pe:binding
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "text"; pe:value "Alice"^^xsd:string ];
    pe:uses _:step4.

  _:step6
    rdf:reifies <<( :test :title "HTML و CSS"@ar--rtl )>>;
    pe:rule "rdf12-interoperability.srl";
    pe:line 27;
    pe:binding [ pe:var "title"; pe:value "HTML و CSS"@ar--rtl ];
    pe:uses _:step7.

  _:step7
    rdf:reifies <<( :document :title "HTML و CSS"@ar--rtl )>>;
    pe:fact "rdf12-interoperability.srl";
    pe:line 16.

  _:step8
    rdf:reifies <<( :test :knowsSource :chat )>>;
    pe:rule "rdf12-interoperability.srl";
    pe:line 30;
    pe:binding
      [ pe:var "claim"; pe:value :claim ],
      [ pe:var "o"; pe:value :bob ],
      [ pe:var "s"; pe:value :alice ],
      [ pe:var "source"; pe:value :chat ];
    pe:uses
      _:step9,
      _:step10.

  _:step9
    rdf:reifies <<( :claim rdf:reifies <<( :alice :knows :bob )>> )>>;
    pe:fact "rdf12-interoperability.srl";
    pe:line 17.

  _:step10
    rdf:reifies <<( :claim :source :chat )>>;
    pe:fact "rdf12-interoperability.srl";
    pe:line 18.

  _:step11
    rdf:reifies <<( :test :knowsSubject :alice )>>;
    pe:rule "rdf12-interoperability.srl";
    pe:line 30;
    pe:binding
      [ pe:var "claim"; pe:value :claim ],
      [ pe:var "o"; pe:value :bob ],
      [ pe:var "s"; pe:value :alice ],
      [ pe:var "source"; pe:value :chat ];
    pe:uses
      _:step9,
      _:step10.

  _:step12
    rdf:reifies <<( :test :knowsObject :bob )>>;
    pe:rule "rdf12-interoperability.srl";
    pe:line 30;
    pe:binding
      [ pe:var "claim"; pe:value :claim ],
      [ pe:var "o"; pe:value :bob ],
      [ pe:var "s"; pe:value :alice ],
      [ pe:var "source"; pe:value :chat ];
    pe:uses
      _:step9,
      _:step10.
}
