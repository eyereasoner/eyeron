PREFIX : <https://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DATA {
  :alice :displayName "Bonjour"@fr .
  :test :namedPerson :alice .
  :test :namedText "Alice"^^xsd:string .
  :test :title "HTML و CSS"@ar--rtl .
  :test :knowsSource :chat .
  :test :knowsSubject :alice .
  :test :knowsObject :bob .

  _:step1
    rdf:reifies <<(:alice :displayName "Bonjour"@fr)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "label"; pe:value "Bonjour"@fr ],
      [ pe:var "person"; pe:value :alice ];
    pe:uses <<(:alice :label "Bonjour"@fr)>>.

  _:step2
    rdf:reifies <<(:test :namedPerson :alice)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "text"; pe:value "Alice"^^xsd:string ];
    pe:uses <<(:alice :name "Alice"^^xsd:string)>>.

  _:step3
    rdf:reifies <<(:test :namedText "Alice"^^xsd:string)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "text"; pe:value "Alice"^^xsd:string ];
    pe:uses <<(:alice :name "Alice"^^xsd:string)>>.

  _:step4
    rdf:reifies <<(:test :title "HTML و CSS"@ar--rtl)>>;
    pe:rule 3;
    pe:binding [ pe:var "title"; pe:value "HTML و CSS"@ar--rtl ];
    pe:uses <<(:document :title "HTML و CSS"@ar--rtl)>>.

  _:step5
    rdf:reifies <<(:test :knowsSource :chat)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "claim"; pe:value :claim ],
      [ pe:var "o"; pe:value :bob ],
      [ pe:var "s"; pe:value :alice ],
      [ pe:var "source"; pe:value :chat ];
    pe:uses
      <<(:claim rdf:reifies <<(:alice :knows :bob)>>)>>,
      <<(:claim :source :chat)>>.

  _:step6
    rdf:reifies <<(:test :knowsSubject :alice)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "claim"; pe:value :claim ],
      [ pe:var "o"; pe:value :bob ],
      [ pe:var "s"; pe:value :alice ],
      [ pe:var "source"; pe:value :chat ];
    pe:uses
      <<(:claim rdf:reifies <<(:alice :knows :bob)>>)>>,
      <<(:claim :source :chat)>>.

  _:step7
    rdf:reifies <<(:test :knowsObject :bob)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "claim"; pe:value :claim ],
      [ pe:var "o"; pe:value :bob ],
      [ pe:var "s"; pe:value :alice ],
      [ pe:var "source"; pe:value :chat ];
    pe:uses
      <<(:claim rdf:reifies <<(:alice :knows :bob)>>)>>,
      <<(:claim :source :chat)>>.
}
