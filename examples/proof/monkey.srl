PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  _:b1 a :Animal .
  :test :is true .

  _:step1
    rdf:reifies <<(_:b1 a :Animal)>>;
    pe:rule "rule#1";
    pe:binding [ pe:var "x"; pe:value _:b1 ];
    pe:uses <<(_:b1 a :Monkey)>>.

  _:step2
    rdf:reifies <<(:test :is true)>>;
    pe:rule "rule#2";
    pe:binding [ pe:var "x"; pe:value _:b1 ];
    pe:uses
      <<(_:b1 a :Monkey)>>,
      _:step1.
}
