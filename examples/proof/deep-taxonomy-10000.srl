  _:step30009
    rdf:reifies <<(:report log:outputString "Deep Taxonomy - deep classification benchmark\n\nAnswer\nThe test succeeds: starting from one individual classified as N0, the rules eventually classify it as N10000 and then as A2.\n\nReason Why\nEach rule moves the same individual one level deeper in the taxonomy and also adds two side labels. Because that chain continues all the way from N0 to N10000, the final rule deriving A2 fires, and that in turn makes the test true.\n\nCheck\nC1 OK - the starting classification N0 is present.\nC2 OK - the first expansion produced N1 together with side labels I1 and J1.\nC3 OK - the chain reaches the midpoint N5000 and still carries both side-label branches.\nC4 OK - the final taxonomy step from N9999 to N10000 was completed.\nC5 OK - once N10000 is reached, the terminal class A2 is derived.\nC6 OK - the success flag is raised only after the terminal class A2 is present.")>>;
    pe:rule 10009;
    pe:binding
      [ pe:var "C1"; pe:value "C1 OK - the starting classification N0 is present." ],
      [ pe:var "C2"; pe:value "C2 OK - the first expansion produced N1 together with side labels I1 and J1." ],
      [ pe:var "C3"; pe:value "C3 OK - the chain reaches the midpoint N5000 and still carries both side-label branches." ],
      [ pe:var "C4"; pe:value "C4 OK - the final taxonomy step from N9999 to N10000 was completed." ],
      [ pe:var "C5"; pe:value "C5 OK - once N10000 is reached, the terminal class A2 is derived." ],
      [ pe:var "C6"; pe:value "C6 OK - the success flag is raised only after the terminal class A2 is present." ];
    pe:uses
      _:step30006,
      _:step4,
      _:step8,
      _:step15006,
      _:step30005,
      _:step30007,
      _:step30008.
}
