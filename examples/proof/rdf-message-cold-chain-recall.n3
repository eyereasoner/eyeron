{ :telemetryStream a ldes:EventStream . }
  pe:rule 2;
  pe:binding
    [ pe:var "Bookmark"; pe:value 42 ],
    [ pe:var "DecisionText"; pe:value "quarantine batchA, notify QA, and hold shipment" ],
    [ pe:var "Envelope"; pe:value <urn:eyeron:rdf-message-stream:1:envelope:1> ],
    [ pe:var "Limit"; pe:value 80 ],
    [ pe:var "LimitLabel"; pe:value "8.0°C" ],
    [ pe:var "Payload"; pe:value <urn:eyeron:rdf-message-stream:1:payload:1> ],
    [ pe:var "PayloadContext"; pe:value {
        :telemetryStream a ldes:EventStream .
        :telemetryStream ldes:timestampPath :observedAt .
        :telemetryStream ldes:sequencePath :sequence .
        :telemetryStream tree:view :telemetryPage .
        :telemetryStream :lastCommittedSequence 42 .
        :telemetryStream :currentWindowFromSequence 43 .
        :telemetryStream :temperatureLimitTenthC 80 .
        :telemetryStream :temperatureLimitLabel "8.0°C" .
        :telemetryStream :repairPolicy :preferCalibratedLogger .
        :quarantineDecision :decisionText "quarantine batchA, notify QA, and hold shipment" .
        in:run a see:InputDataset .
        in:run see:name "rdf_message_cold_chain_recall" .
        in:run see:title "RDF Message Cold Chain Recall" .
        in:run see:sourceFile "examples/rdf-message-cold-chain-recall.n3" .
        in:run see:description "Forty-eight cold-chain telemetry members serialized as RDF Messages; the rules resume after a sequence checkpoint and repair contradictory tail evidence." .
        in:run see:compiler "Eyeron RDF Message Log input" .
    } ],
    [ pe:var "WindowStart"; pe:value 43 ];
  pe:uses
    { <urn:eyeron:rdf-message-stream:1:envelope:1> eymsg:payloadGraph <urn:eyeron:rdf-message-stream:1:payload:1> . },
    {
        <urn:eyeron:rdf-message-stream:1:payload:1> log:nameOf {
            :telemetryStream a ldes:EventStream .
            :telemetryStream ldes:timestampPath :observedAt .
            :telemetryStream ldes:sequencePath :sequence .
            :telemetryStream tree:view :telemetryPage .
            :telemetryStream :lastCommittedSequence 42 .
            :telemetryStream :currentWindowFromSequence 43 .
            :telemetryStream :temperatureLimitTenthC 80 .
            :telemetryStream :temperatureLimitLabel "8.0°C" .
            :telemetryStream :repairPolicy :preferCalibratedLogger .
            :quarantineDecision :decisionText "quarantine batchA, notify QA, and hold shipment" .
            in:run a see:InputDataset .
            in:run see:name "rdf_message_cold_chain_recall" .
            in:run see:title "RDF Message Cold Chain Recall" .
            in:run see:sourceFile "examples/rdf-message-cold-chain-recall.n3" .
            in:run see:description "Forty-eight cold-chain telemetry members serialized as RDF Messages; the rules resume after a sequence checkpoint and repair contradictory tail evidence." .
            in:run see:compiler "Eyeron RDF Message Log input" .
        } .
    },
    {
        {
            :telemetryStream a ldes:EventStream .
            :telemetryStream ldes:timestampPath :observedAt .
