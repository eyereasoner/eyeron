        :alice a :Person .
        :alice :age 30 .
        :alice :status :OldStatus .
        :alice :email "alice@example.org" .
        :bob a :Person .
    } .
}
    pe:builtin log:collectAllIn.

  {
    ({
        :alice a :Person .
    } {
        :bob a :Person .
    }) log:conjunction {
        :alice a :Person .
        :bob a :Person .
    } .
}
    pe:builtin log:conjunction.

  {
    ({
        :alice a :Person .
        :bob a :Person .
    } {
        :alice :age 31 .
        :alice :status :ActiveStatus .
        :alice :verified true .
    }) log:conjunction {
        :alice a :Person .
        :bob a :Person .
        :alice :age 31 .
        :alice :status :ActiveStatus .
        :alice :verified true .
