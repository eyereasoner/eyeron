PREFIX : <http://example/eyeling/good-cobbler/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :test :goodAt :Cobbler .
  :joe :classifiedAs :Cobbler .

  _:step1
    rdf:reifies <<( :test :goodAt :Cobbler )>>;
    pe:rule "good-cobbler.srl";
    pe:line 10;
    pe:binding
      [ pe:var "__b3"; pe:value _:b1 ],
      [ pe:var "__b4"; pe:value _:b2 ],
      [ pe:var "person"; pe:value :joe ],
      [ pe:var "trade"; pe:value :Cobbler ];
    pe:uses
      _:step2,
      _:step3,
      _:step4,
      _:step5,
      _:step6.

  _:step2
    rdf:reifies <<( _:b1 rdf:first :good )>>;
    pe:fact "good-cobbler.srl";
    pe:line 7.

  _:step3
    rdf:reifies <<( _:b1 rdf:rest _:b2 )>>;
    pe:fact "good-cobbler.srl";
    pe:line 7.

  _:step4
    rdf:reifies <<( _:b2 rdf:first :Cobbler )>>;
    pe:fact "good-cobbler.srl";
    pe:line 7.

  _:step5
    rdf:reifies <<( _:b2 rdf:rest rdf:nil )>>;
    pe:fact "good-cobbler.srl";
    pe:line 7.

  _:step6
    rdf:reifies <<( :joe :is _:b1 )>>;
    pe:fact "good-cobbler.srl";
    pe:line 7.

  _:step7
    rdf:reifies <<( :joe :classifiedAs :Cobbler )>>;
    pe:rule "good-cobbler.srl";
    pe:line 13;
    pe:binding
      [ pe:var "__b5"; pe:value _:b1 ],
      [ pe:var "__b6"; pe:value _:b2 ],
      [ pe:var "person"; pe:value :joe ],
      [ pe:var "trade"; pe:value :Cobbler ];
    pe:uses
      _:step2,
      _:step3,
      _:step4,
      _:step5,
      _:step6.
}
