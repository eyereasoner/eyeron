PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :bob a :Orphan .

  _:step1
    rdf:reifies <<(:bob a :Orphan)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :bob ];
    pe:uses <<(:bob a :Person)>>.
}
