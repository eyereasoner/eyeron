PREFIX : <https://eyereasoner.github.io/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :ok_list_append_1 a :Pass .
  :ok_list_first_1 a :Pass .
  :ok_list_in_1 a :Pass .
  :ok_list_iterate_1 a :Pass .
  :ok_list_last_1 a :Pass .
  :ok_list_length_1 a :Pass .
  :ok_list_member_1 a :Pass .
  :ok_list_memberAt_1 a :Pass .
  :ok_list_remove_1 a :Pass .
  :ok_list_rest_1 a :Pass .
  :ok_list_firstRest_1 a :Pass .

  _:step1
    rdf:reifies <<(:ok_list_append_1 a :Pass)>>;
    pe:rule 1;
    pe:uses
      <<(:l1 :item0 1)>>,
      <<(:l1 :item1 2)>>,
      <<(:l1 :item2 3)>>,
      <<(:l1 :item3 4)>>.

  _:step2
    rdf:reifies <<(:ok_list_first_1 a :Pass)>>;
    pe:rule 2;
    pe:uses <<(:l1 :item0 1)>>.

  _:step3
    rdf:reifies <<(:ok_list_in_1 a :Pass)>>;
    pe:rule 3;
    pe:uses <<(:l2 :item2 "cat")>>.

  _:step4
    rdf:reifies <<(:ok_list_iterate_1 a :Pass)>>;
    pe:rule 4;
    pe:uses <<(:l2 :item2 "cat")>>.

  _:step5
    rdf:reifies <<(:ok_list_last_1 a :Pass)>>;
    pe:rule 5;
    pe:uses <<(:l1 :item3 4)>>.

  _:step6
    rdf:reifies <<(:ok_list_length_1 a :Pass)>>;
    pe:rule 6;
    pe:uses <<(:l1 :length 4)>>.

  _:step7
    rdf:reifies <<(:ok_list_member_1 a :Pass)>>;
    pe:rule 7;
    pe:uses <<(:l2 :item2 "cat")>>.

  _:step8
    rdf:reifies <<(:ok_list_memberAt_1 a :Pass)>>;
    pe:rule 8;
    pe:uses <<(:l2 :item2 "cat")>>.

  _:step9
    rdf:reifies <<(:ok_list_remove_1 a :Pass)>>;
    pe:rule 9;
    pe:uses
      <<(:l3 :item0 "dog")>>,
      <<(:l3 :item2 "cat")>>.

  _:step10
    rdf:reifies <<(:ok_list_rest_1 a :Pass)>>;
    pe:rule 10;
    pe:uses <<(:l1 :item1 2)>>.

  _:step11
    rdf:reifies <<(:ok_list_firstRest_1 a :Pass)>>;
    pe:rule 11;
    pe:uses
      <<(:l1 :item0 1)>>,
      <<(:l1 :item1 2)>>.
}
