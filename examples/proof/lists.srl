PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :query1 :appendResultLeft :a .
  :query1 :appendResultRight :b .
  :items :member :a .
  :items :member :b .

  _:step1
    rdf:reifies <<(:query1 :appendResultLeft :a)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ].

  _:step2
    rdf:reifies <<(:query1 :appendResultRight :b)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ].

  _:step3
    rdf:reifies <<(:items :member :a)>>;
    pe:rule 2;
    pe:binding [ pe:var "m"; pe:value :a ].

  _:step4
    rdf:reifies <<(:items :member :b)>>;
    pe:rule 3;
    pe:binding [ pe:var "m"; pe:value :b ].
}
