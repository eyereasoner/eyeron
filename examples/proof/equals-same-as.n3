@prefix : <http://example.org/socrates#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:test :is true .

{ :test :is true . } pe:why {
  { :test :is true . }
    pe:by [ pe:rule "equals-same-as.n3"; pe:line 14 ];
    pe:uses { :X owl:sameAs :Y . }.

  { :X owl:sameAs :Y . }
    pe:by [ pe:fact "equals-same-as.n3"; pe:line 12 ].
}.