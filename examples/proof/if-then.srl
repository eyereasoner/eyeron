PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :Socrates a :Mortal .

  _:step1
    rdf:reifies <<( :Socrates a :Mortal )>>;
    pe:rule "if-then.srl";
    pe:line 7;
    pe:binding [ pe:var "x"; pe:value :Socrates ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :Socrates a :Man )>>;
    pe:fact "if-then.srl";
    pe:line 4.
}
