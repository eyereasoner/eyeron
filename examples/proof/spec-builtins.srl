PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DATA {
  :event :year 2026 .
  :event :month 5 .
  :event :blank _:event .
  :event :tripleSubject :subject .

  _:step1
    rdf:reifies <<( :event :year 2026 )>>;
    pe:rule "spec-builtins.srl";
    pe:line 8;
    pe:binding
      [ pe:var "blank"; pe:value _:event ],
      [ pe:var "month"; pe:value 5 ],
      [ pe:var "subject"; pe:value :subject ],
      [ pe:var "when"; pe:value "2026-05-15T10:20:30Z"^^xsd:dateTime ],
      [ pe:var "year"; pe:value 2026 ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :event :when "2026-05-15T10:20:30Z"^^xsd:dateTime )>>;
    pe:fact "spec-builtins.srl";
    pe:line 5.

  _:step3
    rdf:reifies <<( :event :month 5 )>>;
    pe:rule "spec-builtins.srl";
    pe:line 8;
    pe:binding
      [ pe:var "blank"; pe:value _:event ],
      [ pe:var "month"; pe:value 5 ],
      [ pe:var "subject"; pe:value :subject ],
      [ pe:var "when"; pe:value "2026-05-15T10:20:30Z"^^xsd:dateTime ],
      [ pe:var "year"; pe:value 2026 ];
    pe:uses _:step2.

  _:step4
    rdf:reifies <<( :event :blank _:event )>>;
    pe:rule "spec-builtins.srl";
    pe:line 8;
    pe:binding
      [ pe:var "blank"; pe:value _:event ],
      [ pe:var "month"; pe:value 5 ],
      [ pe:var "subject"; pe:value :subject ],
      [ pe:var "when"; pe:value "2026-05-15T10:20:30Z"^^xsd:dateTime ],
      [ pe:var "year"; pe:value 2026 ];
    pe:uses _:step2.

  _:step5
    rdf:reifies <<( :event :tripleSubject :subject )>>;
    pe:rule "spec-builtins.srl";
    pe:line 8;
    pe:binding
      [ pe:var "blank"; pe:value _:event ],
      [ pe:var "month"; pe:value 5 ],
      [ pe:var "subject"; pe:value :subject ],
      [ pe:var "when"; pe:value "2026-05-15T10:20:30Z"^^xsd:dateTime ],
      [ pe:var "year"; pe:value 2026 ];
    pe:uses _:step2.
}
