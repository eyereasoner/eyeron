PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :eligible true .

  _:step1
    rdf:reifies <<(:alice :eligible true)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :alice ];
    pe:uses <<(:alice a :Person)>>.
}
