PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :claim1 :trusted true .

  _:step1
    rdf:reifies <<(:claim1 :trusted true)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "claim"; pe:value :claim1 ],
      [ pe:var "person"; pe:value :alice ],
      [ pe:var "q1"; pe:value _:b1 ],
      [ pe:var "q2"; pe:value _:b2 ];
    pe:uses
      <<(_:b1 :subject :alice)>>,
      <<(_:b1 :predicate :role)>>,
      <<(_:b1 :object :reviewer)>>,
      <<(_:b1 :graph :staff)>>,
      <<(_:b2 :subject :alice)>>,
      <<(_:b2 :predicate :approved)>>,
      <<(_:b2 :object :claim1)>>,
      <<(_:b2 :graph :reviews)>>.
}
