PREFIX : <http://example/eyeling/collection-basic/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :test :first 1 .
  :test :blankNodeProperty :q .
  :test :nestedFirst 2 .

  _:step1
    rdf:reifies <<(:test :first 1)>>;
    pe:rule "rule#1";
    pe:binding [ pe:var "first"; pe:value 1 ].

  _:step2
    rdf:reifies <<(:test :blankNodeProperty :q)>>;
    pe:rule "rule#2";
    pe:binding [ pe:var "value"; pe:value :q ].

  _:step3
    rdf:reifies <<(:test :nestedFirst 2)>>;
    pe:rule "rule#3";
    pe:binding [ pe:var "value"; pe:value 2 ].
}
