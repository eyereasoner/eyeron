PREFIX : <http://example/eyeling/collection-basic/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :test :first 1 .
  :test :blankNodeProperty :q .
  :test :nestedFirst 2 .

  _:step1
    rdf:reifies <<( :test :first 1 )>>;
    pe:rule "collection.srl";
    pe:line 11;
    pe:binding [ pe:var "first"; pe:value 1 ];
    pe:uses
      <<( ?__path_s_0 :p2 ?__path_o_0 )>>,
      <<( ?__path_s_1 rdf:first ?__path_o_1 )>>.

  _:step2
    rdf:reifies <<( :root :p2 _:b1 )>>;
    pe:fact "collection.srl";
    pe:line 8.

  _:step3
    rdf:reifies <<( _:b1 rdf:first 1 )>>;
    pe:fact "collection.srl";
    pe:line 8.

  _:step4
    rdf:reifies <<( :test :blankNodeProperty :q )>>;
    pe:rule "collection.srl";
    pe:line 14;
    pe:binding [ pe:var "value"; pe:value :q ];
    pe:uses
      <<( ?__path_s_0 :p2 ?__path_o_0 )>>,
      <<( ?__path_s_1 rdf:rest ?__path_o_1 )>>,
      <<( ?__path_s_2 rdf:first ?__path_o_2 )>>,
      <<( ?__path_s_3 :p ?__path_o_3 )>>.

  _:step5
    rdf:reifies <<( _:b1 rdf:rest _:b2 )>>;
    pe:fact "collection.srl";
    pe:line 8.

  _:step6
    rdf:reifies <<( _:b3 :p :q )>>;
    pe:fact "collection.srl";
    pe:line 8.

  _:step7
    rdf:reifies <<( :test :nestedFirst 2 )>>;
    pe:rule "collection.srl";
    pe:line 17;
    pe:binding [ pe:var "value"; pe:value 2 ];
    pe:uses
      <<( ?__path_s_0 :p2 ?__path_o_0 )>>,
      <<( ?__path_s_1 rdf:rest ?__path_o_1 )>>,
      <<( ?__path_s_2 rdf:rest ?__path_o_2 )>>,
      <<( ?__path_s_3 rdf:first ?__path_o_3 )>>,
      <<( ?__path_s_4 rdf:first ?__path_o_4 )>>.
}
