PREFIX : <http://example/eyeling/collection-basic/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :test :first 1 .
  :test :blankNodeProperty :q .
  :test :nestedFirst 2 .

  _:step1
    rdf:reifies <<(:test :first 1)>>;
    pe:rule 1;
    pe:binding [ pe:var "first"; pe:value 1 ];
    pe:uses
      <<(:root :p2 _:b1)>>,
      <<(_:b1 rdf:first 1)>>.

  _:step2
    rdf:reifies <<(:test :blankNodeProperty :q)>>;
    pe:rule 2;
    pe:binding [ pe:var "value"; pe:value :q ];
    pe:uses
      <<(:root :p2 _:b1)>>,
      <<(_:b1 rdf:rest _:b2)>>,
      <<(_:b2 rdf:first _:b3)>>,
      <<(_:b3 :p :q)>>.

  _:step3
    rdf:reifies <<(:test :nestedFirst 2)>>;
    pe:rule 3;
    pe:binding [ pe:var "value"; pe:value 2 ];
    pe:uses
      <<(:root :p2 _:b1)>>,
      <<(_:b1 rdf:rest _:b2)>>,
      <<(_:b2 rdf:rest _:b4)>>,
      <<(_:b4 rdf:first _:b5)>>,
      <<(_:b5 rdf:first 2)>>.
}
