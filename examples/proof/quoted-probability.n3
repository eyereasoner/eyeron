@prefix : <http://example.org/rdf-star-reasoning#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix owlstar: <http://example.org/owlstar#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

{
    :y :q :x .
} :s :o .
{
    :y :q :x .
} owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
{
    :z :q :y .
} owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
{
    :y :q :x .
} :probability 0.89 .
{
    :x :p :z .
} owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
{
    :x :r :z .
} :probability 0.49840000000000007 .
{
    :x :r :x .
} :probability 0.7921 .
{
    :z :q :x .
} owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .

{
  {
      :y :q :x .
  } :s :o .
}
  pe:rule 1;
  pe:binding
    [ pe:var "o"; pe:value :o ],
    [ pe:var "p"; pe:value :p ],
    [ pe:var "q"; pe:value :q ],
    [ pe:var "s"; pe:value :s ],
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :y ];
  pe:uses
    {
        {
            :x :p :y .
        } :s :o .
    },
    { :p owl:inverseOf :q . }.

{
  {
      :x :p :y .
  } :s :o .
}
  pe:fact "quoted-probability.n3".

{ :p owl:inverseOf :q . }
  pe:fact "quoted-probability.n3".

{
  {
      :y :q :x .
  } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
}
  pe:rule 1;
  pe:binding
    [ pe:var "o"; pe:value owlstar:SubClassOfSomeValuesFrom ],
    [ pe:var "p"; pe:value :p ],
    [ pe:var "q"; pe:value :q ],
    [ pe:var "s"; pe:value owlstar:hasInterpretation ],
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :y ];
  pe:uses
    {
        {
            :x :p :y .
        } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
    },
    { :p owl:inverseOf :q . }.

{
  {
      :x :p :y .
  } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
}
  pe:fact "quoted-probability.n3".

{
  {
      :z :q :y .
  } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
}
  pe:rule 1;
  pe:binding
    [ pe:var "o"; pe:value owlstar:SubClassOfSomeValuesFrom ],
    [ pe:var "p"; pe:value :p ],
    [ pe:var "q"; pe:value :q ],
    [ pe:var "s"; pe:value owlstar:hasInterpretation ],
    [ pe:var "x"; pe:value :y ],
    [ pe:var "y"; pe:value :z ];
  pe:uses
    {
        {
            :y :p :z .
        } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
    },
    { :p owl:inverseOf :q . }.

{
  {
      :y :p :z .
  } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
}
  pe:fact "quoted-probability.n3".

{
  {
      :y :q :x .
  } :probability 0.89 .
}
  pe:rule 1;
  pe:binding
    [ pe:var "o"; pe:value 0.89 ],
    [ pe:var "p"; pe:value :p ],
    [ pe:var "q"; pe:value :q ],
    [ pe:var "s"; pe:value :probability ],
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :y ];
  pe:uses
    {
        {
            :x :p :y .
        } :probability 0.89 .
    },
    { :p owl:inverseOf :q . }.

{
  {
      :x :p :y .
  } :probability 0.89 .
}
  pe:fact "quoted-probability.n3".

{
  {
      :x :p :z .
  } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
}
  pe:rule 2;
  pe:binding
    [ pe:var "p"; pe:value :p ],
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :y ],
    [ pe:var "z"; pe:value :z ];
  pe:uses
    {
        {
            :x :p :y .
        } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
    },
    {
        {
            :y :p :z .
        } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
    },
    { :p a owl:TransitiveProperty . }.

{ :p a owl:TransitiveProperty . }
  pe:fact "quoted-probability.n3".

{
  {
      :x :r :z .
  } :probability 0.49840000000000007 .
}
  pe:rule 3;
  pe:binding
    [ pe:var "p"; pe:value :p ],
    [ pe:var "p1"; pe:value 0.89 ],
    [ pe:var "p2"; pe:value 0.56 ],
    [ pe:var "p3"; pe:value 0.49840000000000007 ],
    [ pe:var "q"; pe:value :q ],
    [ pe:var "r"; pe:value :r ],
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :y ],
    [ pe:var "z"; pe:value :z ];
  pe:uses
    {
        {
            :x :p :y .
        } :probability 0.89 .
    },
    {
        {
            :y :q :z .
        } :probability 0.56 .
    },
    { :r owl:propertyChainAxiom (:p :q) . },
    { (0.89 0.56) math:product 0.49840000000000007 . }.

{
  {
      :y :q :z .
  } :probability 0.56 .
}
  pe:fact "quoted-probability.n3".

{ :r owl:propertyChainAxiom (:p :q) . }
  pe:fact "quoted-probability.n3".

{ (0.89 0.56) math:product 0.49840000000000007 . }
  pe:builtin math:product.

{
  {
      :x :r :x .
  } :probability 0.7921 .
}
  pe:rule 3;
  pe:binding
    [ pe:var "p"; pe:value :p ],
    [ pe:var "p1"; pe:value 0.89 ],
    [ pe:var "p2"; pe:value 0.89 ],
    [ pe:var "p3"; pe:value 0.7921 ],
    [ pe:var "q"; pe:value :q ],
    [ pe:var "r"; pe:value :r ],
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :y ],
    [ pe:var "z"; pe:value :x ];
  pe:uses
    {
        {
            :x :p :y .
        } :probability 0.89 .
    },
    {
        {
            :y :q :x .
        } :probability 0.89 .
    },
    { :r owl:propertyChainAxiom (:p :q) . },
    { (0.89 0.89) math:product 0.7921 . }.

{ (0.89 0.89) math:product 0.7921 . }
  pe:builtin math:product.

{
  {
      :z :q :x .
  } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
}
  pe:rule 1;
  pe:binding
    [ pe:var "o"; pe:value owlstar:SubClassOfSomeValuesFrom ],
    [ pe:var "p"; pe:value :p ],
    [ pe:var "q"; pe:value :q ],
    [ pe:var "s"; pe:value owlstar:hasInterpretation ],
    [ pe:var "x"; pe:value :x ],
    [ pe:var "y"; pe:value :z ];
  pe:uses
    {
        {
            :x :p :z .
        } owlstar:hasInterpretation owlstar:SubClassOfSomeValuesFrom .
    },
    { :p owl:inverseOf :q . }.
