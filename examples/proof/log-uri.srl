PREFIX : <http://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :uriString :is "https://www.w3.org" .
  :uriResource :is <https://www.w3.org> .

  _:step1
    rdf:reifies <<( :uriString :is "https://www.w3.org" )>>;
    pe:rule "log-uri.srl";
    pe:line 11;
    pe:binding
      [ pe:var "iri"; pe:value <https://www.w3.org> ],
      [ pe:var "r"; pe:value <https://www.w3.org> ],
      [ pe:var "s"; pe:value "https://www.w3.org" ],
      [ pe:var "text"; pe:value "https://www.w3.org" ];
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( :thing :theIri <https://www.w3.org> )>>;
    pe:fact "log-uri.srl";
    pe:line 7.

  _:step3
    rdf:reifies <<( :thing :iriText "https://www.w3.org" )>>;
    pe:fact "log-uri.srl";
    pe:line 8.

  _:step4
    rdf:reifies <<( :uriResource :is <https://www.w3.org> )>>;
    pe:rule "log-uri.srl";
    pe:line 11;
    pe:binding
      [ pe:var "iri"; pe:value <https://www.w3.org> ],
      [ pe:var "r"; pe:value <https://www.w3.org> ],
      [ pe:var "s"; pe:value "https://www.w3.org" ],
      [ pe:var "text"; pe:value "https://www.w3.org" ];
    pe:uses
      _:step2,
      _:step3.
}
