@prefix : <https://eyereasoner.github.io/eyepl/examples/spec-2-1-basic-usage#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:X :childOf :A .
:X :childOf :B .
:A :childOf :C .

{ :X :childOf :A . } pe:why {
  { :X :childOf :A . }
    pe:by [ pe:rule "spec-2-1-basic-usage.n3"; pe:line 10 ];
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :A ];
    pe:uses { :A :fatherOf :X . }.

  { :A :fatherOf :X . }
    pe:by [ pe:fact "spec-2-1-basic-usage.n3"; pe:line 6 ].
}.

{ :X :childOf :B . } pe:why {
  { :X :childOf :B . }
    pe:by [ pe:rule "spec-2-1-basic-usage.n3"; pe:line 11 ];
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :B ];
    pe:uses { :B :motherOf :X . }.

  { :B :motherOf :X . }
    pe:by [ pe:fact "spec-2-1-basic-usage.n3"; pe:line 7 ].
}.

{ :A :childOf :C . } pe:why {
  { :A :childOf :C . }
    pe:by [ pe:rule "spec-2-1-basic-usage.n3"; pe:line 11 ];
    pe:binding
      [ pe:var "x"; pe:value :A ],
      [ pe:var "y"; pe:value :C ];
    pe:uses { :C :motherOf :A . }.

  { :C :motherOf :A . }
    pe:by [ pe:fact "spec-2-1-basic-usage.n3"; pe:line 8 ].
}.