@prefix : <https://eyereasoner.github.io/eyepl/examples/spec-2-1-basic-usage#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:X :childOf :A .
:X :childOf :B .
:A :childOf :C .

{ :X :childOf :A . }
  pe:rule 1;
  pe:binding
    [ pe:var "x"; pe:value :X ],
    [ pe:var "y"; pe:value :A ];
  pe:uses { :A :fatherOf :X . }.

{ :A :fatherOf :X . }
  pe:fact "spec-2-1-basic-usage.n3".

{ :X :childOf :B . }
  pe:rule 2;
  pe:binding
    [ pe:var "x"; pe:value :X ],
    [ pe:var "y"; pe:value :B ];
  pe:uses { :B :motherOf :X . }.

{ :B :motherOf :X . }
  pe:fact "spec-2-1-basic-usage.n3".

{ :A :childOf :C . }
  pe:rule 2;
  pe:binding
    [ pe:var "x"; pe:value :A ],
    [ pe:var "y"; pe:value :C ];
  pe:uses { :C :motherOf :A . }.

{ :C :motherOf :A . }
  pe:fact "spec-2-1-basic-usage.n3".
