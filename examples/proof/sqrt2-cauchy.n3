{ (1.0 1.0) math:product "1"^^xsd:decimal . }
  pe:builtin math:product.

{ ("1"^^xsd:decimal 2) math:difference "-1"^^xsd:decimal . }
  pe:builtin math:difference.

{ "-1"^^xsd:decimal math:absoluteValue 1 . }
  pe:builtin math:absoluteValue.

