PREFIX : <http://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :a :leq :a .
  :b :leq :b .
  :g1 :leq :g1 .
  :g2 :leq :g2 .
  :g1 :lowerBoundOfA :a .
  :g1 :lowerBoundOfB :b .
  :g2 :lowerBoundOfA :a .
  :g2 :lowerBoundOfB :b .
  :g1 :leq :a .
  :g2 :leq :a .
  :g1 :leq :b .
  :g2 :leq :b .
  :a :sameTerm :a .
  :b :sameTerm :b .
  :g1 :sameTerm :g1 .
  :g2 :sameTerm :g2 .
  :g2 :leq :g1 .
  :g1 :leq :g2 .
  :g2 :sameTerm :g1 .
  :g1 :sameTerm :g2 .
  _:b1_b648fc5553315d7b a :SameGlbWitness .
  _:b1_b648fc5553315d7b :witnessA :a .
  _:b1_b648fc5553315d7b :witnessB :b .
  _:b1_b648fc5553315d7b :witnessM :g1 .
  _:b1_b648fc5553315d7b :witnessN :g2 .
  _:b1_36ad155a7d394a17 a :SameGlbWitness .
  _:b1_36ad155a7d394a17 :witnessA :a .
  _:b1_36ad155a7d394a17 :witnessB :b .
  _:b1_36ad155a7d394a17 :witnessM :g2 .
  _:b1_36ad155a7d394a17 :witnessN :g1 .

  _:step1
    rdf:reifies <<(:a :leq :a)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :a ];
    pe:uses <<(:a :inP true)>>.

  _:step2
    rdf:reifies <<(:b :leq :b)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :b ];
    pe:uses <<(:b :inP true)>>.

  _:step3
    rdf:reifies <<(:g1 :leq :g1)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :g1 ];
    pe:uses <<(:g1 :inP true)>>.

  _:step4
    rdf:reifies <<(:g2 :leq :g2)>>;
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :g2 ];
    pe:uses <<(:g2 :inP true)>>.

  _:step5
    rdf:reifies <<(:g1 :lowerBoundOfA :a)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ];
    pe:uses
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>.

  _:step6
    rdf:reifies <<(:g1 :lowerBoundOfB :b)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ];
    pe:uses
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>.

  _:step7
    rdf:reifies <<(:g2 :lowerBoundOfA :a)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ];
    pe:uses
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>.

  _:step8
    rdf:reifies <<(:g2 :lowerBoundOfB :b)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ];
    pe:uses
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>.

  _:step9
    rdf:reifies <<(:g1 :leq :a)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "m"; pe:value :g1 ];
    pe:uses <<(:g1 :glbOfA :a)>>.

  _:step10
    rdf:reifies <<(:g2 :leq :a)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "m"; pe:value :g2 ];
    pe:uses <<(:g2 :glbOfA :a)>>.

  _:step11
    rdf:reifies <<(:g1 :leq :b)>>;
    pe:rule 7;
    pe:binding
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ];
    pe:uses <<(:g1 :glbOfB :b)>>.

  _:step12
    rdf:reifies <<(:g2 :leq :b)>>;
    pe:rule 7;
    pe:binding
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ];
    pe:uses <<(:g2 :glbOfB :b)>>.

  _:step13
    rdf:reifies <<(:a :sameTerm :a)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :a ];
    pe:uses
      _:step1,
      _:step1.

  _:step14
    rdf:reifies <<(:b :sameTerm :b)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :b ];
    pe:uses
      _:step2,
      _:step2.

  _:step15
    rdf:reifies <<(:g1 :sameTerm :g1)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :g1 ],
      [ pe:var "y"; pe:value :g1 ];
    pe:uses
      _:step3,
      _:step3.

  _:step16
    rdf:reifies <<(:g2 :sameTerm :g2)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :g2 ],
      [ pe:var "y"; pe:value :g2 ];
    pe:uses
      _:step4,
      _:step4.

  _:step17
    rdf:reifies <<(:g2 :leq :g1)>>;
    pe:rule 8;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "l"; pe:value :g2 ],
      [ pe:var "m"; pe:value :g1 ];
    pe:uses
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      _:step7,
      _:step8.

  _:step18
    rdf:reifies <<(:g1 :leq :g2)>>;
    pe:rule 8;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "l"; pe:value :g1 ],
      [ pe:var "m"; pe:value :g2 ];
    pe:uses
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      _:step5,
      _:step6.

  _:step19
    rdf:reifies <<(:g2 :sameTerm :g1)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :g2 ],
      [ pe:var "y"; pe:value :g1 ];
    pe:uses
      _:step17,
      _:step18.

  _:step20
    rdf:reifies <<(:g1 :sameTerm :g2)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :g1 ],
      [ pe:var "y"; pe:value :g2 ];
    pe:uses
      _:step18,
      _:step17.

  _:step21
    rdf:reifies <<(_:b1_b648fc5553315d7b a :SameGlbWitness)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ],
      [ pe:var "n"; pe:value :g2 ];
    pe:uses
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      _:step20.

  _:step22
    rdf:reifies <<(_:b1_b648fc5553315d7b :witnessA :a)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ],
      [ pe:var "n"; pe:value :g2 ];
    pe:uses
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      _:step20.

  _:step23
    rdf:reifies <<(_:b1_b648fc5553315d7b :witnessB :b)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ],
      [ pe:var "n"; pe:value :g2 ];
    pe:uses
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      _:step20.

  _:step24
    rdf:reifies <<(_:b1_b648fc5553315d7b :witnessM :g1)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ],
      [ pe:var "n"; pe:value :g2 ];
    pe:uses
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      _:step20.

  _:step25
    rdf:reifies <<(_:b1_b648fc5553315d7b :witnessN :g2)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ],
      [ pe:var "n"; pe:value :g2 ];
    pe:uses
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      _:step20.

  _:step26
    rdf:reifies <<(_:b1_36ad155a7d394a17 a :SameGlbWitness)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ],
      [ pe:var "n"; pe:value :g1 ];
    pe:uses
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      _:step19.

  _:step27
    rdf:reifies <<(_:b1_36ad155a7d394a17 :witnessA :a)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ],
      [ pe:var "n"; pe:value :g1 ];
    pe:uses
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      _:step19.

  _:step28
    rdf:reifies <<(_:b1_36ad155a7d394a17 :witnessB :b)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ],
      [ pe:var "n"; pe:value :g1 ];
    pe:uses
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      _:step19.

  _:step29
    rdf:reifies <<(_:b1_36ad155a7d394a17 :witnessM :g2)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ],
      [ pe:var "n"; pe:value :g1 ];
    pe:uses
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      _:step19.

  _:step30
    rdf:reifies <<(_:b1_36ad155a7d394a17 :witnessN :g1)>>;
    pe:rule 9;
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ],
      [ pe:var "n"; pe:value :g1 ];
    pe:uses
      <<(:g2 :glbOfA :a)>>,
      <<(:g2 :glbOfB :b)>>,
      <<(:g1 :glbOfA :a)>>,
      <<(:g1 :glbOfB :b)>>,
      _:step19.
}
