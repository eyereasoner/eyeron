@prefix : <https://eyereasoner.github.io/eyepl/examples/derivative#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:query :derivative (:add (:mul (:const 1) (:var :x)) (:mul (:var :x) (:const 1))) .

{ :query :derivative (:add (:mul (:const 1) (:var :x)) (:mul (:var :x) (:const 1))) . }
  pe:rule 6;
  pe:binding [ pe:var "d"; pe:value (:add (:mul (:const 1) (:var :x)) (:mul (:var :x) (:const 1))) ];
  pe:uses { ((:mul (:var :x) (:var :x)) :x) :derivative (:add (:mul (:const 1) (:var :x)) (:mul (:var :x) (:const 1))) . }.

{ ((:mul (:var :x) (:var :x)) :x) :derivative (:add (:mul (:const 1) (:var :x)) (:mul (:var :x) (:const 1))) . }
  pe:rule 5;
  pe:binding
    [ pe:var "du"; pe:value (:const 1) ],
    [ pe:var "dv"; pe:value (:const 1) ],
    [ pe:var "u"; pe:value (:var :x) ],
    [ pe:var "v"; pe:value (:var :x) ],
    [ pe:var "x"; pe:value :x ];
  pe:uses
    { ((:var :x) :x) :derivative (:const 1) . },
    { ((:var :x) :x) :derivative (:const 1) . }.

{ ((:var :x) :x) :derivative (:const 1) . }
  pe:rule 2;
  pe:binding [ pe:var "x"; pe:value :x ].
