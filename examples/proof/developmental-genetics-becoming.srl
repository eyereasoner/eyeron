PREFIX : <http://example.org/genetics#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :s2 :inheritsMarker :Sox2 .
  :s2 :inheritsMarker :Pax6 .
  :s2 :considers :proneuralProgram .
  :s3 :considers :neuronalMaturationProgram .
  :s2 :targetsMarker :NeuroD1 .
  :s3 :targetsMarker :Tubb3 .
  :s1 :status :stableCellState .
  :s2 :preservesMarker :Sox2 .
  :s2 :integrates :proneuralProgram .
  :s2 :preservesMarker :Pax6 .
  :s2 :expresses :NeuroD1 .
  :s3 :expresses :Tubb3 .
  :s3 :integrates :neuronalMaturationProgram .
  :s3 :inheritsMarker :NeuroD1 .
  :s2 :expresses :Sox2 .
  :s2 :expresses :Pax6 .
  :s2 :realizes :proneuralProgram .
  :s3 :realizes :neuronalMaturationProgram .
  :s3 :inheritsMarker :Sox2 .
  :s3 :inheritsMarker :Pax6 .
  :s3 :preservesMarker :NeuroD1 .
  :s2 :achieves :stableCellState .
  :s2 :availableForFurtherDifferentiation :yes .
  :s3 :achieves :stableCellState .
  :s3 :availableForFurtherDifferentiation :yes .
  :s3 :preservesMarker :Pax6 .
  :s3 :expresses :NeuroD1 .
  :s2 :status :stableCellState .
  :s3 :status :stableCellState .
  :s3 :expresses :Pax6 .

  _:step1
    rdf:reifies <<(:s2 :inheritsMarker :Sox2)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "earlier"; pe:value :s1 ],
      [ pe:var "later"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :Sox2 ];
    pe:uses
      <<(:s2 :derivesFrom :s1)>>,
      <<(:s1 :expresses :Sox2)>>.

  _:step2
    rdf:reifies <<(:s2 :inheritsMarker :Pax6)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "earlier"; pe:value :s1 ],
      [ pe:var "later"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :Pax6 ];
    pe:uses
      <<(:s2 :derivesFrom :s1)>>,
      <<(:s1 :expresses :Pax6)>>.

  _:step3
    rdf:reifies <<(:s2 :considers :proneuralProgram)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "program"; pe:value :proneuralProgram ],
      [ pe:var "signal"; pe:value :neurogenicSignal ];
    pe:uses
      <<(:s2 :receives :neurogenicSignal)>>,
      <<(:neurogenicSignal :suggests :proneuralProgram)>>.

  _:step4
    rdf:reifies <<(:s3 :considers :neuronalMaturationProgram)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "program"; pe:value :neuronalMaturationProgram ],
      [ pe:var "signal"; pe:value :maturationSignal ];
    pe:uses
      <<(:s3 :receives :maturationSignal)>>,
      <<(:maturationSignal :suggests :neuronalMaturationProgram)>>.

  _:step5
    rdf:reifies <<(:s2 :targetsMarker :NeuroD1)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :NeuroD1 ],
      [ pe:var "signal"; pe:value :neurogenicSignal ];
    pe:uses
      <<(:s2 :receives :neurogenicSignal)>>,
      <<(:neurogenicSignal :introducesMarker :NeuroD1)>>.

  _:step6
    rdf:reifies <<(:s3 :targetsMarker :Tubb3)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :Tubb3 ],
      [ pe:var "signal"; pe:value :maturationSignal ];
    pe:uses
      <<(:s3 :receives :maturationSignal)>>,
      <<(:maturationSignal :introducesMarker :Tubb3)>>.

  _:step7
    rdf:reifies <<(:s1 :status :stableCellState)>>;
    pe:rule "rule#9";
    pe:binding [ pe:var "cell"; pe:value :s1 ];
    pe:uses <<(:s1 :achieves :stableCellState)>>.

  _:step8
    rdf:reifies <<(:s2 :preservesMarker :Sox2)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :Sox2 ],
      [ pe:var "program"; pe:value :proneuralProgram ];
    pe:uses
      _:step1,
      _:step3,
      <<(:proneuralProgram :compatibleWith :Sox2)>>.

  _:step9
    rdf:reifies <<(:s2 :integrates :proneuralProgram)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :Sox2 ],
      [ pe:var "program"; pe:value :proneuralProgram ];
    pe:uses
      _:step1,
      _:step3,
      <<(:proneuralProgram :compatibleWith :Sox2)>>.

  _:step10
    rdf:reifies <<(:s2 :preservesMarker :Pax6)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :Pax6 ],
      [ pe:var "program"; pe:value :proneuralProgram ];
    pe:uses
      _:step2,
      _:step3,
      <<(:proneuralProgram :compatibleWith :Pax6)>>.

  _:step11
    rdf:reifies <<(:s2 :expresses :NeuroD1)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :NeuroD1 ],
      [ pe:var "program"; pe:value :proneuralProgram ];
    pe:uses
      _:step5,
      _:step3,
      <<(:proneuralProgram :enables :NeuroD1)>>.

  _:step12
    rdf:reifies <<(:s3 :expresses :Tubb3)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :Tubb3 ],
      [ pe:var "program"; pe:value :neuronalMaturationProgram ];
    pe:uses
      _:step6,
      _:step4,
      <<(:neuronalMaturationProgram :enables :Tubb3)>>.

  _:step13
    rdf:reifies <<(:s3 :integrates :neuronalMaturationProgram)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :Tubb3 ],
      [ pe:var "program"; pe:value :neuronalMaturationProgram ];
    pe:uses
      _:step6,
      _:step4,
      <<(:neuronalMaturationProgram :enables :Tubb3)>>.

  _:step14
    rdf:reifies <<(:s3 :inheritsMarker :NeuroD1)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "earlier"; pe:value :s2 ],
      [ pe:var "later"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :NeuroD1 ];
    pe:uses
      <<(:s3 :derivesFrom :s2)>>,
      _:step11.

  _:step15
    rdf:reifies <<(:s2 :expresses :Sox2)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :Sox2 ];
    pe:uses _:step8.

  _:step16
    rdf:reifies <<(:s2 :expresses :Pax6)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "marker"; pe:value :Pax6 ];
    pe:uses _:step10.

  _:step17
    rdf:reifies <<(:s2 :realizes :proneuralProgram)>>;
    pe:rule "rule#7";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "program"; pe:value :proneuralProgram ];
    pe:uses _:step9.

  _:step18
    rdf:reifies <<(:s3 :realizes :neuronalMaturationProgram)>>;
    pe:rule "rule#7";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "program"; pe:value :neuronalMaturationProgram ];
    pe:uses _:step13.

  _:step19
    rdf:reifies <<(:s3 :inheritsMarker :Sox2)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "earlier"; pe:value :s2 ],
      [ pe:var "later"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :Sox2 ];
    pe:uses
      <<(:s3 :derivesFrom :s2)>>,
      _:step15.

  _:step20
    rdf:reifies <<(:s3 :inheritsMarker :Pax6)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "earlier"; pe:value :s2 ],
      [ pe:var "later"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :Pax6 ];
    pe:uses
      <<(:s3 :derivesFrom :s2)>>,
      _:step16.

  _:step21
    rdf:reifies <<(:s3 :preservesMarker :NeuroD1)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :NeuroD1 ],
      [ pe:var "program"; pe:value :neuronalMaturationProgram ];
    pe:uses
      _:step14,
      _:step4,
      <<(:neuronalMaturationProgram :compatibleWith :NeuroD1)>>.

  _:step22
    rdf:reifies <<(:s2 :achieves :stableCellState)>>;
    pe:rule "rule#8";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "program"; pe:value :proneuralProgram ];
    pe:uses _:step17.

  _:step23
    rdf:reifies <<(:s2 :availableForFurtherDifferentiation :yes)>>;
    pe:rule "rule#8";
    pe:binding
      [ pe:var "cell"; pe:value :s2 ],
      [ pe:var "program"; pe:value :proneuralProgram ];
    pe:uses _:step17.

  _:step24
    rdf:reifies <<(:s3 :achieves :stableCellState)>>;
    pe:rule "rule#8";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "program"; pe:value :neuronalMaturationProgram ];
    pe:uses _:step18.

  _:step25
    rdf:reifies <<(:s3 :availableForFurtherDifferentiation :yes)>>;
    pe:rule "rule#8";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "program"; pe:value :neuronalMaturationProgram ];
    pe:uses _:step18.

  _:step26
    rdf:reifies <<(:s3 :preservesMarker :Pax6)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :Pax6 ],
      [ pe:var "program"; pe:value :neuronalMaturationProgram ];
    pe:uses
      _:step20,
      _:step4,
      <<(:neuronalMaturationProgram :compatibleWith :Pax6)>>.

  _:step27
    rdf:reifies <<(:s3 :expresses :NeuroD1)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :NeuroD1 ];
    pe:uses _:step21.

  _:step28
    rdf:reifies <<(:s2 :status :stableCellState)>>;
    pe:rule "rule#9";
    pe:binding [ pe:var "cell"; pe:value :s2 ];
    pe:uses _:step22.

  _:step29
    rdf:reifies <<(:s3 :status :stableCellState)>>;
    pe:rule "rule#9";
    pe:binding [ pe:var "cell"; pe:value :s3 ];
    pe:uses _:step24.

  _:step30
    rdf:reifies <<(:s3 :expresses :Pax6)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "cell"; pe:value :s3 ],
      [ pe:var "marker"; pe:value :Pax6 ];
    pe:uses _:step26.
}
