@prefix : <https://eyereasoner.github.io/eyepl/examples/filter-town#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:town2 a :largeTown .

{ :town2 a :largeTown . } pe:why {
  { :town2 a :largeTown . }
    pe:by [ pe:rule "filter-town.n3"; pe:line 11 ];
    pe:binding
      [ pe:var "p"; pe:value 2000 ],
      [ pe:var "x"; pe:value :town2 ];
    pe:uses
      { :town2 :population 2000 . },
      { 2000 math:greaterThan 1500 . }.

  { :town2 :population 2000 . }
    pe:by [ pe:fact "filter-town.n3"; pe:line 9 ].

  { 2000 math:greaterThan 1500 . }
    pe:by [ pe:builtin math:greaterThan ].
}.