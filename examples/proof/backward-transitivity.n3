@prefix : <http://example.org/#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:A :moreInterestingThan :C .

{ :A :moreInterestingThan :C . }
  pe:rule 3;
  pe:binding
    [ pe:var "X"; pe:value :A ],
    [ pe:var "Y"; pe:value :B ],
    [ pe:var "Z"; pe:value :C ];
  pe:uses
    { :A :moreInterestingThan :B . },
    { :B :moreInterestingThan :C . }.

{ :A :moreInterestingThan :B . }
  pe:rule 1;
  pe:binding
    [ pe:var "SX"; pe:value 8 ],
    [ pe:var "SY"; pe:value 5 ],
    [ pe:var "X"; pe:value :A ],
    [ pe:var "Y"; pe:value :B ];
  pe:uses
    { :A :score 8 . },
    { :B :score 5 . },
    { 8 math:greaterThan 5 . }.

{ :A :score 8 . }
  pe:fact "backward-transitivity.n3".

{ :B :score 5 . }
  pe:fact "backward-transitivity.n3".

{ 8 math:greaterThan 5 . }
  pe:builtin math:greaterThan.

{ :B :moreInterestingThan :C . }
  pe:fact "backward-transitivity.n3".
