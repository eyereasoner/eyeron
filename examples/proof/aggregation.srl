PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :report :count 3 .
  :report :total 35 .

  _:step1
    rdf:reifies <<( :report :count 3 )>>;
    pe:rule "aggregation.srl";
    pe:line 15;
    pe:binding
      [ pe:var "a"; pe:value 10 ],
      [ pe:var "b"; pe:value 15 ],
      [ pe:var "c"; pe:value 10 ],
      [ pe:var "total"; pe:value 35 ];
    pe:uses
      _:step2,
      _:step3,
      _:step4.

  _:step2
    rdf:reifies <<( :sensor_a :reading 10 )>>;
    pe:fact "aggregation.srl";
    pe:line 10.

  _:step3
    rdf:reifies <<( :sensor_b :reading 15 )>>;
    pe:fact "aggregation.srl";
    pe:line 11.

  _:step4
    rdf:reifies <<( :sensor_c :reading 10 )>>;
    pe:fact "aggregation.srl";
    pe:line 12.

  _:step5
    rdf:reifies <<( :report :total 35 )>>;
    pe:rule "aggregation.srl";
    pe:line 15;
    pe:binding
      [ pe:var "a"; pe:value 10 ],
      [ pe:var "b"; pe:value 15 ],
      [ pe:var "c"; pe:value 10 ],
      [ pe:var "total"; pe:value 35 ];
    pe:uses
      _:step2,
      _:step3,
      _:step4.
}
