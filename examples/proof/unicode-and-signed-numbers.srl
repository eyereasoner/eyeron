PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :sample :unicodeDecoded true .
  :thermo :belowZero true .

  _:step1
    rdf:reifies <<( :sample :unicodeDecoded true )>>;
    pe:rule "unicode-and-signed-numbers.srl";
    pe:line 8;
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :sample :text "ABC" )>>;
    pe:fact "unicode-and-signed-numbers.srl";
    pe:line 4.

  _:step3
    rdf:reifies <<( :thermo :belowZero true )>>;
    pe:rule "unicode-and-signed-numbers.srl";
    pe:line 9;
    pe:binding [ pe:var "d"; pe:value -12 ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :thermo :delta -12 )>>;
    pe:fact "unicode-and-signed-numbers.srl";
    pe:line 5.
}
