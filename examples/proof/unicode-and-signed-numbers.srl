PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :sample :unicodeDecoded true .
  :thermo :belowZero true .

  _:step1
    rdf:reifies <<(:sample :unicodeDecoded true)>>;
    pe:rule 1;
    pe:uses <<(:sample :text "ABC")>>.

  _:step2
    rdf:reifies <<(:thermo :belowZero true)>>;
    pe:rule 2;
    pe:binding [ pe:var "d"; pe:value -12 ];
    pe:uses <<(:thermo :delta -12)>>.
}
