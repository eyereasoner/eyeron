      :mythic :hasWings true .
  } log:includes {
      :nemo :hasWings false .
  } .
}
  pe:builtin log:includes.

{
  {
      :tweety a :Bird .
      :tweety a :Penguin .
      :falco a :Bird .
      :opus a :Penguin .
      :batsy a :Mammal .
      :batsy a :Bat .
      :nemo a :Fish .
      :mythic a :Bird .
      :mythic :canFly false .
      {
          :nemo a :Bird .
      } => {
          :nemo :canFly true .
          :nemo :hasWings true .
      } .
      {
          :nemo a :Penguin .
      } => {
          :nemo :canFly false .
      } .
      {
          :nemo a :Mammal .
      } => {
          :nemo :hasWings false .
      } .
      {
          :nemo a :Bat .
      } => {
          :nemo :hasWings true .
          :nemo :canFly true .
      } .
      {
          :nemo a :Fish .
      } => {
          :nemo :canSwim true .
          :nemo :hasWings false .
      } .
      :tweety :canFly true .
      :tweety :hasWings true .
      :tweety :canFly false .
      :falco :canFly true .
      :falco :hasWings true .
      :opus :canFly false .
      :batsy :hasWings false .
      :batsy :hasWings true .
      :batsy :canFly true .
      :nemo :canSwim true .
      :nemo :hasWings false .
      :mythic :canFly true .
      :mythic :hasWings true .
  } log:notIncludes {
      :nemo :hasWings true .
  } .
}
  pe:builtin log:notIncludes.

{ :falco :canFlySafely true . }
  pe:rule 9;
  pe:binding [ pe:var "x"; pe:value :falco ];
  pe:uses { :falco :canFlyStatus :TrueOnly . }.

