@prefix : <http://example.org/paraconsistent#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:mythic :canFlyStatus :Both .
:tweety :canFlyStatus :Both .
:batsy :hasWingsStatus :Both .
:mythic :inconsistent :canFly .
:mythic :needsReview :canFly .
:mythic :canFlySafely :Undecided .
:mythic :movesBySafely :Unknown .
:mythic :migratesSafely :Undecided .
:tweety :inconsistent :canFly .
:tweety :needsReview :canFly .
:tweety :canFlySafely :Undecided .
:tweety :movesBySafely :Unknown .
:tweety :migratesSafely :Undecided .
:batsy :inconsistent :hasWings .
:batsy :needsReview :hasWings .
:batsy :hasWingsSafely :Undecided .
:falco :canFlyStatus :TrueOnly .
:batsy :canFlyStatus :TrueOnly .
:opus :canFlyStatus :FalseOnly .
:tweety :hasWingsStatus :TrueOnly .
:falco :hasWingsStatus :TrueOnly .
:mythic :hasWingsStatus :TrueOnly .
:nemo :hasWingsStatus :FalseOnly .
:falco :canFlySafely true .
:falco :movesBySafely :Flying .
:falco :migratesSafely true .
:batsy :canFlySafely true .
:batsy :movesBySafely :Flying .
:batsy :migratesSafely true .
:opus :canFlySafely false .
:opus :movesBySafely :Walking .
:opus :migratesSafely false .
:tweety :hasWingsSafely true .
:falco :hasWingsSafely true .
:mythic :hasWingsSafely true .
:nemo :hasWingsSafely false .

{ :mythic :canFlyStatus :Both . }
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value {
        :tweety a :Bird .
        :tweety a :Penguin .
        :falco a :Bird .
        :opus a :Penguin .
        :batsy a :Mammal .
        :batsy a :Bat .
        :nemo a :Fish .
        :mythic a :Bird .
        :mythic :canFly false .
        {
            :mythic a :Bird .
        } => {
            :mythic :canFly true .
            :mythic :hasWings true .
        } .
        {
            :mythic a :Penguin .
        } => {
            :mythic :canFly false .
        } .
        {
            :mythic a :Mammal .
        } => {
            :mythic :hasWings false .
        } .
        {
            :mythic a :Bat .
        } => {
            :mythic :hasWings true .
            :mythic :canFly true .
        } .
        {
            :mythic a :Fish .
        } => {
            :mythic :canSwim true .
            :mythic :hasWings false .
        } .
        :tweety :canFly true .
        :tweety :hasWings true .
        :tweety :canFly false .
        :falco :canFly true .
        :falco :hasWings true .
        :opus :canFly false .
        :batsy :hasWings false .
        :batsy :hasWings true .
        :batsy :canFly true .
        :nemo :canSwim true .
        :nemo :hasWings false .
        :mythic :canFly true .
        :mythic :hasWings true .
    } ],
    [ pe:var "F"; pe:value {
        :tweety a :Bird .
        :tweety a :Penguin .
        :falco a :Bird .
        :opus a :Penguin .
        :batsy a :Mammal .
        :batsy a :Bat .
        :nemo a :Fish .
        :mythic a :Bird .
        :mythic :canFly false .
        {
            :mythic a :Bird .
        } => {
            :mythic :canFly true .
            :mythic :hasWings true .
        } .
        {
            :mythic a :Penguin .
        } => {
            :mythic :canFly false .
        } .
        {
            :mythic a :Mammal .
        } => {
            :mythic :hasWings false .
        } .
        {
            :mythic a :Bat .
        } => {
            :mythic :hasWings true .
            :mythic :canFly true .
        } .
        {
            :mythic a :Fish .
        } => {
            :mythic :canSwim true .
            :mythic :hasWings false .
        } .
    } ],
    [ pe:var "x"; pe:value :mythic ];
  pe:uses
    {
        :kb :hasFormula {
            :tweety a :Bird .
            :tweety a :Penguin .
            :falco a :Bird .
            :opus a :Penguin .
            :batsy a :Mammal .
            :batsy a :Bat .
            :nemo a :Fish .
            :mythic a :Bird .
            :mythic :canFly false .
            {
                :mythic a :Bird .
            } => {
                :mythic :canFly true .
                :mythic :hasWings true .
            } .
            {
                :mythic a :Penguin .
            } => {
                :mythic :canFly false .
            } .
            {
                :mythic a :Mammal .
            } => {
                :mythic :hasWings false .
            } .
            {
                :mythic a :Bat .
            } => {
                :mythic :hasWings true .
                :mythic :canFly true .
            } .
            {
                :mythic a :Fish .
            } => {
                :mythic :canSwim true .
                :mythic :hasWings false .
            } .
        } .
    },
    {
        {
            :tweety a :Bird .
            :tweety a :Penguin .
            :falco a :Bird .
            :opus a :Penguin .
            :batsy a :Mammal .
            :batsy a :Bat .
            :nemo a :Fish .
            :mythic a :Bird .
            :mythic :canFly false .
            {
                :mythic a :Bird .
            } => {
                :mythic :canFly true .
                :mythic :hasWings true .
            } .
            {
                :mythic a :Penguin .
            } => {
                :mythic :canFly false .
            } .
            {
                :mythic a :Mammal .
            } => {
                :mythic :hasWings false .
            } .
            {
                :mythic a :Bat .
            } => {
                :mythic :hasWings true .
                :mythic :canFly true .
            } .
            {
                :mythic a :Fish .
            } => {
                :mythic :canSwim true .
                :mythic :hasWings false .
            } .
        } log:conclusion {
            :tweety a :Bird .
            :tweety a :Penguin .
            :falco a :Bird .
            :opus a :Penguin .
            :batsy a :Mammal .
            :batsy a :Bat .
            :nemo a :Fish .
            :mythic a :Bird .
            :mythic :canFly false .
            {
                :mythic a :Bird .
            } => {
                :mythic :canFly true .
                :mythic :hasWings true .
            } .
            {
                :mythic a :Penguin .
            } => {
                :mythic :canFly false .
            } .
            {
                :mythic a :Mammal .
            } => {
                :mythic :hasWings false .
            } .
            {
                :mythic a :Bat .
            } => {
                :mythic :hasWings true .
                :mythic :canFly true .
            } .
            {
                :mythic a :Fish .
            } => {
                :mythic :canSwim true .
                :mythic :hasWings false .
            } .
            :tweety :canFly true .
            :tweety :hasWings true .
            :tweety :canFly false .
            :falco :canFly true .
            :falco :hasWings true .
            :opus :canFly false .
            :batsy :hasWings false .
            :batsy :hasWings true .
            :batsy :canFly true .
            :nemo :canSwim true .
            :nemo :hasWings false .
            :mythic :canFly true .
            :mythic :hasWings true .
        } .
    },
    {
        {
            :tweety a :Bird .
            :tweety a :Penguin .
            :falco a :Bird .
            :opus a :Penguin .
            :batsy a :Mammal .
            :batsy a :Bat .
            :nemo a :Fish .
            :mythic a :Bird .
            :mythic :canFly false .
            {
                :mythic a :Bird .
            } => {
                :mythic :canFly true .
                :mythic :hasWings true .
            } .
            {
                :mythic a :Penguin .
            } => {
                :mythic :canFly false .
            } .
            {
                :mythic a :Mammal .
            } => {
                :mythic :hasWings false .
            } .
            {
                :mythic a :Bat .
            } => {
                :mythic :hasWings true .
                :mythic :canFly true .
            } .
            {
                :mythic a :Fish .
            } => {
                :mythic :canSwim true .
                :mythic :hasWings false .
            } .
            :tweety :canFly true .
            :tweety :hasWings true .
            :tweety :canFly false .
            :falco :canFly true .
            :falco :hasWings true .
            :opus :canFly false .
            :batsy :hasWings false .
            :batsy :hasWings true .
            :batsy :canFly true .
            :nemo :canSwim true .
            :nemo :hasWings false .
            :mythic :canFly true .
            :mythic :hasWings true .
        } log:includes {
            :mythic :canFly true .
        } .
    },
    {
        {
            :tweety a :Bird .
            :tweety a :Penguin .
            :falco a :Bird .
            :opus a :Penguin .
            :batsy a :Mammal .
            :batsy a :Bat .
            :nemo a :Fish .
            :mythic a :Bird .
            :mythic :canFly false .
            {
                :mythic a :Bird .
            } => {
                :mythic :canFly true .
                :mythic :hasWings true .
            } .
            {
                :mythic a :Penguin .
            } => {
                :mythic :canFly false .
            } .
            {
                :mythic a :Mammal .
            } => {
                :mythic :hasWings false .
            } .
            {
                :mythic a :Bat .
            } => {
                :mythic :hasWings true .
                :mythic :canFly true .
            } .
            {
                :mythic a :Fish .
            } => {
                :mythic :canSwim true .
                :mythic :hasWings false .
            } .
            :tweety :canFly true .
            :tweety :hasWings true .
            :tweety :canFly false .
            :falco :canFly true .
            :falco :hasWings true .
            :opus :canFly false .
            :batsy :hasWings false .
            :batsy :hasWings true .
            :batsy :canFly true .
            :nemo :canSwim true .
            :nemo :hasWings false .
            :mythic :canFly true .
            :mythic :hasWings true .
        } log:includes {
            :mythic :canFly false .
        } .
    }.

{
  :kb :hasFormula {
      :tweety a :Bird .
      :tweety a :Penguin .
      :falco a :Bird .
      :opus a :Penguin .
      :batsy a :Mammal .
      :batsy a :Bat .
      :nemo a :Fish .
      :mythic a :Bird .
      :mythic :canFly false .
      {
          ?x a :Bird .
      } => {
          ?x :canFly true .
          ?x :hasWings true .
      } .
      {
          ?x a :Penguin .
      } => {
          ?x :canFly false .
      } .
      {
          ?x a :Mammal .
      } => {
          ?x :hasWings false .
      } .
      {
          ?x a :Bat .
      } => {
          ?x :hasWings true .
          ?x :canFly true .
      } .
      {
          ?x a :Fish .
      } => {
          ?x :canSwim true .
          ?x :hasWings false .
      } .
  } .
}
  pe:fact "paraconsistent-animals.n3".

