@prefix : <https://eyereasoner.github.io/eyepl/examples/spec-2-5-assignment#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:route1 :distanceKm 16.0934 .
:route2 :distanceKm 8.0467 .

{ :route1 :distanceKm 16.0934 . }
  pe:rule 1;
  pe:binding
    [ pe:var "km"; pe:value 16.0934 ],
    [ pe:var "miles"; pe:value 10 ],
    [ pe:var "x"; pe:value :route1 ];
  pe:uses
    { :route1 :distanceMiles 10 . },
    { (10 1.60934) math:product 16.0934 . }.

{ :route1 :distanceMiles 10 . }
  pe:fact "spec-2-5-assignment.n3".

{ (10 1.60934) math:product 16.0934 . }
  pe:builtin math:product.

{ :route2 :distanceKm 8.0467 . }
  pe:rule 1;
  pe:binding
    [ pe:var "km"; pe:value 8.0467 ],
    [ pe:var "miles"; pe:value 5 ],
    [ pe:var "x"; pe:value :route2 ];
  pe:uses
    { :route2 :distanceMiles 5 . },
    { (5 1.60934) math:product 8.0467 . }.

{ :route2 :distanceMiles 5 . }
  pe:fact "spec-2-5-assignment.n3".

{ (5 1.60934) math:product 8.0467 . }
  pe:builtin math:product.
