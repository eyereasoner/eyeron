{ :HighRiskClinic :trustsPositiveInWorld :W0 . }
  pe:rule 2;
  pe:binding
    [ pe:var "PPV"; pe:value 0.9166666666666666 ],
    [ pe:var "S"; pe:value :HighRiskClinic ];
  pe:uses
    { :HighRiskClinic :ppv_Bayes 0.9166666666666666 . },
    { 0.9166666666666666 math:notLessThan 0.9 . }.

{ :HighRiskClinic :ppv_Bayes 0.9166666666666666 . }
  pe:rule 1;
  pe:binding
    [ pe:var "PPV"; pe:value 0.9166666666666666 ],
    [ pe:var "S"; pe:value :HighRiskClinic ],
    [ pe:var "Se"; pe:value 0.99 ],
    [ pe:var "Sp"; pe:value 0.99 ],
    [ pe:var "denom"; pe:value 0.10800000000000001 ],
    [ pe:var "fp"; pe:value 0.009000000000000008 ],
    [ pe:var "fpr"; pe:value 0.010000000000000009 ],
    [ pe:var "num"; pe:value 0.099 ],
    [ pe:var "p"; pe:value 0.10 ],
    [ pe:var "pNeg"; pe:value 0.9 ];
  pe:uses
    { :HighRiskClinic a :Scenario . },
    { :HighRiskClinic :prevalence 0.10 . },
    { :HighRiskClinic :sensitivity 0.99 . },
    { :HighRiskClinic :specificity 0.99 . },
    { (0.99 0.10) math:product 0.099 . },
    { (1.0 0.10) math:difference 0.9 . },
    { (1.0 0.99) math:difference 0.010000000000000009 . },
    { (0.010000000000000009 0.9) math:product 0.009000000000000008 . },
    { (0.099 0.009000000000000008) math:sum 0.10800000000000001 . },
    { (0.099 0.10800000000000001) math:quotient 0.9166666666666666 . }.

{ :HighRiskClinic a :Scenario . }
  pe:fact "screening-trust-worlds.n3".

{ :HighRiskClinic :prevalence 0.10 . }
  pe:fact "screening-trust-worlds.n3".

{ :HighRiskClinic :sensitivity 0.99 . }
  pe:fact "screening-trust-worlds.n3".

{ :HighRiskClinic :specificity 0.99 . }
  pe:fact "screening-trust-worlds.n3".

{ (0.99 0.10) math:product 0.099 . }
  pe:builtin math:product.

{ (1.0 0.10) math:difference 0.9 . }
  pe:builtin math:difference.

{ (1.0 0.99) math:difference 0.010000000000000009 . }
  pe:builtin math:difference.

{ (0.010000000000000009 0.9) math:product 0.009000000000000008 . }
  pe:builtin math:product.

{ (0.099 0.009000000000000008) math:sum 0.10800000000000001 . }
  pe:builtin math:sum.

{ (0.099 0.10800000000000001) math:quotient 0.9166666666666666 . }
  pe:builtin math:quotient.

{ 0.9166666666666666 math:notLessThan 0.9 . }
  pe:builtin math:notLessThan.

