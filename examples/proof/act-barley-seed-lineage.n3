    { :mainSeed :hasVehicle :mainEmbryoVehicle . },
    { :mainEmbryoVehicle :usesRepair :mainRepair . },
    { :mainRepair a :RepairVehicle . },
    { :zygote a :DevelopmentalBottleneck . }.

