PREFIX : <https://eyereasoner.github.io/eyeling/examples/rdf-message-microgrid#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :clinicMicrogrid :criticalWatts 620 .
  :clinicMicrogrid :availableWatts 800 .
  :clinicMicrogrid :deferrableWatts 600 .
  :clinicMicrogrid :protectedBudgetWatts 1400 .
  :clinicMicrogrid :resilienceAction :protectClinic .

  _:step1
    rdf:reifies <<(:clinicMicrogrid :criticalWatts 620)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "f"; pe:value 120 ],
      [ pe:var "o"; pe:value 500 ],
      [ pe:var "w"; pe:value 620 ];
    pe:uses
      <<(:oxygenConcentrator :requiresWatts 500)>>,
      <<(:vaccineFridge :requiresWatts 120)>>.

  _:step2
    rdf:reifies <<(:clinicMicrogrid :availableWatts 800)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "b"; pe:value 650 ],
      [ pe:var "s"; pe:value 150 ],
      [ pe:var "w"; pe:value 800 ];
    pe:uses
      <<(:batteryBank :availableWatts 650)>>,
      <<(:solarForecast :expectedWatts 150)>>.

  _:step3
    rdf:reifies <<(:clinicMicrogrid :deferrableWatts 600)>>;
    pe:rule 3;
    pe:binding [ pe:var "w"; pe:value 600 ];
    pe:uses <<(:evChargers :shedWatts 600)>>.

  _:step4
    rdf:reifies <<(:clinicMicrogrid :protectedBudgetWatts 1400)>>;
    pe:rule 4;
    pe:binding
      [ pe:var "a"; pe:value 800 ],
      [ pe:var "d"; pe:value 600 ],
      [ pe:var "w"; pe:value 1400 ];
    pe:uses
      _:step2,
      _:step3.

  _:step5
    rdf:reifies <<(:clinicMicrogrid :resilienceAction :protectClinic)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "c"; pe:value 620 ],
      [ pe:var "p"; pe:value 1400 ];
    pe:uses
      _:step4,
      _:step1.
}
