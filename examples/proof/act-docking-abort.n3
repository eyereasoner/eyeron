{ :quantumSeal :cannot :UniversalClone . }
  pe:rule 6;
  pe:binding
    [ pe:var "M"; pe:value :quantumSeal ],
    [ pe:var "V"; pe:value :SealVariable ];
  pe:uses
    { :quantumSeal a :SuperinformationMedium . },
    { :quantumSeal :encodes :SealVariable . }.

{ :quantumSeal a :SuperinformationMedium . }
  pe:fact "act-docking-abort.n3".

{ :quantumSeal :encodes :SealVariable . }
  pe:fact "act-docking-abort.n3".

{ :quantumSeal :cannot :UnrestrictedAuditFanOut . }
  pe:rule 7;
  pe:binding [ pe:var "M"; pe:value :quantumSeal ];
  pe:uses { :quantumSeal :cannot :UniversalClone . }.

