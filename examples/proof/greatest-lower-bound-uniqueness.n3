      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g2 ];
    pe:uses { :g2 :glbOf (:a :b) . }.

  { :g1 :leq :g2 . }
    pe:by [ pe:rule "greatest-lower-bound-uniqueness.n3"; pe:line 124 ];
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "l"; pe:value :g1 ],
      [ pe:var "m"; pe:value :g2 ];
    pe:uses
      { :g2 :glbOf (:a :b) . },
      { :g1 :lowerBoundOf (:a :b) . }.

  { :g1 :lowerBoundOf (:a :b) . }
    pe:by [ pe:rule "greatest-lower-bound-uniqueness.n3"; pe:line 110 ];
    pe:binding
      [ pe:var "a"; pe:value :a ],
      [ pe:var "b"; pe:value :b ],
      [ pe:var "m"; pe:value :g1 ];
    pe:uses { :g1 :glbOf (:a :b) . }.
}.