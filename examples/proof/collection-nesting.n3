@prefix : <http://example/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:test :first 1 .
:test :secondProperty :q .
:test :thirdFirst 2 .

{ :test :first 1 . }
  pe:rule 1;
  pe:binding
    [ pe:var "first"; pe:value 1 ],
    [ pe:var "second"; pe:value (:node :q) ],
    [ pe:var "third"; pe:value (2) ];
  pe:uses { :root :nested (1 (:node :q) (2)) . }.

{ :root :nested (1 (:node :q) (2)) . }
  pe:fact "collection-nesting.n3".

{ :test :secondProperty :q . }
  pe:rule 2;
  pe:binding
    [ pe:var "first"; pe:value 1 ],
    [ pe:var "third"; pe:value (2) ],
    [ pe:var "value"; pe:value :q ];
  pe:uses { :root :nested (1 (:node :q) (2)) . }.

{ :test :thirdFirst 2 . }
  pe:rule 3;
  pe:binding
    [ pe:var "first"; pe:value 1 ],
    [ pe:var "second"; pe:value (:node :q) ],
    [ pe:var "value"; pe:value 2 ];
  pe:uses { :root :nested (1 (:node :q) (2)) . }.
