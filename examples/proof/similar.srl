PREFIX : <https://eyereasoner.github.io/ns#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :Alice :similar :Bob .
  :Bob :similar :Alice .
  :test :is true .

  _:step1
    rdf:reifies <<(:Alice :similar :Bob)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "A"; pe:value :Alice ],
      [ pe:var "B"; pe:value :Bob ],
      [ pe:var "Obj"; pe:value :Human ],
      [ pe:var "Pred"; pe:value rdf:type ];
    pe:uses
      <<(:Alice a :Human)>>,
      <<(:Bob a :Human)>>.

  _:step2
    rdf:reifies <<(:Bob :similar :Alice)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "A"; pe:value :Bob ],
      [ pe:var "B"; pe:value :Alice ],
      [ pe:var "Obj"; pe:value :Human ],
      [ pe:var "Pred"; pe:value rdf:type ];
    pe:uses
      <<(:Bob a :Human)>>,
      <<(:Alice a :Human)>>.

  _:step3
    rdf:reifies <<(:test :is true)>>;
    pe:rule 2;
    pe:uses _:step1.
}
