PREFIX : <http://example.org/proof-audit#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :stepMortal :dependsOn :stepHuman .
  :stepMortal :dependsOn :stepSubClass .
  :stepHuman :sourceFact true .
  :stepSubClass :sourceFact true .
  :test :root :stepMortal .
  :stepHuman :supportedBy :stepHuman .
  :stepSubClass :supportedBy :stepSubClass .
  :stepMortal :supportedBy :stepHuman .
  :stepMortal :supportedBy :stepSubClass .
  :test :queryDependency :stepHuman .
  :test :queryDependency :stepSubClass .
  :test :support :stepHuman .
  :test :support :stepSubClass .
  _:b4_517b3be80e8ffd1b a :AnswerApplied .
  _:b4_517b3be80e8ffd1b :var "A" .
  _:b4_517b3be80e8ffd1b :value :Human .
  _:b4_b74b502731877675 a :AnswerApplied .
  _:b4_b74b502731877675 :var "B" .
  _:b4_b74b502731877675 :value :Mortal .
  _:b4_67f64218deb828d6 a :AnswerApplied .
  _:b4_67f64218deb828d6 :var "S" .
  _:b4_67f64218deb828d6 :value :Socrates .

  _:step1
    rdf:reifies <<(:stepMortal :dependsOn :stepHuman)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "dep"; pe:value :stepHuman ],
      [ pe:var "step"; pe:value :stepMortal ];
    pe:uses <<(:stepMortal pe:uses :stepHuman)>>.

  _:step2
    rdf:reifies <<(:stepMortal :dependsOn :stepSubClass)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "dep"; pe:value :stepSubClass ],
      [ pe:var "step"; pe:value :stepMortal ];
    pe:uses <<(:stepMortal pe:uses :stepSubClass)>>.

  _:step3
    rdf:reifies <<(:stepHuman :sourceFact true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "src"; pe:value "socrates.srl" ],
      [ pe:var "step"; pe:value :stepHuman ];
    pe:uses <<(:stepHuman pe:fact "socrates.srl")>>.

  _:step4
    rdf:reifies <<(:stepSubClass :sourceFact true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "src"; pe:value "socrates.srl" ],
      [ pe:var "step"; pe:value :stepSubClass ];
    pe:uses <<(:stepSubClass pe:fact "socrates.srl")>>.

  _:step5
    rdf:reifies <<(:test :root :stepMortal)>>;
    pe:rule "rule#6";
    pe:binding
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "ruleName"; pe:value "socrates.srl" ];
    pe:uses <<(:stepMortal pe:rule "socrates.srl")>>.

  _:step6
    rdf:reifies <<(:stepHuman :supportedBy :stepHuman)>>;
    pe:rule "rule#4";
    pe:binding [ pe:var "step"; pe:value :stepHuman ];
    pe:uses _:step3.

  _:step7
    rdf:reifies <<(:stepSubClass :supportedBy :stepSubClass)>>;
    pe:rule "rule#4";
    pe:binding [ pe:var "step"; pe:value :stepSubClass ];
    pe:uses _:step4.

  _:step8
    rdf:reifies <<(:stepMortal :supportedBy :stepHuman)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "anc"; pe:value :stepHuman ],
      [ pe:var "step"; pe:value :stepMortal ];
    pe:uses
      _:step1,
      _:step3.

  _:step9
    rdf:reifies <<(:stepMortal :supportedBy :stepSubClass)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "anc"; pe:value :stepSubClass ],
      [ pe:var "step"; pe:value :stepMortal ];
    pe:uses
      _:step2,
      _:step4.

  _:step10
    rdf:reifies <<(:test :queryDependency :stepHuman)>>;
    pe:rule "rule#7";
    pe:binding
      [ pe:var "anc"; pe:value :stepHuman ],
      [ pe:var "root"; pe:value :stepMortal ];
    pe:uses
      _:step5,
      _:step1.

  _:step11
    rdf:reifies <<(:test :queryDependency :stepSubClass)>>;
    pe:rule "rule#7";
    pe:binding
      [ pe:var "anc"; pe:value :stepSubClass ],
      [ pe:var "root"; pe:value :stepMortal ];
    pe:uses
      _:step5,
      _:step2.

  _:step12
    rdf:reifies <<(:test :support :stepHuman)>>;
    pe:rule "rule#8";
    pe:binding
      [ pe:var "fact"; pe:value :stepHuman ],
      [ pe:var "root"; pe:value :stepMortal ];
    pe:uses
      _:step5,
      _:step8.

  _:step13
    rdf:reifies <<(:test :support :stepSubClass)>>;
    pe:rule "rule#8";
    pe:binding
      [ pe:var "fact"; pe:value :stepSubClass ],
      [ pe:var "root"; pe:value :stepMortal ];
    pe:uses
      _:step5,
      _:step9.

  _:step14
    rdf:reifies <<(_:b4_517b3be80e8ffd1b a :AnswerApplied)>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b1 ],
      [ pe:var "name"; pe:value "A" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Human ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b1)>>,
      <<(_:b1 pe:var "A")>>,
      <<(_:b1 pe:value :Human)>>.

  _:step15
    rdf:reifies <<(_:b4_517b3be80e8ffd1b :var "A")>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b1 ],
      [ pe:var "name"; pe:value "A" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Human ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b1)>>,
      <<(_:b1 pe:var "A")>>,
      <<(_:b1 pe:value :Human)>>.

  _:step16
    rdf:reifies <<(_:b4_517b3be80e8ffd1b :value :Human)>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b1 ],
      [ pe:var "name"; pe:value "A" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Human ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b1)>>,
      <<(_:b1 pe:var "A")>>,
      <<(_:b1 pe:value :Human)>>.

  _:step17
    rdf:reifies <<(_:b4_b74b502731877675 a :AnswerApplied)>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b2 ],
      [ pe:var "name"; pe:value "B" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Mortal ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b2)>>,
      <<(_:b2 pe:var "B")>>,
      <<(_:b2 pe:value :Mortal)>>.

  _:step18
    rdf:reifies <<(_:b4_b74b502731877675 :var "B")>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b2 ],
      [ pe:var "name"; pe:value "B" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Mortal ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b2)>>,
      <<(_:b2 pe:var "B")>>,
      <<(_:b2 pe:value :Mortal)>>.

  _:step19
    rdf:reifies <<(_:b4_b74b502731877675 :value :Mortal)>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b2 ],
      [ pe:var "name"; pe:value "B" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Mortal ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b2)>>,
      <<(_:b2 pe:var "B")>>,
      <<(_:b2 pe:value :Mortal)>>.

  _:step20
    rdf:reifies <<(_:b4_67f64218deb828d6 a :AnswerApplied)>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b3 ],
      [ pe:var "name"; pe:value "S" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Socrates ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b3)>>,
      <<(_:b3 pe:var "S")>>,
      <<(_:b3 pe:value :Socrates)>>.

  _:step21
    rdf:reifies <<(_:b4_67f64218deb828d6 :var "S")>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b3 ],
      [ pe:var "name"; pe:value "S" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Socrates ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b3)>>,
      <<(_:b3 pe:var "S")>>,
      <<(_:b3 pe:value :Socrates)>>.

  _:step22
    rdf:reifies <<(_:b4_67f64218deb828d6 :value :Socrates)>>;
    pe:rule "rule#9";
    pe:binding
      [ pe:var "bindingNode"; pe:value _:b3 ],
      [ pe:var "name"; pe:value "S" ],
      [ pe:var "root"; pe:value :stepMortal ],
      [ pe:var "value"; pe:value :Socrates ];
    pe:uses
      _:step5,
      <<(:stepMortal pe:binding _:b3)>>,
      <<(_:b3 pe:var "S")>>,
      <<(_:b3 pe:value :Socrates)>>.
}
