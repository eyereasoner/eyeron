PREFIX : <http://example/eyeling/annotation/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DATA {
  :test :hasStatement true .
  :test :hasNamedStatement :t .
  :test :statementAuthor :bob .
  :test :statementDate "2021-07-07"^^xsd:date .

  _:step1
    rdf:reifies <<( :test :hasStatement true )>>;
    pe:rule "annotation-evidence.srl";
    pe:line 11;
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :a :name "Alice" )>>;
    pe:fact "annotation-evidence.srl";
    pe:line 8.

  _:step3
    rdf:reifies <<( :test :hasNamedStatement :t )>>;
    pe:rule "annotation-evidence.srl";
    pe:line 14;
    pe:binding [ pe:var "statement"; pe:value :t ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :t rdf:reifies <<( :a :name "Alice" )>> )>>;
    pe:fact "annotation-evidence.srl";
    pe:line 8.

  _:step5
    rdf:reifies <<( :test :statementAuthor :bob )>>;
    pe:rule "annotation-evidence.srl";
    pe:line 17;
    pe:binding
      [ pe:var "statement"; pe:value :t ],
      [ pe:var "who"; pe:value :bob ];
    pe:uses
      _:step4,
      _:step6.

  _:step6
    rdf:reifies <<( :t :statedBy :bob )>>;
    pe:fact "annotation-evidence.srl";
    pe:line 8.

  _:step7
    rdf:reifies <<( :test :statementDate "2021-07-07"^^xsd:date )>>;
    pe:rule "annotation-evidence.srl";
    pe:line 23;
    pe:binding
      [ pe:var "date"; pe:value "2021-07-07"^^xsd:date ],
      [ pe:var "statement"; pe:value :t ];
    pe:uses
      _:step4,
      _:step8.

  _:step8
    rdf:reifies <<( :t :recorded "2021-07-07"^^xsd:date )>>;
    pe:fact "annotation-evidence.srl";
    pe:line 8.
}
