PREFIX : <http://example/eyeling/annotation/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DATA {
  :test :hasStatement true .
  :test :hasNamedStatement :t .
  :test :statementAuthor :bob .
  :test :statementDate "2021-07-07"^^xsd:date .

  _:step1
    rdf:reifies <<(:test :hasStatement true)>>;
    pe:rule "rule#1";
    pe:uses <<(:a :name "Alice")>>.

  _:step2
    rdf:reifies <<(:test :hasNamedStatement :t)>>;
    pe:rule "rule#2";
    pe:binding [ pe:var "statement"; pe:value :t ];
    pe:uses <<(:t rdf:reifies <<(:a :name "Alice")>>)>>.

  _:step3
    rdf:reifies <<(:test :statementAuthor :bob)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "statement"; pe:value :t ],
      [ pe:var "who"; pe:value :bob ];
    pe:uses
      <<(:t rdf:reifies <<(:a :name "Alice")>>)>>,
      <<(:t :statedBy :bob)>>.

  _:step4
    rdf:reifies <<(:test :statementDate "2021-07-07"^^xsd:date)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "date"; pe:value "2021-07-07"^^xsd:date ],
      [ pe:var "statement"; pe:value :t ];
    pe:uses
      <<(:t rdf:reifies <<(:a :name "Alice")>>)>>,
      <<(:t :recorded "2021-07-07"^^xsd:date)>>.
}
