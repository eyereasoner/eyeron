PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :sentence1 :verb :open .
  :sentence1 :object :door .

  _:step1
    rdf:reifies <<(:sentence1 :verb :open)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "n"; pe:value :door ],
      [ pe:var "v"; pe:value :open ];
    pe:uses
      <<(:open a :Verb)>>,
      <<(:door a :Noun)>>.

  _:step2
    rdf:reifies <<(:sentence1 :object :door)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "n"; pe:value :door ],
      [ pe:var "v"; pe:value :open ];
    pe:uses
      <<(:open a :Verb)>>,
      <<(:door a :Noun)>>.
}
