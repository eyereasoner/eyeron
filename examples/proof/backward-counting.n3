@prefix : <http://example.org/#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:TEST :PASS 1 .

{ :TEST :PASS 1 . }
  pe:rule 2;
  pe:uses { :alice :canCountTo 10 . }.

{ :alice :canCountTo 10 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 9 ],
    [ pe:var "s"; pe:value 10 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 10 math:greaterThan 1 . },
    { (10 1) math:difference 9 . },
    { :alice :canCountTo 9 . }.

{ 10 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (10 1) math:difference 9 . }
  pe:builtin math:difference.

{ :alice :canCountTo 9 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 8 ],
    [ pe:var "s"; pe:value 9 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 9 math:greaterThan 1 . },
    { (9 1) math:difference 8 . },
    { :alice :canCountTo 8 . }.

{ 9 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (9 1) math:difference 8 . }
  pe:builtin math:difference.

{ :alice :canCountTo 8 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 7 ],
    [ pe:var "s"; pe:value 8 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 8 math:greaterThan 1 . },
    { (8 1) math:difference 7 . },
    { :alice :canCountTo 7 . }.

{ 8 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (8 1) math:difference 7 . }
  pe:builtin math:difference.

{ :alice :canCountTo 7 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 6 ],
    [ pe:var "s"; pe:value 7 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 7 math:greaterThan 1 . },
    { (7 1) math:difference 6 . },
    { :alice :canCountTo 6 . }.

{ 7 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (7 1) math:difference 6 . }
  pe:builtin math:difference.

{ :alice :canCountTo 6 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 5 ],
    [ pe:var "s"; pe:value 6 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 6 math:greaterThan 1 . },
    { (6 1) math:difference 5 . },
    { :alice :canCountTo 5 . }.

{ 6 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (6 1) math:difference 5 . }
  pe:builtin math:difference.

{ :alice :canCountTo 5 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 4 ],
    [ pe:var "s"; pe:value 5 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 5 math:greaterThan 1 . },
    { (5 1) math:difference 4 . },
    { :alice :canCountTo 4 . }.

{ 5 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (5 1) math:difference 4 . }
  pe:builtin math:difference.

{ :alice :canCountTo 4 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 3 ],
    [ pe:var "s"; pe:value 4 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 4 math:greaterThan 1 . },
    { (4 1) math:difference 3 . },
    { :alice :canCountTo 3 . }.

{ 4 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (4 1) math:difference 3 . }
  pe:builtin math:difference.

{ :alice :canCountTo 3 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 2 ],
    [ pe:var "s"; pe:value 3 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 3 math:greaterThan 1 . },
    { (3 1) math:difference 2 . },
    { :alice :canCountTo 2 . }.

{ 3 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (3 1) math:difference 2 . }
  pe:builtin math:difference.

{ :alice :canCountTo 2 . }
  pe:rule 1;
  pe:binding
    [ pe:var "n"; pe:value 1 ],
    [ pe:var "s"; pe:value 2 ],
    [ pe:var "x"; pe:value :alice ];
  pe:uses
    { 2 math:greaterThan 1 . },
    { (2 1) math:difference 1 . },
    { :alice :canCountTo 1 . }.

{ 2 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ (2 1) math:difference 1 . }
  pe:builtin math:difference.

{ :alice :canCountTo 1 . }
  pe:fact "backward-counting.n3".
