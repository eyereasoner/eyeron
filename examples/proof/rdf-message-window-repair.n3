        in:run see:description "A true RDF 1.2 Message Log for sliding-window repair of an open/closed fire-door inconsistency." .
        in:run see:compiler "Eyeron RDF Message Log input" .
    } log:includes {
        :doorA :windowSize 3 .
        :doorA :repairPolicy :preferHigherPriority .
        :open :actionText "send a technician to inspect and close the fire door" .
        :open :stateText "open" .
        :closed :actionText "mark the fire compartment as sealed" .
        :closed :stateText "closed" .
    } .
}
