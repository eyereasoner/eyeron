{ :o1 :ingresses :red . } pe:why {
  { :o1 :ingresses :red . }
    pe:rule 6;
    pe:binding
      [ pe:var "form"; pe:value :red ],
      [ pe:var "o"; pe:value :o1 ];
    pe:uses
      { :o1 :realizes :red . },
      { :red a :PurePotential . }.

  { :o1 :realizes :red . }
    pe:fact "whitehead-becoming.n3".

  { :red a :PurePotential . }
    pe:fact "whitehead-becoming.n3".
}.

