@prefix : <http://example.org/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix time: <http://www.w3.org/2000/10/swap/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:out :year 2023 .
:out :month 4 .
:out :day 1 .
:out :minute 6 .
:out :second 4 .
:out :tz "Z" .

{ :out :year 2023 . }
  pe:rule 1;
  pe:binding
    [ pe:var "d"; pe:value "2023-04-01T18:06:04Z"^^xsd:dateTime ],
    [ pe:var "day"; pe:value 1 ],
    [ pe:var "m"; pe:value 4 ],
    [ pe:var "min"; pe:value 6 ],
    [ pe:var "sec"; pe:value 4 ],
    [ pe:var "tz"; pe:value "Z" ],
    [ pe:var "y"; pe:value 2023 ];
  pe:uses
    { :Let :dt "2023-04-01T18:06:04Z"^^xsd:dateTime . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:year 2023 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:month 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:day 1 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:minute 6 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:second 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:timeZone "Z" . }.

{ :Let :dt "2023-04-01T18:06:04Z"^^xsd:dateTime . }
  pe:fact "time.n3".

{ "2023-04-01T18:06:04Z"^^xsd:dateTime time:year 2023 . }
  pe:builtin time:year.

{ "2023-04-01T18:06:04Z"^^xsd:dateTime time:month 4 . }
  pe:builtin time:month.

{ "2023-04-01T18:06:04Z"^^xsd:dateTime time:day 1 . }
  pe:builtin time:day.

{ "2023-04-01T18:06:04Z"^^xsd:dateTime time:minute 6 . }
  pe:builtin time:minute.

{ "2023-04-01T18:06:04Z"^^xsd:dateTime time:second 4 . }
  pe:builtin time:second.

{ "2023-04-01T18:06:04Z"^^xsd:dateTime time:timeZone "Z" . }
  pe:builtin time:timeZone.

{ :out :month 4 . }
  pe:rule 1;
  pe:binding
    [ pe:var "d"; pe:value "2023-04-01T18:06:04Z"^^xsd:dateTime ],
    [ pe:var "day"; pe:value 1 ],
    [ pe:var "m"; pe:value 4 ],
    [ pe:var "min"; pe:value 6 ],
    [ pe:var "sec"; pe:value 4 ],
    [ pe:var "tz"; pe:value "Z" ],
    [ pe:var "y"; pe:value 2023 ];
  pe:uses
    { :Let :dt "2023-04-01T18:06:04Z"^^xsd:dateTime . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:year 2023 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:month 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:day 1 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:minute 6 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:second 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:timeZone "Z" . }.

{ :out :day 1 . }
  pe:rule 1;
  pe:binding
    [ pe:var "d"; pe:value "2023-04-01T18:06:04Z"^^xsd:dateTime ],
    [ pe:var "day"; pe:value 1 ],
    [ pe:var "m"; pe:value 4 ],
    [ pe:var "min"; pe:value 6 ],
    [ pe:var "sec"; pe:value 4 ],
    [ pe:var "tz"; pe:value "Z" ],
    [ pe:var "y"; pe:value 2023 ];
  pe:uses
    { :Let :dt "2023-04-01T18:06:04Z"^^xsd:dateTime . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:year 2023 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:month 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:day 1 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:minute 6 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:second 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:timeZone "Z" . }.

{ :out :minute 6 . }
  pe:rule 1;
  pe:binding
    [ pe:var "d"; pe:value "2023-04-01T18:06:04Z"^^xsd:dateTime ],
    [ pe:var "day"; pe:value 1 ],
    [ pe:var "m"; pe:value 4 ],
    [ pe:var "min"; pe:value 6 ],
    [ pe:var "sec"; pe:value 4 ],
    [ pe:var "tz"; pe:value "Z" ],
    [ pe:var "y"; pe:value 2023 ];
  pe:uses
    { :Let :dt "2023-04-01T18:06:04Z"^^xsd:dateTime . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:year 2023 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:month 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:day 1 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:minute 6 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:second 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:timeZone "Z" . }.

{ :out :second 4 . }
  pe:rule 1;
  pe:binding
    [ pe:var "d"; pe:value "2023-04-01T18:06:04Z"^^xsd:dateTime ],
    [ pe:var "day"; pe:value 1 ],
    [ pe:var "m"; pe:value 4 ],
    [ pe:var "min"; pe:value 6 ],
    [ pe:var "sec"; pe:value 4 ],
    [ pe:var "tz"; pe:value "Z" ],
    [ pe:var "y"; pe:value 2023 ];
  pe:uses
    { :Let :dt "2023-04-01T18:06:04Z"^^xsd:dateTime . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:year 2023 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:month 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:day 1 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:minute 6 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:second 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:timeZone "Z" . }.

{ :out :tz "Z" . }
  pe:rule 1;
  pe:binding
    [ pe:var "d"; pe:value "2023-04-01T18:06:04Z"^^xsd:dateTime ],
    [ pe:var "day"; pe:value 1 ],
    [ pe:var "m"; pe:value 4 ],
    [ pe:var "min"; pe:value 6 ],
    [ pe:var "sec"; pe:value 4 ],
    [ pe:var "tz"; pe:value "Z" ],
    [ pe:var "y"; pe:value 2023 ];
  pe:uses
    { :Let :dt "2023-04-01T18:06:04Z"^^xsd:dateTime . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:year 2023 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:month 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:day 1 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:minute 6 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:second 4 . },
    { "2023-04-01T18:06:04Z"^^xsd:dateTime time:timeZone "Z" . }.
