@prefix : <http://example/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:g1 a :SocialGraphTerm .
:g1 :mentions :alice .
:g1 :mentions :bob .
:g2 :mentions :alice .
:g1 :mentions :carol .
:g2 :mentions :tea .

{ :g1 a :SocialGraphTerm . } pe:why {
  { :g1 a :SocialGraphTerm . }
    pe:by [ pe:rule "graph-term-emulation.n3"; pe:line 15 ];
    pe:binding
      [ pe:var "formula"; pe:value {
          :alice :knows :bob .
          :bob :knows :carol .
      } ],
      [ pe:var "g"; pe:value :g1 ],
      [ pe:var "o"; pe:value :bob ],
      [ pe:var "s"; pe:value :alice ];
    pe:uses
      {
          :g1 :graphTerm {
              :alice :knows :bob .
              :bob :knows :carol .
          } .
      },
      {
          {
              :alice :knows :bob .
              :bob :knows :carol .
          } log:includes {
              :alice :knows :bob .
          } .
      }.

  {
    :g1 :graphTerm {
        :alice :knows :bob .
        :bob :knows :carol .
    } .
}
    pe:by [ pe:fact "graph-term-emulation.n3"; pe:line 11 ].

  {
    {
        :alice :knows :bob .
        :bob :knows :carol .
    } log:includes {
        :alice :knows :bob .
    } .
}
    pe:by [ pe:builtin log:includes ].
}.

