    {
        ({
            ?a list:in (-2 -1 -0.5 -0.1 0 0.5 1 1.3 1.4 1.41 1.414 1.4142 1.4143 1.42 1.5 2) .
            ?b list:in (-2 -1 -0.5 -0.1 0 0.5 1 1.3 1.4 1.41 1.414 1.4142 1.4143 1.42 1.5 2) .
            ?a math:lessThan ?b .
            :sqrt2Cut :seedLeft ?b .
        } {
            :sqrt2Cut :seedLeft ?a .
        }) log:forAllIn 1 .
    }.

{
