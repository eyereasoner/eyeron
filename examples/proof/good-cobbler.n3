@prefix : <https://eyereasoner.github.io/ns#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:test :is {
    :joe :is (:good :Cobbler) .
} .

{
  :test :is {
      :joe :is (:good :Cobbler) .
  } .
}
  pe:rule 1;
  pe:binding
    [ pe:var "X"; pe:value :joe ],
    [ pe:var "Y"; pe:value :Cobbler ];
  pe:uses { :joe :is (:good :Cobbler) . }.

{ :joe :is (:good :Cobbler) . }
  pe:fact "good-cobbler.n3".
