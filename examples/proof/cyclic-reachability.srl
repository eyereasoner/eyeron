PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :a :path :b .
  :b :path :c .
  :c :path :a .
  :a :path :c .
  :b :path :a .
  :c :path :b .
  :a :path :a .
  :b :path :b .
  :c :path :c .

  _:step1
    rdf:reifies <<(:a :path :b)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ];
    pe:uses <<(:a :edge :b)>>.

  _:step2
    rdf:reifies <<(:b :path :c)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ];
    pe:uses <<(:b :edge :c)>>.

  _:step3
    rdf:reifies <<(:c :path :a)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :a ];
    pe:uses <<(:c :edge :a)>>.

  _:step4
    rdf:reifies <<(:a :path :c)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ],
      [ pe:var "z"; pe:value :c ];
    pe:uses
      _:step1,
      <<(:b :edge :c)>>.

  _:step5
    rdf:reifies <<(:b :path :a)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ],
      [ pe:var "z"; pe:value :a ];
    pe:uses
      _:step2,
      <<(:c :edge :a)>>.

  _:step6
    rdf:reifies <<(:c :path :b)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :a ],
      [ pe:var "z"; pe:value :b ];
    pe:uses
      _:step3,
      <<(:a :edge :b)>>.

  _:step7
    rdf:reifies <<(:a :path :a)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :c ],
      [ pe:var "z"; pe:value :a ];
    pe:uses
      _:step4,
      <<(:c :edge :a)>>.

  _:step8
    rdf:reifies <<(:b :path :b)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :a ],
      [ pe:var "z"; pe:value :b ];
    pe:uses
      _:step5,
      <<(:a :edge :b)>>.

  _:step9
    rdf:reifies <<(:c :path :c)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :b ],
      [ pe:var "z"; pe:value :c ];
    pe:uses
      _:step6,
      <<(:b :edge :c)>>.
}
