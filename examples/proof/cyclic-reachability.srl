PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :a :path :b .
  :b :path :c .
  :c :path :a .
  :a :path :c .
  :b :path :a .
  :c :path :b .
  :a :path :a .
  :b :path :b .
  :c :path :c .

  _:step1
    rdf:reifies <<( :a :path :b )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 12;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :a :edge :b )>>;
    pe:fact "cyclic-reachability.srl";
    pe:line 7.

  _:step3
    rdf:reifies <<( :b :path :c )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 12;
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :b :edge :c )>>;
    pe:fact "cyclic-reachability.srl";
    pe:line 8.

  _:step5
    rdf:reifies <<( :c :path :a )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 12;
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :a ];
    pe:uses _:step6.

  _:step6
    rdf:reifies <<( :c :edge :a )>>;
    pe:fact "cyclic-reachability.srl";
    pe:line 9.

  _:step7
    rdf:reifies <<( :a :path :c )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ],
      [ pe:var "z"; pe:value :c ];
    pe:uses
      _:step1,
      _:step4.

  _:step8
    rdf:reifies <<( :b :path :a )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ],
      [ pe:var "z"; pe:value :a ];
    pe:uses
      _:step3,
      _:step6.

  _:step9
    rdf:reifies <<( :c :path :b )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :a ],
      [ pe:var "z"; pe:value :b ];
    pe:uses
      _:step5,
      _:step2.

  _:step10
    rdf:reifies <<( :a :path :a )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :c ],
      [ pe:var "z"; pe:value :a ];
    pe:uses
      _:step7,
      _:step6.

  _:step11
    rdf:reifies <<( :b :path :b )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :a ],
      [ pe:var "z"; pe:value :b ];
    pe:uses
      _:step8,
      _:step2.

  _:step12
    rdf:reifies <<( :c :path :c )>>;
    pe:rule "cyclic-reachability.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :b ],
      [ pe:var "z"; pe:value :c ];
    pe:uses
      _:step9,
      _:step4.
}
