PREFIX : <https://eyereasoner.github.io/eyeling/examples/rdf-message-cold-chain-recall#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :obs040 :alreadyCommitted true .
  :obs041 :alreadyCommitted true .
  :obs042 :alreadyCommitted true .
  :obs043 :newlyEmitted true .
  :obs044 :newlyEmitted true .
  :obs045 :newlyEmitted true .
  :obs046 :newlyEmitted true .
  :obs047 :newlyEmitted true .
  :obs048 :newlyEmitted true .
  :obs043 :inWindow true .
  :obs044 :inWindow true .
  :obs045 :inWindow true .
  :obs046 :inWindow true .
  :obs047 :inWindow true .
  :obs048 :inWindow true .
  :batchA :rawConflict true .
  :currentColdChainWindow :preferredEvidence :obs047 .
  :currentColdChainWindow :repairedTemperatureTenthC 118 .
  :currentColdChainWindow :preferredPriority 5 .
  :currentColdChainWindow :preferredSource "calibrated-cold-chain-logger" .
  :quarantineDecision :decisionText "quarantine batchA, notify QA, and hold shipment" .

  _:step1
    rdf:reifies <<(:obs040 :alreadyCommitted true)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs040 ],
      [ pe:var "seq"; pe:value 40 ];
    pe:uses
      <<(:obs040 :sequence 40)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step2
    rdf:reifies <<(:obs041 :alreadyCommitted true)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs041 ],
      [ pe:var "seq"; pe:value 41 ];
    pe:uses
      <<(:obs041 :sequence 41)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step3
    rdf:reifies <<(:obs042 :alreadyCommitted true)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs042 ],
      [ pe:var "seq"; pe:value 42 ];
    pe:uses
      <<(:obs042 :sequence 42)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step4
    rdf:reifies <<(:obs043 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs043 ],
      [ pe:var "seq"; pe:value 43 ];
    pe:uses
      <<(:obs043 :sequence 43)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step5
    rdf:reifies <<(:obs044 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs044 ],
      [ pe:var "seq"; pe:value 44 ];
    pe:uses
      <<(:obs044 :sequence 44)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step6
    rdf:reifies <<(:obs045 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs045 ],
      [ pe:var "seq"; pe:value 45 ];
    pe:uses
      <<(:obs045 :sequence 45)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step7
    rdf:reifies <<(:obs046 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs046 ],
      [ pe:var "seq"; pe:value 46 ];
    pe:uses
      <<(:obs046 :sequence 46)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step8
    rdf:reifies <<(:obs047 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs047 ],
      [ pe:var "seq"; pe:value 47 ];
    pe:uses
      <<(:obs047 :sequence 47)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step9
    rdf:reifies <<(:obs048 :newlyEmitted true)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "b"; pe:value 42 ],
      [ pe:var "m"; pe:value :obs048 ],
      [ pe:var "seq"; pe:value 48 ];
    pe:uses
      <<(:obs048 :sequence 48)>>,
      <<(:telemetryStream :lastCommittedSequence 42)>>.

  _:step10
    rdf:reifies <<(:obs043 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs043 ],
      [ pe:var "seq"; pe:value 43 ],
      [ pe:var "w"; pe:value 43 ];
    pe:uses
      _:step4,
      <<(:obs043 :sequence 43)>>,
      <<(:telemetryStream :currentWindowFromSequence 43)>>.

  _:step11
    rdf:reifies <<(:obs044 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs044 ],
      [ pe:var "seq"; pe:value 44 ],
      [ pe:var "w"; pe:value 43 ];
    pe:uses
      _:step5,
      <<(:obs044 :sequence 44)>>,
      <<(:telemetryStream :currentWindowFromSequence 43)>>.

  _:step12
    rdf:reifies <<(:obs045 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs045 ],
      [ pe:var "seq"; pe:value 45 ],
      [ pe:var "w"; pe:value 43 ];
    pe:uses
      _:step6,
      <<(:obs045 :sequence 45)>>,
      <<(:telemetryStream :currentWindowFromSequence 43)>>.

  _:step13
    rdf:reifies <<(:obs046 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs046 ],
      [ pe:var "seq"; pe:value 46 ],
      [ pe:var "w"; pe:value 43 ];
    pe:uses
      _:step7,
      <<(:obs046 :sequence 46)>>,
      <<(:telemetryStream :currentWindowFromSequence 43)>>.

  _:step14
    rdf:reifies <<(:obs047 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs047 ],
      [ pe:var "seq"; pe:value 47 ],
      [ pe:var "w"; pe:value 43 ];
    pe:uses
      _:step8,
      <<(:obs047 :sequence 47)>>,
      <<(:telemetryStream :currentWindowFromSequence 43)>>.

  _:step15
    rdf:reifies <<(:obs048 :inWindow true)>>;
    pe:rule "rule#3";
    pe:binding
      [ pe:var "m"; pe:value :obs048 ],
      [ pe:var "seq"; pe:value 48 ],
      [ pe:var "w"; pe:value 43 ];
    pe:uses
      _:step9,
      <<(:obs048 :sequence 48)>>,
      <<(:telemetryStream :currentWindowFromSequence 43)>>.

  _:step16
    rdf:reifies <<(:batchA :rawConflict true)>>;
    pe:rule "rule#4";
    pe:binding
      [ pe:var "limit"; pe:value 80 ],
      [ pe:var "m1"; pe:value :obs043 ],
      [ pe:var "m2"; pe:value :obs046 ],
      [ pe:var "t1"; pe:value 45 ],
      [ pe:var "t2"; pe:value 121 ];
    pe:uses
      _:step10,
      <<(:obs043 :temperatureTenthC 45)>>,
      _:step13,
      <<(:obs046 :temperatureTenthC 121)>>,
      <<(:telemetryStream :temperatureLimitTenthC 80)>>.

  _:step17
    rdf:reifies <<(:currentColdChainWindow :preferredEvidence :obs047)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "limit"; pe:value 80 ],
      [ pe:var "m"; pe:value :obs047 ],
      [ pe:var "priority"; pe:value 5 ],
      [ pe:var "source"; pe:value "calibrated-cold-chain-logger" ],
      [ pe:var "temp"; pe:value 118 ];
    pe:uses
      _:step14,
      <<(:obs047 :temperatureTenthC 118)>>,
      <<(:obs047 :priority 5)>>,
      <<(:obs047 :source "calibrated-cold-chain-logger")>>,
      <<(:obs047 :calibrationClass :calibratedLogger)>>,
      <<(:telemetryStream :temperatureLimitTenthC 80)>>.

  _:step18
    rdf:reifies <<(:currentColdChainWindow :repairedTemperatureTenthC 118)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "limit"; pe:value 80 ],
      [ pe:var "m"; pe:value :obs047 ],
      [ pe:var "priority"; pe:value 5 ],
      [ pe:var "source"; pe:value "calibrated-cold-chain-logger" ],
      [ pe:var "temp"; pe:value 118 ];
    pe:uses
      _:step14,
      <<(:obs047 :temperatureTenthC 118)>>,
      <<(:obs047 :priority 5)>>,
      <<(:obs047 :source "calibrated-cold-chain-logger")>>,
      <<(:obs047 :calibrationClass :calibratedLogger)>>,
      <<(:telemetryStream :temperatureLimitTenthC 80)>>.

  _:step19
    rdf:reifies <<(:currentColdChainWindow :preferredPriority 5)>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "limit"; pe:value 80 ],
      [ pe:var "m"; pe:value :obs047 ],
      [ pe:var "priority"; pe:value 5 ],
      [ pe:var "source"; pe:value "calibrated-cold-chain-logger" ],
      [ pe:var "temp"; pe:value 118 ];
    pe:uses
      _:step14,
      <<(:obs047 :temperatureTenthC 118)>>,
      <<(:obs047 :priority 5)>>,
      <<(:obs047 :source "calibrated-cold-chain-logger")>>,
      <<(:obs047 :calibrationClass :calibratedLogger)>>,
      <<(:telemetryStream :temperatureLimitTenthC 80)>>.

  _:step20
    rdf:reifies <<(:currentColdChainWindow :preferredSource "calibrated-cold-chain-logger")>>;
    pe:rule "rule#5";
    pe:binding
      [ pe:var "limit"; pe:value 80 ],
      [ pe:var "m"; pe:value :obs047 ],
      [ pe:var "priority"; pe:value 5 ],
      [ pe:var "source"; pe:value "calibrated-cold-chain-logger" ],
      [ pe:var "temp"; pe:value 118 ];
    pe:uses
      _:step14,
      <<(:obs047 :temperatureTenthC 118)>>,
      <<(:obs047 :priority 5)>>,
      <<(:obs047 :source "calibrated-cold-chain-logger")>>,
      <<(:obs047 :calibrationClass :calibratedLogger)>>,
      <<(:telemetryStream :temperatureLimitTenthC 80)>>.

  _:step21
    rdf:reifies <<(:quarantineDecision :decisionText "quarantine batchA, notify QA, and hold shipment")>>;
    pe:rule "rule#6";
    pe:binding [ pe:var "_"; pe:value :obs047 ];
    pe:uses _:step17.
}
