@prefix : <https://eyereasoner.github.io/eyepl/examples/unicode-and-signed-numbers#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:sample a :UnicodeDecoded .
:thermo a :BelowZero .

{ :sample a :UnicodeDecoded . }
  pe:rule 1;
  pe:uses { :sample :text "ABC" . }.

{ :sample :text "ABC" . }
  pe:fact "unicode-and-signed-numbers.n3".

{ :thermo a :BelowZero . }
  pe:rule 2;
  pe:binding [ pe:var "d"; pe:value -12 ];
  pe:uses
    { :thermo :delta -12 . },
    { -12 math:lessThan 0 . }.

{ :thermo :delta -12 . }
  pe:fact "unicode-and-signed-numbers.n3".

{ -12 math:lessThan 0 . }
  pe:builtin math:lessThan.
