PREFIX : <urn:example#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :a :ancestor :b .
  :b :ancestor :c .
  :c :ancestor :d .
  :a :ancestor :c .
  :b :ancestor :d .
  :a :reaches :b .
  :a :ancestor :d .
  :a :reaches :c .
  :a :reaches :d .

  _:step1
    rdf:reifies <<( :a :ancestor :b )>>;
    pe:rule "backward-recursion.srl";
    pe:line 12;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :a :parent :b )>>;
    pe:fact "backward-recursion.srl";
    pe:line 7.

  _:step3
    rdf:reifies <<( :b :ancestor :c )>>;
    pe:rule "backward-recursion.srl";
    pe:line 12;
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ];
    pe:uses _:step4.

  _:step4
    rdf:reifies <<( :b :parent :c )>>;
    pe:fact "backward-recursion.srl";
    pe:line 8.

  _:step5
    rdf:reifies <<( :c :ancestor :d )>>;
    pe:rule "backward-recursion.srl";
    pe:line 12;
    pe:binding
      [ pe:var "x"; pe:value :c ],
      [ pe:var "y"; pe:value :d ];
    pe:uses _:step6.

  _:step6
    rdf:reifies <<( :c :parent :d )>>;
    pe:fact "backward-recursion.srl";
    pe:line 9.

  _:step7
    rdf:reifies <<( :a :ancestor :c )>>;
    pe:rule "backward-recursion.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ],
      [ pe:var "z"; pe:value :c ];
    pe:uses
      _:step2,
      _:step3.

  _:step8
    rdf:reifies <<( :b :ancestor :d )>>;
    pe:rule "backward-recursion.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :b ],
      [ pe:var "y"; pe:value :c ],
      [ pe:var "z"; pe:value :d ];
    pe:uses
      _:step4,
      _:step5.

  _:step9
    rdf:reifies <<( :a :reaches :b )>>;
    pe:rule "backward-recursion.srl";
    pe:line 14;
    pe:binding [ pe:var "who"; pe:value :b ];
    pe:uses _:step1.

  _:step10
    rdf:reifies <<( :a :ancestor :d )>>;
    pe:rule "backward-recursion.srl";
    pe:line 13;
    pe:binding
      [ pe:var "x"; pe:value :a ],
      [ pe:var "y"; pe:value :b ],
      [ pe:var "z"; pe:value :d ];
    pe:uses
      _:step2,
      _:step8.

  _:step11
    rdf:reifies <<( :a :reaches :c )>>;
    pe:rule "backward-recursion.srl";
    pe:line 14;
    pe:binding [ pe:var "who"; pe:value :c ];
    pe:uses _:step7.

  _:step12
    rdf:reifies <<( :a :reaches :d )>>;
    pe:rule "backward-recursion.srl";
    pe:line 14;
    pe:binding [ pe:var "who"; pe:value :d ];
    pe:uses _:step10.
}
