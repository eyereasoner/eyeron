PREFIX : <http://example.com/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :X :childOf :A .
  :X :childOf :B .
  :A :childOf :C .
  :X :descendedFrom :A .
  :X :descendedFrom :B .
  :A :descendedFrom :C .

  _:step1
    rdf:reifies <<(:X :childOf :A)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :A ];
    pe:uses <<(:A :fatherOf :X)>>.

  _:step2
    rdf:reifies <<(:X :childOf :B)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :B ];
    pe:uses <<(:B :motherOf :X)>>.

  _:step3
    rdf:reifies <<(:A :childOf :C)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "x"; pe:value :A ],
      [ pe:var "y"; pe:value :C ];
    pe:uses <<(:C :motherOf :A)>>.

  _:step4
    rdf:reifies <<(:X :descendedFrom :A)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :A ];
    pe:uses _:step1.

  _:step5
    rdf:reifies <<(:X :descendedFrom :B)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :X ],
      [ pe:var "y"; pe:value :B ];
    pe:uses _:step2.

  _:step6
    rdf:reifies <<(:A :descendedFrom :C)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "x"; pe:value :A ],
      [ pe:var "y"; pe:value :C ];
    pe:uses _:step3.
}
