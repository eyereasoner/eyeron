@prefix : <https://eyereasoner.github.io/eyepl/examples/assignment#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:alice :grade (:pass 7) .

{ :alice :grade (:pass 7) . } pe:why {
  { :alice :grade (:pass 7) . }
    pe:rule 1;
    pe:binding
      [ pe:var "score"; pe:value 7 ],
      [ pe:var "x"; pe:value :alice ];
    pe:uses
      { :alice :score 7 . },
      { 7 math:notLessThan 5 . }.

  { :alice :score 7 . }
    pe:fact "assignment.n3".

  { 7 math:notLessThan 5 . }
    pe:builtin math:notLessThan.
}.
