@prefix : <http://example/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:alice :statementSource :chat .
:bob :statementSource :email .

{ :alice :statementSource :chat . }
  pe:rule 1;
  pe:binding
    [ pe:var "claim"; pe:value :claim1 ],
    [ pe:var "object"; pe:value "hello" ],
    [ pe:var "source"; pe:value :chat ],
    [ pe:var "speaker"; pe:value :alice ];
  pe:uses
    {
        :claim1 :statement {
            :alice :says "hello" .
        } .
    },
    { :claim1 :source :chat . }.

{
  :claim1 :statement {
      :alice :says "hello" .
  } .
}
  pe:fact "reifiers.n3".

{ :claim1 :source :chat . }
  pe:fact "reifiers.n3".

{ :bob :statementSource :email . }
  pe:rule 1;
  pe:binding
    [ pe:var "claim"; pe:value :claim2 ],
    [ pe:var "object"; pe:value "hi" ],
    [ pe:var "source"; pe:value :email ],
    [ pe:var "speaker"; pe:value :bob ];
  pe:uses
    {
        :claim2 :statement {
            :bob :says "hi" .
        } .
    },
    { :claim2 :source :email . }.

{
  :claim2 :statement {
      :bob :says "hi" .
  } .
}
  pe:fact "reifiers.n3".

{ :claim2 :source :email . }
  pe:fact "reifiers.n3".
