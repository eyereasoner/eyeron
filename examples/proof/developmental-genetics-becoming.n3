  pe:uses
    { :s3 :derivesFrom :s2 . },
    { :s2 :expresses :Sox2 . }.

{ :s3 :inheritsMarker :Pax6 . }
  pe:rule 1;
  pe:binding
    [ pe:var "earlier"; pe:value :s2 ],
