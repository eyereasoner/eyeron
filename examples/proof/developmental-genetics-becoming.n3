    { :s3 :considers :neuronalMaturationProgram . },
    { :neuronalMaturationProgram :compatibleWith :NeuroD1 . }.

{ :neuronalMaturationProgram :compatibleWith :NeuroD1 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s2 :realizes :proneuralProgram . }
  pe:rule 7;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "program"; pe:value :proneuralProgram ];
  pe:uses { :s2 :integrates :proneuralProgram . }.

{ :s3 :realizes :neuronalMaturationProgram . }
  pe:rule 7;
  pe:binding
    [ pe:var "cell"; pe:value :s3 ],
    [ pe:var "program"; pe:value :neuronalMaturationProgram ];
  pe:uses { :s3 :integrates :neuronalMaturationProgram . }.

{ :s2 :expresses :Sox2 . }
  pe:rule 6;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :Sox2 ];
  pe:uses { :s2 :preservesMarker :Sox2 . }.

{ :s2 :expresses :Pax6 . }
  pe:rule 6;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :Pax6 ];
  pe:uses { :s2 :preservesMarker :Pax6 . }.

{ :s3 :expresses :NeuroD1 . }
  pe:rule 6;
  pe:binding
    [ pe:var "cell"; pe:value :s3 ],
    [ pe:var "marker"; pe:value :NeuroD1 ];
  pe:uses { :s3 :preservesMarker :NeuroD1 . }.

{ :s2 :achieves :stableCellState . }
  pe:rule 8;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "program"; pe:value :proneuralProgram ];
  pe:uses { :s2 :realizes :proneuralProgram . }.

{ :s2 :availableForFurtherDifferentiation :yes . }
  pe:rule 8;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "program"; pe:value :proneuralProgram ];
  pe:uses { :s2 :realizes :proneuralProgram . }.

{ :s3 :achieves :stableCellState . }
  pe:rule 8;
  pe:binding
    [ pe:var "cell"; pe:value :s3 ],
    [ pe:var "program"; pe:value :neuronalMaturationProgram ];
  pe:uses { :s3 :realizes :neuronalMaturationProgram . }.

