{ :s3 :derivesFrom :s2 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s2 :preservesMarker :Sox2 . }
  pe:rule 4;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :Sox2 ],
    [ pe:var "program"; pe:value :proneuralProgram ];
  pe:uses
    { :s2 :inheritsMarker :Sox2 . },
    { :s2 :considers :proneuralProgram . },
    { :proneuralProgram :compatibleWith :Sox2 . }.

{ :proneuralProgram :compatibleWith :Sox2 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s2 :preservesMarker :Pax6 . }
  pe:rule 4;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :Pax6 ],
