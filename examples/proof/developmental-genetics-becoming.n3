{ :s2 :status :stableCellState . }
  pe:rule 9;
  pe:binding [ pe:var "cell"; pe:value :s2 ];
  pe:uses { :s2 :achieves :stableCellState . }.

{ :s3 :status :stableCellState . }
  pe:rule 9;
