@prefix : <http://example.org/genetics#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:s2 :considers :proneuralProgram .
:s2 :targetsMarker :NeuroD1 .
:s3 :considers :neuronalMaturationProgram .
:s3 :targetsMarker :Tubb3 .
:s2 :expresses :NeuroD1 .
:s2 :integrates :proneuralProgram .
:s3 :expresses :Tubb3 .
:s3 :integrates :neuronalMaturationProgram .
:s2 :inheritsMarker :Sox2 .
:s2 :inheritsMarker :Pax6 .
:s1 :status :stableCellState .
:s3 :inheritsMarker :NeuroD1 .
:s2 :preservesMarker :Sox2 .
:s2 :preservesMarker :Pax6 .
:s3 :preservesMarker :NeuroD1 .
:s2 :realizes :proneuralProgram .
:s3 :realizes :neuronalMaturationProgram .
:s2 :expresses :Sox2 .
:s2 :expresses :Pax6 .
:s3 :expresses :NeuroD1 .
:s2 :achieves :stableCellState .
:s2 :availableForFurtherDifferentiation :yes .
:s3 :achieves :stableCellState .
:s3 :availableForFurtherDifferentiation :yes .
:s3 :inheritsMarker :Sox2 .
:s3 :inheritsMarker :Pax6 .
:s2 :status :stableCellState .
:s3 :status :stableCellState .
:s3 :preservesMarker :Pax6 .
:s3 :expresses :Pax6 .

{ :s2 :considers :proneuralProgram . }
  pe:rule 2;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "program"; pe:value :proneuralProgram ],
    [ pe:var "signal"; pe:value :neurogenicSignal ];
  pe:uses
    { :s2 :receives :neurogenicSignal . },
    { :neurogenicSignal :suggests :proneuralProgram . }.

{ :s2 :receives :neurogenicSignal . }
  pe:fact "developmental-genetics-becoming.n3".

{ :neurogenicSignal :suggests :proneuralProgram . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s2 :targetsMarker :NeuroD1 . }
  pe:rule 3;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :NeuroD1 ],
    [ pe:var "signal"; pe:value :neurogenicSignal ];
  pe:uses
    { :s2 :receives :neurogenicSignal . },
    { :neurogenicSignal :introducesMarker :NeuroD1 . }.

{ :neurogenicSignal :introducesMarker :NeuroD1 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s3 :considers :neuronalMaturationProgram . }
  pe:rule 2;
  pe:binding
    [ pe:var "cell"; pe:value :s3 ],
    [ pe:var "program"; pe:value :neuronalMaturationProgram ],
    [ pe:var "signal"; pe:value :maturationSignal ];
  pe:uses
    { :s3 :receives :maturationSignal . },
    { :maturationSignal :suggests :neuronalMaturationProgram . }.

{ :s3 :receives :maturationSignal . }
  pe:fact "developmental-genetics-becoming.n3".

{ :maturationSignal :suggests :neuronalMaturationProgram . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s3 :targetsMarker :Tubb3 . }
  pe:rule 3;
  pe:binding
    [ pe:var "cell"; pe:value :s3 ],
    [ pe:var "marker"; pe:value :Tubb3 ],
    [ pe:var "signal"; pe:value :maturationSignal ];
  pe:uses
    { :s3 :receives :maturationSignal . },
    { :maturationSignal :introducesMarker :Tubb3 . }.

{ :maturationSignal :introducesMarker :Tubb3 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s2 :expresses :NeuroD1 . }
  pe:rule 5;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :NeuroD1 ],
    [ pe:var "program"; pe:value :proneuralProgram ];
  pe:uses
    { :s2 :targetsMarker :NeuroD1 . },
    { :s2 :considers :proneuralProgram . },
    { :proneuralProgram :enables :NeuroD1 . }.

{ :proneuralProgram :enables :NeuroD1 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s2 :integrates :proneuralProgram . }
  pe:rule 5;
  pe:binding
    [ pe:var "cell"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :NeuroD1 ],
    [ pe:var "program"; pe:value :proneuralProgram ];
  pe:uses
    { :s2 :targetsMarker :NeuroD1 . },
    { :s2 :considers :proneuralProgram . },
    { :proneuralProgram :enables :NeuroD1 . }.

{ :s3 :expresses :Tubb3 . }
  pe:rule 5;
  pe:binding
    [ pe:var "cell"; pe:value :s3 ],
    [ pe:var "marker"; pe:value :Tubb3 ],
    [ pe:var "program"; pe:value :neuronalMaturationProgram ];
  pe:uses
    { :s3 :targetsMarker :Tubb3 . },
    { :s3 :considers :neuronalMaturationProgram . },
    { :neuronalMaturationProgram :enables :Tubb3 . }.

{ :neuronalMaturationProgram :enables :Tubb3 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s3 :integrates :neuronalMaturationProgram . }
  pe:rule 5;
  pe:binding
    [ pe:var "cell"; pe:value :s3 ],
    [ pe:var "marker"; pe:value :Tubb3 ],
    [ pe:var "program"; pe:value :neuronalMaturationProgram ];
  pe:uses
    { :s3 :targetsMarker :Tubb3 . },
    { :s3 :considers :neuronalMaturationProgram . },
    { :neuronalMaturationProgram :enables :Tubb3 . }.

{ :s2 :inheritsMarker :Sox2 . }
  pe:rule 1;
  pe:binding
    [ pe:var "earlier"; pe:value :s1 ],
    [ pe:var "later"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :Sox2 ];
  pe:uses
    { :s2 :derivesFrom :s1 . },
    { :s1 :expresses :Sox2 . }.

{ :s2 :derivesFrom :s1 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s1 :expresses :Sox2 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s2 :inheritsMarker :Pax6 . }
  pe:rule 1;
  pe:binding
    [ pe:var "earlier"; pe:value :s1 ],
    [ pe:var "later"; pe:value :s2 ],
    [ pe:var "marker"; pe:value :Pax6 ];
  pe:uses
    { :s2 :derivesFrom :s1 . },
    { :s1 :expresses :Pax6 . }.

{ :s1 :expresses :Pax6 . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s1 :status :stableCellState . }
  pe:rule 9;
  pe:binding [ pe:var "cell"; pe:value :s1 ];
  pe:uses { :s1 :achieves :stableCellState . }.

{ :s1 :achieves :stableCellState . }
  pe:fact "developmental-genetics-becoming.n3".

{ :s3 :inheritsMarker :NeuroD1 . }
  pe:rule 1;
  pe:binding
    [ pe:var "earlier"; pe:value :s2 ],
