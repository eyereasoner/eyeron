PREFIX : <http://example.org/socrates#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :Socrates :is _:srl1 .
  :Plato :is _:srl2 .

  _:step1
    rdf:reifies <<(:Socrates :is _:srl1)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "s"; pe:value :Socrates ],
      [ pe:var "w"; pe:value _:srl1 ];
    pe:uses <<(:Socrates a :Human)>>.

  _:step2
    rdf:reifies <<(:Plato :is _:srl2)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "s"; pe:value :Plato ],
      [ pe:var "w"; pe:value _:srl2 ];
    pe:uses <<(:Plato a :Human)>>.
}
