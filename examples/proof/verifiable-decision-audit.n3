@prefix : <https://example.org/access#> .
@prefix doc: <https://example.org/doc/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:audit dpv:hasJustification doc:intake .
:audit dpv:hasJustification doc:ethics .
:audit dpv:hasJustification doc:consent .
:audit dpv:hasJustification doc:registry .

{ :audit dpv:hasJustification doc:intake . }
  pe:rule
    {
        {
            :audit dpv:hasDataSource ?doc .
        } => {
            :audit dpv:hasJustification ?doc .
        } .
    };
  pe:binding [ pe:var "doc"; pe:value doc:intake ];
  pe:uses { :audit dpv:hasDataSource doc:intake . }.

{ :audit dpv:hasDataSource doc:intake . }
  pe:rule 3;
  pe:binding
    [ pe:var "audit"; pe:value :audit ],
    [ pe:var "claim"; pe:value {
        :request-42 odrl:profile :research-profile .
    } ],
    [ pe:var "doc"; pe:value doc:intake ],
    [ pe:var "label"; pe:value "verifiable-decision.n3" ],
    [ pe:var "root"; pe:value {
        :agreement-42 a odrl:Agreement .
    } ];
  pe:uses
    { :audit a dpv:Audit . },
    {
        :audit dpv:hasScope {
            :agreement-42 a odrl:Agreement .
        } .
    },
    {
        {
            :agreement-42 a odrl:Agreement .
        } prov:wasDerivedFrom {
            :request-42 odrl:profile :research-profile .
        } .
    },
    {
        {
            :request-42 odrl:profile :research-profile .
        } pe:fact "verifiable-decision.n3" .
    },
    {
        {
            :request-42 odrl:profile :research-profile .
        } prov:hadPrimarySource doc:intake .
    }.

{ :audit a dpv:Audit . }
  pe:fact "verifiable-decision-audit.n3".

{
