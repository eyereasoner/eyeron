{ (:doorBeacon :doorBeacon) :canCopy :BreachBit . }
  pe:rule
    {
        {
            ?Task a :PossibleTask .
            ?Task :kind :Copy .
            ?Task :from ?From .
            ?Task :to ?To .
            ?Task :variable ?Variable .
        } => {
            (?From ?To) :canCopy ?Variable .
        } .
    };
  pe:binding
    [ pe:var "From"; pe:value :doorBeacon ],
    [ pe:var "Task"; pe:value _:b9_aca6292e9274c721 ],
    [ pe:var "To"; pe:value :doorBeacon ],
    [ pe:var "Variable"; pe:value :BreachBit ];
  pe:uses
