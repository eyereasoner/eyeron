PREFIX : <http://example.org/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :x :y 1 .
  :a :b :c .

  _:step1
    rdf:reifies <<( :x :y 1 )>>;
    pe:rule "log-not-includes.srl";
    pe:line 11;
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :one :equalsOne 1 )>>;
    pe:fact "log-not-includes.srl";
    pe:line 9.

  _:step3
    rdf:reifies <<( :a :b :c )>>;
    pe:rule "log-not-includes.srl";
    pe:line 12;
    pe:uses _:step1.
}
