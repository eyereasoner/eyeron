PREFIX : <http://example.org/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :x :y 1 .
  :a :b :c .

  _:step1
    rdf:reifies <<(:x :y 1)>>;
    pe:rule 1;
    pe:uses <<(:one :equalsOne 1)>>.

  _:step2
    rdf:reifies <<(:a :b :c)>>;
    pe:rule 2;
    pe:uses _:step1.
}
