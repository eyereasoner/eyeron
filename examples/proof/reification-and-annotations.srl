PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :statementSource :chat .
  :bob :statementSource :email .

  _:step1
    rdf:reifies <<( :alice :statementSource :chat )>>;
    pe:rule "reification-and-annotations.srl";
    pe:line 8;
    pe:binding
      [ pe:var "claim"; pe:value _:b1 ],
      [ pe:var "object"; pe:value :hello ],
      [ pe:var "source"; pe:value :chat ],
      [ pe:var "speaker"; pe:value :alice ];
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( _:b1 rdf:reifies <<( :alice :says :hello )>> )>>;
    pe:fact "reification-and-annotations.srl";
    pe:line 4.

  _:step3
    rdf:reifies <<( _:b1 :source :chat )>>;
    pe:fact "reification-and-annotations.srl";
    pe:line 4.

  _:step4
    rdf:reifies <<( :bob :statementSource :email )>>;
    pe:rule "reification-and-annotations.srl";
    pe:line 8;
    pe:binding
      [ pe:var "claim"; pe:value :bobClaim ],
      [ pe:var "object"; pe:value :hi ],
      [ pe:var "source"; pe:value :email ],
      [ pe:var "speaker"; pe:value :bob ];
    pe:uses
      _:step5,
      _:step6.

  _:step5
    rdf:reifies <<( :bobClaim rdf:reifies <<( :bob :says :hi )>> )>>;
    pe:fact "reification-and-annotations.srl";
    pe:line 5.

  _:step6
    rdf:reifies <<( :bobClaim :source :email )>>;
    pe:fact "reification-and-annotations.srl";
    pe:line 5.
}
