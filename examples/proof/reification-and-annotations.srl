PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :statementSource :chat .
  :bob :statementSource :email .

  _:step1
    rdf:reifies <<(:alice :statementSource :chat)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "claim"; pe:value _:b1 ],
      [ pe:var "object"; pe:value :hello ],
      [ pe:var "source"; pe:value :chat ],
      [ pe:var "speaker"; pe:value :alice ];
    pe:uses
      <<(_:b1 rdf:reifies <<(:alice :says :hello)>>)>>,
      <<(_:b1 :source :chat)>>.

  _:step2
    rdf:reifies <<(:bob :statementSource :email)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "claim"; pe:value :bobClaim ],
      [ pe:var "object"; pe:value :hi ],
      [ pe:var "source"; pe:value :email ],
      [ pe:var "speaker"; pe:value :bob ];
    pe:uses
      <<(:bobClaim rdf:reifies <<(:bob :says :hi)>>)>>,
      <<(:bobClaim :source :email)>>.
}
