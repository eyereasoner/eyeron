PREFIX : <http://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :test1 :is true .
  :test2 :is true .
  :test3 :is true .
  :test4 :is true .

  _:step1
    rdf:reifies <<( :test1 :is true )>>;
    pe:rule "list-map.srl";
    pe:line 15;
    pe:uses
      _:step2,
      _:step3.

  _:step2
    rdf:reifies <<( :s1 :p1 :o1 )>>;
    pe:fact "list-map.srl";
    pe:line 10.

  _:step3
    rdf:reifies <<( :s2 :p1 :o2 )>>;
    pe:fact "list-map.srl";
    pe:line 11.

  _:step4
    rdf:reifies <<( :test2 :is true )>>;
    pe:rule "list-map.srl";
    pe:line 19;
    pe:uses
      _:step2,
      _:step3,
      _:step5,
      _:step6.

  _:step5
    rdf:reifies <<( :s3 :p1 :o3 )>>;
    pe:fact "list-map.srl";
    pe:line 12.

  _:step6
    rdf:reifies <<( :s3 :p1 :o4 )>>;
    pe:fact "list-map.srl";
    pe:line 12.

  _:step7
    rdf:reifies <<( :test3 :is true )>>;
    pe:rule "list-map.srl";
    pe:line 23.

  _:step8
    rdf:reifies <<( :test4 :is true )>>;
    pe:rule "list-map.srl";
    pe:line 27.
}
