PREFIX : <http://example.org/#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :test1 :is true .
  :test2 :is true .
  :test3 :is true .
  :test4 :is true .

  _:step1
    rdf:reifies <<(:test1 :is true)>>;
    pe:rule 1;
    pe:uses
      <<(:s1 :p1 :o1)>>,
      <<(:s2 :p1 :o2)>>.

  _:step2
    rdf:reifies <<(:test2 :is true)>>;
    pe:rule 2;
    pe:uses
      <<(:s1 :p1 :o1)>>,
      <<(:s2 :p1 :o2)>>,
      <<(:s3 :p1 :o3)>>,
      <<(:s3 :p1 :o4)>>.

  _:step3
    rdf:reifies <<(:test3 :is true)>>;
    pe:rule 3.

  _:step4
    rdf:reifies <<(:test4 :is true)>>;
    pe:rule 4.
}
