PREFIX : <https://example.org/knowledge-engineering-alignment-flow#>
PREFIX fpv: <https://example.org/fpv#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DATA {
  :msg1 a sosa:Observation .
  :probe7 a sosa:Sensor .
  :msg1 sosa:madeBySensor :probe7 .
  :msg1 sosa:resultTime "2026-06-17T12:34:56Z"^^xsd:dateTime .
  :msg1 sosa:hasSimpleResult 18.6 .
  :msg1 fpv:hasFlowStep :ingestStep .
  :msg1 sosa:hasFeatureOfInterest :platformB .
  :observedBy fpv:runtimeRule fpv:copyToTarget .
  :observedBy fpv:targetPredicate sosa:madeBySensor .
  :observedAt fpv:runtimeRule fpv:copyToTarget .
  :observedAt fpv:targetPredicate sosa:resultTime .
  :temperatureCelsius fpv:runtimeRule fpv:copyToTarget .
  :temperatureCelsius fpv:targetPredicate sosa:hasSimpleResult .
  :inFlow fpv:runtimeRule fpv:copyToTarget .
  :inFlow fpv:targetPredicate fpv:hasFlowStep .
  :observedFeature fpv:runtimeRule fpv:copyToTarget .
  :observedFeature fpv:targetPredicate sosa:hasFeatureOfInterest .
  :ingestStep fpv:emits :msg1 .
  :ingestStep fpv:trustedBy :probe7 .

  _:step1
    rdf:reifies <<(:msg1 a sosa:Observation)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "class"; pe:value :LocalObservation ],
      [ pe:var "super"; pe:value sosa:Observation ],
      [ pe:var "thing"; pe:value :msg1 ];
    pe:uses
      <<(:msg1 a :LocalObservation)>>,
      <<(:LocalObservation rdfs:subClassOf sosa:Observation)>>.

  _:step2
    rdf:reifies <<(:probe7 a sosa:Sensor)>>;
    pe:rule 1;
    pe:binding
      [ pe:var "class"; pe:value :TemperatureProbe ],
      [ pe:var "super"; pe:value sosa:Sensor ],
      [ pe:var "thing"; pe:value :probe7 ];
    pe:uses
      <<(:probe7 a :TemperatureProbe)>>,
      <<(:TemperatureProbe rdfs:subClassOf sosa:Sensor)>>.

  _:step3
    rdf:reifies <<(:msg1 sosa:madeBySensor :probe7)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "object"; pe:value :probe7 ],
      [ pe:var "property"; pe:value :observedBy ],
      [ pe:var "subject"; pe:value :msg1 ],
      [ pe:var "superProperty"; pe:value sosa:madeBySensor ];
    pe:uses
      <<(:msg1 :observedBy :probe7)>>,
      <<(:observedBy rdfs:subPropertyOf sosa:madeBySensor)>>.

  _:step4
    rdf:reifies <<(:msg1 sosa:resultTime "2026-06-17T12:34:56Z"^^xsd:dateTime)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "object"; pe:value "2026-06-17T12:34:56Z"^^xsd:dateTime ],
      [ pe:var "property"; pe:value :observedAt ],
      [ pe:var "subject"; pe:value :msg1 ],
      [ pe:var "superProperty"; pe:value sosa:resultTime ];
    pe:uses
      <<(:msg1 :observedAt "2026-06-17T12:34:56Z"^^xsd:dateTime)>>,
      <<(:observedAt rdfs:subPropertyOf sosa:resultTime)>>.

  _:step5
    rdf:reifies <<(:msg1 sosa:hasSimpleResult 18.6)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "object"; pe:value 18.6 ],
      [ pe:var "property"; pe:value :temperatureCelsius ],
      [ pe:var "subject"; pe:value :msg1 ],
      [ pe:var "superProperty"; pe:value sosa:hasSimpleResult ];
    pe:uses
      <<(:msg1 :temperatureCelsius 18.6)>>,
      <<(:temperatureCelsius rdfs:subPropertyOf sosa:hasSimpleResult)>>.

  _:step6
    rdf:reifies <<(:msg1 fpv:hasFlowStep :ingestStep)>>;
    pe:rule 2;
    pe:binding
      [ pe:var "object"; pe:value :ingestStep ],
      [ pe:var "property"; pe:value :inFlow ],
      [ pe:var "subject"; pe:value :msg1 ],
      [ pe:var "superProperty"; pe:value fpv:hasFlowStep ];
    pe:uses
      <<(:msg1 :inFlow :ingestStep)>>,
      <<(:inFlow rdfs:subPropertyOf fpv:hasFlowStep)>>.

  _:step7
    rdf:reifies <<(:msg1 sosa:hasFeatureOfInterest :platformB)>>;
    pe:rule 3;
    pe:binding
      [ pe:var "o"; pe:value :platformB ],
      [ pe:var "p"; pe:value :observedFeature ],
      [ pe:var "q"; pe:value sosa:hasFeatureOfInterest ],
      [ pe:var "s"; pe:value :msg1 ];
    pe:uses
      <<(:observedFeature owl:equivalentProperty sosa:hasFeatureOfInterest)>>,
      <<(:msg1 :observedFeature :platformB)>>.

  _:step8
    rdf:reifies <<(:observedBy fpv:runtimeRule fpv:copyToTarget)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :observedBy ],
      [ pe:var "targetPredicate"; pe:value sosa:madeBySensor ];
    pe:uses <<(:observedBy rdfs:subPropertyOf sosa:madeBySensor)>>.

  _:step9
    rdf:reifies <<(:observedBy fpv:targetPredicate sosa:madeBySensor)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :observedBy ],
      [ pe:var "targetPredicate"; pe:value sosa:madeBySensor ];
    pe:uses <<(:observedBy rdfs:subPropertyOf sosa:madeBySensor)>>.

  _:step10
    rdf:reifies <<(:observedAt fpv:runtimeRule fpv:copyToTarget)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :observedAt ],
      [ pe:var "targetPredicate"; pe:value sosa:resultTime ];
    pe:uses <<(:observedAt rdfs:subPropertyOf sosa:resultTime)>>.

  _:step11
    rdf:reifies <<(:observedAt fpv:targetPredicate sosa:resultTime)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :observedAt ],
      [ pe:var "targetPredicate"; pe:value sosa:resultTime ];
    pe:uses <<(:observedAt rdfs:subPropertyOf sosa:resultTime)>>.

  _:step12
    rdf:reifies <<(:temperatureCelsius fpv:runtimeRule fpv:copyToTarget)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :temperatureCelsius ],
      [ pe:var "targetPredicate"; pe:value sosa:hasSimpleResult ];
    pe:uses <<(:temperatureCelsius rdfs:subPropertyOf sosa:hasSimpleResult)>>.

  _:step13
    rdf:reifies <<(:temperatureCelsius fpv:targetPredicate sosa:hasSimpleResult)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :temperatureCelsius ],
      [ pe:var "targetPredicate"; pe:value sosa:hasSimpleResult ];
    pe:uses <<(:temperatureCelsius rdfs:subPropertyOf sosa:hasSimpleResult)>>.

  _:step14
    rdf:reifies <<(:inFlow fpv:runtimeRule fpv:copyToTarget)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :inFlow ],
      [ pe:var "targetPredicate"; pe:value fpv:hasFlowStep ];
    pe:uses <<(:inFlow rdfs:subPropertyOf fpv:hasFlowStep)>>.

  _:step15
    rdf:reifies <<(:inFlow fpv:targetPredicate fpv:hasFlowStep)>>;
    pe:rule 5;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :inFlow ],
      [ pe:var "targetPredicate"; pe:value fpv:hasFlowStep ];
    pe:uses <<(:inFlow rdfs:subPropertyOf fpv:hasFlowStep)>>.

  _:step16
    rdf:reifies <<(:observedFeature fpv:runtimeRule fpv:copyToTarget)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :observedFeature ],
      [ pe:var "targetPredicate"; pe:value sosa:hasFeatureOfInterest ];
    pe:uses <<(:observedFeature owl:equivalentProperty sosa:hasFeatureOfInterest)>>.

  _:step17
    rdf:reifies <<(:observedFeature fpv:targetPredicate sosa:hasFeatureOfInterest)>>;
    pe:rule 6;
    pe:binding
      [ pe:var "sourcePredicate"; pe:value :observedFeature ],
      [ pe:var "targetPredicate"; pe:value sosa:hasFeatureOfInterest ];
    pe:uses <<(:observedFeature owl:equivalentProperty sosa:hasFeatureOfInterest)>>.

  _:step18
    rdf:reifies <<(:ingestStep fpv:emits :msg1)>>;
    pe:rule 7;
    pe:binding
      [ pe:var "message"; pe:value :msg1 ],
      [ pe:var "sensor"; pe:value :probe7 ],
      [ pe:var "step"; pe:value :ingestStep ];
    pe:uses
      _:step1,
      _:step6,
      _:step3.

  _:step19
    rdf:reifies <<(:ingestStep fpv:trustedBy :probe7)>>;
    pe:rule 7;
    pe:binding
      [ pe:var "message"; pe:value :msg1 ],
      [ pe:var "sensor"; pe:value :probe7 ],
      [ pe:var "step"; pe:value :ingestStep ];
    pe:uses
      _:step1,
      _:step6,
      _:step3.
}
