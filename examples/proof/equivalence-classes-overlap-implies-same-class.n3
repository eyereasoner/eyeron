{ :a :sim :a . } pe:why {
  { :a :sim :a . }
    pe:rule 1;
    pe:binding [ pe:var "x"; pe:value :a ];
    pe:uses { :a :inX true . }.

  { :a :inX true . }
    pe:fact "equivalence-classes-overlap-implies-same-class.n3".
}.

