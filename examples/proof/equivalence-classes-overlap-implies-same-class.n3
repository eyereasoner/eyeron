    [ pe:var "z"; pe:value :b ];
  pe:uses
    { (:c :a :b) :sharedMemberShowsSameClass true . },
    { :c log:notEqualTo :a . }.

{ (:c :a :b) :sharedMemberShowsSameClass true . }
  pe:rule 7;
  pe:binding
    [ pe:var "x"; pe:value :c ],
    [ pe:var "y"; pe:value :a ],
    [ pe:var "z"; pe:value :b ];
  pe:uses
    { :b :inClassOf :c . },
    { :b :inClassOf :a . },
    { (:c :a) :sameClass true . }.
