@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:result :sameClassBecauseOfSharedMember (:a :b :b) .
:result :sameClassBecauseOfSharedMember (:b :a :b) .
:result :sameClassBecauseOfSharedMember (:b :a :a) .
:result :sameClassBecauseOfSharedMember (:c :b :b) .
:result :sameClassBecauseOfSharedMember (:a :c :b) .
:result :sameClassBecauseOfSharedMember (:b :c :b) .
:result :sameClassBecauseOfSharedMember (:b :c :a) .
:result :sameClassBecauseOfSharedMember (:b :c :c) .
:result :sameClassBecauseOfSharedMember (:a :b :a) .
:result :sameClassBecauseOfSharedMember (:a :c :a) .
:result :sameClassBecauseOfSharedMember (:c :b :c) .
:result :sameClassBecauseOfSharedMember (:c :b :a) .
:result :sameClassBecauseOfSharedMember (:b :a :c) .
:result :sameClassBecauseOfSharedMember (:a :b :c) .
:result :sameClassBecauseOfSharedMember (:c :a :a) .
:result :sameClassBecauseOfSharedMember (:a :c :c) .
:result :sameClassBecauseOfSharedMember (:c :a :c) .
:result :sameClassBecauseOfSharedMember (:c :a :b) .

{ :result :sameClassBecauseOfSharedMember (:a :b :b) . }
  pe:rule
    {
        {
            (?x ?y ?z) :sharedMemberShowsSameClass true .
            ?x log:notEqualTo ?y .
        } => {
            :result :sameClassBecauseOfSharedMember (?x ?y ?z) .
        } .
    };
  pe:binding
    [ pe:var "x"; pe:value :a ],
    [ pe:var "y"; pe:value :b ],
    [ pe:var "z"; pe:value :b ];
  pe:uses
    { (:a :b :b) :sharedMemberShowsSameClass true . },
    { :a log:notEqualTo :b . }.

{ (:a :b :b) :sharedMemberShowsSameClass true . }
  pe:rule 7;
  pe:binding
    [ pe:var "x"; pe:value :a ],
    [ pe:var "y"; pe:value :b ],
    [ pe:var "z"; pe:value :b ];
  pe:uses
    { :b :inClassOf :a . },
    { :b :inClassOf :b . },
    { (:a :b) :sameClass true . }.

{ :b :inClassOf :a . }
  pe:rule 4;
  pe:binding
    [ pe:var "u"; pe:value :b ],
    [ pe:var "x"; pe:value :a ];
  pe:uses { :b :sim :a . }.

{ :b :sim :a . }
  pe:fact "equivalence-classes-overlap-implies-same-class.n3".

{ :b :inClassOf :b . }
  pe:rule 4;
  pe:binding
    [ pe:var "u"; pe:value :b ],
    [ pe:var "x"; pe:value :b ];
  pe:uses { :b :sim :b . }.

{ :b :sim :b . }
  pe:rule 1;
  pe:binding [ pe:var "x"; pe:value :b ];
  pe:uses { :b :inX true . }.

{ :b :inX true . }
  pe:fact "equivalence-classes-overlap-implies-same-class.n3".

{ (:a :b) :sameClass true . }
  pe:rule 5;
  pe:binding
    [ pe:var "x"; pe:value :a ],
    [ pe:var "y"; pe:value :b ];
  pe:uses { :a :sim :b . }.

{ :a :sim :b . }
  pe:rule 2;
  pe:binding
    [ pe:var "x"; pe:value :b ],
    [ pe:var "y"; pe:value :a ];
  pe:uses { :b :sim :a . }.

{ :a log:notEqualTo :b . }
  pe:builtin log:notEqualTo.

