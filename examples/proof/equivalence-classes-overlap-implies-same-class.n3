  pe:binding
    [ pe:var "x"; pe:value :b ],
    [ pe:var "y"; pe:value :a ],
    [ pe:var "z"; pe:value :b ];
  pe:uses
    { (:b :a :b) :sharedMemberShowsSameClass true . },
    { :b log:notEqualTo :a . }.

