{ :ok_string_concatenation_1 a :Pass . } pe:why {
  { :ok_string_concatenation_1 a :Pass . }
    pe:rule 1;
    pe:uses { ("hello" " " "world!") string:concatenation "hello world!" . }.

  { ("hello" " " "world!") string:concatenation "hello world!" . }
    pe:builtin string:concatenation.
}.

{ :ok_string_contains_1 a :Pass . } pe:why {
  { :ok_string_contains_1 a :Pass . }
    pe:rule 2;
    pe:uses { "hello world!" string:contains "llo worl" . }.

  { "hello world!" string:contains "llo worl" . }
    pe:builtin string:contains.
}.

