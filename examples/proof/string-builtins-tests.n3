{ :ok_string_format_1 a :Pass . } pe:why {
  { :ok_string_format_1 a :Pass . }
    pe:rule 6;
    pe:uses { ("%s://%s/%s" "https" "w3c.github.io" "N3/spec/") string:format "https://w3c.github.io/N3/spec/" . }.

  { ("%s://%s/%s" "https" "w3c.github.io" "N3/spec/") string:format "https://w3c.github.io/N3/spec/" . }
    pe:builtin string:format.
}.

