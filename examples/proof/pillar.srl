PREFIX : <http://example.org/socrates#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :Pillar :to :Post .
  :result :is :Post .
  :test :is true .

  _:step1
    rdf:reifies <<(:Pillar :to :Post)>>;
    pe:rule "rule#1";
    pe:binding [ pe:var "What"; pe:value :Post ];
    pe:uses <<(:Post :to :Pillar)>>.

  _:step2
    rdf:reifies <<(:result :is :Post)>>;
    pe:rule "rule#3";
    pe:binding [ pe:var "What"; pe:value :Post ];
    pe:uses _:step1.

  _:step3
    rdf:reifies <<(:test :is true)>>;
    pe:rule "rule#4";
    pe:uses _:step2.
}
