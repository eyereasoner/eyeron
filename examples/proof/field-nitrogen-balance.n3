  pe:rule 1;
  pe:binding
    [ pe:var "F"; pe:value :HighInputRisk ],
    [ pe:var "fert"; pe:value 180.0 ],
    [ pe:var "soil"; pe:value 60.0 ],
    [ pe:var "tot"; pe:value "240"^^xsd:decimal ];
