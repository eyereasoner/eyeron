{ :HighInputRisk :lossFrac 0.25 . }
  pe:fact "field-nitrogen-balance.n3".

{ (1.0 0.25) math:difference 0.75 . }
  pe:builtin math:difference.

{ ("240"^^xsd:decimal 0.75) math:product "180"^^xsd:decimal . }
  pe:builtin math:product.

{ (1.1 160.0) math:product "176"^^xsd:decimal . }
  pe:builtin math:product.

{ "180"^^xsd:decimal math:greaterThan "176"^^xsd:decimal . }
  pe:builtin math:greaterThan.

{ :SandyOverFertil :status "over" . }
  pe:rule 10;
  pe:binding
