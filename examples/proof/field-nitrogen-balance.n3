{ ("280"^^xsd:decimal 0.6) math:product "168"^^xsd:decimal . }
  pe:builtin math:product.

{ (1.1 150.0) math:product "165"^^xsd:decimal . }
  pe:builtin math:product.

{ "168"^^xsd:decimal math:greaterThan "165"^^xsd:decimal . }
  pe:builtin math:greaterThan.

{ :LowInputDry :deficitN "45"^^xsd:decimal . }
  pe:rule 3;
