@prefix : <http://example.org/farming#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:LowInputDry :status "under" .
:BalancedLoam :status "balanced" .
:HighInputRisk :status "over" .
:SandyOverFertil :status "over" .
:LowInputDry :deficitN "45"^^xsd:decimal .
:BalancedLoam :deficitN "11"^^xsd:decimal .
:HighInputRisk :deficitN 0.0 .
:SandyOverFertil :deficitN 0.0 .
:HighInputRisk :surplusN "20"^^xsd:decimal .
:SandyOverFertil :surplusN "18"^^xsd:decimal .
:LowInputDry :surplusN 0.0 .
:BalancedLoam :surplusN 0.0 .
:HighInputRisk :leachIndex "5"^^xsd:decimal .
:SandyOverFertil :leachIndex 7.2 .
:LowInputDry :leachIndex "0"^^xsd:decimal .
:BalancedLoam :leachIndex "0"^^xsd:decimal .

{ :LowInputDry :status "under" . }
  pe:rule 8;
  pe:binding
    [ pe:var "F"; pe:value :LowInputDry ],
    [ pe:var "a"; pe:value "85"^^xsd:decimal ],
    [ pe:var "d"; pe:value 130.0 ],
    [ pe:var "dLow"; pe:value "117"^^xsd:decimal ];
  pe:uses
    { :LowInputDry :cropNdemand 130.0 . },
    { :LowInputDry :availN "85"^^xsd:decimal . },
    { (0.9 130.0) math:product "117"^^xsd:decimal . },
    { "85"^^xsd:decimal math:lessThan "117"^^xsd:decimal . }.

{ :LowInputDry :cropNdemand 130.0 . }
  pe:fact "field-nitrogen-balance.n3".

{ :LowInputDry :availN "85"^^xsd:decimal . }
  pe:rule 2;
  pe:binding
    [ pe:var "F"; pe:value :LowInputDry ],
    [ pe:var "avail"; pe:value "85"^^xsd:decimal ],
    [ pe:var "keepFrac"; pe:value 0.85 ],
    [ pe:var "lf"; pe:value 0.15 ],
    [ pe:var "tot"; pe:value "100"^^xsd:decimal ];
  pe:uses
    { :LowInputDry :totalN "100"^^xsd:decimal . },
    { :LowInputDry :lossFrac 0.15 . },
    { (1.0 0.15) math:difference 0.85 . },
    { ("100"^^xsd:decimal 0.85) math:product "85"^^xsd:decimal . }.

{ :LowInputDry :totalN "100"^^xsd:decimal . }
  pe:rule 1;
  pe:binding
    [ pe:var "F"; pe:value :LowInputDry ],
    [ pe:var "fert"; pe:value 60.0 ],
    [ pe:var "soil"; pe:value 40.0 ],
    [ pe:var "tot"; pe:value "100"^^xsd:decimal ];
  pe:uses
    { :LowInputDry a :Field . },
    { :LowInputDry :soilN 40.0 . },
    { :LowInputDry :fertN 60.0 . },
    { (40.0 60.0) math:sum "100"^^xsd:decimal . }.

{ :LowInputDry a :Field . }
  pe:fact "field-nitrogen-balance.n3".

{ :LowInputDry :soilN 40.0 . }
  pe:fact "field-nitrogen-balance.n3".

{ :LowInputDry :fertN 60.0 . }
  pe:fact "field-nitrogen-balance.n3".

{ (40.0 60.0) math:sum "100"^^xsd:decimal . }
  pe:builtin math:sum.

{ :LowInputDry :lossFrac 0.15 . }
  pe:fact "field-nitrogen-balance.n3".

{ (1.0 0.15) math:difference 0.85 . }
  pe:builtin math:difference.

{ ("100"^^xsd:decimal 0.85) math:product "85"^^xsd:decimal . }
  pe:builtin math:product.

{ (0.9 130.0) math:product "117"^^xsd:decimal . }
  pe:builtin math:product.

{ "85"^^xsd:decimal math:lessThan "117"^^xsd:decimal . }
  pe:builtin math:lessThan.

{ :BalancedLoam :status "balanced" . }
  pe:rule 9;
  pe:binding
    [ pe:var "F"; pe:value :BalancedLoam ],
    [ pe:var "a"; pe:value "119"^^xsd:decimal ],
    [ pe:var "d"; pe:value 130.0 ],
    [ pe:var "dHigh"; pe:value "143"^^xsd:decimal ],
    [ pe:var "dLow"; pe:value "117"^^xsd:decimal ];
  pe:uses
    { :BalancedLoam :cropNdemand 130.0 . },
    { :BalancedLoam :availN "119"^^xsd:decimal . },
    { (0.9 130.0) math:product "117"^^xsd:decimal . },
    { (1.1 130.0) math:product "143"^^xsd:decimal . },
    { "119"^^xsd:decimal math:notLessThan "117"^^xsd:decimal . },
    { "119"^^xsd:decimal math:notGreaterThan "143"^^xsd:decimal . }.

{ :BalancedLoam :cropNdemand 130.0 . }
  pe:fact "field-nitrogen-balance.n3".

{ :BalancedLoam :availN "119"^^xsd:decimal . }
  pe:rule 2;
  pe:binding
    [ pe:var "F"; pe:value :BalancedLoam ],
    [ pe:var "avail"; pe:value "119"^^xsd:decimal ],
    [ pe:var "keepFrac"; pe:value 0.85 ],
    [ pe:var "lf"; pe:value 0.15 ],
    [ pe:var "tot"; pe:value "140"^^xsd:decimal ];
  pe:uses
    { :BalancedLoam :totalN "140"^^xsd:decimal . },
    { :BalancedLoam :lossFrac 0.15 . },
    { (1.0 0.15) math:difference 0.85 . },
    { ("140"^^xsd:decimal 0.85) math:product "119"^^xsd:decimal . }.

{ :BalancedLoam :totalN "140"^^xsd:decimal . }
  pe:rule 1;
  pe:binding
    [ pe:var "F"; pe:value :BalancedLoam ],
    [ pe:var "fert"; pe:value 90.0 ],
    [ pe:var "soil"; pe:value 50.0 ],
    [ pe:var "tot"; pe:value "140"^^xsd:decimal ];
  pe:uses
    { :BalancedLoam a :Field . },
    { :BalancedLoam :soilN 50.0 . },
    { :BalancedLoam :fertN 90.0 . },
    { (50.0 90.0) math:sum "140"^^xsd:decimal . }.

{ :BalancedLoam a :Field . }
  pe:fact "field-nitrogen-balance.n3".

{ :BalancedLoam :soilN 50.0 . }
  pe:fact "field-nitrogen-balance.n3".

{ :BalancedLoam :fertN 90.0 . }
  pe:fact "field-nitrogen-balance.n3".

{ (50.0 90.0) math:sum "140"^^xsd:decimal . }
  pe:builtin math:sum.

{ :BalancedLoam :lossFrac 0.15 . }
  pe:fact "field-nitrogen-balance.n3".

{ ("140"^^xsd:decimal 0.85) math:product "119"^^xsd:decimal . }
  pe:builtin math:product.

{ (1.1 130.0) math:product "143"^^xsd:decimal . }
  pe:builtin math:product.

{ "119"^^xsd:decimal math:notLessThan "117"^^xsd:decimal . }
  pe:builtin math:notLessThan.

{ "119"^^xsd:decimal math:notGreaterThan "143"^^xsd:decimal . }
  pe:builtin math:notGreaterThan.

{ :HighInputRisk :status "over" . }
