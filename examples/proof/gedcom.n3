@prefix : <http://www.agfa.com/w3c/euler/gedcom-facts#> .
@prefix gc: <http://www.daml.org/2001/01/gedcom/gedcom#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:Jos :testRelationship :Bart .
:Geert :testRelationship :Bart .
:Dirk :testRelationship :Bart .
:Jos :testRelationship :Tom .
:Geert :testRelationship :Tom .
:Dirk :testRelationship :Tom .

{ :Jos :testRelationship :Bart . }
  pe:rule
    {
        {
            ?A gc:mother ?M .
            ?M gc:daughter ?D .
            ?D gc:son ?S .
            ?S gc:uncle ?A .
        } => {
            ?A :testRelationship ?S .
        } .
    };
  pe:binding
    [ pe:var "A"; pe:value :Jos ],
    [ pe:var "D"; pe:value :Rita ],
    [ pe:var "M"; pe:value :Maria ],
    [ pe:var "S"; pe:value :Bart ];
  pe:uses
    { :Jos gc:mother :Maria . },
    { :Maria gc:daughter :Rita . },
    { :Rita gc:son :Bart . },
    { :Bart gc:uncle :Jos . }.

{ :Jos gc:mother :Maria . }
  pe:rule 3;
  pe:binding
    [ pe:var "C"; pe:value :Jos ],
    [ pe:var "P"; pe:value :Maria ];
  pe:uses
    { :Jos gc:parent :Maria . },
    { :Maria gc:sex gc:Female . }.

{ :Jos gc:parent :Maria . }
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value :Jos ],
    [ pe:var "F"; pe:value :dp ],
    [ pe:var "P"; pe:value :Maria ];
  pe:uses
    { :Jos gc:childIn :dp . },
    { :Maria gc:spouseIn :dp . }.

{ :Jos gc:childIn :dp . }
  pe:fact "gedcom.n3".

{ :Maria gc:spouseIn :dp . }
  pe:fact "gedcom.n3".

{ :Maria gc:sex gc:Female . }
  pe:fact "gedcom.n3".

{ :Maria gc:daughter :Rita . }
  pe:rule 5;
  pe:binding
    [ pe:var "C"; pe:value :Rita ],
    [ pe:var "P"; pe:value :Maria ];
  pe:uses
    { :Rita gc:parent :Maria . },
    { :Rita gc:sex gc:Female . }.

{ :Rita gc:parent :Maria . }
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value :Rita ],
    [ pe:var "F"; pe:value :dp ],
    [ pe:var "P"; pe:value :Maria ];
  pe:uses
    { :Rita gc:childIn :dp . },
    { :Maria gc:spouseIn :dp . }.

{ :Rita gc:childIn :dp . }
  pe:fact "gedcom.n3".

{ :Rita gc:sex gc:Female . }
  pe:fact "gedcom.n3".

{ :Rita gc:son :Bart . }
  pe:rule 4;
  pe:binding
    [ pe:var "C"; pe:value :Bart ],
    [ pe:var "P"; pe:value :Rita ];
  pe:uses
    { :Bart gc:parent :Rita . },
    { :Bart gc:sex gc:Male . }.

{ :Bart gc:parent :Rita . }
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value :Bart ],
    [ pe:var "F"; pe:value :gd ],
    [ pe:var "P"; pe:value :Rita ];
  pe:uses
    { :Bart gc:childIn :gd . },
    { :Rita gc:spouseIn :gd . }.

{ :Bart gc:childIn :gd . }
  pe:fact "gedcom.n3".

{ :Rita gc:spouseIn :gd . }
  pe:fact "gedcom.n3".

{ :Bart gc:sex gc:Male . }
  pe:fact "gedcom.n3".

{ :Bart gc:uncle :Jos . }
  pe:rule 17;
  pe:binding
    [ pe:var "C"; pe:value :Bart ],
    [ pe:var "P"; pe:value :Rita ],
    [ pe:var "U"; pe:value :Jos ];
  pe:uses
    { :Bart gc:parent :Rita . },
    { :Rita gc:brother :Jos . }.

{ :Rita gc:brother :Jos . }
  pe:rule 12;
  pe:binding
    [ pe:var "C"; pe:value :Rita ],
    [ pe:var "S"; pe:value :Jos ];
  pe:uses
    { :Rita gc:sibling :Jos . },
    { :Jos gc:sex gc:Male . }.

{ :Rita gc:sibling :Jos . }
  pe:rule 11;
  pe:binding
    [ pe:var "C"; pe:value :Rita ],
    [ pe:var "C2"; pe:value :Jos ],
    [ pe:var "F"; pe:value :dp ];
  pe:uses
    { :Rita gc:childIn :dp . },
    { :Jos gc:childIn :dp . },
    { :Rita log:notEqualTo :Jos . }.

{ :Rita log:notEqualTo :Jos . }
  pe:builtin log:notEqualTo.

{ :Jos gc:sex gc:Male . }
  pe:fact "gedcom.n3".

