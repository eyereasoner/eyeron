PREFIX : <http://example.com/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :town2 a :largeTown .

  _:step1
    rdf:reifies <<( :town2 a :largeTown )>>;
    pe:rule "filter-town.srl";
    pe:line 11;
    pe:binding
      [ pe:var "p"; pe:value 2000 ],
      [ pe:var "x"; pe:value :town2 ];
    pe:uses _:step2.

  _:step2
    rdf:reifies <<( :town2 :population 2000 )>>;
    pe:fact "filter-town.srl";
    pe:line 8.
}
