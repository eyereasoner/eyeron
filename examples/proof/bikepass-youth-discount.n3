    [ pe:var "tmp"; pe:value 1800 ];
  pe:uses
    { ex:APP-BP-01 ex:eligible true . },
    { ex:APP-BP-01 ex:status ex:Submitted . },
    { ex:APP-BP-01 ex:baseMonthlyPrice 30 . },
    { ex:APP-BP-01 ex:hasApplicant ex:Zoe . },
    { ex:Zoe ex:hasAge 17 . },
    { 17 math:lessThan 18 . },
    { (30 60) math:product 1800 . },
