# Reading explicit and implicit quantifier scopes
#
# A catalog of quoted graphs writes universal (@forAll, ?x) and existential
# (@forSome, _:x) variables in several scope arrangements: inherited
# bindings, local declarations, shadowing and self-reference. One rule asks
# whether a graph written with different variable names is the same graph;
# eyeron concludes that renaming the quantified variables preserves identity.

@prefix : <http://example.org/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Implicit universals belong to the whole document; blank nodes are local.
:implicitUniversals :graph {
    ?x :loves _:y
} .

:distinctVariables :graph {
    ?x :loves _:x
} .

:explicitQuantifiers :graph {
    @forAll :x .
    @forSome :y .
    :x :loves :y
} .

<example.n3> log:semantics {
    @forAll :x .
    :x :loves _:y
} .

# Someone likes pasta: an existential with no declaration.
:existentialLikes :graph {
    _:x :likes :pasta
} .

# The outer existential remains accessible inside a nested universal graph.
:inheritedExistential :graph {
    @forSome :y .
    :y :says {
        @forAll :x .
        :y :likes :x
    } .
} .

# The inner existential shadows the unused outer universal.
:shadowedVariable :graph {
    @forAll :x .
    :bob :says {
        @forSome :x .
        :x :likes :pizza, :pasta
    } .
} .

# The same two likes, said of a blank node instead of a declared existential.
:renamedExistential :graph {
    _:y :likes :pizza, :pasta
} .

# A speaker talking about itself: as a universal, a constant, an existential,
# and, last, a universal speaker whose statement is about someone else.
:universalSelfReference :graph {
    @forAll :x .
    :x :says {
        :x :is :wise
    }
} .

:concreteSelfReference :graph {
    :bob :says {
        :bob :is :wise
    }
} .

:existentialSelfReference :graph {
    @forSome :x .
    :x :says {
        :x :is :wise
    }
} .

:independentStatement :graph {
    @forAll :x .
    :x :says {
        :bob :is :wise
    }
} .

# Renaming both binders preserves graph identity.
:renamedQuantifiers :graph {
    @forAll :y .
    @forSome :z .
    :y :loves :z
} .

# Declarations precede triples, with @forAll before @forSome in each graph.
# Locally bound variables may be renamed consistently when matching a graph.
{
    :explicitQuantifiers :graph {
        @forAll :person .
        @forSome :beloved .
        :person :loves :beloved .
    }
} => {
    :quantifierRenaming :preservesGraphIdentity true
} .

# Compare a shared existential with two independent existentials.
:sharedMotherCandidate :candidate {
    @forSome :y .
    :bob :hasMother :y .
    :liz :hasMother :y .
} .

:independentMothersCandidate :candidate {
    @forSome :y, :z .
    :bob :hasMother :y .
    :liz :hasMother :z .
} .

# Both candidates are quoted for comparison; neither content is asserted.
