# Finding a shortest path in a directed graph
#
# Six weighted one-way roads connect four places, with a cycle between a
# and c. Backward N3 rules search from a with a cost-sorted queue and a list
# of visited places, so the cycle cannot trap them. The forward rule collects
# every cost they find from a to d (5, 7 and 9), sorts them, and reports the
# cheapest: cost 5 along a, b, c, d. It shows recursive backward rules,
# list built-ins and log:collectAllIn.

@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example/> .

# The roads: (from to) :edge cost.
(:a :b) :edge 2 .
(:a :c) :edge 5 .
(:b :c) :edge 1 .
(:b :d) :edge 7 .
(:c :d) :edge 2 .
(:c :a) :edge 1 .

# A path from Start to Goal: search from a queue holding the single entry
# (0 Start), with nothing visited yet, then turn the reversed path around.
{
    (?Start ?Goal) :shortest (?Path ?Cost)
} <= {
    (((0 ?Start)) ?Goal ()) :shortest2 (?RevPath ?Cost) .
    ?RevPath list:reverse ?Path .
} .

# Queue entries are (Cost Node ...earlier nodes), cheapest first. When the
# first entry has reached the goal, its cost and reversed path are an answer.
{
    (?L1 ?Goal ?L2) :shortest2 (?L3 ?Cost)
} <= {
    ?L1 list:firstRest (?L4 ?L5) .
    ?L4 list:firstRest (?Cost ?L3) .
    ?L3 list:firstRest (?Goal ?Path) .
} .

# Otherwise expand the first entry: collect a new entry for every road out
# of its node to a place not yet visited, add them to the rest of the queue,
# sort by cost, mark the node visited and search on. This rule also applies
# when the first entry is at the goal, so more expensive paths are found too.
{
    (?L1 ?Goal ?Visited) :shortest2 (?ResultPath ?ResultCost)
} <= {
    ?L1 list:firstRest (?L2 ?Queue) .
    ?L2 list:firstRest (?Cost ?L3) .
    ?L3 list:firstRest (?Node ?Path) .
    (
        ?L4 {
            ?L4 list:firstRest (?NewCost ?L5) .
            ?L5 list:firstRest (?Neighbor ?L6) .
            ?L6 list:firstRest (?Node ?Path) .
            (?Node ?Neighbor) :edge ?Weight .
            ?Visited list:notMember ?Neighbor .
            (?Cost ?Weight) math:sum ?NewCost .
        }
        ?Neighbors
    ) log:collectAllIn ?SCOPE .
    (?Queue ?Neighbors) list:append ?NewQueue .
    ?NewQueue list:sort ?SortedQueue .
    ?L7 list:firstRest (?Node ?Visited) .
    (?SortedQueue ?Goal ?L7) :shortest2 (?ResultPath ?ResultCost) .
} .

# Collect the cost of every path found from a to d, take the smallest, and
# report it with its path.
{
    (
        ?cost {
            (:a :d) :shortest (?path ?cost)
        }
        ?costs
    ) log:collectAllIn ?SCOPE .
    ?costs list:sort ?sorted .
    ?sorted list:firstRest (?best ?rest) .
    (:a :d) :shortest (?bestPath ?best) .
} => {
    :test :bestCost ?best ;
        :bestPath ?bestPath
} .
