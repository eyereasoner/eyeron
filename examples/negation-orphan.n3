# N3 example: negation-orphan.
# Companion to negation-orphan.pl/.srl: stratified negation as failure.

@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix : <https://eyereasoner.github.io/eyepl/examples/negation-orphan#>.

:alice a :Person.
:bob a :Person.
:alice :childOf :carol.

{?x a :Person. ?SCOPE log:notIncludes {?x :childOf ?y}.} => {?x a :Orphan}.
