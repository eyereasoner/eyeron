# Transferring a claim between equal names
#
# Lois knows a quoted statement about Superman, and Superman is linked to
# Clark Kent with owl:sameAs. An explicit N3 rule transfers the quoted
# statement to the other name; the equality fact alone does not rewrite it.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Superman and Clark Kent are the same person, and Lois knows a quoted
# statement that names only Superman.
:superman owl:sameAs :clarkKent .
:loisLane :knows {
    :superman :can :fly
} .

# Explicitly transfer the statement about Superman to Clark Kent. The
# pattern { ?x ?q ?r } matches a quoted graph holding exactly one statement.
{
    ?x owl:sameAs ?y .
    ?s ?p {
        ?x ?q ?r
    }
} => {
    ?s ?p {
        ?y ?q ?r
    }
} .
