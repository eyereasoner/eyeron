# Carrying metadata across a symmetric triple
#
# A marriage relation is declared symmetric and also appears as an
# annotated quoted graph. N3 rules derive the reversed fact and the matching
# reversed quoted graph with its metadata.

@base <https://eyereasoner.github.io/eye/reasoning/n3-star/example.n3> .
@prefix : <https://eyereasoner.github.io/eye/reasoning#> .

# Reverse an asserted relationship when its property is declared symmetric.
{
    ?p a :SymetricRelation .
    ?s ?p ?o
} => {
    ?o ?p ?s
} .

# Reverse the relationship inside quoted evidence too, copying its metadata
# predicate and value to the new graph.
{
    ?p a :SymetricRelation .
    {
        ?s ?p ?o .
    } ?p2 ?o2
} => {
    {
        ?o ?p ?s .
    } ?p2 ?o2
} .

# The example supplies both an asserted marriage and a quoted one with a date.
:marriedTo a :SymetricRelation .

:alice :marriedTo :bob .
{
    :alice :marriedTo :bob .
} :since "1999" .

# The three checks report the reversed fact, its dated graph and the original graph.
{
    :bob :marriedTo :alice
} => {
    :TEST :PASS 1
} .

{
    {
        :bob :marriedTo :alice .
    } :since "1999"
} => {
    :TEST :PASS 2
} .

{
    {
        :alice ?p :bob .
    } :since "1999"
} => {
    :TEST :PASS 3
} .
