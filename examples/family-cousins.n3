# Deriving cousins from family links
#
# A four-generation family tree descends from Adam through his two children,
# Bob and Carol, whose families are labelled as two branches. Rules number the
# generations with math:sum, pass the branch label down to descendants, and
# call two people cousins when they are in the same generation but in
# different branches: first cousins in generation 2, second cousins in 3.

@prefix : <http://example.org/family#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .

# Data (a small family tree)
:Adam :parentOf :Bob, :Carol .
:Bob :parentOf :Dave, :Eve .
:Carol :parentOf :Frank, :Grace .
:Dave :parentOf :Heidi .
:Eve :parentOf :Ivan .
:Frank :parentOf :Judy .

# Branch labels, given to Adam's grandchildren: b for Bob's children, c for
# Carol's. Bob and Carol themselves get none, so as siblings they do not
# become cousins.
:Dave :branch :b .
:Eve :branch :b .
:Frank :branch :c .
:Grace :branch :c .

# The two branches are different; stating it as facts avoids an inequality
# built-in.
:b :differentFrom :c .
:c :differentFrom :b .

# Adam is generation 0: a rule with an empty condition always fires.
{} => {
    :Adam :generation 0
} .

# Generation propagation: child.gen = parent.gen + 1
{
    ?P :parentOf ?C .
    ?P :generation ?G .
    (?G 1) math:sum ?G1 .
} => {
    ?C :generation ?G1 .
} .

# Branch propagation: child.branch = parent.branch
{
    ?P :parentOf ?C .
    ?P :branch ?B .
} => {
    ?C :branch ?B .
} .

# Cousins: same generation, different branch
{
    ?X :generation ?G .
    ?Y :generation ?G .
    ?X :branch ?BX .
    ?Y :branch ?BY .
    ?BX :differentFrom ?BY .
} => {
    ?X :cousin ?Y .
} .
