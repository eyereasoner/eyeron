# N3 example: dog-license.
# Companion to dog-license.pl/.srl: counts each person's distinct dogs
# via log:collectAllIn (scoped per ?person, unlike aggregation.n3's global
# collection) and requires a license once the count exceeds four.

@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix : <http://example/>.

:alice :hasDog :dog1, :dog2, :dog3, :dog4, :dog5.
:bob :hasDog :dog6, :dog7.

{
  ?person :hasDog ?anyDog.
  (?dog {?person :hasDog ?dog} ?dogs) log:collectAllIn ?SCOPE.
  ?dogs list:length ?count.
} => {?person :dogCount ?count}.

{?person :dogCount ?count. ?count math:greaterThan 4} => {?person :mustHave :dogLicense}.
