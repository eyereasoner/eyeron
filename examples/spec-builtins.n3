# N3 example: spec-builtins.
# Companion to spec-builtins.pl/.srl: the datetime is encoded as a plain
# RDF list of its components (as in now-and-language-builtins.n3), and the
# quoted `triple(subject, predicate, object)` compound is likewise encoded
# as a 3-element list, both matched structurally.

@prefix : <http://example/>.

:event1 :when (2026 5 15 10 20 30).
:triple1 :value (:subject :predicate :object).

{?event :when (?year ?month ?day ?hour ?minute ?second)} => {?event :year ?year}.
{?t :value (?subject :predicate :object)} => {:test :quoted ?subject}.
