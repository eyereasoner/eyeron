# Companion to pillar.n3/.pl: the same mutually-recursive pair of rules,
# translated directly -- ordinary (non-negated, non-blank-headed) mutual
# recursion is fine in SRL's stratification, unlike the closed-rule
# recursion documented in peano-arithmetic.srl.

PREFIX : <http://example.org/socrates#>

DATA { :Post :to :Pillar. }

RULE { :Pillar :to ?What } WHERE { ?What :to :Pillar }
RULE { ?What :to :Pillar } WHERE { :Pillar :to ?What }
RULE { :result :is ?What } WHERE { :Pillar :to ?What }
RULE { :test :is true } WHERE { :result :is :Post }
