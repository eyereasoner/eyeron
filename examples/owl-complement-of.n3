# Relating complementary classes
#
# Vertebrate and invertebrate are declared complementary. Explicit N3 rules
# derive the reverse complement and disjointness links and include a fuse
# for an individual placed in both classes.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Vertebrate and Invertebrate are declared complements.
:Vertebrate owl:complementOf :Invertebrate .

# Reverse the complement link, derive disjointness, and trip a fuse if
# an individual is found in both complementary classes.
@prefix owl: <http://www.w3.org/2002/07/owl#> .

{
    ?C owl:complementOf ?D
} => {
    ?D owl:complementOf ?C
} .

{
    ?C owl:complementOf ?D
} => {
    ?D owl:disjointWith ?C
} .

{
    ?C owl:complementOf ?D .
    ?X a ?C .
    ?X a ?D
} => false .
