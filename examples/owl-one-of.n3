# Classifying an enumerated set of colors
#
# The class PrimaryColour is defined by listing its members: red, green
# and blue (owl:oneOf). An N3 rule walks the list with the list:in built-in
# and derives that each listed colour is a primary colour.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# A class given by the list of its members
:PrimaryColour owl:oneOf (:red :green :blue) .

# Every item of a oneOf list is a member of the class.
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

{
    ?C owl:oneOf ?L .
    ?X list:in ?L
} => {
    ?X a ?C
} .
