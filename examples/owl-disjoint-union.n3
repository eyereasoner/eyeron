# Expanding a disjoint union of pet classes
#
# Pet is described as a disjoint union of cat, dog, and bird classes. An N3
# rule traverses the class list to derive pairwise disjointness and a union
# statement.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Pet is the disjoint union of Cat, Dog and Bird.
:Pet owl:disjointUnionOf (:Cat :Dog :Bird) .

# Visit every pair of different listed classes to derive disjointness,
# and retain the list as a union declaration.
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .

{
    ?C owl:disjointUnionOf ?L .
    ?A list:in ?L .
    ?B list:in ?L .
    ?A log:notEqualTo ?B
} => {
    ?A owl:disjointWith ?B .
    ?C owl:unionOf ?L
} .
