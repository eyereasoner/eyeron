# Representing JSON-shaped structures in N3
#
# Blank-node property structures and lists stand for JSON-like objects and
# arrays. An N3 rule matches the supplied nested structures, including a
# named null symbol, and records a test result.

@prefix ex: <https://example.org/#> .
@prefix j: <https://example.org/json#> .

# The data: one statement whose subject is a user object, whose predicate is
# the list ("likes" 1) and whose object is a place object. Lists are terms in
# N3, so they can stand in any position, even as a predicate.
[
    j:user "alice" ;
    j:roles ("admin" j:null)
] ("likes" 1) [
    j:city "Paris" ;
    j:coords (2.35 48.85)
] .

# The test: the same shape, with the user name left open, must match.
{
    [
        j:user ?U ;
        j:roles ("admin" j:null)
    ] ("likes" 1) [
        j:city "Paris" ;
        j:coords (2.35 48.85)
    ] .
} => {
    ex:test ex:is true .
} .
