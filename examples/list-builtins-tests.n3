# Checking list operations
#
# Eleven small tests, one per list built-in of N3: joining lists, taking the
# first, last or rest, length, membership, position and removal. Each rule
# states a built-in call with its expected result and concludes a pass marker
# when the call holds; Eyeron derives all eleven markers.

@prefix : <https://eyereasoner.github.io/ns#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# list:append
# Joining (1 2) and (3 4) gives (1 2 3 4).
{
    ((1 2) (3 4)) list:append (1 2 3 4) .
} => {
    :ok_list_append_1 a :Pass .
} .

# list:first
# The first item of (1 2 3 4) is 1.
{
    (1 2 3 4) list:first 1 .
} => {
    :ok_list_first_1 a :Pass .
} .

# list:in
# "cat" is in the list; list:in is list:member with subject and object swapped.
{
    "cat" list:in ("dog" "penguin" "cat") .
} => {
    :ok_list_in_1 a :Pass .
} .

# list:iterate
# Some (index, value) pair of the list has the value "cat".
{
    ("dog" "penguin" "cat") list:iterate (?index "cat") .
} => {
    :ok_list_iterate_1 a :Pass .
} .

# list:last
# The last item of (1 2 3 4) is 4.
{
    (1 2 3 4) list:last 4 .
} => {
    :ok_list_last_1 a :Pass .
} .

# list:length
# (1 2 3 4) has four items.
{
    (1 2 3 4) list:length 4 .
} => {
    :ok_list_length_1 a :Pass .
} .

# list:member
# "cat" is a member of the list.
{
    ("dog" "penguin" "cat") list:member "cat" .
} => {
    :ok_list_member_1 a :Pass .
} .

# list:memberAt
# The item at index 2, counting from 0, is "cat".
{
    (("dog" "penguin" "cat") 2) list:memberAt "cat" .
} => {
    :ok_list_memberAt_1 a :Pass .
} .

# list:remove
# Removing "penguin" removes every occurrence of it.
{
    (("dog" "penguin" "cat" "penguin") "penguin") list:remove ("dog" "cat") .
} => {
    :ok_list_remove_1 a :Pass .
} .

# list:rest
# Without its first item, (1 2 3 4) is (2 3 4).
{
    (1 2 3 4) list:rest (2 3 4) .
} => {
    :ok_list_rest_1 a :Pass .
} .

# list:firstRest
# list:firstRest gives the first item and the rest together.
{
    (1 2 3 4) list:firstRest (1 (2 3 4)) .
} => {
    :ok_list_firstRest_1 a :Pass .
} .
