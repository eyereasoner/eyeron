# Auditing a quoted theory's rules
#
# A theory is given as a quoted graph: rules and facts that are described,
# not run. Eyeron's rules read that graph as data. They sort its rules into
# forward-only, backward-only, and pairs written both ways, and report which
# rule bodies the theory's own facts already satisfy. It shows rules about
# rules, using log:includes and log:notIncludes on a quoted graph.

@prefix : <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# The theory under audit. Inside the braces nothing is asserted: the rules
# below are not run, only inspected.
<> :theory {

    # Bidirectional pair
    {
        ?X a ?C .
        ?C rdfs:subClassOf ?D .
    } => {
        ?X a ?D .
    } .

    {
        ?X a ?D .
    } <= {
        ?X a ?C .
        ?C rdfs:subClassOf ?D .
    } .

    # Forward-only rule
    {
        ?P :parentOf ?Q .
    } => {
        ?Q :childOf ?P .
    } .

    # Backward-only rule
    {
        ?P :worksFor ?Org .
    } <= {
        ?Org :employs ?P .
    } .

    # Facts that activate all three bodies
    :alice a :Student .
    :Student rdfs:subClassOf :Person .

    :alice :parentOf :bob .

    :acme :employs :carol .
} .

# A rule written both forward (=>) and backward (<=) with the same body and
# head is bidirectional.
{
    ?W :theory ?F .
    ?F log:includes {
        ?B log:implies ?H
    } .
    ?F log:includes {
        ?H log:impliedBy ?B
    } .
} => {
    ?B :ruleStatus :Bidirectional .
    ?B :ruleHead ?H .
} .

# A forward rule with no backward twin is forward-only.
{
    ?W :theory ?F .
    ?F log:includes {
        ?B log:implies ?H
    } .
    ?F log:notIncludes {
        ?H log:impliedBy ?B
    } .
} => {
    ?B :ruleStatus :ForwardOnly .
    ?B :ruleHead ?H .
} .

# A backward rule with no forward twin is backward-only.
{
    ?W :theory ?F .
    ?F log:includes {
        ?H log:impliedBy ?B
    } .
    ?F log:notIncludes {
        ?B log:implies ?H
    } .
} => {
    ?B :ruleStatus :BackwardOnly .
    ?B :ruleHead ?H .
} .

# Check which rule bodies are active now: matching a body against the
# theory's facts binds its variables, and the matched instance is reported,
# first for forward rules, then for backward ones.
{
    ?W :theory ?F .
    ?F log:includes {
        ?B log:implies ?H
    } .
    ?F log:includes ?B .
} => {
    ?B :activeAs :ForwardBody .
} .

{
    ?W :theory ?F .
    ?F log:includes {
        ?H log:impliedBy ?B
    } .
    ?F log:includes ?B .
} => {
    ?B :activeAs :BackwardBody .
} .
