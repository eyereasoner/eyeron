# Companion to log-conclusion.n3/.eye: like log-conclusion.eye, SRL has
# no way to reason over a quoted sub-theory given as data, so this
# reifies the same outcome (a cat says "Meow") as an ordinary rule
# instead of reflecting on a formula containing one.

PREFIX : <http://example.org/>

DATA { :Felix a :Cat. }

RULE { ?x :says "Meow" } WHERE { ?x a :Cat }
