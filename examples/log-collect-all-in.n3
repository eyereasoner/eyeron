# Collecting values from a scoped graph pattern
#
# Three facts name Huey, Dewey and Louie. One rule gathers their names into
# lists with log:collectAllIn, the N3 built-in that collects every solution
# of a pattern: all names, each name wrapped in a list of its own, and only
# the names that sort before "Louie". The _:x scope means the current graph.

@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .

# The values to collect.
:Let :param "Huey" .
:Let :param "Dewey" .
:Let :param "Louie" .

# Each call reads (what to collect, the pattern, the resulting list).
{
    # Collect every name.
    (
        ?param {
            :Let :param ?param
        }
        ?allParams
    ) log:collectAllIn _:x .

    # What is collected can also be a larger term, here a one-item list.
    (
        (?param)
        {
            :Let :param ?param
        }
        ?nestedParams
    ) log:collectAllIn _:x .

    # Extra conditions in the pattern filter what is collected.
    (
        ?param {
            :Let :param ?param .
            ?param string:lessThan "Louie" .
        }
        ?filteredParams
    ) log:collectAllIn _:x .
} => {
    :result1 :is ?allParams .
    :result2 :is ?nestedParams .
    :result3 :is ?filteredParams .
} .
