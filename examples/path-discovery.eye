member(?x, [?x | ?_]).
member(?x, [?_ | ?rest]) if member(?x, ?rest).

label_path([], []).
label_path([?id | ?ids], [?lbl | ?lbls]) if label(?id, ?lbl), label_path(?ids, ?lbls).

# route(From, To, Visited, Length, Max, Path): Path is a simple (no repeated
# airport) route from From to To of at most Max stopovers beyond From,
# using only hasRoute edges; Visited starts as [From] at the top-level call
# and Length as 0. Works for any From/To/Max.
route(?from, ?to, ?visited, ?length, ?max, [?from, ?to]) if
    ?length <= ?max,
    hasRoute(?from, ?to),
    not member(?to, ?visited).
route(?from, ?to, ?visited, ?length, ?max, [?from | ?path]) if
    ?length <= ?max,
    hasRoute(?from, ?via),
    not member(?via, ?visited),
    let ?next = ?length + 1,
    route(?via, ?to, [?via | ?visited], ?next, ?max, ?path).

# find routes from Ostend-Bruges International Airport (AIRPORT_310) to
# Václav Havel Airport Prague (AIRPORT_1587) with at most 2 stopovers
discovered_airroute(?labels) if
    route("AIRPORT_310", "AIRPORT_1587", ["AIRPORT_310"], 0, 2, ?ids),
    label_path(?ids, ?labels).

ask discovered_airroute(?path).
