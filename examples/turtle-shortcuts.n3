# N3 example: turtle-shortcuts.
# Companion to turtle-shortcuts.srl: exercises Turtle's predicate-list
# (`;`) and object-list (`,`) shortcuts in the data, alongside an ordinary
# filtering rule.

@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix : <http://example/>.

:alice :knows :bob, :carol;
        :score 8.

:bob :score 3.

{?person :knows ?friend. ?person :score ?score. ?score math:notLessThan 5} => {?friend :knownBy ?person; :scoredFor ?score}.
