# checked: 12 steps, 12 verified, 0 trusted
@prefix : <https://example/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Checked answers: these follow from the source program.
:test :namedPerson :alice .
:test :namedText "Alice"^^xsd:string .
:alice :displayName "Bonjour"@fr .
:test :title "HTML و CSS"@ar--rtl .
:test :knowsSource :chat .
:test :knowsSubject :alice .
:test :knowsObject :bob .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/rdf12-interoperability.n3";
    pe:source "examples/rdf12-interoperability.n3";
    pe:verdict pe:checked;
    pe:steps 12;
    pe:verified 12;
    pe:trusted 0;
    pe:factSteps 5;
    pe:ruleSteps 7;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 12; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 12; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 12; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 17; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 19; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 7; pe:failed 0 ].
