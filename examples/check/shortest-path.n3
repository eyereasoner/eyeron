# checked with obligations: 40 steps, 39 verified, 1 trusted
@prefix : <http://example/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Conditional answers: these follow from the source program if the obligations below hold.
:test :bestCost 5 .
:test :bestPath (:a :b :c :d) .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/shortest-path.n3";
    pe:source "examples/shortest-path.n3";
    pe:verdict pe:checkedWithObligations;
    pe:steps 40;
    pe:verified 39;
    pe:trusted 1;
    pe:builtinSteps 32;
    pe:ruleSteps 8;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 8; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 40; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 40; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 47; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 32; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 5; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 42; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 5; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 8; pe:failed 0 ];
    pe:obligation [
        pe:kind "collected";
        pe:statement {
            (?cost {
                (:a :d) :shortest (?path ?cost) .
            } (5 7 9)) log:collectAllIn ?SCOPE .
        }
    ].
