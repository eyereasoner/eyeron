# checked with obligations: 3 steps, 2 verified, 1 trusted
@prefix : <https://eyereasoner.github.io/eyepl/examples/unstratified-negation#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

# Conditional answers: these follow from the source program if the obligations below hold.
:alice a :In .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/unstratified-negation.n3";
    pe:source "examples/unstratified-negation.n3";
    pe:verdict pe:checkedWithObligations;
    pe:steps 3;
    pe:verified 2;
    pe:trusted 1;
    pe:builtinSteps 1;
    pe:factSteps 1;
    pe:ruleSteps 1;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 2; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 3; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 3; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 3; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 1; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 1; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 4; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 1; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 1; pe:failed 0 ];
    pe:obligation [
        pe:kind "absent";
        pe:statement {
            {
                <http://example.org/a> <http://example.org/b> <http://example.org/c> .
            } log:notIncludes {
                :alice a :Out .
            } .
        }
    ].
