# checked: 10 steps, 10 verified, 0 trusted
@prefix : <http://example/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

# Checked answers: these follow from the source program.
:X :childOf :A .
:X :childOf :B .
:A :childOf :C .
:X :descendedFrom :A .
:X :descendedFrom :B .
:A :descendedFrom :C .
:X :descendedFrom :C .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/family.n3";
    pe:source "examples/family.n3";
    pe:verdict pe:checked;
    pe:steps 10;
    pe:verified 10;
    pe:trusted 0;
    pe:factSteps 3;
    pe:ruleSteps 7;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 10; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 10; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 10; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 15; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 17; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 7; pe:failed 0 ].
