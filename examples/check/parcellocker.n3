# checked: 16 steps, 16 verified, 0 trusted
@prefix : <https://example.org/parcellocker#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

# Checked answers: these follow from the source program.
:case :decision :Permit .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/parcellocker.n3";
    pe:source "examples/parcellocker.n3";
    pe:verdict pe:checked;
    pe:steps 16;
    pe:verified 16;
    pe:trusted 0;
    pe:factSteps 15;
    pe:ruleSteps 1;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 16; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 16; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 16; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 17; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 10; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 17; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 17; pe:failed 0 ].
