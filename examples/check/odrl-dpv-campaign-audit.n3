# checked with obligations: 8 steps, 7 verified, 1 trusted
@prefix : <http://example.org/#> .
@prefix dpv: <http://www.w3.org/ns/dpv#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

# Conditional answers: these follow from the source program if the obligations below hold.
:case :entails {
    :adVendor a :ExternalRecipient .
    :adVendor :authorisedPurpose dpv:Marketing .
    :adVendor :authorisedReadCategory dpv:PersonalData .
} .
:case :decision :ManualReviewRequired .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/odrl-dpv-campaign-audit.n3";
    pe:source "examples/odrl-dpv-campaign-audit.n3";
    pe:verdict pe:checkedWithObligations;
    pe:steps 8;
    pe:verified 7;
    pe:trusted 1;
    pe:builtinSteps 3;
    pe:factSteps 1;
    pe:ruleSteps 4;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 5; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 8; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 8; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 13; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 3; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 10; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 15; pe:failed 0 ];
    pe:obligation [
        pe:kind "impure built-in";
        pe:statement {
            {
                :ticket-99 :request :PublishCampaignAccessSummary .
                :adVendor a :ExternalRecipient .
                :marketingTeam a :InternalRecipient .
                :AudienceList dpv:hasPersonalData dpv:PersonalData .
                :ProductCatalog a :NonPersonalDataset .
                :policy-internal a odrl:Set .
                :policy-internal dpv:hasPurpose dpv:ServiceProvision .
                :policy-internal odrl:permission _:b1 .
                _:b1 odrl:assignee :marketingTeam .
                _:b1 odrl:target :ProductCatalog .
                _:b1 odrl:action odrl:read .
                :policy-external a odrl:Set .
                :policy-external dpv:hasPurpose dpv:Marketing .
                :policy-external odrl:permission _:b2 .
                _:b2 odrl:assignee :adVendor .
                _:b2 odrl:target :AudienceList .
                _:b2 odrl:action odrl:read .
                {
                    ?Policy odrl:permission _:b3 .
                    _:b3 odrl:assignee :adVendor .
                    _:b3 odrl:target ?Dataset .
                    _:b3 odrl:action odrl:read .
                } => {
                    :adVendor :canRead ?Dataset .
                } .
                {
                    ?Policy dpv:hasPurpose ?Purpose .
                    ?Policy odrl:permission _:b4 .
                    _:b4 odrl:assignee :adVendor .
                    _:b4 odrl:target ?Dataset .
                    _:b4 odrl:action odrl:read .
                } => {
                    :adVendor :authorisedPurpose ?Purpose .
                } .
                {
                    ?Policy odrl:permission _:b5 .
                    _:b5 odrl:assignee :adVendor .
                    _:b5 odrl:target ?Dataset .
                    _:b5 odrl:action odrl:read .
                    ?Dataset dpv:hasPersonalData ?Category .
                } => {
                    :adVendor :authorisedReadCategory ?Category .
                } .
            } log:conclusion {
                :ticket-99 :request :PublishCampaignAccessSummary .
                :adVendor a :ExternalRecipient .
                :marketingTeam a :InternalRecipient .
                :AudienceList dpv:hasPersonalData dpv:PersonalData .
                :ProductCatalog a :NonPersonalDataset .
                :policy-internal a odrl:Set .
                :policy-internal dpv:hasPurpose dpv:ServiceProvision .
                :policy-internal odrl:permission _:b1 .
                _:b1 odrl:assignee :marketingTeam .
                _:b1 odrl:target :ProductCatalog .
                _:b1 odrl:action odrl:read .
                :policy-external a odrl:Set .
                :policy-external dpv:hasPurpose dpv:Marketing .
                :policy-external odrl:permission _:b2 .
                _:b2 odrl:assignee :adVendor .
                _:b2 odrl:target :AudienceList .
                _:b2 odrl:action odrl:read .
                {
                    ?Policy odrl:permission _:b3 .
                    _:b3 odrl:assignee :adVendor .
                    _:b3 odrl:target ?Dataset .
                    _:b3 odrl:action odrl:read .
                } => {
                    :adVendor :canRead ?Dataset .
                } .
                {
                    ?Policy dpv:hasPurpose ?Purpose .
                    ?Policy odrl:permission _:b4 .
                    _:b4 odrl:assignee :adVendor .
                    _:b4 odrl:target ?Dataset .
                    _:b4 odrl:action odrl:read .
                } => {
                    :adVendor :authorisedPurpose ?Purpose .
                } .
                {
                    ?Policy odrl:permission _:b5 .
                    _:b5 odrl:assignee :adVendor .
                    _:b5 odrl:target ?Dataset .
                    _:b5 odrl:action odrl:read .
                    ?Dataset dpv:hasPersonalData ?Category .
                } => {
                    :adVendor :authorisedReadCategory ?Category .
                } .
                :adVendor :authorisedReadCategory dpv:PersonalData .
                :marketingTeam :authorisedPurpose dpv:ServiceProvision .
                :marketingTeam :canRead :ProductCatalog .
                :adVendor :authorisedPurpose dpv:Marketing .
                :adVendor :canRead :AudienceList .
            } .
        }
    ].
