# checked: 14 steps, 14 verified, 0 trusted
@prefix : <http://example.org/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

# Checked answers: these follow from the source program.
{
    ?P :parentOf ?Q .
} :missingForwardRule {
    ?Q :childOf ?P .
} .
{
    ?Org :employs ?P .
} :missingBackwardRule {
    ?P :worksFor ?Org .
} .
{
    ?Org :employs ?P .
} :extraForwardRule {
    ?P :worksFor ?Org .
} .
{
    ?P :mentors ?Q .
} :extraForwardRule {
    ?Q :menteeOf ?P .
} .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/theory-diff.n3";
    pe:source "examples/theory-diff.n3";
    pe:verdict pe:checked;
    pe:steps 14;
    pe:verified 14;
    pe:trusted 0;
    pe:builtinSteps 8;
    pe:factSteps 2;
    pe:ruleSteps 4;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 6; pe:failed 0 ];
