# checked: 4 steps, 4 verified, 0 trusted
@prefix : <http://example.org/#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Checked answers: these follow from the source program.
:x :y 1 .
:a :b :c .
{
    :x :y 1 .
} => {
    :a :b :c .
} .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/log-not-includes.n3";
    pe:source "examples/log-not-includes.n3";
    pe:verdict pe:checked;
    pe:steps 4;
    pe:verified 4;
    pe:trusted 0;
    pe:builtinSteps 1;
    pe:ruleSteps 3;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 3; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 4; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 4; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 7; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 1; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 7; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 3; pe:failed 0 ].
