# checked: 50 steps, 50 verified, 0 trusted
@prefix : <https://example.org/odrl-dpv-fpv-trust-flow#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix fpv: <https://example.org/fpv#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Checked answers: these follow from the source program.
:FlowCare fpv:decision fpv:permit .
:FlowCare fpv:confidence 0.92 .
:FlowCare dpv:hasStatus fpv:ExecutableFlow .
:FlowClinic fpv:decision fpv:review .
:FlowClinic fpv:confidence 0.63 .
:FlowClinic dpv:hasRisk risk:TrustworthinessRisk .
:FlowAds fpv:decision fpv:deny .
:FlowAds dpv:hasRisk risk:UnwantedDisclosureData .
:FlowAds dpv:hasStatus fpv:BlockedFlow .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/odrl-dpv-fpv-trust-flow.n3";
    pe:source "examples/odrl-dpv-fpv-trust-flow.n3";
    pe:verdict pe:checked;
    pe:steps 50;
    pe:verified 50;
    pe:trusted 0;
    pe:builtinSteps 2;
    pe:factSteps 39;
    pe:ruleSteps 9;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 48; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 50; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 50; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 168; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 2; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 59; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 9; pe:failed 0 ].
