    a pe:Check;
    pe:proof "examples/proof/fastpow.n3";
    pe:source "examples/fastpow.n3";
    pe:verdict pe:checked;
    pe:steps 66;
    pe:verified 66;
    pe:trusted 0;
    pe:builtinSteps 42;
