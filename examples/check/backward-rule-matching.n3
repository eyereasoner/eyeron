# checked: 6 steps, 6 verified, 0 trusted
@prefix : <http://example.org/#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Checked answers: these follow from the source program.
:TEST :PASS 1.1 .
:TEST :PASS 1.2 .
:TEST :PASS 1.3 .
:TEST :PASS 1.4 .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/backward-rule-matching.n3";
    pe:source "examples/backward-rule-matching.n3";
    pe:verdict pe:checked;
    pe:steps 6;
    pe:verified 6;
    pe:trusted 0;
    pe:factSteps 1;
    pe:ruleSteps 5;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 6; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 6; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 6; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 9; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 10; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 5; pe:failed 0 ].
