# checked: 14 steps, 14 verified, 0 trusted
@prefix : <http://example.org/#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

# Checked answers: these follow from the source program.
:angers :path :nantes .
:lemans :path :nantes .
:chartres :path :nantes .
:paris :path :nantes .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/road-paths.n3";
    pe:source "examples/road-paths.n3";
    pe:verdict pe:checked;
    pe:steps 14;
    pe:verified 14;
    pe:trusted 0;
    pe:factSteps 4;
    pe:ruleSteps 10;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 14; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 14; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 14; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 24; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 18; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 30; pe:failed 0 ].
