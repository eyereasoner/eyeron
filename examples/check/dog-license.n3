# checked: 10 steps, 10 verified, 0 trusted
@prefix : <http://example/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Checked answers: these follow from the source program.
:alice :dogCount 5 .
:bob :dogCount 2 .
:alice :mustHave :dogLicense .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/dog-license.n3";
    pe:source "examples/dog-license.n3";
    pe:verdict pe:checked;
    pe:steps 10;
    pe:verified 10;
    pe:trusted 0;
    pe:builtinSteps 5;
    pe:factSteps 2;
    pe:ruleSteps 3;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 5; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 10; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 10; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 11; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 5; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 2; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 13; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 2; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 3; pe:failed 0 ].
