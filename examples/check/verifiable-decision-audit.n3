# checked: 35 steps, 35 verified, 0 trusted
@prefix : <https://example.org/access#> .
@prefix doc: <https://example.org/doc/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

# Checked answers: these follow from the source program.
:audit dpv:hasJustification doc:intake .
:audit dpv:hasJustification doc:ethics .
:audit dpv:hasJustification doc:consent .
:audit dpv:hasJustification doc:registry .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/verifiable-decision-audit.n3";
    pe:source "examples/verifiable-decision-audit.n3";
    pe:source "examples/input/verifiable-decision-audit.n3";
    pe:verdict pe:checked;
    pe:steps 35;
    pe:verified 35;
    pe:trusted 0;
    pe:factSteps 17;
    pe:ruleSteps 18;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 35; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 35; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 35; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 45; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 1; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 39; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 63; pe:failed 0 ].
