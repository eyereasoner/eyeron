# checked: 30 steps, 30 verified, 0 trusted
@prefix : <http://example.org/socrates#> .
@prefix pa: <http://example.org/proof-audit#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Checked answers: these follow from the source program.
pa:test pa:root {
    :Socrates a :Mortal .
} .
pa:test pa:answerApplied ("A" :Human) .
pa:test pa:answerApplied ("B" :Mortal) .
pa:test pa:answerApplied ("S" :Socrates) .
{
    :Socrates a :Mortal .
} pa:dependsOn {
    :Socrates a :Human .
} .
{
    :Socrates a :Mortal .
} pa:dependsOn {
    :Human rdfs:subClassOf :Mortal .
} .
{
    :Socrates a :Human .
} pa:sourceFact true .
{
    :Human rdfs:subClassOf :Mortal .
} pa:sourceFact true .
pa:test pa:queryDependency {
    :Socrates a :Human .
} .
pa:test pa:queryDependency {
    :Human rdfs:subClassOf :Mortal .
} .
{
    :Socrates a :Mortal .
} pa:supportedBy {
    :Socrates a :Human .
} .
{
    :Socrates a :Mortal .
} pa:supportedBy {
    :Human rdfs:subClassOf :Mortal .
} .
{
    :Socrates a :Human .
} pa:supportedBy {
    :Socrates a :Human .
} .
{
    :Human rdfs:subClassOf :Mortal .
} pa:supportedBy {
    :Human rdfs:subClassOf :Mortal .
} .
pa:test pa:support {
    :Socrates a :Human .
} .
pa:test pa:support {
    :Human rdfs:subClassOf :Mortal .
} .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/proof-audit.n3";
    pe:source "examples/proof-audit.n3";
    pe:source "examples/input/proof-audit.n3";
    pe:verdict pe:checked;
    pe:steps 30;
    pe:verified 30;
    pe:trusted 0;
    pe:factSteps 14;
    pe:ruleSteps 16;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 30; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 30; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 30; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 47; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 46; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 16; pe:failed 0 ].
