# checked with obligations: 12 steps, 11 verified, 1 trusted
@prefix : <http://example.org/> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Conditional answers: these follow from the source program if the obligations below hold.
:alice a :Student .
:alice a :Worker .
:WorkingStudent rdfs:subClassOf :Student .
:WorkingStudent rdfs:subClassOf :Worker .
:bob a :WorkingStudent .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/owl-intersection-of.n3";
    pe:source "examples/owl-intersection-of.n3";
    pe:verdict pe:checkedWithObligations;
    pe:steps 12;
    pe:verified 11;
    pe:trusted 1;
    pe:builtinSteps 4;
    pe:factSteps 3;
    pe:ruleSteps 5;
    pe:condition [ pe:id "C1"; pe:name "resolution"; pe:checked 8; pe:failed 0 ];
    pe:condition [ pe:id "C2"; pe:name "well-foundedness"; pe:checked 12; pe:failed 0 ];
    pe:condition [ pe:id "C3"; pe:name "justification"; pe:checked 12; pe:failed 0 ];
    pe:condition [ pe:id "C4"; pe:name "coverage"; pe:checked 19; pe:failed 0 ];
    pe:condition [ pe:id "C5"; pe:name "re-decision"; pe:checked 4; pe:failed 0 ];
    pe:condition [ pe:id "C6"; pe:name "boundary consistency"; pe:checked 1; pe:failed 0 ];
    pe:condition [ pe:id "C7"; pe:name "relevance"; pe:checked 17; pe:failed 0 ];
    pe:condition [ pe:id "C8"; pe:name "witness integrity"; pe:checked 0; pe:failed 0 ];
    pe:condition [ pe:id "C9"; pe:name "search closure"; pe:checked 1; pe:failed 0 ];
    pe:condition [ pe:id "C10"; pe:name "call fidelity"; pe:checked 5; pe:failed 0 ];
    pe:obligation [
        pe:kind "collected";
        pe:statement {
            ({
                ?D list:in (:Student :Worker) .
            } {
                :bob a ?D .
            }) log:forAllIn _:forAllIn .
        }
    ].
