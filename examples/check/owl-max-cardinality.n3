# checked: 9 steps, 9 verified, 0 trusted
@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

# Checked answers: these follow from the source program.
:bob owl:sameAs :bob .
:bob owl:sameAs :robert .
:robert owl:sameAs :bob .
:robert owl:sameAs :robert .

# The check of these answers against the source program. Its verdict covers
# the answers above; it does not establish that they are all the answers.
[]
    a pe:Check;
    pe:proof "examples/proof/owl-max-cardinality.n3";
    pe:source "examples/owl-max-cardinality.n3";
    pe:verdict pe:checked;
    pe:steps 9;
    pe:verified 9;
    pe:trusted 0;
    pe:factSteps 5;
    pe:ruleSteps 4;
