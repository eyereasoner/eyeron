# Returning rules as query answers
#
# A small relation supplies bindings for two queries. Their N3 conclusions
# are quoted implications, showing how a query can return a chain of rules
# as structured output.

@base <https://eyereasoner.github.io/eye/reasoning/rgb/redgraph001.n3> .
@prefix : <http://example.org/try#> .

:s :p :o .
:o :p :p .
:p :p :s .

# The first query captures S and returns a p-to-q implication. The second
# returns a q-to-r implication for the same bindings; O remains a rule variable.
@prefix : <http://example.org/try#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

{
    ?S :p :o .
} log:query {
    {
        ?S :p ?O .
    } => {
        ?S :q ?O .
    } .
} .

{
    ?S :p :o .
} log:query {
    {
        ?S :q ?O .
    } => {
        ?S :r ?O .
    } .
} .
