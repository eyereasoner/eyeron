# Finding a project's critical tasks
#
# Tasks have durations and dependencies. Backward N3 rules enumerate
# dependency paths, and scoped collection selects the longest completion
# time and the tasks that lie on critical paths.

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example/> .

# Task durations use the same arbitrary time unit; staffing is unlimited.
:requirements :duration 2 .
:architecture :duration 3 .
:api_design :duration 2 .
:database :duration 4 .
:backend :duration 6 .
:frontend :duration 5 .
:auth :duration 3 .
:integration :duration 4 .
:security_review :duration 3 .
:load_test :duration 2 .
:launch :duration 1 .

# A dependsOn link says that the target must finish before the task starts.
:architecture :dependsOn :requirements .
:api_design :dependsOn :requirements .
:database :dependsOn :architecture .
:backend :dependsOn :api_design .
:backend :dependsOn :database .
:frontend :dependsOn :api_design .
:auth :dependsOn :architecture .
:integration :dependsOn :backend .
:integration :dependsOn :frontend .
:integration :dependsOn :auth .
:security_review :dependsOn :integration .
:load_test :dependsOn :integration .
:launch :dependsOn :security_review .
:launch :dependsOn :load_test .

# A task without prerequisites has a one-task path and finishes at its duration.
{
    ?task :durationPath ((?task) ?d)
} <= {
    ?task :duration ?d .
    ?SCOPE log:notIncludes {
        ?task :dependsOn ?any
    }
} .

# Extend each prerequisite path by this task and add its duration.
{
    ?task :durationPath (?path ?finish)
} <= {
    ?task :duration ?d .
    ?task :dependsOn ?predecessor .
    ?predecessor :durationPath (?prevPath ?previous) .
    (?previous ?d) math:sum ?finish .
    ?path list:firstRest (?task ?prevPath) .
} .

# Collect all path durations for a task; its longest path gives its finish.
{
    ?task :duration ?_ .
    (
        ?candidate {
            ?task :durationPath (?p ?candidate)
        }
        ?candidates
    ) log:collectAllIn ?SCOPE .
    ?candidates list:sort ?sorted .
    ?sorted list:last ?maxFinish .
} => {
    ?task :finish ?maxFinish
} .

# Subtract the task duration to recover its earliest start.
{
    ?task :duration ?finish0 .
    ?task :finish ?finish .
    (?finish ?finish0) math:difference ?start .
} => {
    ?task :schedule (?start ?finish)
} .

# The latest task finish is the project completion time.
{
    (
        ?candidate {
            ?any :finish ?candidate
        }
        ?candidates
    ) log:collectAllIn ?SCOPE .
    ?candidates list:sort ?sorted .
    ?sorted list:last ?projectFinish .
} => {
    :test :projectFinish ?projectFinish
} .

# Every task on a path of that length is critical, including tied paths.
{
    :test :projectFinish ?pf .
    ?anyTask :durationPath (?path ?pf) .
    ?path list:member ?task .
} => {
    ?task :critical true
} .
