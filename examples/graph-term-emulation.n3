# Inspecting quoted graph terms
#
# Quoted graphs serve as values that rules can inspect. The N3 example
# matches their internal statements and derives results while keeping the
# quoted evidence distinct from asserted facts.

@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example/> .

# The contents of these graph values are quoted data, not asserted facts.
:g1 :graphTerm {
    :alice :knows :bob .
    :bob :knows :carol
} .

:g2 :graphTerm {
    :alice :likes :tea
} .

:note1 :aboutGraphTerm :g1 .

# A quoted knows statement is enough to classify its containing graph.
{
    ?g :graphTerm ?formula .
    ?formula log:includes {
        ?s :knows ?o
    }
} => {
    ?g a :SocialGraphTerm
} .

# Record subjects mentioned inside each graph.
{
    ?g :graphTerm ?formula .
    ?formula log:includes {
        ?s ?p ?o
    }
} => {
    ?g :mentions ?s
} .

# Record objects too; inspecting the graph does not assert its contents.
{
    ?g :graphTerm ?formula .
    ?formula log:includes {
        ?s ?p ?o
    }
} => {
    ?g :mentions ?o
} .
