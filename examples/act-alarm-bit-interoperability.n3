# Sharing a harbor alarm bit
#
# A harbor alarm is one bit, shown by an optical beacon (blue or red lamp) and
# held in a relay register (low or high voltage). Eyeron derives which tasks
# are possible: flipping the bit on each medium, and copying it from either
# medium to either medium. It contrasts this with a quantum-like token whose
# states cannot all be cloned. Rules introduce each task as a new, unnamed
# resource with a blank node (`[ ... ]`) in their conclusion, and log:query
# picks out the answers. The vocabulary of possible and impossible tasks
# follows the constructor theory of information of Deutsch and Marletto.
#
# See <https://arxiv.org/abs/1405.5563>

@prefix : <http://example.org/alarm-bit/> .
@prefix arc: <https://example.org/arc#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

:case a arc:Case ;
    arc:question "Can the harbor alarm bit be copied between an optical beacon and a relay register, and what exactly can't be done for a quantum-like token?" .

# Classical substrates carrying the same abstract variable
:opticalBeacon a :InformationMedium ;
    :encodes :AlarmBit ;
    :zeroState :BlueLamp ;
    :oneState :RedLamp .

:relayRegister a :InformationMedium ;
    :encodes :AlarmBit ;
    :zeroState :LowVoltage ;
    :oneState :HighVoltage .

# For contrast, a quantum-like token with four polarization states. It is a
# superinformation medium: its states cannot all be cloned.
:quantumToken a :SuperinformationMedium ;
    :encodes :PolarizationVariable ;
    :state :Horizontal ;
    :state :Vertical ;
    :state :Diagonal ;
    :state :AntiDiagonal .

# CAN rules — what becomes possible for information media
# Any information medium supports a local permutation of its designated variable.
{
    ?M a :InformationMedium ;
        :encodes ?V ;
        :zeroState ?Z ;
        :oneState ?O .
} => {
    ?M :can :LocalPermutation .
    [
        a :PossibleTask ;
        :taskType :Permute ;
        :on ?M ;
        :variable ?V ;
        :fromState ?Z ;
        :toState ?O
    ] .
} .

# Two information media that encode the same variable can interoperate, and
# the variable can be copied from one to the other. The rule matches every
# pair, including a medium paired with itself, so copies within one medium
# are listed too.
{
    ?A a :InformationMedium ;
        :encodes ?V .
    ?B a :InformationMedium ;
        :encodes ?V .
} => {
    ?A :can :InteroperateForVariable .
    ?B :can :InteroperateForVariable .
    [
        a :PossibleTask ;
        :taskType :Copy ;
        :from ?A ;
        :to ?B ;
        :variable ?V
    ] .
} .

# CAN'T rules — what becomes impossible for a superinformation token
# A superinformation medium cannot have all of its states universally cloned.
{
    ?M a :SuperinformationMedium ;
        :encodes ?V .
} => {
    ?M :cannot :UniversalClone .
    [
        a :ImpossibleTask ;
        :taskType :CloneAllStates ;
        :on ?M ;
        :variable ?V
    ] .
} .

# If universal cloning is unavailable, unrestricted classical-style fan-out of
# the entire state space is unavailable too.
{
    ?M :cannot :UniversalClone .
} => {
    ?M :cannot :UnrestrictedStateFanOut .
} .

# Query: report every can and cannot statement.
{
    ?Subject :can ?Value .
} log:query {
    ?Subject :can ?Value .
} .

{
    ?Subject :cannot ?Value .
} log:query {
    ?Subject :cannot ?Value .
} .

# Copy answers list the source and destination media, in that order.
{
    ?Task a :PossibleTask ;
        :taskType :Copy ;
        :from ?From ;
        :to ?To ;
        :variable ?Variable .
} log:query {
    (?From ?To) :canCopy ?Variable .
} .
