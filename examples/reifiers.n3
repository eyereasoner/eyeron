# N3 example: reifiers.
# Companion to reifiers.pl/.srl: N3 has no RDF-star `<<...>>` triple-term
# syntax, so a reified statement is represented using N3's own native
# first-class term for a set of triples, a quoted formula (`{...}`),
# attached to its claim via an ordinary `:statement` property -- matching
# the source's `reifies(claim, triple(subject, predicate, object))` shape
# without asserting the reified statement itself as a fact.

@prefix : <http://example/>.

:claim1 :statement {:alice :says "hello"}.
:claim1 :source :chat.
:claim2 :statement {:bob :says "hi"}.
:claim2 :source :email.

{?claim :statement {?speaker :says ?object}. ?claim :source ?source} => {?speaker :statementSource ?source}.
