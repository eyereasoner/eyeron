# Reading an RDF list's head and tail
#
# A two-item list is attached to a subject. Backward N3 rules expose its
# rdf:first and rdf:rest values, and a forward rule checks the resulting
# head and tail.

@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix : <http://example.org/ns#> .

# The list contains the integers one and two.
:X :val (1 2) .

# Backward helpers expose the first item and the list that remains.
{
    ?X :head ?Y
} <= {
    ?X rdf:first ?Y
} .

{
    ?X :tail ?Y
} <= {
    ?X rdf:rest ?Y
} .

# Check both projections: the head is 1 and the tail is the one-item list (2).
{
    ?X :val ?Y .
    ?Y :head ?H .
    ?Y :tail ?T .

    ?H log:equalTo 1 .
    ?T log:equalTo (2) .
} => {
    :result :is true .
} .
