# The Ackermann function
#
# The Ackermann function is a classic recursive function that grows faster
# than any function computed with ordinary bounded loops: A(4, 2) already has
# 19,729 digits. Eyeron computes twelve values, A(3, 1000) and A(4, 2)
# among them, with backward rules and exact integer arithmetic. The rules
# turn A(x, y) into a ladder of operations on 2: successor, addition,
# multiplication, exponentiation, then repeated exponentiation.
#
# See <https://en.wikipedia.org/wiki/Ackermann_function>

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <https://eyereasoner.github.io/ns#> .

# A(x, y) = H(x, y + 3, 2) - 3, where H is the three-argument ladder below.
{
    (?X ?Y) :ackermann ?A .
} <= {
    (?Y 3) math:sum ?B .
    (?X ?B 2) :ackermann ?C .
    (?C 3) math:difference ?A .
} .

# H(x, y, z), step x of the ladder. Step 0 is the successor: y + 1.
{
    (0 ?Y ?Z) :ackermann ?A .
} <= {
    (?Y 1) math:sum ?A .
} .

# Step 1 is addition: y + z.
{
    (1 ?Y ?Z) :ackermann ?A .
} <= {
    (?Y ?Z) math:sum ?A .
} .

# Step 2 is multiplication: y * z.
{
    (2 ?Y ?Z) :ackermann ?A .
} <= {
    (?Y ?Z) math:product ?A .
} .

# Step 3 is exponentiation: z to the power y, computed directly as an exact
# integer rather than by repeated multiplication.
{
    (3 ?Y ?Z) :ackermann ?A .
} <= {
    (?Z ?Y) math:exponentiation ?A .
} .

# Steps above 3 are tetration, pentation and so on. Each starts at
# H(x, 0, z) = 1 ...
{
    (?X 0 ?Z) :ackermann 1 .
} <= {
    ?X math:greaterThan 3 .
} .

# ... and repeats the step below it: H(x, y, z) = H(x - 1, H(x, y - 1, z), z).
{
    (?X ?Y ?Z) :ackermann ?A .
} <= {
    ?X math:greaterThan 3 .
    ?Y math:notEqualTo 0 .
    (?Y 1) math:difference ?B .
    (?X ?B ?Z) :ackermann ?C .
    (?X 1) math:difference ?D .
    (?D ?C ?Z) :ackermann ?A .
} .

# Ask for twelve values and gather them in one answer.
{
    (0 0) :ackermann ?A0 .
    (0 6) :ackermann ?A1 .
    (1 2) :ackermann ?A2 .
    (1 7) :ackermann ?A3 .
    (2 2) :ackermann ?A4 .
    (2 9) :ackermann ?A5 .
    (3 4) :ackermann ?A6 .
    (3 1000) :ackermann ?A7 .
    (4 0) :ackermann ?A8 .
    (4 1) :ackermann ?A9 .
    (4 2) :ackermann ?A10 .
    (5 0) :ackermann ?A11 .
} => {
    :test :is {
        (0 0) :ackermann ?A0 .
        (0 6) :ackermann ?A1 .
        (1 2) :ackermann ?A2 .
        (1 7) :ackermann ?A3 .
        (2 2) :ackermann ?A4 .
        (2 9) :ackermann ?A5 .
        (3 4) :ackermann ?A6 .
        (3 1000) :ackermann ?A7 .
        (4 0) :ackermann ?A8 .
        (4 1) :ackermann ?A9 .
        (4 2) :ackermann ?A10 .
        (5 0) :ackermann ?A11 .
    } .
} .
