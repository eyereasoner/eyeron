# Combining arithmetic and list operations
#
# A short list supplies a small calculation. One N3 rule derives an
# absolute value, a square root through exponentiation, the list length,
# and a sorted list using built-in operations.

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix : <http://example/> .

# The list of numbers to work on.
:numbers :values (-3.7 7 2) .

# One rule asks four built-ins for their answers: the absolute value of -3.7,
# 9 to the power 0.5 (a square root), and the length and sorted order of the
# list. Each built-in binds its variable, and the rule reports all four.
{
    :numbers :values ?values .
    -3.7 math:absoluteValue ?absolute .
    (9 0.5) math:exponentiation ?root .
    ?values list:length ?count .
    ?values list:sort ?sorted .
} => {
    :summary :absolute ?absolute ;
        :root ?root ;
        :count ?count ;
        :sorted ?sorted
} .
