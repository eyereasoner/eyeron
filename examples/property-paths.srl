# SPARQL 1.2 RL: property paths. Sequence `/`, inverse `^`, alternative
# `|`, and the length modifiers `?` (zero or one), `+` (one or more) and
# `*` (zero or more), which may be grouped with `(...)`.
#
# `:reports` is cyclic (:d reports to :b, which :d supervises through :c),
# so `+` also has to report a node as reaching itself, and terminate.

PREFIX : <http://example/>

DATA {
  :a :parentOf :b .
  :b :parentOf :c .
  :x :stepParentOf :b .

  :b :reports :c .
  :c :reports :d .
  :d :reports :b .
}

RULE { ?x :grandparentOf ?z } WHERE { ?x :parentOf/:parentOf ?z }
RULE { ?x :hasParent ?y } WHERE { ?x ^:parentOf ?y }
RULE { ?x :raisedBy ?y } WHERE { ?y :parentOf|:stepParentOf ?x }
RULE { ?x :ancestorOf ?y } WHERE { ?x :parentOf+ ?y }
RULE { ?x :selfOrAncestorOf ?y } WHERE { ?x :parentOf* ?y }
RULE { ?x :nearParentOf ?y } WHERE { ?x :parentOf? ?y }
RULE { ?x :inReportingCycleWith ?y } WHERE { ?x :reports+ ?y }
RULE { :a :reachesBeyondChild ?y } WHERE { :a :parentOf/(:parentOf|:reports)+ ?y }
