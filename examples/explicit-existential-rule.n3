# A universally quantified rule with fresh mothers
#
# A rule says that each human has some mother, and Tom is a human. Explicit
# N3 quantifiers distinguish the universally bound person from a fresh
# existential witness in the conclusion.

@prefix : <http://example.org/> .

# :x is declared universal, so the rule applies to every human. Inside the
# conclusion, @forSome makes :y existential: each firing gets a fresh mother.
@forAll :x .
{
    :x a :Human
} => {
    @forSome :y .
    :x :hasMother :y
} .

# The only human.
:tom a :Human .

# Two quoted graphs, stored as data and not used as rules: the rule as
# written, and its instance for :tom. Substituting :tom for :x leaves the
# local existential :y in place, so the instance still says that Tom has
# some mother, which is what the rule derives: :tom :hasMother _:witness.
:universalRule :graph {
    {
        :x a :Human
    } => {
        @forSome :y .
        :x :hasMother :y
    } .
} .

:instantiatedRule :graph {
    {
        :tom a :Human
    } => {
        @forSome :y .
        :tom :hasMother :y
    } .
} .
