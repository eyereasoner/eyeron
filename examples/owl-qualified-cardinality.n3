# Restricting the number of cat pets
#
# A single-cat owner has at most one pet that is a cat
# (owl:maxQualifiedCardinality 1 on :pet with owl:onClass :Cat). Alice is
# one, and has the pets Milo and Felix, both cats, and Fido, a dog. An N3
# rule counts only the pets of the qualifying class, so it concludes that
# Milo and Felix are the same cat (owl:sameAs) and leaves Fido alone.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# The qualified restriction, a member, and her pets
:SingleCatOwner owl:maxQualifiedCardinality 1 ;
    owl:onProperty :pet ;
    owl:onClass :Cat .
:alice a :SingleCatOwner ;
    :pet :milo, :felix, :fido .
:milo a :Cat .
:felix a :Cat .
:fido a :Dog .

# Rules for qualified maximum cardinality
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Under a maximum of one, any two values in the qualifying class are the
# same thing (each is also the same as itself).
{
    ?C owl:maxQualifiedCardinality 1 .
    ?C owl:onProperty ?P .
    ?C owl:onClass ?D .
    ?U a ?C .
    ?U ?P ?Y .
    ?Y a ?D .
    ?U ?P ?Z .
    ?Z a ?D
} => {
    ?Y owl:sameAs ?Z
} .

# With owl:Thing as the class, every value qualifies.
{
    ?C owl:maxQualifiedCardinality 1 .
    ?C owl:onProperty ?P .
    ?C owl:onClass owl:Thing .
    ?U a ?C .
    ?U ?P ?Y .
    ?U ?P ?Z
} => {
    ?Y owl:sameAs ?Z
} .

# Fuse for a maximum of zero. As written it uses ?C for both the restricted
# class and the qualifying class, so it only fires for a restriction that is
# its own owl:onClass.
{
    ?C owl:maxQualifiedCardinality 0 .
    ?C owl:onProperty ?P .
    ?C owl:onClass ?C .
    ?U a ?C .
    ?U ?P ?Y .
    ?Y a ?C
} => false .

# Fuse: with owl:Thing as the class, a maximum of zero allows no value.
{
    ?C owl:maxQualifiedCardinality 0 .
    ?C owl:onProperty ?P .
    ?C owl:onClass owl:Thing .
    ?U a ?C .
    ?U ?P ?Y
} => false .
