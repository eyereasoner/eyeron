@prefix : <http://example.org/socrates#> .
@prefix pa: <http://example.org/proof-audit#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pa:test pa:root {
    :Socrates a :Mortal .
} .

pa:test pa:answerApplied ("A" :Human) .
pa:test pa:answerApplied ("B" :Mortal) .
pa:test pa:answerApplied ("S" :Socrates) .

{
    :Socrates a :Mortal .
} pa:dependsOn {
    :Socrates a :Human .
} .

{
    :Socrates a :Mortal .
} pa:dependsOn {
    :Human rdfs:subClassOf :Mortal .
} .

{
    :Socrates a :Human .
} pa:sourceFact true .

{
    :Human rdfs:subClassOf :Mortal .
} pa:sourceFact true .

pa:test pa:queryDependency {
    :Socrates a :Human .
} .

pa:test pa:queryDependency {
    :Human rdfs:subClassOf :Mortal .
} .

{
    :Socrates a :Mortal .
} pa:supportedBy {
    :Socrates a :Human .
} .

{
    :Socrates a :Mortal .
} pa:supportedBy {
    :Human rdfs:subClassOf :Mortal .
} .

{
    :Socrates a :Human .
} pa:supportedBy {
    :Socrates a :Human .
} .

{
    :Human rdfs:subClassOf :Mortal .
} pa:supportedBy {
    :Human rdfs:subClassOf :Mortal .
} .

pa:test pa:support {
    :Socrates a :Human .
} .

pa:test pa:support {
    :Human rdfs:subClassOf :Mortal .
} .
