@prefix : <http://example.org/whitehead#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:red a :PurePotential .
:warm a :PurePotential .
:bright a :PurePotential .
:dark a :PurePotential .
:intensity a :SubjectiveAim .
:contrast a :SubjectiveAim .
:intensity :lures :bright .
:contrast :lures :dark .
:o1 a :ActualOccasion .
:o1 :time 1 .
:o1 :realizes :red .
:o1 :realizes :warm .
:o1 :achieves :satisfaction .
:o2 a :ActualOccasion .
:o2 :time 2 .
:o2 :prehends :o1 .
:o2 :subjectiveAim :intensity .
:o3 a :ActualOccasion .
:o3 :time 3 .
:o3 :prehends :o2 .
:o3 :subjectiveAim :contrast .
:o2 :becomesFrom :o1 .
:o3 :becomesFrom :o2 .
:o2 :inherits :red .
:o2 :inherits :warm .
:o2 :mayRealize :bright .
:o3 :mayRealize :dark .
:o1 :ingresses :red .
:o1 :ingresses :warm .
:o1 :status :objectivelyAvailable .
:o1 :availableForFuturePrehension :yes .
:o2 :integrates :red .
:o2 :integrates :bright .
:o2 :achieves :satisfaction .
:o2 :integrates :warm .
:o2 :realizes :red .
:o2 :realizes :bright .
:o2 :realizes :warm .
:o2 :status :objectivelyAvailable .
:o2 :availableForFuturePrehension :yes .
:o3 :inherits :red .
:o3 :inherits :bright .
:o3 :inherits :warm .
:o2 :ingresses :red .
:o2 :ingresses :bright .
:o2 :ingresses :warm .
:o3 :integrates :red .
:o3 :integrates :dark .
:o3 :achieves :satisfaction .
:o3 :integrates :bright .
:o3 :integrates :warm .
:o3 :realizes :red .
:o3 :realizes :dark .
:o3 :realizes :bright .
:o3 :realizes :warm .
:o3 :status :objectivelyAvailable .
:o3 :availableForFuturePrehension :yes .
:o3 :ingresses :red .
:o3 :ingresses :dark .
:o3 :ingresses :bright .
:o3 :ingresses :warm .
