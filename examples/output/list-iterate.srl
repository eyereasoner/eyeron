@prefix : <urn:example:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b1 rdf:first "Huey" .
_:b1 rdf:rest _:b2 .
_:b2 rdf:first "Dewey" .
_:b2 rdf:rest _:b3 .
_:b3 rdf:first "Louie" .
_:b3 rdf:rest rdf:nil .
:Let :param _:b1 .
_:b1 :iterate0 "Huey" .
_:b1 :iterate1 "Dewey" .
_:b1 :iterate2 "Louie" .
"Dewey" :hasIndex 1 .
:test :is true .
