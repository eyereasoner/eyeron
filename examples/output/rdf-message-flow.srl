@prefix : <https://eyereasoner.github.io/eyeling/examples/rdf-message-flow#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:temperatureFlow :highThreshold 26 .
:m1 :result 21 .
:m2 :result 22 .
:m3 :empty true .
:m4 :result 28 .
:m5 :result 29 .
:m1 :route :archiveSink .
:m2 :route :archiveSink .
:m4 :route :alertSink .
:m5 :route :alertSink .
:m3 :route :heartbeatSink .
