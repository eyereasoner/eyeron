@prefix : <http://example/graph-term-list/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:g1 a :GraphTerm .

_:b1 rdf:first {
    :alice :knows :bob .
} .

_:b1 rdf:rest _:b2 .

_:b2 rdf:first {
    :bob :knows :carol .
} .

_:b2 rdf:rest rdf:nil .
:g1 :quotedTriples _:b1 .
:g2 a :GraphTerm .

_:b3 rdf:first {
    :alice :likes :tea .
} .

_:b3 rdf:rest rdf:nil .
:g2 :quotedTriples _:b3 .
:note1 :aboutGraphTerm :g1 .
:g1 :listCell _:b1 .
:g2 :listCell _:b3 .
:g1 :listCell _:b2 .
:g2 :listCell rdf:nil .
:g1 a :SocialGraphTerm .
:g1 :mentions :alice .
:g2 :mentions :alice .
:g1 :mentions :bob .
:g2 :mentions :tea .
:g1 :listCell rdf:nil .
:g1 :mentions :carol .
