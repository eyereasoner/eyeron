:a :inP true. :b :inP true. :g1 :inP true. :g2 :inP true.
:g1 :glbOfA :a; :glbOfB :b.
:g2 :glbOfA :a; :glbOfB :b.

:a :leq :a .
:b :leq :b .
:g1 :leq :g1 .
:g2 :leq :g2 .
:g1 :lowerBoundOfA :a .
:g1 :lowerBoundOfB :b .
:g2 :lowerBoundOfA :a .
:g2 :lowerBoundOfB :b .
:g1 :leq :a .
:g2 :leq :a .
:g1 :leq :b .
:g2 :leq :b .
:a :sameTerm :a .
:b :sameTerm :b .
:g1 :sameTerm :g1 .
:g2 :sameTerm :g2 .
:g2 :leq :g1 .
:g1 :leq :g2 .
:g2 :sameTerm :g1 .
:g1 :sameTerm :g2 .
_:b1 a :SameGlbWitness .
_:b1 :witnessA :a .
_:b1 :witnessB :b .
_:b1 :witnessM :g1 .
_:b1 :witnessN :g2 .
_:b2 a :SameGlbWitness .
_:b2 :witnessA :a .
_:b2 :witnessB :b .
_:b2 :witnessM :g2 .
_:b2 :witnessN :g1 .
