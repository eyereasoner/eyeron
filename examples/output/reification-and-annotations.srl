@prefix : <http://example/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:alice :says :hello .
_:b1 rdf:reifies <<(:alice :says :hello)>> .
_:b1 :source :chat .
_:b1 :certainty 0.9 .
:bobClaim rdf:reifies <<(:bob :says :hi)>> .
:bobClaim :source :email .
:alice :statementSource :chat .
:bob :statementSource :email .
