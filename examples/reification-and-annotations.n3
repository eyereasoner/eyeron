# Connecting statements to their sources
#
# Alice's statement is asserted and separately described by a claim node,
# while Bob's statement is quoted. N3 rules inspect the claim graphs and
# metadata to derive statement-source relationships.

@prefix : <http://example/> .

# Alice's statement is asserted separately from its claim record.
:alice :says :hello .
[ ] :statement {
    :alice :says :hello
} ;
    :source :chat ;
    :certainty 0.9 .

# Bob's statement is only quoted; it is still available for provenance inspection.
:bobClaim :statement {
    :bob :says :hi
} ;
    :source :email .

# For each claim, match its quoted speaker and copy the source.
# The result records provenance without asserting the quoted statement.
{
    ?claim :statement {
        ?speaker :says ?object
    } .
    ?claim :source ?source
} => {
    ?speaker :statementSource ?source
} .
