# Companion to patch.n3/.eye: the same source-minus-delete-plus-insert
# patch, represented as RDF-star TRIPLE() values attached to :patch1
# rather than a quoted graph term (SRL has no such term). The "kept"
# rule only reads the `a` (rdf:type) property specifically, rather than
# a fully variable predicate, which the stratifier would otherwise flag
# as a genuine self-referential cycle through this rule's own
# SET-constructed :resultTriple output (a completely free predicate
# pattern can match anything, including this rule's own conclusions).
# Filtering by predicate name, rather than the exact (subject, predicate,
# object) triple, is enough here since each deleted property occurs only
# once in the source data.

PREFIX : <http://example.org/>

DATA {
  :alice a :Person; :age 30; :status :OldStatus; :email "alice@example.org".
  :bob a :Person.
}

RULE { :patch1 :resultTriple ?t } WHERE {
  ?s a ?o.
  SET(?t := TRIPLE(?s, rdf:type, ?o))
}

RULE { :patch1 :resultTriple ?t } WHERE {
  SET(?t := TRIPLE(:alice, :age, 31))
}

RULE { :patch1 :resultTriple ?t } WHERE {
  SET(?t := TRIPLE(:alice, :status, :ActiveStatus))
}

RULE { :patch1 :resultTriple ?t } WHERE {
  SET(?t := TRIPLE(:alice, :verified, true))
}
