# Placing four nonattacking queens
#
# Four row choices define a small chessboard search. Recursive backward N3
# rules build placements and check that queens share neither a row nor a
# diagonal.

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <https://eyereasoner.github.io/eyepl/examples/four-queens#> .

# Row choices are 1 through 4; each new list item occupies the next column.
:r1 a :Row ;
    :n 1 .
:r2 a :Row ;
    :n 2 .
:r3 a :Row ;
    :n 3 .
:r4 a :Row ;
    :n 4 .

# No previously placed queen means there is no conflict to check.
{
    (?row () ?distance) :safe true
} <= true .

# Reject the same row or a row difference equal to the column distance;
# then check the rest of the placed queens one column farther away.
{
    (?row ?placed ?distance) :safe true
} <= {
    ?placed list:firstRest (?other ?rest) .
    ?row log:notEqualTo ?other .
    (?row ?other) math:difference ?diff .
    ?diff math:absoluteValue ?delta .
    ?delta log:notEqualTo ?distance .
    (?distance 1) math:sum ?next .
    (?row ?rest ?next) :safe true .
} .

# When no columns remain, the accumulated placement is a solution.
{
    (0 ?placed) :place ?placed
} <= true .

# Try a row, check it against the current placement and recurse.
{
    (?remaining ?placed) :place ?rows
} <= {
    ?remaining math:greaterThan 0 .
    ?rowRes a :Row .
    ?rowRes :n ?row .
    (?row ?placed 1) :safe true .
    (?remaining 1) math:difference ?next .
    ?newPlaced list:firstRest (?row ?placed) .
    (?next ?newPlaced) :place ?rows .
} .

# Start with four empty columns and report every complete safe placement.
{
    (4 ()) :place ?rows
} => {
    :query :solution ?rows
} .
