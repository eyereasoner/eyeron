# Instantiating universally quantified statements
#
# Two statements are made about everything: everything has property :p
# with value :o, and everything has some mother. Rules then ask about
# particular things: :s has :p :o, and Bob and Liz each have a mother, each
# a separate unnamed individual. It shows the explicit quantifiers @forAll
# and @forSome, and how a "some" inside an "all" gives each thing its own
# witness.

@prefix : <http://example.org/> .

# For all x there is some y: x has :p :o, and y is x's mother.
@forAll :x .
@forSome :y .
:x :p :o .
:x :hasMother :y .

# :s is one instance of the universal statement.
{
    :s :p :o
} => {
    :universalInstance :holds true
} .

# Bob's and Liz's mothers, whoever they are.
{
    :bob :hasMother ?mother
} => {
    :bob :mother ?mother
} .

{
    :liz :hasMother ?mother
} => {
    :liz :mother ?mother
} .

# The witnesses for Bob's and Liz's mothers may differ.
