# Comparing two quoted rule sets
#
# A base theory and a candidate theory are stored as quoted graphs. N3
# rules inspect the forward (=>) and backward (<=) rules inside them and
# report which rules the candidate is missing and which it adds. Rules are
# data here: they are compared, never run.

@prefix : <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# The base theory: a subclass rule, a parent/child rule and a backward rule
# for worksFor.
<> :base {
    {
        ?X a ?C .
        ?C rdfs:subClassOf ?D .
    } => {
        ?X a ?D .
    } .

    {
        ?P :parentOf ?Q .
    } => {
        ?Q :childOf ?P .
    } .

    {
        ?P :worksFor ?Org .
    } <= {
        ?Org :employs ?P .
    } .
} .

# The candidate theory keeps the subclass rule, turns the worksFor rule
# into a forward rule, drops the parent/child rule and adds a mentor rule.
<> :candidate {
    {
        ?X a ?C .
        ?C rdfs:subClassOf ?D .
    } => {
        ?X a ?D .
    } .

    {
        ?Org :employs ?P .
    } => {
        ?P :worksFor ?Org .
    } .

    {
        ?P :mentors ?Q .
    } => {
        ?Q :menteeOf ?P .
    } .
} .

# Missing in candidate: a forward rule (log:implies) of the base that the
# candidate does not contain.
{
    ?W :base ?Base .
    ?W :candidate ?Cand .
    ?Base log:includes {
        ?B log:implies ?H
    } .
    ?Cand log:notIncludes {
        ?B log:implies ?H
    } .
} => {
    ?B :missingForwardRule ?H .
} .

# A backward rule (log:impliedBy) of the base missing from the candidate.
{
    ?W :base ?Base .
    ?W :candidate ?Cand .
    ?Base log:includes {
        ?H log:impliedBy ?B
    } .
    ?Cand log:notIncludes {
        ?H log:impliedBy ?B
    } .
} => {
    ?B :missingBackwardRule ?H .
} .

# Extra in candidate: a forward rule the base does not contain.
{
    ?W :base ?Base .
    ?W :candidate ?Cand .
    ?Cand log:includes {
        ?B log:implies ?H
    } .
    ?Base log:notIncludes {
        ?B log:implies ?H
    } .
} => {
    ?B :extraForwardRule ?H .
} .

# A backward rule of the candidate that the base does not contain.
{
    ?W :base ?Base .
    ?W :candidate ?Cand .
    ?Cand log:includes {
        ?H log:impliedBy ?B
    } .
    ?Base log:notIncludes {
        ?H log:impliedBy ?B
    } .
} => {
    ?B :extraBackwardRule ?H .
} .
