# N3 example: type-inference.
# Companion to type-inference.eye: a monomorphic lambda-calculus type
# relation, using ordinary unification. This is not Hindley-Milner let
# polymorphism.
#
# Adapted: type-inference.eye also asks for lam(x, var(x))'s type alone,
# whose answer is fun(?arg, ?arg) with ?arg left as a genuinely
# unresolved logic variable (there is no application to pin it down).
# Confirmed by testing, eyeron's N3 backward chaining does not derive a
# fact whose result still contains such an unresolved variable at the end
# of resolution (unlike Prolog, it does not skolemize it into a fresh
# placeholder), so only the fully-applied query -- which does resolve to
# a concrete type -- is included here.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix : <https://eyereasoner.github.io/eyepl/examples/type-inference#>.

{(?name ?env) :lookup ?type} <= {
    ?env list:firstRest ((?name ?type) ?_).
}.
{(?name ?env) :lookup ?type} <= {
    ?env list:firstRest (?first ?rest).
    ?first list:firstRest (?other ?_).
    ?name log:notEqualTo ?other.
    (?name ?rest) :lookup ?type.
}.

{(?env (:intLit ?n)) :typeOf :int} <= true.
{(?env (:var ?name)) :typeOf ?type} <= {(?name ?env) :lookup ?type}.
{(?env (:lam ?name ?body)) :typeOf (:fun ?arg ?result)} <= {
    ?newEnv list:firstRest ((?name ?arg) ?env).
    (?newEnv ?body) :typeOf ?result.
}.
{(?env (:app ?fn ?arg)) :typeOf ?result} <= {
    (?env ?fn) :typeOf (:fun ?input ?result).
    (?env ?arg) :typeOf ?input.
}.

{(() (:app (:lam :x (:var :x)) (:intLit 42))) :typeOf ?t} => {:query :type ?t}.
