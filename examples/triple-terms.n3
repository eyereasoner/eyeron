# Deriving an entailment from a triple term
#
# A companion RDF input records a device report as a reified triple term.
# N3 rules combine that report with an action requirement and return a
# derived needs-action triple term.

VERSION "1.2"
@prefix : <https://eyereasoner.github.io/eyeling/examples/triple_terms#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Read the required device evidence from the companion input before
# producing the derived action graph.
{
    ?observation rdf:reifies {
        ?device :reports ?condition .
    } .
    ?condition :requires ?action .
} => {
    ?observation :entails {
        ?device :needs ?action .
    } .
} .

{
    ?observation :entails ?entailment
} log:query {
    ?observation :entails ?entailment
} .

# A fixed text sample is also queried for display. Its content is supplied text,
# not a rendering of the bindings returned by the entailment query.
:__md_output :text "# triple-terms\n\n## Source files\n\n- [N3 rules](../triple-terms.n3)\n- [Input TriG](../input/triple-terms.trig)\n\nVERSION \"1.2\"\n\n@prefix : <https://eyereasoner.github.io/eyeling/examples/triple_terms#> .\n\n:observation :entails <<( :sensor :needs :inspection )>> .\n" .
{
    :__md_output :text ?text
} log:query {
    :__md_output log:outputString ?text
} .
