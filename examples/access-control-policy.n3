# Checking an access policy
#
# A request names a policy and lists the fields it has. The policy says which
# fields are all required, which fields at least one of must be present, and
# which fields must be absent. Eyeron concludes that the request passes all
# three tests, so the policy is satisfied. The tests are backward rules (`<=`)
# that use log:forAllIn and log:collectAllIn to look over the current facts.

@base <https://eyereasoner.github.io/eye/reasoning/access-control-policy/acp.n3> .

@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example.org/#> .

# The request: test1 is checked against PolicyX and has fields A, B and C.
:test1 :policy :PolicyX ;
    :has :A, :B, :C .

# The policy: A and B are both required, C is an allowed option of which at
# least one must be present, and D is forbidden.
:PolicyX a :Policy ;
    :allOf :A, :B ;
    :anyOf :C ;
    :noneOf :D .

# All of: every field the policy lists under allOf is one the request has.
{
    ?Pol :pass :allOfTest .
} <= {
    ?Test :policy ?Pol .
    ?Pol a :Policy .
    (
        {
            ?Pol :allOf ?Field
        }
        {
            ?Test :has ?Field
        }
    ) log:forAllIn ?X .
} .

# Any of: collect the anyOf fields the request has; the list is not empty.
{
    ?Pol :pass :anyOfTest .
} <= {
    ?Test :policy ?Pol .
    ?Pol a :Policy .
    (
        ?Field {
            ?Pol :anyOf ?Field .
            ?Test :has ?Field
        }
        ?List
    ) log:collectAllIn ?X .
    ?List list:length ?L .
    ?L log:notEqualTo 0 .
} .

# None of: collect the noneOf fields the request has; the list is empty.
{
    ?Pol :pass :noneOfTest .
} <= {
    ?Test :policy ?Pol .
    ?Pol a :Policy .
    (
        ?Field {
            ?Pol :noneOf ?Field .
            ?Test :has ?Field
        }
        ?List
    ) log:collectAllIn ?X .
    ?List list:length ?L .
    ?L log:equalTo 0 .
} .

# Query: report each policy that passes all three tests.
@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

{
    ?Pol a :Policy .
    ?Pol :pass :allOfTest .
    ?Pol :pass :anyOfTest .
    ?Pol :pass :noneOfTest .
} log:query {
    :test :for ?Pol .
    :test :is true .
} .
