# N3 example: spec-2-5-assignment.
# Companion to spec-2-5-assignment.pl/.srl.

@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix : <https://eyereasoner.github.io/eyepl/examples/spec-2-5-assignment#>.

:route1 :distanceMiles 10.
:route2 :distanceMiles 5.

{?x :distanceMiles ?miles. (?miles 1.60934) math:product ?km.} => {?x :distanceKm ?km}.
