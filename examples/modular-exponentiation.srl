RULE { :r11 :val ?v } WHERE { :r10 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r12 :val ?v } WHERE { :r11 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r13 :val ?v } WHERE { :r12 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r14 :val ?v } WHERE { :r13 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r15 :val ?v } WHERE { :r14 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r16 :val ?v } WHERE { :r15 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r17 :val ?v } WHERE { :r16 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r18 :val ?v } WHERE { :r17 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r19 :val ?v } WHERE { :r18 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r20 :val ?v } WHERE { :r19 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r21 :val ?v } WHERE { :r20 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r22 :val ?v } WHERE { :r21 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r23 :val ?v } WHERE { :r22 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r24 :val ?v } WHERE { :r23 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r25 :val ?v } WHERE { :r24 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r26 :val ?v } WHERE { :r25 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r27 :val ?v } WHERE { :r26 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r28 :val ?v } WHERE { :r27 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r29 :val ?v } WHERE { :r28 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r30 :val ?v } WHERE { :r29 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :test :largeCase ?v } WHERE { :r30 :val ?v }
