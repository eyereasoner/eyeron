# Companion to modular-exponentiation.n3/.eye: same repeated-squaring
# algorithm and small-modulus rescoping as modular-exponentiation.n3 (SRL
# arithmetic is also IEEE double precision, with the same 2^53 exactness
# limit). SRL has no modulo operator, so a % m is computed as
# a - FLOOR(a / m) * m. A generic recursive :modPow relation would also
# need SET (for the arithmetic) recursing through itself, which is a
# closed-rule cycle stratification rejects (see peano-arithmetic.srl's
# own note); since the exponent's bit pattern is fixed and known ahead of
# time, this instead unrolls square-and-multiply into one concrete,
# non-recursive rule per bit, each depending only on the previous bit's
# named result -- a strict chain, not a cycle.

PREFIX : <http://example.org/modular-exponentiation#>

DATA { :s0 :val 1. :r0 :val 1. }

RULE { :s1 :val ?v } WHERE { :s0 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 97) * 97)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 97) * 97), ?sq)) }
RULE { :s2 :val ?v } WHERE { :s1 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 97) * 97)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 97) * 97), ?sq)) }
RULE { :s3 :val ?v } WHERE { :s2 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 97) * 97)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 97) * 97), ?sq)) }
RULE { :s4 :val ?v } WHERE { :s3 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 97) * 97)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 97) * 97), ?sq)) }
RULE { :test :smallCheck ?v } WHERE { :s4 :val ?v }

RULE { :r1 :val ?v } WHERE { :r0 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r2 :val ?v } WHERE { :r1 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r3 :val ?v } WHERE { :r2 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r4 :val ?v } WHERE { :r3 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r5 :val ?v } WHERE { :r4 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r6 :val ?v } WHERE { :r5 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r7 :val ?v } WHERE { :r6 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(1 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r8 :val ?v } WHERE { :r7 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
RULE { :r9 :val ?v } WHERE { :r8 :val ?p. SET(?sq := (?p * ?p - FLOOR((?p * ?p) / 1000003) * 1000003)) SET(?v := IF(0 = 1, (?sq * 7 - FLOOR((?sq * 7) / 1000003) * 1000003), ?sq)) }
