# Stopping on an explicit contradiction
#
# One stone is described as both black and white. An N3 rule concludes
# false when it finds that combination, causing an inference fuse to stop
# the run.
#
# expect-exit: 65

@prefix : <https://eyereasoner.github.io/ns#> .

# Both colour facts are deliberately supplied for the same stone.
:stone :color :black .
:stone :color :white .

# This combination trips the inference fuse. The command exits with code 65.
{
    ?X :color :black .
    ?X :color :white .
} => false .
