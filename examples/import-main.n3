# N3 example: import-main.
# instead IMPORTS the rules from import-lib.srl and supplies its own data
# side's self-contained data and rules.

@prefix : <https://eyereasoner.github.io/eyepl/examples/import-main#>.

:alice :parent :bob.
:bob :parent :carol.

{?x :parent ?y} => {?x :ancestor ?y}.
{?x :parent ?y. ?y :ancestor ?z} => {?x :ancestor ?z}.
