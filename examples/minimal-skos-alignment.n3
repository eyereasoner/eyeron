# Propagating a category alignment
#
# A dataset-specific vehicle category maps to a reference concept. N3 rules
# derive a treated-as relationship and propagate it down to a narrower
# category using SKOS links.

@prefix ex: <http://example.org/#> .
@prefix ref: <http://example.org/ref/> .
@prefix anpr: <http://example.org/anpr/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Concepts from two schemes: a reference scheme (ref:) and the scheme of an
# automatic number-plate recognition dataset (anpr:)
ref:Car a skos:Concept .

anpr:VehicleWithPlate a skos:Concept ;
    skos:broadMatch ref:Car .

anpr:PassengerCar a skos:Concept ;
    skos:broader anpr:VehicleWithPlate .

# Rules
# Rule 1: interpret skos:broadMatch as "treat A as B" for reporting
{
    ?a skos:broadMatch ?b .
} => {
    ?a ex:treatedAs ?b .
} .

# Rule 2: propagate that treatment down the SKOS hierarchy:
# if X has broader concept Y, and Y is treatedAs Z, then X is treatedAs Z
{
    ?x skos:broader ?y .
    ?y ex:treatedAs ?z .
} => {
    ?x ex:treatedAs ?z .
} .
