# Substituting equal names in triples
#
# Bob and Robert are linked as the same individual, and two properties are
# also equated. Explicit N3 rules substitute these names in subject,
# predicate, and object positions.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Bob and Robert name the same individual; likes and enjoys are also equated.
:bob owl:sameAs :robert .
:bob :likes :pizza .
:alice :knows :bob .
:likes owl:sameAs :enjoys .

# Substitute a sameAs-linked name in the subject, predicate and object
# positions, one rule for each position.
@prefix owl: <http://www.w3.org/2002/07/owl#> .

{
    ?X owl:sameAs ?Y .
    ?X ?P ?O
} => {
    ?Y ?P ?O
} .

{
    ?X owl:sameAs ?Y .
    ?S ?X ?O
} => {
    ?S ?Y ?O
} .

{
    ?X owl:sameAs ?Y .
    ?S ?P ?X
} => {
    ?S ?P ?Y
} .
