# Matching a language tag and reading a date tuple
#
# A French-tagged greeting and a fixed date-time tuple supply the data. N3
# rules compare the complete literal and extract the year by list matching.

@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example/> .

# The timestamp is a fixed tuple, so this example does not read the clock.
:msg :text "bonjour"@fr .
:clock :event (2026 5 15 10 20 30) .

# Equality includes the language tag, not just the greeting text.
{
    ?msg :text ?text .
    ?text log:equalTo "bonjour"@fr
} => {
    ?msg :sameLanguageAs true
} .

# Match the six date-time positions and copy the first as the year.
{
    ?event :event (?year ?month ?day ?hour ?minute ?second)
} => {
    ?event :eventYear ?year
} .
