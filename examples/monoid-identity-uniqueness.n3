# Comparing identity elements in a monoid
#
# The monoid laws are written as N3 rules: associativity, an identity :e on
# both sides, and a candidate ?e2 that acts as a left identity, together with
# the classic argument that e2 = e2 * e = e. The program states no elements,
# so none of these rules fires. The query asks which ?e2 is log:equalTo :e,
# and that built-in, which holds only for identical terms, answers :e itself.
# Adding elements and a candidate :e2 makes the uniqueness rule conclude
# :e2 log:equalTo :e, which eyeron rejects as a false built-in statement,
# because two different names are not identical terms.

@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Carrier membership
# We use:
#
# ?x :inG true.
#
# to indicate that ?x belongs to the underlying set G.
# Monoid axioms
# Associativity:
# if
# (a * b) = ab
# (ab * c) = left
# (b * c) = bc
# (a * bc) = right
# then
# left = right
{
    (?a ?b) :mul ?ab .
    (?ab ?c) :mul ?left .
    (?b ?c) :mul ?bc .
    (?a ?bc) :mul ?right .
} => {
    ?left log:equalTo ?right .
} .

# Left identity:
# for every element a in G,
# e * a = a
{
    ?a :inG true .
} => {
    (:e ?a) :mul ?a .
} .

# Right identity:
# for every element a in G,
# a * e = a
{
    ?a :inG true .
} => {
    (?a :e) :mul ?a .
} .

# Assumption about a second candidate identity
# If ?e2 also acts as a left identity for every element of G,
# then it is a candidate for being "another identity".
#
# e2 * a = a
{
    ?e2 :candidateIdentity true .
    ?a :inG true .
} => {
    (?e2 ?a) :mul ?a .
} .

# Optional stronger assumption:
# if desired, we can also state that ?e2 acts as a right identity.
# It is not needed for the uniqueness proof below, but it can make
# the intended meaning more explicit.
#
# {
# ?e2 :candidateIdentity true.
# ?a  :inG true.
# }
# =>
# {
# (?a ?e2) :mul ?a.
# }.
# Uniqueness of identity
# Proof idea:
#
# e2 = e2 * e     by the right identity law for e
# = e          because e2 acts as a left identity
#
# Therefore:
#
# e2 = e
#
# In relational form we express the two needed multiplication facts:
#
# (e2, e) :mul e2
# (e2, e) :mul e
#
# and conclude:
#
# e2 log:equalTo e
{
    ?e2 :candidateIdentity true .
    ?e2 :inG true .
    :e :inG true .

    (?e2 :e) :mul ?e2 .
    (?e2 :e) :mul :e .
} => {
    ?e2 log:equalTo :e .
} .

# Optional query
# Ask for any candidate identity that must coincide with :e.
{
    ?e2 log:equalTo :e .
} log:query {
    :result :uniqueIdentity ?e2 .
} .
