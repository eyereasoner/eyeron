# Checking subtasks inside a quoted document
#
# Two composite tasks refer to an embedded subtask graph. An N3 rule uses a
# scoped universal test to derive completion only when every listed subtask
# is completed in that document.

@prefix : <http://example.org/test#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Two composite tasks in the main graph.
:task1 a :CompositeTask .

:task2 a :CompositeTask .

# A quoted document listing each task's subtasks and which are completed.
# Task 2's second subtask is not marked completed.
:subtasks :graph {

    :task1 :subTask :subtask1 .
    :subtask1 a :Completed .

    :task1 :subTask :subtask2 .
    :subtask2 a :Completed .

    :task1 :subTask :subtask3 .
    :subtask3 a :Completed .

    :task2 :subTask :subtask4 .
    :subtask4 a :Completed .

    :task2 :subTask :subtask5 .

    # :subtask5 a :Completed.
} .

# A task is completed when, inside the quoted document, every subtask it
# lists is marked completed: log:forAllIn checks the second pattern for
# every match of the first.
{
    ?Task a :CompositeTask .
    :subtasks :graph ?Graph .
    (
        {
            ?Task :subTask ?Subtask
        }
        {
            ?Subtask a :Completed
        }
    ) log:forAllIn ?Graph .
} => {
    ?Task a :AllTasksCompleted
} .
