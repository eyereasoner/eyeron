# Companion to derived-rule.n3/.eye: the same outcome (a cat and a dog
# together trigger the derived conclusion), as an ordinary SRL rule --
# SRL has no rule-generating rule either.
PREFIX : <https://eyereasoner.github.io/ns#>

DATA { :Minka a :Cat. :Charly a :Dog. }

RULE { :test :is true } WHERE { ?x a :Cat. ?y a :Dog }
