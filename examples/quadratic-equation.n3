# Solving quadratic equations
#
# Six sample equations ax^2 + bx + c = 0 give their coefficients a, b and c.
# Three rules, one for each sign of the discriminant b^2 - 4ac, use the math:
# built-ins to compute two real roots, one double root, or two complex
# conjugate roots. Each root is a new blank node. Queries return the roots,
# including the multiplicity of a double root, and each equation's status.

@base <https://eyereasoner.github.io/eye/reasoning/quadratic-equation/quadratic-equation.n3> .
@prefix : <http://example.org/quad#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Solve ax^2 + bx + c = 0, a ≠ 0
# Vocabulary
:Quadratic a rdfs:Class .
:RealRoot a rdfs:Class .
:ComplexRoot a rdfs:Class .

# Properties on a quadratic instance: its coefficients, its root nodes (real
# or complex), the intermediate values that explain them, and its status
:a a rdf:Property .
:b a rdf:Property .
:c a rdf:Property .
:answer a rdf:Property .
:why a rdf:Property .
:status a rdf:Property .

# Properties used in reasoning/explanation:
:discriminant a rdf:Property .
:denominator a rdf:Property .
:negB a rdf:Property .
:sqrtDiscriminant a rdf:Property .
:value a rdf:Property .
:real a rdf:Property .
:imag a rdf:Property .
:multiplicity a rdf:Property .
:val a rdf:Property .

# A numeric tolerance of 1e-9; no rule uses it
:eps :val 0.000000001 .

# Core math facts shared by all branches, kept as an explanation: the
# discriminant, the denominator 2a and -b
{
    ?q a :Quadratic ;
        :a ?a ;
        :b ?b ;
        :c ?c .
    ?a math:notEqualTo 0 .
    (?b 2) math:exponentiation ?b2 .
    (4 ?a ?c) math:product ?fourac .
    (?b2 ?fourac) math:difference ?D .
    # D = b^2 - 4ac
    (2 ?a) math:product ?den .
    # 2a
    ?b math:negation ?negB .
    # -b
} => {
    ?q :why [
        :discriminant ?D ;
        :denominator ?den ;
        :negB ?negB
    ] .
} .

# Branch 1: Two real roots (D > 0)
{
    ?q a :Quadratic ;
        :a ?a ;
        :b ?b ;
        :c ?c .
    ?a math:notEqualTo 0 .
    (?b 2) math:exponentiation ?b2 .
    (4 ?a ?c) math:product ?fourac .
    (?b2 ?fourac) math:difference ?D .
    ?D math:greaterThan 0 .
    (2 ?a) math:product ?den .
    ?b math:negation ?negB .
    (?D 0.5) math:exponentiation ?sqrtD .
    # sqrt(D) as D^0.5
    (?negB ?sqrtD) math:sum ?numPlus .
    (?negB ?sqrtD) math:difference ?numMinus .
    (?numPlus ?den) math:quotient ?x1 .
    (?numMinus ?den) math:quotient ?x2 .
} => {
    ?q :answer [ a :RealRoot ; :value ?x1 ], [ a :RealRoot ; :value ?x2 ] ;
        :why [ :sqrtDiscriminant ?sqrtD ] ;
        :status "two-real-roots" .
} .

# Branch 2: One real double root (D = 0)
{
    ?q a :Quadratic ;
        :a ?a ;
        :b ?b ;
        :c ?c .
    ?a math:notEqualTo 0 .
    (?b 2) math:exponentiation ?b2 .
    (4 ?a ?c) math:product ?fourac .
    (?b2 ?fourac) math:difference ?D .
    ?D math:equalTo 0 .
    (2 ?a) math:product ?den .
    ?b math:negation ?negB .
    (?negB ?den) math:quotient ?x .
} => {
    ?q :answer [ a :RealRoot ; :value ?x ; :multiplicity 2 ] ;
        :why [ :sqrtDiscriminant 0 ] ;
        :status "double-root" .
} .

# Branch 3: Complex conjugate roots (D < 0)
# real = (-b)/(2a), imag = sqrt(-D)/(2a)
{
    ?q a :Quadratic ;
        :a ?a ;
        :b ?b ;
        :c ?c .
    ?a math:notEqualTo 0 .
    (?b 2) math:exponentiation ?b2 .
    (4 ?a ?c) math:product ?fourac .
    (?b2 ?fourac) math:difference ?D .
    ?D math:lessThan 0 .
    (2 ?a) math:product ?den .
    ?b math:negation ?negB .

    ?D math:negation ?Dn .
    # -D > 0
    (?Dn 0.5) math:exponentiation ?sqrtDn .

    # sqrt(-D)
    (?negB ?den) math:quotient ?re .
    (?sqrtDn ?den) math:quotient ?im .
    ?im math:negation ?imNeg .
} => {
    ?q :answer [ a :ComplexRoot ; :real ?re ; :imag ?im ], [
        a :ComplexRoot ;
        :real ?re ;
        :imag ?imNeg
    ] ;
        :why [ :sqrtDiscriminant ?sqrtDn ] ;
        :status "complex-roots" .
} .

# Six sample quadratics that exercise all three branches
# H1: Two distinct real roots: x^2 - 3x + 2 = 0 → {1, 2}
:Q1 a :Quadratic ;
    :a 1 ;
    :b -3 ;
    :c 2 .

# H2: Double root: x^2 + 2x + 1 = 0 → {-1 (mult. 2)}
:Q2 a :Quadratic ;
    :a 1 ;
    :b 2 ;
    :c 1 .

# H3: Two real roots with negative leading coefficient: -x^2 + 1 = 0 → { -1, 1 }
:Q3 a :Quadratic ;
    :a -1 ;
    :b 0 ;
    :c 1 .

# H4: Leading coefficient other than 1: 2x^2 + 10x + 8 = 0 → { -4, -1 }
:Q4 a :Quadratic ;
    :a 2 ;
    :b 10 ;
    :c 8 .

# H5: No real roots (complex): x^2 + 1 = 0 → { i, -i }
:Q5 a :Quadratic ;
    :a 1 ;
    :b 0 ;
    :c 1 .

# H6 (extra): Mixed signs: 3x^2 - 12x + 9 = 0 → {1, 3}
:Q6 a :Quadratic ;
    :a 3 ;
    :b -12 ;
    :c 9 .

# Query: the roots of each equation, with their properties
{
    ?Case :answer ?Answer .
    ?Answer ?Property ?Value .
} log:query {
    ?Case :answer ?Answer .
    ?Answer ?Property ?Value .
} .

# Query: which branch applied to each equation
{
    ?Case :status ?Status .
} log:query {
    ?Case :status ?Status .
} .
