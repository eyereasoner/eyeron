# Parsing a tiny command language
#
# Commands consist of a supported verb followed by a supported noun.
# Backward N3 rules consume input lists and derive a structured command
# together with any unconsumed words.

@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix : <https://eyereasoner.github.io/eyepl/examples/grammar#> .

# A verb consumes the first word and returns the remaining input.
{
    ?input :verbMatch (:open ?rest)
} <= {
    ?input list:firstRest (:open ?rest) .
} .

{
    ?input :verbMatch (:close ?rest)
} <= {
    ?input list:firstRest (:close ?rest) .
} .

# The noun rules work the same way for door and window.
{
    ?input :nounMatch (:door ?rest)
} <= {
    ?input list:firstRest (:door ?rest) .
} .

{
    ?input :nounMatch (:window ?rest)
} <= {
    ?input list:firstRest (:window ?rest) .
} .

# Parse a verb followed by a noun, threading the unconsumed list between them.
{
    (?input ?rest) :sentence (:command ?verb ?object)
} <= {
    ?input :verbMatch (?verb ?middle) .
    ?middle :nounMatch (?object ?rest) .
} .

# An empty remainder requires the whole two-word command to be consumed.
{
    ((:open :door) ()) :sentence ?ast
} => {
    :query :parsed ?ast
} .
