# N3 example: unicode-and-signed-numbers.
# Companion to unicode-and-signed-numbers.eye/.srl.

@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix : <https://eyereasoner.github.io/eyepl/examples/unicode-and-signed-numbers#>.

:sample :text "AB\U00000043".
:thermo :delta -12.

{:sample :text "ABC"} => {:sample a :UnicodeDecoded}.
{:thermo :delta ?d. ?d math:lessThan 0.} => {:thermo a :BelowZero}.
