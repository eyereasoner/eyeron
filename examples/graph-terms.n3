# Activating statements from a quoted graph
#
# Bob's statements are stored as quoted graphs, including one with an
# unnamed subject. N3 rules activate the stored graphs and derive further
# food preferences, showing graph values used as rule conclusions.

@prefix : <http://example.org/> .

# Alice likes pasta, and Bob says two things as quoted graphs: one about
# Alice, one about someone unnamed who likes pizza and pasta.
:alice :likes :pasta .
:bob :says {
    :alice :likes :pizza, :pasta
} .

:bob :says {
    _:x :likes :pizza .
    _:x :likes :pasta
} .

# Whoever likes pasta likes spaghetti.
{
    ?x :likes :pasta
} => {
    ?x :likes :spaghetti
} .

# Unquoting: whatever Bob says is taken as true. The conclusion is the
# variable ?x itself, so the quoted graph it stands for is asserted.
{
    :bob :says ?x
} => ?x .

# The unquoting rule written out for Bob's statement about Alice. It
# derives nothing the general rule does not already derive.
{
    :bob :says {
        :alice :likes :pasta, :pizza
    }
} => {
    :alice :likes :pasta, :pizza
} .
