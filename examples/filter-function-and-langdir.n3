# N3 example: filter-function-and-langdir.
# Companion to filter-function-and-langdir.srl: N3 has no builtin to
# extract a literal's base direction, so (matching
# now-and-language-builtins.n3's own `log:equalTo` trick for a language
# tag) this confirms the directed text by comparing it against the exact
# `fr--ltr` literal.

@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix : <http://example/>.

:n1 :value -3.5.
:n2 :value 7.
:msg :text "bonjour"@fr--ltr.

{?x :value ?v. ?v math:lessThan 0} => {?x :negative true}.
{:msg :text ?text. ?text log:equalTo "bonjour"@fr--ltr} => {:msg :languageDirection "ltr"}.
