# Filtering numbers and matching directed text
#
# One rule selects a negative number; another recognizes a French literal
# marked left-to-right. The example shows numeric conditions and exact
# matching of a language-and-direction-tagged literal.

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example/> .

# The samples include a negative value and a literal with language and direction.
:n1 :value -3.5 .
:n2 :value 7 .
:msg :text "bonjour"@fr--ltr .

# Only n1 passes the numeric test; n2 is positive.
{
    ?x :value ?v .
    ?v math:lessThan 0
} => {
    ?x :negative true
} .

# Match the whole literal, including its French tag and left-to-right direction.
{
    :msg :text ?text .
    ?text log:equalTo "bonjour"@fr--ltr
} => {
    :msg :languageDirection "ltr"
} .
