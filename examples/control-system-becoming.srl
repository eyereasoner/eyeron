# Companion to control-system-becoming.n3/.pl: the same nine forward
# rules, translated directly.

PREFIX : <http://example.org/control#>

DATA {
  :reduceOvershoot a :DesignGoal; :suggests :leadCompensator; :introducesRequirement :overshootReq.
  :rejectDisturbance a :DesignGoal; :suggests :integralAction; :introducesRequirement :disturbanceRejectionReq.

  :leadCompensator a :ControlStrategy; :compatibleWith :stabilityReq, :trackingReq; :enables :overshootReq.
  :integralAction a :ControlStrategy; :compatibleWith :stabilityReq, :trackingReq, :overshootReq; :enables :disturbanceRejectionReq.

  :c1 a :ControllerRevision; :time 1; :satisfies :stabilityReq, :trackingReq; :realizes :baselinePID; :achieves :approvedController.
  :c2 a :ControllerRevision; :time 2; :derivesFrom :c1; :designGoal :reduceOvershoot.
  :c3 a :ControllerRevision; :time 3; :derivesFrom :c2; :designGoal :rejectDisturbance.
}

RULE { ?later :inheritsRequirement ?req } WHERE { ?later :derivesFrom ?earlier. ?earlier :satisfies ?req }
RULE { ?ctrl :considers ?strategy } WHERE { ?ctrl :designGoal ?goal. ?goal :suggests ?strategy }
RULE { ?ctrl :targets ?req } WHERE { ?ctrl :designGoal ?goal. ?goal :introducesRequirement ?req }

RULE { ?ctrl :preserves ?req; :integrates ?strategy } WHERE {
  ?ctrl :inheritsRequirement ?req.
  ?ctrl :considers ?strategy.
  ?strategy :compatibleWith ?req.
}

RULE { ?ctrl :satisfies ?req; :integrates ?strategy } WHERE {
  ?ctrl :targets ?req.
  ?ctrl :considers ?strategy.
  ?strategy :enables ?req.
}

RULE { ?ctrl :satisfies ?req } WHERE { ?ctrl :preserves ?req }
RULE { ?ctrl :realizes ?strategy } WHERE { ?ctrl :integrates ?strategy }
RULE { ?ctrl :achieves :approvedController; :availableForFutureTuning :yes } WHERE { ?ctrl :realizes ?strategy }
RULE { ?ctrl :status :approvedController } WHERE { ?ctrl :achieves :approvedController }
