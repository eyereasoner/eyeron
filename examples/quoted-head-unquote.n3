# Activating a quoted rule
#
# A fact stores a graph containing a cat-to-animal rule. An N3 rule uses
# that graph value directly as its conclusion, allowing the stored rule to
# classify the sample cat.

@prefix : <http://example.org/ns#> .

# Store a cat-to-animal rule inside a quoted graph.
:a :b {
    {
        ?X a :Cat
    } => {
        ?X a :Animal
    } .
} .

# Using the bound graph as the rule head activates its contents.
{
    :a :b ?C .
} => ?C .

# Once the rule is active, this cat can be classified as an animal.
:c a :Cat .

# Report that the activated rule produced the expected classification.
{
    :c a :Animal
} => {
    :test :is true
} .
