# Scoring illustrative diagnoses
#
# A patient has fever, cough, a smell symptom, shortness of breath and no
# sneezing. For four candidate conditions, a prior (how common it is) is
# multiplied by the likelihood of each finding, as in naive Bayes. eyeron
# derives each condition's unnormalized score and ranks it by thresholds:
# COVID-19 comes out "high" and screened in, the others "low". It shows N3
# math built-ins on decimals; an illustrative model, not medical guidance.

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix : <http://example/> .

# For each condition: its prior, then the probability of each of the
# patient's findings given that condition.
:COVID19 :prior 0.05 ;
    :fever 0.70 ;
    :cough 0.65 ;
    :smell 0.40 ;
    :noSneezing 0.85 ;
    :breath 0.20 .
:Influenza :prior 0.03 ;
    :fever 0.80 ;
    :cough 0.50 ;
    :smell 0.05 ;
    :noSneezing 0.80 ;
    :breath 0.10 .
:AllergicRhinitis :prior 0.10 ;
    :fever 0.05 ;
    :cough 0.15 ;
    :smell 0.10 ;
    :noSneezing 0.20 ;
    :breath 0.05 .
:BacterialPneumonia :prior 0.01 ;
    :fever 0.70 ;
    :cough 0.60 ;
    :smell 0.02 ;
    :noSneezing 0.95 ;
    :breath 0.60 .

# The score multiplies the prior by every finding's likelihood. It is not
# divided by the total over all conditions, so only the comparison counts.
{
    ?d :prior ?prior ;
        :fever ?fever ;
        :cough ?cough ;
        :smell ?smell ;
        :noSneezing ?noSneezing ;
        :breath ?breath .
    (?prior ?fever) math:product ?p1 .
    (?p1 ?cough) math:product ?p2 .
    (?p2 ?smell) math:product ?p3 .
    (?p3 ?noSneezing) math:product ?p4 .
    (?p4 ?breath) math:product ?score .
} => {
    ?d :score ?score
} .

# A condition with a score of at least 0.001 is screened in for follow-up.
{
    ?d :score ?score .
    ?score math:notLessThan 0.001
} => {
    ?d :screenedIn true
} .

# Rank each score as high, medium or low; the ranges do not overlap.
{
    ?d :score ?score .
    ?score math:notLessThan 0.0015
} => {
    ?d :rank "high"
} .

{
    ?d :score ?score .
    ?score math:notLessThan 0.0005 .
    ?score math:lessThan 0.0015
} => {
    ?d :rank "medium"
} .

{
    ?d :score ?score .
    ?score math:lessThan 0.0005
} => {
    ?d :rank "low"
} .
