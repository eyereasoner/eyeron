# Matching people by a declared key
#
# A person is identified by given name and birth date together
# (owl:hasKey). Three person records share the given name Alice; two also
# share the birth date. An N3 rule uses log:forAllIn, a universal test over
# the current graph, to check that two records agree on every key property,
# and concludes that those two are the same person (owl:sameAs).

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# The key, and three person records
:Person owl:hasKey (:givenName :birthDate) .
:alice a :Person ;
    :givenName "Alice" ;
    :birthDate "1990-01-02" .
:alias a :Person ;
    :givenName "Alice" ;
    :birthDate "1990-01-02" .
:other a :Person ;
    :givenName "Alice" ;
    :birthDate "1991-03-04" .

# Two different members of a keyed class that have the same value for every
# key property are the same individual.
{
    ?C owl:hasKey ?L .
    ?X a ?C .
    ?Y a ?C .
    ?X log:notEqualTo ?Y .
    (
        {
            ?P list:in ?L
        }
        {
            ?X ?P ?Z .
            ?Y ?P ?Z
        }
    ) log:forAllIn ?SCOPE
} => {
    ?X owl:sameAs ?Y
} .
