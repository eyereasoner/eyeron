# Applying an encoded finiteness theorem
#
# A sample curve is described as genus two over the rationals. An N3 rule
# states Faltings' theorem as an implication (genus at least two over a number
# field means finitely many rational points), and eyeron applies it to the
# curve. The rule uses the theorem; it does not prove it.
# See https://en.wikipedia.org/wiki/Faltings%27s_theorem

@prefix : <http://example.org/faltings#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The example curve, of genus two since its right-hand side has degree five.
:C a :Curve ;
    :equation "y^2 = x(x+1)(x-2)(x+2)(x-3)" ;
    :definedOver :Q ;
    :genus 2 ;
    rdfs:label "Example genus-2 curve" .

:Q a :NumberField ;
    rdfs:label "the rationals" .

:FaltingsTheorem a :Theorem ;
    rdfs:label "If a curve over a number field has genus >= 2, then it has finitely many rational points." .

:Finite a :CardinalityClass .

# Five rational points on the curve, where the right-hand side is zero. They
# are listed for the reader; no rule uses them.
:P0 a :RationalPoint ;
    :onCurve :C ;
    :x 0 ;
    :y 0 .
:P1 a :RationalPoint ;
    :onCurve :C ;
    :x -1 ;
    :y 0 .
:P2 a :RationalPoint ;
    :onCurve :C ;
    :x 2 ;
    :y 0 .
:P3 a :RationalPoint ;
    :onCurve :C ;
    :x -2 ;
    :y 0 .
:P4 a :RationalPoint ;
    :onCurve :C ;
    :x 3 ;
    :y 0 .

# Faltings' theorem: a curve of genus at least two over a number field has
# finitely many rational points.
{
    ?curve a :Curve ;
        :definedOver ?field ;
        :genus ?g .
    ?field a :NumberField .
    ?g math:notLessThan 2 .
} => {
    ?curve :coveredBy :FaltingsTheorem ;
        :hasRationalPointsCardinality :Finite .
} .

# The same conclusion said the other way round.
{
    ?curve :hasRationalPointsCardinality :Finite .
} => {
    ?curve :doesNotHaveInfinitelyManyRationalPoints true .
} .
