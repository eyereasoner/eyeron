# Companion to proof-audit.n3. `--proof` on a .srl file (see
# examples/proof/socrates.srl) now generates exactly this shape:
# `_:stepN rdf:reifies <<( s p o )>> ; pe:rule N (or pe:fact "file") ;
# pe:uses ...` reified DATA facts, one flat, separately-addressable
# reifier per proof step rather than N3's nested quoted-formula steps
# (which need log:includes to search inside). This example predates that
# and builds the same small proof shape -- socrates.n3's own two-premise
# derivation -- by hand instead of by replaying a generated proof
# document, to keep its own golden output stable; matches reifiers.srl's
# source's own `depends_on`/`support`/`answer_applied`.

PREFIX : <http://example.org/proof-audit#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

DATA {
  :Socrates a :Human .
  :Human rdfs:subClassOf :Mortal .
  :Socrates a :Mortal .

  :stepMortal rdf:reifies <<( :Socrates a :Mortal )>> ;
    pe:rule 1 ;
    pe:uses :stepHuman, :stepSubClass ;
    pe:binding [ pe:var "A" ; pe:value :Human ], [ pe:var "B" ; pe:value :Mortal ], [ pe:var "S" ; pe:value :Socrates ] .
  :stepHuman rdf:reifies <<( :Socrates a :Human )>> ;
    pe:fact "socrates.srl" .
  :stepSubClass rdf:reifies <<( :Human rdfs:subClassOf :Mortal )>> ;
    pe:fact "socrates.srl" .
}

RULE { ?step :dependsOn ?dep }
WHERE { ?step pe:uses ?dep }

RULE { ?a :dependsOn ?c }
WHERE { ?a :dependsOn ?b. ?b :dependsOn ?c }

RULE { ?step :sourceFact true }
WHERE { ?step pe:fact ?src }

RULE { ?step :supportedBy ?step }
WHERE { ?step :sourceFact true }

RULE { ?step :supportedBy ?anc }
WHERE { ?step :dependsOn ?anc. ?anc :sourceFact true }

RULE { :test :root ?root }
WHERE { ?root pe:rule ?ruleName }

RULE { :test :queryDependency ?anc }
WHERE { :test :root ?root. ?root :dependsOn ?anc }

RULE { :test :support ?fact }
WHERE { :test :root ?root. ?root :supportedBy ?fact }

RULE { [] a :AnswerApplied ; :var ?name ; :value ?value }
WHERE {
  :test :root ?root.
  ?root pe:binding ?bindingNode.
  ?bindingNode pe:var ?name ; pe:value ?value.
}
