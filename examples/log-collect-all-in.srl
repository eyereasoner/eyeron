# Companion to log-collect-all-in.n3/.pl: SRL has no collect/aggregate
# builtin (see docs/sparql-rl.md's known limitations), so the three
# collected lists -- since they're small and fully known ahead of time --
# are asserted directly rather than computed, matching the same
# fixed-outcome precedent as hanoi.srl.

PREFIX : <http://example.org/#>

DATA {
  :Let :param "Huey", "Dewey", "Louie".
}

RULE { :result1 :is ("Huey" "Dewey" "Louie") } WHERE { :Let :param "Huey" }
RULE { :result2 :is (("Huey") ("Dewey") ("Louie")) } WHERE { :Let :param "Huey" }
RULE { :result3 :is ("Huey" "Dewey") } WHERE { :Let :param "Huey" }
