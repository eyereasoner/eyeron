# Expanding a list of distinct colors
#
# A list declares red, green, and blue to be distinct members. An explicit
# N3 rule enumerates different list entries and derives pairwise
# owl:differentFrom statements.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# The three named colors are listed as distinct.
:colours owl:distinctMembers (:red :green :blue) .

# Enumerate every ordered pair of different entries and assert their difference.
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

{
    ?A owl:distinctMembers ?L .
    ?X list:in ?L .
    ?Y list:in ?L .
    ?X log:notEqualTo ?Y
} => {
    ?X owl:differentFrom ?Y
} .
