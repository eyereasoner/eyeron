# Finding a conclusion shared by possible cases
#
# Water is an inorganic compound, and every inorganic compound is solid,
# liquid or gas, without saying which. Each of the three states makes a thing
# observable, so whichever case holds, water is observable. eyeron derives
# exactly that, by proof by cases: log:allPossibleCases records the list of
# alternatives, and log:forAllIn checks each case against the rules that
# lead to the common conclusion.

@base <https://eyereasoner.github.io/eye/reasoning/proof-by-cases/example2.n3> .

# See <https://en.wikipedia.org/wiki/Disjunction_elimination>
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <https://eyereasoner.github.io/ns#> .

# water is an inorganic compound
:water a :InorganicCompound .

# water is solid or liquid or gas
{
    ?A a :InorganicCompound .
} => {
    (?A) log:allPossibleCases (
        {
            ?A :is :solid
        }
        {
            ?A :is :liquid
        }
        {
            ?A :is :gas
        }
    )
} .

# solid, liquid and gas things are observable
{
    ?A :is :solid
} => {
    ?A :is :observable
} .

{
    ?A :is :liquid
} => {
    ?A :is :observable
} .

{
    ?A :is :gas
} => {
    ?A :is :observable
} .

# proof by cases: for every alternative ?A :is ?C in the case list,
# log:forAllIn looks in the program for a rule from ?A :is ?C to
# observability; if the test passes, ?A is observable, even though no single
# case is known to hold
{
    (?A) log:allPossibleCases ?B .
    (
        {
            ?B list:member {
                ?A :is ?C
            }
        }
        {
            {
                ?A :is ?C
            } => {
                ?A :is :observable
            }
        }
    ) log:forAllIn ?SCOPE .
} => {
    ?A :is :observable .
} .

# Query: show every :is statement derived
@prefix : <https://eyereasoner.github.io/ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

{
    ?A :is ?B .
} log:query {
    ?A :is ?B .
} .
