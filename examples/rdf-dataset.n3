# Reasoning from a companion RDF dataset
#
# A companion dataset describes sensor conditions and required actions. N3
# rules derive a work-order entailment and an audit graph, showing RDF
# input used as evidence in N3 reasoning.

VERSION "1.2"
@prefix : <https://eyereasoner.github.io/eyeling/examples/rdf-dataset#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

{
    :sensor :reports ?condition .
    ?condition :requires ?action .
    :maintenanceSystem :trusted true .
} => {
    :workOrder :entails {
        :sensor :needs ?action .
    } .
    :audit log:nameOf {
        :workOrder :basedOn :factoryDataset .
        :workOrder :checkedBy :maintenanceSystem .
    } .
} .

{
    :workOrder :entails {
        ?device :needs ?action .
    } .
} log:query {
    :workOrder :entails {
        ?device :needs ?action .
    } .
} .

# Markdown rendering via log:outputString.
:__md_output :text "# rdf-dataset\n\n## Source files\n\n- [N3 rules](../rdf-dataset.n3)\n- [Input TriG](../input/rdf-dataset.trig)\n\nVERSION \"1.2\"\n\n@prefix : <https://eyereasoner.github.io/eyeling/examples/rdf-dataset#> .\n\n:workOrder :entails <<( :sensor :needs :inspection )>> .\n" .
{
    :__md_output :text ?text
} log:query {
    :__md_output log:outputString ?text
} .
