# When dog ownership requires a license
#
# A license is required when a person owns more than four dogs. An N3 rule
# collects one item per dog, sums the list, and applies the threshold to
# the sample owners.

@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix : <https://eyereasoner.github.io/ns#> .

# Who owns which dogs.
:alice :hasDog :dog1, :dog2, :dog3, :dog4, :dog5 .
:bob :hasDog :dog6, :dog7 .

# For each owner, collect a 1 for every dog, add them up, and require a
# license when the total is more than four.
{
    ?Subject :hasDog ?Any .
    (
        1 {
            ?Subject :hasDog ?Dog
        }
        ?List
    ) log:collectAllIn ?Scope .
    ?List math:sum ?Count .
    ?Count math:greaterThan 4 .
} => {
    ?Subject :mustHave :dogLicense .
} .
