# Companion to quoted-head-unquote.n3: the outcome the source's
# activated quoted rule produces, as an ordinary SRL rule (SRL has no
# term-valued rule head or quoted formula to unquote either).

PREFIX : <http://example.org/ns#>

DATA { :c a :Cat. }

RULE { ?x a :Animal } WHERE { ?x a :Cat }
RULE { :test :is true } WHERE { :c a :Animal }
