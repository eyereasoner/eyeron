# Companion to derived-backward-rule.n3/.pl: the inverse relationship
# the N3 source generates from :invOf metadata, as an ordinary forward
# rule instead (SRL has no rule generation and no backward chaining).

PREFIX : <https://eyereasoner.github.io/ns#>

DATA { :alice :parentOf :bob. }

RULE { ?x :childOf ?y } WHERE { ?y :parentOf ?x }
RULE { ?x :hasParent ?y } WHERE { ?x :childOf ?y }
