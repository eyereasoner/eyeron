# Companion to derived-backward-rule-2.n3/.eye: the two generated
# unconditional facts (Socrates is Human, Human subClassOf Mortal) as
# ordinary DATA, plus the subclass rule that uses them.

PREFIX : <http://example.org/socrates#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

DATA { :Socrates a :Human. :Human rdfs:subClassOf :Mortal. }

RULE { ?s a ?b } WHERE { ?s a ?a. ?a rdfs:subClassOf ?b }
RULE { :test :is true } WHERE { :Socrates a :Mortal }
