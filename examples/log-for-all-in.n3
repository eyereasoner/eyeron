# Checking every subtask
#
# A composite task lists three completed subtasks. An N3 rule uses
# log:forAllIn to test that each listed subtask meets the completion
# condition and derives a result when all do.

@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# The composite task and its three subtasks, each marked completed.
:c a :CompositeTask ;
    :subTask :s1, :s2, :s3 .

:s1 :state :Completed .
:s2 :state :Completed .
:s3 :state :Completed .

# For a composite task, log:forAllIn takes a pair of formulas: for every way
# the first matches (each listed subtask ?s), the second must hold as well
# (?s is completed). Only then is the result true.
{
    ?c a :CompositeTask .
    (
        {
            ?c :subTask ?s
        }
        {
            ?s :state :Completed
        }
    ) log:forAllIn _:t .
} => {
    :result :is true .
} .
