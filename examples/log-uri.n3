# Converting between an IRI and its text
#
# A web address is supplied once as an IRI and once as a string. N3 rules
# use log:uri in both directions to derive the corresponding text and
# resource values.

@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# log:uri relates a resource to the text of its IRI: given the resource it
# yields the string, and given the string it yields the resource.
{
    <https://www.w3.org> log:uri ?s .
    ?r log:uri "https://www.w3.org" .
} => {
    :uriString :is ?s .
    :uriResource :is ?r .
} .
