# N3 example: assignment.
# Companion to assignment.srl. The grade is a compound term
# (rather than SRL's string-concatenation adaptation).

@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix : <https://eyereasoner.github.io/eyepl/examples/assignment#>.

:alice :score 7.
:bob :score 3.

{?x :score ?score. ?score math:notLessThan 5.} => {?x :grade (:pass ?score)}.
