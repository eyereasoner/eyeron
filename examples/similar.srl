# Companion to similar.n3: the same fully generic "shares a
# predicate/object" relation, expressed directly with a variable
# predicate position (SRL's triple patterns allow this natively, unlike

PREFIX : <https://eyereasoner.github.io/ns#>

DATA { :Alice a :Human. :Bob a :Human. }

RULE { ?A :similar ?B } WHERE { ?A ?Pred ?Obj. ?B ?Pred ?Obj. FILTER(?A != ?B) }
RULE { :test :is true } WHERE { :Alice :similar :Bob }
