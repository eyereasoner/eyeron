# Constructing consequences from finite data
#
# Three people, a team inside an organisation, and two projects. Rules
# derive who is an adult, who is whose ancestor, who belongs to the
# organisation, who can read which project and why, and they create new,
# unnamed people: a manager for the project that needs one and a supervisor
# for every manager. A log:query prints the whole resulting graph. It shows
# a comparison built-in, recursive rules, and rules that introduce blank
# nodes, which Eyeron names with Skolem terms so the run still terminates.

@prefix ex: <https://example.org/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .

# The people, the team and organisation, and the projects.
ex:Alice a ex:Person ;
    ex:age "29"^^xsd:integer ;
    ex:memberOf ex:TeamA ;
    ex:parent ex:Bob .
ex:Bob a ex:Person ;
    ex:age "54"^^xsd:integer ;
    ex:memberOf ex:TeamA ;
    ex:parent ex:Carol .
ex:Carol a ex:Person ;
    ex:age "78"^^xsd:integer ;
    ex:memberOf ex:OrgX .

ex:TeamA a ex:Team ;
    ex:partOf ex:OrgX .
ex:OrgX a ex:Org .

ex:Proj1 a ex:Project ;
    ex:ownedBy ex:OrgX ;
    ex:hasManager ex:Bob .
ex:Proj2 a ex:Project ;
    ex:ownedBy ex:OrgX ;
    ex:needsManager true .

# Anyone older than 17 is an adult.
{
    ?p ex:age ?n .
    ?n math:greaterThan "17"^^xsd:integer
} => {
    ?p a ex:Adult .
} .

# A parent is an ancestor, and so is any ancestor of a parent.
{
    ?x ex:parent ?y
} => {
    ?x ex:ancestor ?y
} .

{
    ?x ex:parent ?y .
    ?y ex:ancestor ?z
} => {
    ?x ex:ancestor ?z
} .

# A member of a team is also a member of the organisation it is part of.
{
    ?p ex:memberOf ?team .
    ?team ex:partOf ?org
} => {
    ?p ex:memberOf ?org
} .

# Members of an organisation can read the projects it owns.
{
    ?p ex:memberOf ?org .
    ?proj a ex:Project ;
        ex:ownedBy ?org
} => {
    ?p ex:canRead ?proj
} .

# Record why each read access holds, as a new, unnamed reason.
{
    ?p ex:canRead ?proj .
    ?proj ex:ownedBy ?org .
    ?p ex:memberOf ?org .
} => {
    ?p ex:reason [
        a ex:Reason ;
        ex:for ?proj ;
        ex:because "memberOf(org) & ownedBy(org)"
    ] .
} .

# A project that needs a manager gets a new, unnamed person with the role
# "AutoManager". The blank node becomes a Skolem term, the same one each time
# the rule fires for that project, so it adds only one manager.
{
    ?proj a ex:Project ;
        ex:needsManager true .
} => {
    ?proj ex:hasManager [
        a ex:Person ;
        ex:role "AutoManager"
    ] .
} .

# Every manager gets one new supervisor. The supervisor is not made a
# manager of anything, so no chain of supervisors of supervisors follows.
{
    ?proj ex:hasManager ?m .
} => {
    ?m ex:hasSupervisor [
        a ex:Person ;
        ex:role "Supervisor" ;
        ex:supervises ?m
    ] .
} .

# Print every statement of the final graph, given and derived.
{
    ?S ?P ?O
} log:query {
    ?S ?P ?O
} .
