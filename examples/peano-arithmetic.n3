# Calculating with successor terms
#
# Natural numbers are represented by zero and nested successor lists.
# Recursive backward N3 rules implement addition, multiplication, and
# factorial, calculating a small expression structurally.

@prefix : <http://example/> .

# Adding zero leaves a number unchanged; adding a successor wraps the sum
# in one more (:s ...) list. No numeric built-in is needed.
{
    (?a :zero) :peanoAdd ?a
} <= true .

{
    (?a (:s ?b)) :peanoAdd (:s ?c)
} <= {
    (?a ?b) :peanoAdd ?c
} .

# Multiplication is repeated addition, with zero as its base case.
{
    (?a :zero) :peanoMultiply :zero
} <= true .

{
    (?a (:s ?b)) :peanoMultiply ?c
} <= {
    (?a ?b) :peanoMultiply ?d .
    (?a ?d) :peanoAdd ?c
} .

# The factorial helper carries a running product; stopping returns it.
{
    (:zero ?a) :fac ?a
} <= true .

{
    ((:s ?a) ?b) :fac ?c
} <= {
    (?b (:s ?a)) :peanoMultiply ?d .
    (?a ?d) :fac ?c
} .

# Begin factorial with the product one, represented by (:s :zero).
{
    ?a :factorialValue ?b
} <= {
    (?a (:s :zero)) :fac ?b
} .

# The names two and three are variables: 1*1 gives one, adding two gives
# three, and its factorial is six. The output retains the successor structure.
{
    ((:s :zero) (:s :zero)) :peanoMultiply ?two .
    (?two (:s (:s :zero))) :peanoAdd ?three .
    ?three :factorialValue ?result .
} => {
    :test :three ?three ;
        :result ?result
} .
