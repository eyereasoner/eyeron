# Checking a traveler's possible coordinates
#
# A traveler may be in one of five named cities, each with latitude and
# longitude data. An N3 rule enumerates the city list to derive possible
# coordinates, and a query selects the coordinates of Ghent.

@base <https://eyereasoner.github.io/eye/reasoning/h2o/hypothesis-001.n3> .
@prefix t: <https://eyereasoner.github.io/eye/reasoning/tfcontext#> .
@prefix h: <https://eyereasoner.github.io/eye/reasoning/h2o#> .

# The hypothesis lists possible cities; it does not choose a single current city.
h:traveler1 h:inOneOf (
    t:Antwerp-Belgium t:Boston-USA t:Cambridge-USA t:Ghent-Belgium t:Ostend-Belgium
) .

@base <https://eyereasoner.github.io/eye/reasoning/h2o/data-001.n3> .
@prefix t: <https://eyereasoner.github.io/eye/reasoning/tfcontext#> .

# The location table supplies a latitude and longitude for each named city.
t:Antwerp-Belgium t:position-tensor (51.2192 4.4029) .
t:Boston-USA t:position-tensor (42.3584 -71.0598) .
t:Bruges-Belgium t:position-tensor (51.2108 3.2249) .
t:Cambridge-USA t:position-tensor (42.3736 -71.1097) .
t:Chicago-USA t:position-tensor (41.8781 -87.6298) .
t:Ghent-Belgium t:position-tensor (51.0535 3.7304) .
t:Ostend-Belgium t:position-tensor (51.2154 2.9286) .

@base <https://eyereasoner.github.io/eye/reasoning/h2o/rules-001.n3> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix t: <https://eyereasoner.github.io/eye/reasoning/tfcontext#> .
@prefix h: <https://eyereasoner.github.io/eye/reasoning/h2o#> .

# Derive a coordinate pair for every city in the traveler's possible-city list.
{
    ?T h:inOneOf ?LIST .
    ?C list:in ?LIST .
    ?C t:position-tensor (?LA ?LO) .
} => {
    ?T h:location (?LA ?LO) .
} .

# Ask specifically whether Ghent's coordinates are among the derived possibilities.
@prefix h: <https://eyereasoner.github.io/eye/reasoning/h2o#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

{
    h:traveler1 h:location (51.0535 3.7304) .
} log:query {
    h:traveler1 h:location (51.0535 3.7304) .
} .
