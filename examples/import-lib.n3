# N3 example: import-lib.
# is instead a headless rule library meant only to be IMPORTS-ed by
# import-main.srl -- N3 has no IMPORTS directive of its own, so this

@prefix : <https://eyereasoner.github.io/eyepl/examples/import-lib#>.

:iris :parent :jules.
:jules :parent :kai.

{?x :parent ?y} => {?x :ancestor ?y}.
{?x :parent ?y. ?y :ancestor ?z} => {?x :ancestor ?z}.
