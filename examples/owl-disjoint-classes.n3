# Deriving differences from disjoint classes
#
# Cats and dogs are declared disjoint, with one member of each. Explicit N3
# rules derive that their members differ and include a fuse for membership
# in both classes.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Milo is a cat and Fido is a dog; their classes are disjoint.
:Cat owl:disjointWith :Dog .
:milo a :Cat .
:fido a :Dog .

# Members of disjoint classes differ. A shared member would trip the fuse.
@prefix owl: <http://www.w3.org/2002/07/owl#> .

{
    ?A owl:disjointWith ?B .
    ?X a ?A .
    ?Y a ?B
} => {
    ?X owl:differentFrom ?Y
} .

{
    ?A owl:disjointWith ?B .
    ?X a ?A .
    ?X a ?B
} => false .
