# Classifying members of a union
#
# Pet is defined as a union of cat and dog classes. Explicit N3 rules
# derive pet memberships for the supplied animals and subclass links for
# the component classes.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Pet lists Cat and Dog as component classes, with one member of each.
:Pet owl:unionOf (:Cat :Dog) .
:milo a :Cat .
:fido a :Dog .

# A member of either component is a Pet; each component is a subclass of Pet.
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

{
    ?C owl:unionOf ?L .
    ?D list:in ?L .
    ?X a ?D
} => {
    ?X a ?C
} .

{
    ?C owl:unionOf ?L .
    ?D list:in ?L
} => {
    ?D rdfs:subClassOf ?C
} .
