# Solving a three-disk Towers of Hanoi puzzle
#
# Three disks must move between pegs using the spare peg. Recursive
# backward N3 rules split the task into smaller tasks and join their move
# lists into a solution.

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix : <https://eyereasoner.github.io/eye/reasoning#> .

# ?M is the sequence of moves to move ?N disks from ?X to ?Y using ?Z as
# intermediary: move N-1 disks out of the way to ?Z, move the largest disk
# to ?Y, then move the N-1 disks from ?Z onto it.
{
    (?N ?X ?Y ?Z) :moves ?M
} <= {
    ?N math:greaterThan 1 .
    (?N 1) math:difference ?N1 .
    (?N1 ?X ?Z ?Y) :moves ?M1 .
    (?N1 ?Z ?Y ?X) :moves ?M2 .
    (?M1 ((?X ?Y)) ?M2) list:append ?M .
} .

# A single disk moves directly.
{
    (1 ?X ?Y ?Z) :moves ((?X ?Y))
} <= true .

# Ask for the moves of three disks from the left to the right peg.
{
    (3 :left :right :center) :moves ?M
} => {
    3 :answer ?M
} .
