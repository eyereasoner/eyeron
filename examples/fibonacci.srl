# Companion to fibonacci.n3/.pl: SET-based rules are always "run once"
# (SPARQL 1.2 RL SS4.4) and can never depend on themselves, even
# indirectly, so a single general recursive :fib rule is unstratifiable
# (confirmed by testing; genuinely a SPARQL 1.2 RL constraint, not just an
# eyeron limitation). Instead, like deep-taxonomy-*.srl, this unrolls one
# concrete rule per level: each targets a specific, different individual
# (:n2, :n3, ...), so the dependency graph is a DAG, not a cycle, even
# though every rule shares the :fib predicate name.
#
# Adapted: fibonacci.pl asks fib(100, ?value), exact because Prolog uses
# arbitrary-precision integers throughout. SRL's arithmetic is IEEE double
# precision, which can only represent integers exactly up to 2^53; fib(79)
# already exceeds that. This stops at :n78 (fib(78) = 8944394323791464),
# the largest Fibonacci number still exactly representable, rather than
# silently returning a rounded value for fib(100).

PREFIX : <http://example/>

DATA {
  :n0 :fib 0 .
  :n1 :fib 1 .
  :n0 :succ :n1 .
  :n1 :succ :n2 .
  :n2 :succ :n3 .
  :n3 :succ :n4 .
  :n4 :succ :n5 .
  :n5 :succ :n6 .
  :n6 :succ :n7 .
  :n7 :succ :n8 .
  :n8 :succ :n9 .
  :n9 :succ :n10 .
  :n10 :succ :n11 .
  :n11 :succ :n12 .
  :n12 :succ :n13 .
  :n13 :succ :n14 .
  :n14 :succ :n15 .
  :n15 :succ :n16 .
  :n16 :succ :n17 .
  :n17 :succ :n18 .
  :n18 :succ :n19 .
  :n19 :succ :n20 .
  :n20 :succ :n21 .
  :n21 :succ :n22 .
  :n22 :succ :n23 .
  :n23 :succ :n24 .
  :n24 :succ :n25 .
  :n25 :succ :n26 .
  :n26 :succ :n27 .
  :n27 :succ :n28 .
  :n28 :succ :n29 .
  :n29 :succ :n30 .
  :n30 :succ :n31 .
  :n31 :succ :n32 .
  :n32 :succ :n33 .
  :n33 :succ :n34 .
  :n34 :succ :n35 .
  :n35 :succ :n36 .
  :n36 :succ :n37 .
  :n37 :succ :n38 .
  :n38 :succ :n39 .
  :n39 :succ :n40 .
  :n40 :succ :n41 .
  :n41 :succ :n42 .
  :n42 :succ :n43 .
  :n43 :succ :n44 .
  :n44 :succ :n45 .
  :n45 :succ :n46 .
  :n46 :succ :n47 .
  :n47 :succ :n48 .
  :n48 :succ :n49 .
  :n49 :succ :n50 .
  :n50 :succ :n51 .
  :n51 :succ :n52 .
  :n52 :succ :n53 .
  :n53 :succ :n54 .
  :n54 :succ :n55 .
  :n55 :succ :n56 .
  :n56 :succ :n57 .
  :n57 :succ :n58 .
  :n58 :succ :n59 .
  :n59 :succ :n60 .
  :n60 :succ :n61 .
  :n61 :succ :n62 .
  :n62 :succ :n63 .
  :n63 :succ :n64 .
  :n64 :succ :n65 .
  :n65 :succ :n66 .
  :n66 :succ :n67 .
  :n67 :succ :n68 .
  :n68 :succ :n69 .
  :n69 :succ :n70 .
  :n70 :succ :n71 .
  :n71 :succ :n72 .
  :n72 :succ :n73 .
  :n73 :succ :n74 .
  :n74 :succ :n75 .
  :n75 :succ :n76 .
  :n76 :succ :n77 .
  :n77 :succ :n78 .
}

RULE { :n2 :fib ?f }
WHERE { :n0 :fib ?a . :n1 :fib ?b . SET(?f := ?a + ?b) }

RULE { :n3 :fib ?f }
WHERE { :n1 :fib ?a . :n2 :fib ?b . SET(?f := ?a + ?b) }

RULE { :n4 :fib ?f }
WHERE { :n2 :fib ?a . :n3 :fib ?b . SET(?f := ?a + ?b) }

RULE { :n5 :fib ?f }
