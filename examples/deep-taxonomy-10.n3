# Following a classification chain 10 levels deep
#
# One individual starts in class N0. Forward N3 rules move it through 10
# classification levels and add side labels; reaching N10 derives A2 and a
# final test result. This provides a deep rule-chain workload.
#
# See <https://web.archive.org/web/20220119222608/http://responder.ruleml.org/WellnessRules/files/WellnessRulesN3-2009-11-10.pdf>

@prefix : <http://eulersharp.sourceforge.net/2009/12dtb/test#> .

# Start the individual in the first class of the chain.
:ind a :N0 .

# The final test depends on reaching A2 at the far end of the chain.
{
    :ind a :A2
} => {
    :test :is true
} .

# Each level adds the next N class and two side labels. Only N continues
# the chain; the I and J labels do not lead to the final test.
{
    ?X a :N0
} => {
    ?X a :N1, :I1, :J1
} .

{
    ?X a :N1
} => {
    ?X a :N2, :I2, :J2
} .

{
    ?X a :N2
} => {
    ?X a :N3, :I3, :J3
} .

{
    ?X a :N3
} => {
    ?X a :N4, :I4, :J4
} .

{
    ?X a :N4
} => {
    ?X a :N5, :I5, :J5
} .

{
    ?X a :N5
} => {
    ?X a :N6, :I6, :J6
} .

{
    ?X a :N6
} => {
    ?X a :N7, :I7, :J7
} .

{
    ?X a :N7
} => {
    ?X a :N8, :I8, :J8
} .

{
    ?X a :N8
} => {
    ?X a :N9, :I9, :J9
} .

{
    ?X a :N9
} => {
    ?X a :N10, :I10, :J10
} .

# Reaching the last N class enables the A2 classification.
{
    ?X a :N10
} => {
    ?X a :A2
} .

@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Report only the final test result, keeping the long classification output out.
{
    :test :is ?Result .
} log:query {
    :test :is ?Result .
} .
