# Following a parent relationship in reverse
#
# Parent-of and child-of are declared inverse properties (owl:inverseOf):
# A is the parent of B exactly when B is the child of A. N3 rules turn each
# family link around, in both directions, and also derive that the inverse
# declaration holds the other way round.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# The inverse declaration, and one link with each property
:parentOf owl:inverseOf :childOf .
:alice :parentOf :bob .
:carol :childOf :dave .

# Rules for owl:inverseOf
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# A statement with P gives the reverse statement with Q ...
{
    ?P owl:inverseOf ?Q .
    ?S ?P ?O
} => {
    ?O ?Q ?S
} .

# ... and a statement with Q gives the reverse statement with P.
{
    ?P owl:inverseOf ?Q .
    ?S ?Q ?O
} => {
    ?O ?P ?S
} .

# Being inverses is symmetric.
{
    ?P owl:inverseOf ?Q
} => {
    ?Q owl:inverseOf ?P
} .
