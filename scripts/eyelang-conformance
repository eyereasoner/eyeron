#!/usr/bin/env python3
"""Cross-check the Eyelang conformance cases against the reference implementation.

Every case in tests/eyelang_conformance/cases.txt is run through this
repository's `eyeron` and, when it is available, through the reference
`eyelang` CLI in a sibling checkout. A case that succeeds must produce the
same result document in both; a case that fails must fail in both, though
the two may word the message differently.

    scripts/eyelang-conformance            # report agreement
    scripts/eyelang-conformance --update   # also fill in the expectations
"""

import os
import re
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CASES = os.path.join(ROOT, "tests", "eyelang_conformance", "cases.txt")
EYERON = os.path.join(ROOT, "target", "release", "eyeron")
REFERENCE = os.path.join(ROOT, "..", "eyelang", "bin", "eyelang.js")


def parse(text):
    """Split the manifest into a header and a list of case dicts."""
    blocks = re.split(r"^\[case\] ", text, flags=re.M)
    header = blocks[0]
    cases = []
    for block in blocks[1:]:
        lines = block.split("\n")
        case = {"name": lines[0].strip(), "program": [], "output": [], "error": None, "section": "", "intent": ""}
        field = None
        for line in lines[1:]:
            tag = re.match(r"^\[(section|intent|program|output|error)\](.*)$", line)
            if tag:
                field, rest = tag.group(1), tag.group(2).strip()
                if field in ("section", "intent"):
                    case[field] = rest
                elif field == "error":
                    case["error"] = rest
                continue
            if field in ("program", "output"):
                case[field].append(line)
        for key in ("program", "output"):
            while case[key] and case[key][-1] == "":
                case[key].pop()
        cases.append(case)
    return header, cases


def run(command, program):
    with tempfile.NamedTemporaryFile("w", suffix=".eye", delete=False) as handle:
        handle.write(program + "\n")
        path = handle.name
    try:
        done = subprocess.run(command + [path], capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return None, "timed out"
    finally:
        os.unlink(path)
    if done.returncode != 0:
        message = (done.stderr or done.stdout).strip().split("\n")[0]
        return None, re.sub(r"^eyeron: |^eyelang: ", "", message)
    return done.stdout.rstrip("\n"), None


def main(argv):
    update = "--update" in argv
    if not os.path.exists(EYERON):
        sys.exit(f"build first: {EYERON} is missing")
    have_reference = os.path.exists(REFERENCE)
    if not have_reference:
        print(f"note: reference implementation not found at {REFERENCE}; checking eyeron alone\n")

    header, cases = parse(open(CASES).read())
    agree = differ = errors_both = 0
    problems = []

    for case in cases:
        program = "\n".join(case["program"])
        out, err = run([EYERON], program)
        if have_reference:
            ref_out, ref_err = run(["node", REFERENCE], program)
            if err is None and ref_err is None:
                if out == ref_out:
                    agree += 1
                else:
                    differ += 1
                    problems.append(f"OUTPUT DIFFERS  {case['name']} (§{case['section']})\n  intent: {case['intent']}\n  eyeron:\n{indent(out)}\n  eyelang:\n{indent(ref_out)}")
            elif err is not None and ref_err is not None:
                errors_both += 1
            else:
                differ += 1
                which = "eyeron failed, eyelang succeeded" if err else "eyelang failed, eyeron succeeded"
                problems.append(f"OUTCOME DIFFERS {case['name']} (§{case['section']})\n  intent: {case['intent']}\n  {which}\n  eyeron: {err or 'ok'}\n  eyelang: {ref_err or 'ok'}")
        case["new_output"] = [] if out is None else out.split("\n")
        case["new_error"] = err

    if problems:
        print("\n".join(problems))
        print()
    print(f"{len(cases)} cases: {agree} agree on output, {errors_both} agree on failure, {differ} differ")

    if update:
        chunks = [header.rstrip("\n"), ""]
        for case in cases:
            chunk = [f"[case] {case['name']}", f"[section] {case['section']}", f"[intent] {case['intent']}", "[program]"]
            chunk += case["program"]
            if case["new_error"] is not None:
                chunk.append(f"[error] {case['new_error']}")
            else:
                chunk.append("[output]")
                chunk += case["new_output"]
            chunks.append("\n".join(chunk))
        open(CASES, "w").write("\n\n".join(chunks) + "\n")
        print(f"wrote {CASES}")
    return 1 if differ else 0


def indent(text):
    return "\n".join(f"    {line}" for line in (text or "").split("\n"))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
