#!/usr/bin/env bash
# Cargo calls this for each native test executable. Rustdoc uses the same
# accounting through test-rustdoc, so compile-fail doctests count as well.
set -uo pipefail
script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(cd -- "$script_dir/.." && pwd)
if [[ "${1:-}" == --rustdoc ]]; then
  shift
  command=(rustdoc "$@")
  case " $* " in
    *' --test '*) suite='Doc-tests eyeron' ;;
    *) exec "${command[@]}" ;;
  esac
else
  command=("$@")
  suite="Running $1"
fi

# A target runner also receives cargo run and bench commands. Only a direct
# cargo test invocation gets totals; test-all supplies its own final footer.
cargo_args=$(ps -o args= -p "$PPID" 2>/dev/null || true)
if [[ "${EYERON_TEST_SUMMARY:-1}" == 0 || ! "$cargo_args" =~ cargo[[:space:]]+test([[:space:]]|$) ]]; then
  exec "${command[@]}"
fi

# Cargo runs the suites of this package sequentially. A process start stamp
# keeps separate invocations apart, including reuse of the same process ID.
stamp=$(ps -o lstart= -p "$PPID" | cksum | awk '{print $1}')
state="$repo_root/target/test-totals/$PPID-$stamp"
mkdir -p "$state"
if [[ ! -f "$state/started" ]]; then printf '%s\n' "$EPOCHREALTIME" > "$state/started"; fi
printf '%s\n' "$suite" >> "$state/output"
EYERON_TEST_SUMMARY=0 "${command[@]}" 2>&1 | tee -a "$state/output"
status=${PIPESTATUS[0]}
if [[ "$status" -ne 0 ]]; then touch "$state/failed"; fi

# On Linux count from Cargo's start, including compilation. Elsewhere start
# at the first test suite; both clocks stay independent of each suite's timer.
if [[ -r "/proc/$PPID/stat" && -r /proc/uptime ]]; then
  ticks=$(awk '{print $22}' "/proc/$PPID/stat")
  rate=$(getconf CLK_TCK)
  elapsed=$(awk -v ticks="$ticks" -v rate="$rate" '{printf "%.2f", $1 - ticks / rate}' /proc/uptime)
else
  read -r started < "$state/started"
  elapsed=$(awk -v start="$started" -v end="$EPOCHREALTIME" 'BEGIN {printf "%.2f", end - start}')
fi
aggregate_status=0
if [[ -f "$state/failed" ]]; then aggregate_status=1; fi
bash "$script_dir/test-summary" "$state/output" "$aggregate_status" "$elapsed"
exit "$status"
