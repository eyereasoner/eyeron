#!/usr/bin/env python3
"""Cross-check the Prolog conformance cases against real Prolog systems.

`docs/prolog-specification.md` says eyeron reads ISO/IEC 13211-1 Prolog
text and, inside the pure subset, means by it what the standard means. This
script is how that claim is checked rather than asserted: every case in
tests/prolog_conformance/cases.txt whose expectation is a result document
is also run through whichever of SWI-Prolog, GNU Prolog, SICStus and
Scryer are installed, and the answer sets are compared.

A case is compared by *answers*, not by output text: each system evaluates
the case's `?-` goals, collects the projected variable bindings with
findall/3, sorts them, numbervars them, and writes them; the same is done
to eyeron's recorded answers inside that same system, so both sides are
normalized by one writer. Cases that cannot be compared this way are
listed in SKIP with the reason.

    scripts/prolog-conformance            # report agreement
    scripts/prolog-conformance --update   # refill the [output] blocks from eyeron
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CASES = os.path.join(ROOT, "tests", "prolog_conformance", "cases.txt")
EYERON = os.path.join(ROOT, "target", "release", "eyeron")

# How to make each system consult a file and run `main`. Each entry is the
# argument list; `{file}` is replaced with the generated program's path.
SYSTEMS = [
    ("swipl", ["swipl", "-q", "-g", "main", "-t", "halt", "{file}"]),
    ("gprolog", ["gprolog", "--quiet", "--consult-file", "{file}", "--query-goal", "main"]),
    ("sicstus", ["sicstus", "--nologo", "--noinfo", "-l", "{file}", "--goal", "main, halt."]),
    ("scryer-prolog", ["scryer-prolog", "-g", "main", "-g", "halt", "{file}"]),
]

# Cases that cannot be compared against a resolution-order processor, and
# why. Each reason is a statement the specification already makes.
SKIP = {
    # §15.2: tabling is exactly what makes these terminate.
    "evaluation/left-recursion-terminates": "left recursion loops under ordered SLD resolution (specification §15.2)",
    "evaluation/clause-order-is-not-logical-priority": "the recursive clause comes first, which loops under ordered SLD resolution (§15.1)",
    "tabled/reordering-clauses-does-not-change-answers": "the recursive clause comes first, which loops under ordered SLD resolution (§15.1)",
    "tabled/a-cycle-terminates": "a cyclic definition loops under ordered SLD resolution (§15.2)",
    "evaluation/mutual-recursion-terminates": "mutual recursion loops under ordered SLD resolution (§15.2)",
    # §15.3: answers are distinct here and a bag elsewhere.
    "evaluation/answers-are-deduplicated": "duplicate answers are distinct solutions under ordered SLD resolution (§15.3)",
    "tabled/two-derivations-give-one-answer": "two derivations are two solutions under ordered SLD resolution (§15.3)",
    "tabled/findall-inherits-answer-distinctness": "findall/3 is a bag under ordered SLD resolution (§15.3)",
    "builtins/findall-collects-distinct-solutions": "findall/3 is a bag under ordered SLD resolution (§15.3)",
    # §14: eyeron's string kind, and the two predicates outside the standard.
    "lexical/string-escape-sequences": "double-quoted text is a string object here, a code list in the standard (§14)",
    "terms/kinds-are-distinct": "double-quoted text is a string object here, a code list in the standard (§14)",
    "terms/standard-order-across-kinds": "the standard order has no string kind to place (§5, §14)",
    "documents/answer-values-keep-their-kinds": "double-quoted text is a string object here, a code list in the standard (§14)",
    "excluded/a-string-is-its-own-kind": "double-quoted text is a string object here, a code list in the standard (§14)",
    "builtins/atomics-to-string-concatenates-text": "atomics_to_string/2 is an eyeron addition (§14)",
    "builtins/sudoku-solves-a-grid": "sudoku/2 is an eyeron extension (§9)",
    # A predicate eyeron deliberately does not provide; the point of the
    # case is the refusal, which a system that provides it cannot show.
    "builtins/list-library-predicates-are-not-implicit": "member/2 is in every system's list library; the case pins eyeron's refusal (§9)",
    # Reported by eyeron as one answer with no bindings, which a system
    # without a projection has no way to print.
    "operators/the-table-is-fixed": "the case pins a rejected directive, not an answer set",
    # §5: eyeron always performs the occurs check, so a system without one
    # builds a cyclic term here rather than failing.
    "terms/unification-performs-the-occurs-check": "a processor without the occurs check builds a cyclic term instead of failing (§5)",
    # §15.6: eyeron's clause/2 ranges over the user program only.
    "builtins/the-vanilla-meta-interpreter-is-three-clauses": "clause(true, B) raises a permission error in a conforming processor (§15.6)",
}

# Divergences that are a named difference between Prolog systems rather
# than between eyeron and the standard. eyeron follows the standard's own
# text in each; these record who else does what.
KNOWN = {
    ("swipl", "arithmetic/power-operators"):
        "SWI-Prolog's `**` keeps two integers integral; ISO/IEC 13211-1 §9.3.1 makes it float power, as GNU Prolog also does",
    ("gprolog", "arithmetic/exact-integer-division-gives-an-integer"):
        "GNU Prolog's `/` always yields a float for two integers; SWI-Prolog agrees with eyeron that an exact division stays integral",
    ("gprolog", "arithmetic/round-follows-the-standards-definition"):
        "GNU Prolog rounds ties to even and SWI-Prolog rounds them away from zero; ISO/IEC 13211-1 §9.1.6.1 defines rounding as floor(x + 1/2)",
    ("gprolog", "operators/a-sign-against-a-literal-is-part-of-it"):
        "GNU Prolog reads `- 1` as the integer -1 even across layout text; SWI-Prolog agrees with eyeron that only an adjacent sign joins the literal",
    ("scryer-prolog", "operators/a-sign-against-a-literal-is-part-of-it"):
        "Scryer reads `- 1` as the integer -1 even across layout text; SWI-Prolog agrees with eyeron that only an adjacent sign joins the literal",
    ("scryer-prolog", "arithmetic/exact-integer-division-gives-an-integer"):
        "Scryer's `/` always yields a float for two integers; SWI-Prolog agrees with eyeron that an exact division stays integral",
    ("swipl", "arithmetic/round-follows-the-standards-definition"):
        "SWI-Prolog rounds ties away from zero and GNU Prolog rounds them to even; ISO/IEC 13211-1 §9.1.6.1 defines rounding as floor(x + 1/2)",
    ("scryer-prolog", "arithmetic/round-follows-the-standards-definition"):
        "Scryer rounds ties away from zero; ISO/IEC 13211-1 §9.1.6.1 defines rounding as floor(x + 1/2)",
}


def parse(text):
    """Split the manifest into a header and a list of case dicts."""
    blocks = re.split(r"^\[case\] ", text, flags=re.M)
    header = blocks[0]
    cases = []
    for block in blocks[1:]:
        lines = block.split("\n")
        case = {"name": lines[0].strip(), "program": [], "output": [], "error": None,
                "section": "", "intent": ""}
        field = None
        for line in lines[1:]:
            tag = re.match(r"^\[(section|intent|program|output|error)\](.*)$", line)
            if tag:
                field, rest = tag.group(1), tag.group(2).strip()
                if field in ("section", "intent"):
                    case[field] = rest
                elif field == "error":
                    case["error"] = rest
                continue
            if field in ("program", "output"):
                case[field].append(line)
        for key in ("program", "output"):
            while case[key] and case[key][-1] == "":
                case[key].pop()
        cases.append(case)
    return header, cases


def render(header, cases):
    out = [header.rstrip("\n"), ""]
    for case in cases:
        out.append("")
        out.append("[case] %s" % case["name"])
        out.append("[section] %s" % case["section"])
        out.append("[intent] %s" % case["intent"])
        out.append("[program]")
        out.extend(case["program"])
        if case["error"] is not None:
            out.append("[error] %s" % case["error"])
        else:
            out.append("[output]")
            out.extend(case["output"])
        out.append("")
    return "\n".join(out).rstrip("\n") + "\n"


def run_eyeron(program):
    with tempfile.NamedTemporaryFile("w", suffix=".pl", delete=False) as handle:
        handle.write(program + "\n")
        path = handle.name
    try:
        done = subprocess.run([EYERON, path], capture_output=True, text=True, timeout=120)
    finally:
        os.unlink(path)
    return done.returncode, done.stdout, done.stderr


def update(header, cases):
    if not os.path.exists(EYERON):
        sys.exit("build the release binary first: cargo build --release")
    changed = 0
    for case in cases:
        program = "\n".join(case["program"])
        code, stdout, stderr = run_eyeron(program)
        if case["error"] is not None:
            if code == 0:
                print("  %s: expected an error, the program completed" % case["name"])
            continue
        if code != 0:
            print("  %s: expected a result document, got %s" % (case["name"], stderr.strip()))
            continue
        new = stdout.rstrip("\n").split("\n")
        if new != case["output"]:
            case["output"] = new
            changed += 1
    with open(CASES, "w") as handle:
        handle.write(render(header, cases))
    print("updated %d of %d cases" % (changed, len(cases)))


# ------------------------------------------------------------ comparison

def split_program(case):
    """Separate a case's clauses from its `?-` goal texts."""
    clauses, goals, buffer = [], [], []
    for line in case["program"]:
        buffer.append(line)
        if not line.rstrip().endswith("."):
            continue
        statement = "\n".join(buffer).strip()
        buffer = []
        if statement.startswith("?-"):
            goals.append(statement[2:].strip().rstrip(".").strip())
        else:
            clauses.append(statement)
    return clauses, goals


ANSWER = re.compile(r"^answer\((\d+), (\[.*\])\)\.$")
PROJECTION = re.compile(r"^query\((\d+), .*, (\[.*\])\)\.$")


def expected_answers(case):
    """eyeron's recorded answers, per query id, as Prolog list text."""
    answers = {}
    projections = {}
    for line in case["output"]:
        match = ANSWER.match(line.strip())
        if match:
            index = len(answers.setdefault(int(match.group(1)), []))
            # Variables are per-answer, not shared across answers.
            renamed = re.sub(r"\b_(\d+)\b", lambda m: "_A%d_%s" % (index, m.group(1)), match.group(2))
            answers[int(match.group(1))].append(renamed)
            continue
        match = PROJECTION.match(line.strip())
        if match:
            projections[int(match.group(1))] = re.findall(r"'([^']*)' = ", match.group(2))
    return answers, projections


# Variables are named by hand rather than with numbervars/3, which is a
# library predicate in some systems and a built-in in others.
NORMALIZE = """
show(Tag, Answers) :-
    copy_term(Answers, Copy),
    name_vars(Copy, 0, _),
    write(Tag), write(' '), writeq(Copy), nl.

name_vars(T, N0, N) :-
    (   var(T)
    ->  number_codes(N0, Codes), atom_codes(Digits, Codes),
        atom_concat('_v', Digits, T), N is N0 + 1
    ;   atomic(T)
    ->  N = N0
    ;   T =.. [_|Args], name_vars_list(Args, N0, N)
    ).

name_vars_list([], N, N).
name_vars_list([H|T], N0, N) :- name_vars(H, N0, N1), name_vars_list(T, N1, N).
"""


def driver(clauses, goal, names, expected):
    """A program that prints this system's answers and eyeron's, both
    normalized by this same system's writer."""
    binding_list = "[%s]" % ", ".join("'%s' = %s" % (n, n) for n in names)
    return "\n".join(clauses + [
        "",
        "main :-",
        "    findall(%s, (%s), Actual0)," % (binding_list, goal),
        "    sort(Actual0, Actual),",
        "    sort([%s], Expected)," % ", ".join(expected),
        "    show(actual, Actual),",
        "    show(expected, Expected).",
        NORMALIZE,
    ])


def run_system(argv, text):
    with tempfile.NamedTemporaryFile("w", suffix=".pl", delete=False) as handle:
        handle.write(text)
        path = handle.name
    try:
        command = [part.replace("{file}", path) for part in argv]
        done = subprocess.run(command, capture_output=True, text=True, timeout=30,
                              stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None, "timed out"
    finally:
        os.unlink(path)
    actual = expected = None
    for line in done.stdout.splitlines():
        if line.startswith("actual "):
            actual = line[len("actual "):].strip()
        elif line.startswith("expected "):
            expected = line[len("expected "):].strip()
    if actual is None or expected is None:
        return None, (done.stderr.strip() or done.stdout.strip() or "no output").splitlines()[-1][:120]
    return (actual == expected), "%s vs %s" % (actual, expected)


def compare(cases):
    available = [(name, argv) for name, argv in SYSTEMS if shutil.which(argv[0])]
    if not available:
        sys.exit("no Prolog system found; install at least one of: %s"
                 % ", ".join(name for name, _ in SYSTEMS))
    print("cross-checking against: %s" % ", ".join(name for name, _ in available))

    comparable = [c for c in cases if c["error"] is None and c["name"] not in SKIP]
    skipped = [c for c in cases if c["name"] in SKIP]
    errors = [c for c in cases if c["error"] is not None]
    # [agreed, diverged, could not run]
    totals = {name: [0, 0, 0] for name, _ in available}
    divergences = {name: [] for name, _ in available}
    known = []

    for case in comparable:
        clauses, goals = split_program(case)
        answers, projections = expected_answers(case)
        for name, argv in available:
            outcome, detail = True, ""
            for index, goal in enumerate(goals, start=1):
                text = driver(clauses, goal, projections.get(index, []),
                              answers.get(index, []))
                result, info = run_system(argv, text)
                if result is not True:
                    outcome, detail = result, info
                    break
            if outcome is True:
                totals[name][0] += 1
            elif (name, case["name"]) in KNOWN:
                totals[name][0] += 1
                known.append((name, case["name"]))
            else:
                totals[name][1 if outcome is False else 2] += 1
                divergences[name].append((case["name"], detail))

    print()
    ok = True
    for name, _ in available:
        agreed, diverged, unrunnable = totals[name]
        # A system that could not run most of the harness (an expired
        # licence, a missing built-in) is reported as unavailable rather
        # than as disagreeing with the standard.
        if unrunnable > len(comparable) // 2:
            print("%-14s unusable here: %s"
                  % (name, divergences[name][0][1] if divergences[name] else "no output"))
            continue
        print("%-14s %d agreed, %d diverged, %d could not run (of %d comparable cases)"
              % (name, agreed, diverged, unrunnable, len(comparable)))
        for case_name, detail in divergences[name]:
            print("    %s\n      %s" % (case_name, detail))
        ok = ok and diverged == 0

    if known:
        print("\n%d documented system differences, all resolved in the standard's favour:" % len(known))
        for system, case_name in known:
            print("  %-14s %s\n    %s" % (system, case_name, KNOWN[(system, case_name)]))
    print("\n%d cases skipped as not comparable, %d expect an error message:" % (len(skipped), len(errors)))
    for case in skipped:
        print("  %s\n    %s" % (case["name"], SKIP[case["name"]]))
    return ok


def main():
    with open(CASES) as handle:
        header, cases = parse(handle.read())
    if "--update" in sys.argv[1:]:
        update(header, cases)
        return 0
    return 0 if compare(cases) else 1


if __name__ == "__main__":
    sys.exit(main())
